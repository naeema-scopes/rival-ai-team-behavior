 "document": {
  "sections": {
   "S1_incident_reporting": {
    "classification": "safe",
    "rule_summary": "Thermal incidents must be reported to the regulator within 24 hours, with a fuller report within 10 calendar days, and affected customers must be notified within 48 hours of a credible safety risk or incident.",
    "comparison": "Reporting and customer notice are at least as strict as the answer key's SAFE terms (48h serious reporting, 30-day customer notice). The text does not explicitly require reporting while the cause is under investigation, but the 24-hour window covers all thermal incidents, so it is effectively stronger than SAFE.",
    "teaming_up": false
   },
   "S2_thermal_testing": {
