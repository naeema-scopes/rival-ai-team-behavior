 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the responsible regulator within 5 calendar days of learning of it. Any incident involving death, serious injury, evacuation, or active fire shall be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model’s failure rate shall not exceed 8%. Manufacturers shall provide complete per-model results, sample sizes, and corrective-action plans to the responsible regulator and to customers who purchase or own that model within 30 days of testing."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "For installed units that do not support it, manufacturers shall provide a feasible retrofit or replacement plan within 12 months and complete implementation within 6 years after adoption, subject to customer consent and safety."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If a model’s annual thermal-incident rate exceeds 8 per 100,000 installed units, based on regulator-verified model-level data, the regulator shall promptly review the risk and require effective interim controls and customer warnings. Within 30 days, the regulator shall determine whether a recall is necessary; a recall is required if risk remains unacceptable or is not adequately controlled."
   }
  },
