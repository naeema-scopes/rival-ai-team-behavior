 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 90,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Less severe thermal incidents must be reported to the regulator in a quarterly aggregate, with model and incident details. Customers whose unit was involved must be notified within 24 hours; customers in an affected installation or batch must receive a safety notice within 5 business days when a credible safety risk is identified."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires prompt submission of a corrective-action plan and retesting; it does not by itself require an immediate sales ban. Regulators may impose proportionate interim safeguards or restrict sales where the evidence warrants it."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery systems placed on the market must support a secure remote emergency shut-off function that can be initiated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or emergency responders under documented safeguards. For already-installed units, manufacturers must offer a retrofit or equivalent mitigation plan within 6 years of this standard taking effect"
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems placed on the market must include built-in fire suppression beginning 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "The threshold triggers prompt regulator review and a documented decision on corrective action; it does not by itself require automatic recall. Regulators may require a recall or other corrective action whenever evidence indicates an imminent or material safety risk, or remediation is inadequate."
   }
  },
