  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal event involving fire, smoke, uncontrolled overheating, injury, or property damage to the relevant regulator within 24 hours of learning of it, and provide a complete incident report within 10 business days. Reports must include known facts and be updated as investigations proceed; uncertainty is not a reason to delay an initial report."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers prompt corrective action, a documented retest, and regulator review of the model’s safety and interim risk controls; it is not by itself an automatic sales ban. Regulators may require additional measures, including sales restrictions, where the evidence indicates they are warranted."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Remote emergency shut-off is required for all new home battery units placed on the market beginning 12 months after adoption. Manufacturers must retrofit installed units to support remote emergency shut-off, or provide an equally effective regulator-approved remote emergency isolation capability, within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units placed on the market must include built-in fire suppression beginning 36 months after adoption. Regulators may approve an equivalent or safer mitigation for a specific design where built-in suppression is not technically suitable."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model’s verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any rolling 12-month period. Manufacturers must promptly notify regulators and affected customers, stop sales, and implement the regulator-approved recall and remedy; an investigation must not delay interim protective measures or notice."
   }
  },
