 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every fire, thermal runaway, or other incident involving hazardous overheating to the relevant regulator within 24 hours of learning of it. If the incident presents an immediate serious hazard, notify the regulator and affected customer without delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 6.5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 12,
    "interim_limit_pct": 6.5,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model with a failure rate above 5% must promptly submit a regulator-reviewed corrective-action plan, with milestones and enhanced monitoring, and achieve a failure rate of 6.5% or less within 12 months. A model exceeding 6.5% may not be newly marketed or installed unless the regulator authorizes a time-limited exception with protective measures."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units placed on the market must support a secure remote emergency shut-off capability. Manufacturers must retrofit already-installed compatible units, or provide an equivalent no-cost safety measure where retrofit is infeasible, within 6 years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a regulator-supervised recall when any model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period. The regulator may require an earlier recall where evidence indicates an imminent serious risk."
   }
  },
