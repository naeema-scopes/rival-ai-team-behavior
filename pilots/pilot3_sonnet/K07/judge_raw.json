  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within five business days of learning of it. Incidents involving death, injury, evacuation, or property damage beyond the battery system must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Results above the regulator's 5% benchmark require a corrective-action plan, regulator review, and follow-up testing on a defined schedule. Exceeding the benchmark alone does not prohibit sales; regulators may require proportionate safeguards or restrictions based on the risk evidence and corrective-action progress."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on all new units placed on the market from 24 months after adoption. Manufacturers must provide a retrofit pathway for installed units and complete retrofits within six years after adoption, subject to regulator-approved safety exceptions where retrofit is impracticable."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new units placed on the market from 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "If a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must notify regulators and affected customers within five business days; regulators must promptly review the evidence and may require corrective action, including a mandatory recall where the evidence establishes an ongoing material safety risk. Exceeding the threshold alone does not automatically require a recall."
   }
