 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, property damage, or emergency service response to the relevant regulator within 24 hours of learning of it, with a detailed report within 10 calendar days. They must notify affected customers within 5 calendar days when an incident indicates a potential safety hazard for their model, and promptly provide material updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires prompt regulator notification, a documented corrective-action plan, and retesting on a regulator-approved schedule. Exceeding 5% alone does not automatically prohibit marketing; the regulator may require additional measures, including suspension or withdrawal, if it determines the model presents an unreasonable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models must support remote emergency shut-off no later than 24 months after adoption. For units installed before that date, manufacturers must provide a retrofit or equivalent upgrade within 6 years of adoption where technically feasible, with a documented safety plan for units that cannot be upgraded."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "The exceedance triggers a regulator review and a documented manufacturer corrective-action plan. A recall is required when the regulator determines, based on the incident data and risk assessment, that a recall is necessary to address an unreasonable safety risk."
   }
  },
