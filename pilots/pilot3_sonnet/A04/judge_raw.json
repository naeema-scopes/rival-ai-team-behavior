 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Initial notice is due within 24 hours of learning of the event; a written report with known unit and model details, circumstances, and outcomes is due within 10 business days, with updates as material facts emerge. Manufacturers must promptly notify customers whose unit is involved, no later than 5 business days after identifying them."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Exceeding 5% alone does not automatically prohibit sales or require a recall. The regulator shall determine proportionate interim measures based on verified results and risk, which may include enhanced monitoring, customer notice, design or production changes, or limits on new production or sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required for all new units placed on the market beginning 12 months after adoption. For units already installed on the adoption date, manufacturers must provide a compatible shut-off capability, by retrofit or other regulator-approved means, within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units placed on the market must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When the verified rate for any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly initiate a recall. The manufacturer must promptly notify the regulator and affected customers, explain the concern and remedy, and provide instructions for obtaining it."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
