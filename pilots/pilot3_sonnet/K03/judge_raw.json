 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal injury to the regulator within 24 hours of learning of it, including incidents initially reported by customers or emergency services. Manufacturers must notify affected customers within 5 days of confirming a material thermal hazard, with safe-use guidance and any interim restrictions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model's failure rate must not exceed 5%. A model exceeding 5% must promptly submit a regulator-approved corrective-action plan and be retested within 12 months. The regulator may require sales restrictions or additional protective action based on results, severity, and evidence of risk; urgent protective measures are not delayed by the corrective-action period."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units manufactured 24 months or more after adoption must support remote emergency shut-off, with safeguards against unauthorized activation and a clear way for customers to understand when shut-off has occurred. For installed units, manufacturers must provide a compatible remote shut-off retrofit or equivalent effective emergency isolation capability within six years of adoption, where technically feasible, and report implementation progress annually to the regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 5,
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when a model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period. The regulator may require a recall below that threshold where the severity or pattern of incidents warrants it."
   }
  },
