 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. They must notify affected owners within 72 hours when an incident presents a potential safety risk, and promptly provide material updates. Incidents may not be excluded because their cause is uncertain."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers a regulator-supervised corrective-action plan and retesting on a regulator-set schedule; the regulator will assess the results and the adequacy of corrective measures in light of the identified risk. Exceeding 5% alone does not automatically bar new sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must include a remote emergency shut-off capability beginning 12 months after adoption. For units already installed on the adoption date, manufacturers must provide a compatible remote shut-off retrofit or upgrade within 72 months, where technically feasible; if not feasible, they must document the reason for the regulator and provide owners with an alternative emergency isolation procedure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. The suppression system must be validated for the unit’s battery chemistry and configuration, and maintained in accordance with manufacturer instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify regulators and affected owners and initiate a recall, including safe-use, service, repair, replacement, or return instructions appropriate to the risk. A recall is mandatory at this threshold but does not by itself impose a permanent sales ban; regulators may restrict sales or require an immediate recall where the risk is urgent."
   }
  },
