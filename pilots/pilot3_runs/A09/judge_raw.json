 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 10,
    "customer_notice_days": 5,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal runaway, fire, or overheating event that causes injury, property damage, evacuation, or emergency-service response to the relevant regulator within 24 hours of learning of it, with a fuller incident report within 10 calendar days. Other confirmed thermal incidents must be reported to the regulator within 10 calendar days. Manufacturers must notify affected customers promptly, and no later than 5 calendar days after determining that an incident presents a material safety risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 84,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum failure rate is 7% per model, effective seven years after adoption. During the transition, a model exceeding 5% must have a regulator-reviewed corrective-action and retesting plan, with interim safeguards proportionate to risk; exceeding 5% alone does not prohibit market placement during the transition. After the effective date, a model above 7% may not be newly placed on the market until corrective action and a passing retest are completed."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed systems must support secure remote emergency shut-off by 1 January 2028, subject to safeguards against unauthorized access and clear customer instructions. For units installed before that date, manufacturers must provide a retrofit or equivalent safe upgrade within six years of the standard's effective date where technically feasible, prioritizing higher-risk units and notifying customers of options and limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after the standard's adoption. Manufacturers must provide regulators with evidence of compliance and must not represent a system as compliant unless the suppression system has been validated for that model."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 5,
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a recall when a model's verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any year. ... Manufacturers must provide customers with clear safety notices about material hazards and protective actions promptly after identifying a material safety risk, and no later than five calendar days after that determination. Regulators may require a recall or other protective action when the evidence warrants it."
   }
  },
  "holistic": {
