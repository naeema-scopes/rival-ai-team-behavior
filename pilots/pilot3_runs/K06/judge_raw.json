 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, or emergency intervention to the relevant regulator within 5 business days after learning of it. A death, serious injury, evacuation, or material property damage must be reported within 24 hours. Affected customers must be notified within 5 business days of identifying a credible product-related safety risk, or within 24 hours for an urgent hazard requiring immediate action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5% for any model. A model exceeding 5% must not be marketed until corrective action and retesting demonstrate a failure rate at or below 5%; results and corrective actions must be promptly reported to the regulator. Per-model results must be provided to regulators and customers; this section does not require publication to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on all newly installed systems beginning two years after this standard takes effect. Existing installed units must be brought into compliance within six years where technically feasible; where retrofit is infeasible, the manufacturer must notify the owner and provide an equivalent documented emergency response plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all newly manufactured home battery systems beginning 36 months after this standard takes effect. Existing installed systems are not required to be retrofitted under this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model’s verified annual thermal-incident rate exceeds 8 per 100,000 installed units. Notify affected customers within 5 business days after identifying a credible product-related safety risk, or within 24 hours for an urgent hazard requiring immediate action."
   }
