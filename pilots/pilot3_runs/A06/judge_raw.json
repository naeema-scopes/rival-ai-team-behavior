 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a follow-up report containing known cause and corrective actions within 30 days. Manufacturers shall notify affected owners within 48 hours when an incident presents a credible safety risk to their unit or requires action; notices shall describe immediate precautions and how to obtain assistance. Reports and notices shall not be delayed while cause is investigated."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "If more than 5% of tested units fail, the manufacturer shall promptly notify regulators, submit a corrective-action plan, and retest the model under the regulator-established protocol. Regulators may require additional safeguards or restrict sales if the manufacturer fails to implement adequate corrective action. (Per-model results go to regulators and to customers who buy that model: \"Results need not be published to the general public.\")"
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units manufactured 24 months or more after adoption shall include a remote emergency shut-off capability that can be activated by the manufacturer or emergency responders when necessary to address an imminent thermal safety risk. For installed units lacking this capability, manufacturers shall offer a retrofit or replacement pathway and complete it, where technically feasible, within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption shall include built-in fire suppression appropriate to the unit's chemistry and installation conditions, validated under a regulator-recognized test protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a 12-month period, the manufacturer shall promptly notify regulators and affected customers, submit supporting data and a corrective-action plan, and cooperate with regulator review. Regulators shall assess the evidence and may require a recall or other protective measures where warranted by the risk; manufacturers shall promptly implement any such order."
   }
  },
