 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving overheating, fire, injury, property damage, or emergency-service response within 24 hours of becoming aware of it, with a fuller report within 10 business days. Manufacturers must notify affected customers within 48 hours when an incident indicates a material safety risk, and provide updates as the investigation proceeds."
   },
