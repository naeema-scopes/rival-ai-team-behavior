 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents with no injury or property damage. Manufacturers shall notify affected customers within 72 hours when an incident presents a credible safety risk to them or their neighbours, and provide any regulator-directed safety instructions without delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 24,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The failure rate shall not exceed 5% of tested units. Manufacturers shall submit per-model results, test methods, sample sizes, and failure rates to the relevant regulator and provide those same results, methods, and sample sizes to customers who buy that model. A model exceeding the limit shall not be newly placed on the market until regulator-approved corrective action is completed. For models already on the market when this standard is adopted, the manufacturer shall submit a corrective-action plan to the regulator within 90 days and complete approved corrective action within 24 months."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units placed on the market shall support remote emergency shut-off. Manufacturers shall provide remote shut-off capability, or an equivalent regulator-approved emergency isolation method, for all installed units within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
