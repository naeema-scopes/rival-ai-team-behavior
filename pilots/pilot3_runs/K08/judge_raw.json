    "customer_notice_days": 5,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery-related fire, thermal runaway, evacuation, injury, or material property damage within 24 hours of becoming aware of it, with a written incident report within 10 calendar days. Other confirmed thermal incidents must be reported within 10 calendar days. Manufacturers must notify affected customers within 5 calendar days when an incident indicates a material safety risk to their unit or model, and promptly provide any protective steps."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum failure rate is 5%. Manufacturers must submit per-model results, sample sizes, test methods, and corrective actions to regulators, and must provide the numerical result for each model to customers who buy it. A model exceeding the limit must promptly submit an enforceable corrective-action plan and timetable to the regulator, complete corrective measures, and undergo a verified retest; regulators may restrict sales where a manufacturer fails to implement its plan or where evidence indicates an imminent safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must include remote emergency shut-off capability. Manufacturers must retrofit installed units that lack this capability, or provide an equivalent regulator-approved emergency measure, within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression no later than 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Notify affected customers promptly when new information indicates a material risk, and provide updates as material facts emerge. Regulators must receive the numerical per-model 55 °C test result. A mandatory model recall is triggered when the confirmed annual thermal-incident rate exceeds 8 incidents per 100,000 installed units."
   }
