 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or suspected thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents with no injury or property damage. They must provide affected customers with an initial safety notice within 48 hours when an incident presents a credible safety risk, and promptly update that notice as material facts become known."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a documented, reproducible protocol before sale and at least annually thereafter, and after a material design or manufacturing change. No more than 7% of tested units of any model may fail. Manufacturers must provide regulators and customers who buy or own that model with the per-model test protocol, sample size, failure rate, results, and corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support remote emergency shut-off beginning two years after adoption of this standard. Manufacturers must retrofit already-installed units to support remote emergency shut-off within six years after adoption, where technically feasible, and must notify affected customers of the schedule and any interim safety guidance."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must provide customers with clear safety notices for incidents, test failures, and corrective actions affecting their model, including available interim precautions and repair or replacement information, promptly as material facts become known. When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers and initiate a recall."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
