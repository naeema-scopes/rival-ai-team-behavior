 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 72 hours of learning of it, with a complete incident record and any known contributing factors within 30 days. A manufacturer must notify affected customers within 7 days when an incident indicates a material safety risk or requires a customer action; urgent hazards require notice without delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol, with a representative sample and repeat testing after material design changes. The maximum permitted failure rate is 5%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units must support remote emergency shut-off. Manufacturers must provide a retrofit pathway for installed units and complete retrofits within six years of this standard taking effect, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, the manufacturer must immediately notify the relevant regulator and affected customers, provide interim risk-mitigation instructions, and submit incident and population data for prompt regulator review. A recall is mandatory if the regulator confirms the threshold is exceeded and determines that the risk cannot be adequately controlled through corrective action; an imminent safety risk requires immediate recall or other protective action."
   }
  },
