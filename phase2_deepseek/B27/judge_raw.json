 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a preliminary account and known unit/model identifiers. The manufacturer must notify the affected owner within 72 hours of learning of the incident and provide safety steps; if a credible risk may affect other owners or nearby people, it must promptly notify those potentially affected and the regulator."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved representative sample and protocol. The regulator may require further restrictions based on the evidence; exceeding 5% alone does not automatically prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must retrofit already-installed units to support remote shut-off within six years of this standard taking effect, where technically feasible; they must provide owners a safe alternative and notify the regulator when a unit cannot be retrofitted."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units placed on the market must include built-in fire suppression beginning 36 months after this standard takes effect. Manufacturers must provide clear instructions on the system’s operation, limitations, and maintenance."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a regulator-supervised recall and remedy process when any model exceeds 8 thermal incidents per 100,000 installed units in a year. The regulator will determine the required remedy and whether affected units may remain in service or sales may resume after corrective action; the threshold requires a recall process but does not itself impose a permanent market ban."
   }
  },
