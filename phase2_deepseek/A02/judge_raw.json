 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving a home battery—including overheating, smoke, fire, injury, emergency-service response, or property damage—to the relevant safety regulator within 24 hours after learning of it, and provide a written incident report within 10 calendar days. They must notify the affected customer promptly, and no later than 24 hours after learning of an incident presenting an ongoing safety risk; otherwise, notify the affected customer within 5 calendar days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 18,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and a representative sample. A model complies only if no more than 5% of tested units fail. ... For a model already on sale when this standard is adopted that exceeds the 5% limit, the manufacturer may seek a transition period of up to 18 months from adoption."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New home battery units must support remote emergency shut-off no later than 36 months after adoption of this standard. ... For units already installed when the standard is adopted, manufacturers must provide remote shut-off capability through retrofit or replacement within 6 years, where technically feasible, and report implementation progress annually to the regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard. Manufacturers must document the suppression design and its validation in the product safety materials. Existing installed units are not subject to a retrofit requirement under this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must notify the regulator and affected customers promptly when a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. A confirmed exceedance triggers a mandatory recall of that model; the manufacturer must provide a corrective-action plan and recall progress updates to the regulator."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
