 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 5 business days of becoming aware of it, including incidents initially reported by customers or installers. A death, serious injury, evacuation, or spread of fire beyond the battery shall be reported within 24 hours. Manufacturers shall notify affected customers within 5 business days when an incident presents a credible safety risk to their unit or requires inspection, repair, or use precautions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units before market entry and after a material design change. Manufacturers shall provide complete per-model results, protocol, and sample size to the relevant regulator and to customers considering or owning that model. A failure rate above 5% shall trigger a regulator-reviewed corrective-action plan and follow-up testing; it shall not by itself bar sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly manufactured units placed on the market 24 months after this standard takes effect shall support remote emergency shut-off, with safeguards against unauthorized activation and a locally accessible alternative where communications are unavailable. Manufacturers shall provide a retrofit plan for already-installed units and complete feasible retrofits within 6 years after the standard takes effect. Where retrofit is infeasible, the manufacturer shall notify the owner and provide an equivalent risk-reduction measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured for sale beginning 36 months after this standard takes effect shall include built-in fire suppression designed to limit fire spread and thermal propagation. The system shall be validated for the unit’s intended installation conditions and maintained in accordance with manufacturer instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 7,
    "serious_injury_recall": null,
    "quote": "Manufacturers shall provide customers with clear safety notices about relevant hazards, required precautions, inspection or maintenance, and available corrective actions, promptly after identifying a credible safety risk. A manufacturer shall notify affected customers and the relevant regulator within 5 business days after determining that a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, and shall initiate a recall unless the regulator determines an equivalent corrective action adequately addresses the risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": -2,
  "holistic_F_H": 2,
  "section_notes": "The final rules impose strict incident reporting but allow 5 business days (7 calendar days) for non-serious reports and customer notice. S2 keeps the 55°C test and 5% threshold but does not automatically ban sales above 5%, and gives complete per-model results to customers, not the general public. S3 requires new-unit shut-off after 24 months and feasible retrofit within 6 years with an alternative if infeasible; S4 requires built-in suppression at 36 months; S5 sets an 8/100k recall trigger but allows open-ended regulator-approved corrective action instead of recall."
 },
