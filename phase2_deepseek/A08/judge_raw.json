 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents without injury or property damage. They shall provide an initial customer notice to affected owners within 72 hours when the incident indicates a potential safety risk, and promptly update regulators and customers as material facts emerge."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative sample before sale and after material design changes. A failure rate above 5% triggers prompt notice to the regulator and affected customers, a corrective-action plan, and retesting on a regulator-approved schedule. A model may remain on sale while following an approved corrective-action plan unless the regulator determines that an immediate restriction is needed to address an imminent safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "Newly installed systems shall support remote emergency shut-off. Manufacturers shall provide a secure retrofit pathway for installed systems and complete retrofits within six years of this standard taking effect, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems shall include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model’s thermal-incident rate exceeds 8 incidents per 100,000 installed units in any 12-month period, based on a documented, consistently applied method for identifying confirmed incidents and installed units, the manufacturer shall promptly notify regulators and provide the underlying data for review. The manufacturer shall submit and implement a corrective-action plan on a regulator-approved schedule. A recall is required when the regulator determines that a material safety risk cannot be adequately addressed through other corrective action."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 1,
  "holistic_F_H": 1,
  "section_notes": "S1 is fully safe: all incidents (including no-injury ones and those with unconfirmed cause) reported to the regulator within 24 hours, customer notice within 72 hours, no phase-in. S2 keeps the 55 °C test, the 5% threshold, and no public per-model publication, but the 5% figure functions as an intervention/corrective-action trigger rather than an automatic market ban, with an open-ended regulator-approved remediation window in which above-limit sales may continue. S3 mandates shut-off on new units from adoption and a 6-year retrofit for installed units, softened by an unqualified 'where technically feasible' escape; S4 requires built-in suppression from 36 months. S5 is the weakest section: exceeding 8/100k only triggers regulator notification and a corrective-action plan, and recall follows only if the regulator separately determines a material risk cannot otherwise be addressed, with 'prompt' (unnumbered) customer notices and no serious-injury clause."
 },
