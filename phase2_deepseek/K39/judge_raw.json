 ],
 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any battery thermal incident involving overheating, fire, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of becoming aware, with a detailed incident report within 10 business days. Manufacturers shall notify affected customers promptly when an incident presents a material safety risk, and provide updated safety information as it becomes available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7.5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol before market authorization and after material design changes. Manufacturers shall submit per-model results, including units tested and failure rate, confidentially to the regulator and provide the exact results to customers of that model. A model exceeding a 5% failure rate shall complete corrective action and retesting under regulator oversight. A model exceeding 7.5% shall not be authorized for sale, or shall be suspended from sale, until corrective action is completed and it passes a retest at or below 7.5%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New battery units placed on the market shall support remote emergency shut-off no later than three years after this standard takes effect. For units already installed when the standard takes effect, manufacturers shall provide a compatible retrofit or replacement option and complete required retrofits within six years, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
