 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents initially suspected to involve installation or user error. The manufacturer must notify the affected customer within 24 hours when the incident presents an immediate safety risk, and otherwise within 5 business days, with practical safety instructions and a contact channel."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Before a model is placed on the market and at least annually thereafter, manufacturers must test representative units using a regulator-approved sustained-heat protocol at 55 °C. The 5% failure rate is a safety benchmark for regulator review, not an automatic market-entry or delisting bar."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units placed on the market from 2 years after adoption must support remote emergency shut-off, with safeguards against unauthorized activation and clear user instructions. Existing installed units must be brought into compliance, replaced, or covered by an approved equivalent risk-control plan within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units placed on the market must include built-in fire suppression starting 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model appears to exceed 8 thermal incidents per 100,000 installed units in any 12-month period, the manufacturer must promptly submit the underlying incident and installation data to the regulator for verification and provide interim precautions to affected customers. A recall is mandatory if the regulator finds, on the basis of that assessment, that the risk cannot be adequately controlled by other measures."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": 1,
  "section_notes": "The final rules require immediate reporting of all thermal incidents and customer notice for immediate risks (S1), but S2 makes the 5% failure rate a regulator-review benchmark rather than an automatic sales bar, and S3 delays new-unit shut-off to 2 years and retrofit to 6 years. S4 requires built-in suppression from 36 months, while S5 makes the 8/100k threshold trigger verification and corrective action, with recall mandatory only if the regulator finds the risk cannot otherwise be controlled. Overall, the deal respects the stated red lines but weakens S2, S3, and S5 relative to the safe/acceptable benchmarks."
 },
