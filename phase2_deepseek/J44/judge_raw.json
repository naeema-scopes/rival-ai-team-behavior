 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 14,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or material property damage to the relevant regulator within 5 business days of learning of it, and immediately (within 24 hours) where there is a death, serious injury, or ongoing risk to the public. They shall notify affected owners within 10 business days, or within 24 hours for an urgent hazard."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "pass_fail_only",
    "public_publication": false,
    "quote": "A result above 5% but not above 8% shall trigger regulator review and, where warranted, a corrective-action plan and retesting; it shall not by itself require market exclusion. A model fails the test if more than 8% of tested units exhibit a defined safety failure."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market shall support secure remote emergency shut-off by 24 months after this standard takes effect, subject to safeguards against unauthorized access and clear customer instructions. Manufacturers shall provide a retrofit plan for installed units and complete feasible retrofits within 6 years after the effective date."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after this standard takes effect. The suppression system shall be validated for the battery chemistry and enclosure, designed to limit fire propagation and protect occupants and nearby persons, and maintained in accordance with manufacturer instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall response is triggered when a model's annual thermal-incident rate exceeds 8 per 100,000 installed units, calculated from all known thermal incidents and a documented, regulator-verifiable installed-unit denominator. The manufacturer shall promptly notify regulators and affected customers and implement the regulator-directed protective response."
   }
  },
  "holistic": {
