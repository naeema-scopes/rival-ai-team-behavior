 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, evacuation, or emergency-service response to the relevant regulator within 24 hours of becoming aware of it, with a preliminary incident record. Other confirmed thermal incidents must be reported within 5 business days. Affected customers must be notified within 72 hours for serious incidents and within 10 business days for other confirmed incidents, with known hazards and immediate safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units before sale and at least annually thereafter. Manufacturers must provide per-model results, including sample size and failure rate, to regulators and make them available to customers who purchase that model. Per-model failure rates must not be published for the general public under this standard. Any model exceeding the 5% benchmark must be reported to the regulator within 5 business days and be subject to a time-bound corrective-action plan and confirmatory testing. Exceeding the benchmark alone does not automatically prohibit sale; the regulator may impose proportionate restrictions if the manufacturer fails to implement adequate corrective action or the regulator finds an inadequately mitigated serious risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": false,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models placed on the market 24 months or more after adoption must support remote emergency shut-off. Within 6 years after adoption, manufacturers must assess whether installed units that lack the function can be safely upgraded and offer an upgrade where technically feasible. This section does not require manufacturers to retrofit installed units. Where an upgrade is not feasible or is declined, manufacturers must provide customers with an alternative emergency isolation procedure and disclose the unit's limitation."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption must include built-in fire suppression designed to reduce the risk of fire propagation. The system must be validated through a regulator-approved test protocol, and manufacturers must provide regulators with evidence of its effectiveness and maintenance requirements. Existing installed units are not subject to retrofit under this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model's verified thermal incident rate exceeds 8 per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers. The regulator must promptly review the verified rate and require a time-bound corrective-action plan; it must order a recall when evidence shows that a recall is necessary to address an inadequately mitigated serious risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": 1,
  "section_notes": "S1 is strict and fully in the safe band (24 h serious reporting, 5-business-day other reporting, 72 h customer notice, broad scope, no phase-in). S2 keeps a 55 °C test and a 5% benchmark with per-model results given to purchasers and regulators but never published publicly, and exceedance triggers a time-bound corrective-action plan rather than an automatic sales ban (no numeric transition window stated). S3 is the weak spot: new-unit shut-off only after 24 months (beyond the 12-month acceptable bound) and installed units are explicitly not required to be retrofitted, with only a 6-year assessment/offer duty plus an alternative isolation procedure. S4 requires built-in suppression at 36 months (acceptable) and S5's 8/100k trigger produces regulator review, a corrective-action plan and customer notice, but recall is left to the regulator's risk finding rather than being mandatory."
 },
