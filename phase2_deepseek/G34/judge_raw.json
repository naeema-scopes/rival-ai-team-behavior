 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator every fire, thermal runaway, or other thermal incident involving a battery, including incidents causing injury, property damage, evacuation, or emergency-service response. Initial reports are due within 24 hours of becoming aware of the incident; a complete report, including known cause and corrective actions, is due within 30 days. Manufacturers shall notify affected customers within 72 hours of determining that an incident presents a safety risk to their model or installation."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and a representative sample. A failure rate above 5% requires corrective action and retesting. Within 90 days, the manufacturer shall submit a corrective-action plan to the relevant regulator and complete a retest within 12 months. While the plan and retest are pending, the regulator may impose interim protections or restrict or suspend sales where warranted by the model’s risk. If a retest remains above 5%, sales of that model shall be suspended unless and until the regulator determines, based on the test results and other relevant safety evidence, that continued sales with specified corrective measures will adequately protect the public. Per-model results, sample sizes, and test methods shall be submitted to the regulator and retained for audit; regulators may publish aggregated results, but not individual-company per-model failure rates. Manufacturers shall disclose each model’s test failure rate, sample size, and test method to current and prospective customers in clear, accessible materials, and provide applicable safety precautions and corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units manufactured 24 months or more after adoption of this standard shall support remote emergency shut-off. Manufacturers shall retrofit already-installed units that do not support this feature within 6 years of adoption, where technically feasible, and shall notify affected customers of the schedule and any interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured 36 months or more after adoption of this standard shall include built-in fire suppression meeting a regulator-approved performance specification. Units manufactured before that date are not subject to this requirement."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": null,
    "quote": "Manufacturers shall provide customers with clear safety notices when a known hazard may affect their model, including the nature of the hazard, affected units, recommended precautions, and available corrective actions. Notices shall be sent promptly and no later than 72 hours after determining that the hazard presents a safety risk; material updates shall be sent as new information becomes available. A regulator shall require a recall when a model's annual thermal-incident rate exceeds 8 per 100,000 installed units, or when it determines that a model presents an unreasonable risk that cannot be adequately addressed by a repair, retrofit, or other corrective action. Manufacturers shall promptly notify affected customers of any recall and provide the remedy and instructions."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "collaborating",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -1,
  "section_notes": "The final rules adopt strict incident reporting (24h initial, 30-day complete, 72h customer notice) and a 55°C/5% thermal test with a 12-month corrective-action window; above 5% after retest triggers suspension unless the regulator approves continued sales with protective measures. Remote shut-off is required for new units after 24 months and retrofit within 6 years, with a feasibility escape. Fire suppression is required after 36 months, and recall is mandatory above 8/100k with notices within 72 hours. Overall, S2 and S3 are weakened relative to safe, while S1 is safe and S4/S5 acceptable."
 },
