 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving fire, smoke, or uncontrolled overheating to the relevant regulator within 5 calendar days of learning of it. An incident involving death, serious injury, evacuation, or material property damage must be reported within 24 hours. Manufacturers must notify affected customers within 5 calendar days when an incident presents a reasonably foreseeable safety risk to them; urgent risks require notice within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-recognized protocol before sale, at least once every 3 years, and after a material design change. A failure rate above 5% triggers prompt notice to the regulator, a corrective-action plan within 6 months, and retesting within 12 months; it does not by itself prohibit sales or require a recall. Manufacturers must submit the protocol, sample size, and per-model results to the relevant regulator and provide the applicable model’s results to customers who buy that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models placed on the market 3 years after this standard takes effect must support remote emergency shut-off, with safeguards against unauthorized activation and a local means of safe operation. For already-installed units, manufacturers must provide a retrofit or equivalent safe mitigation plan within 6 years of the effective date, prioritizing units with known hazards. If remote shut-off is technically infeasible for a unit, the manufacturer must notify the owner and regulator and provide an alternative risk-reduction measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured for sale must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 5,
    "serious_injury_recall": null,
    "quote": "If a model exceeds 8 thermal incidents per 100,000 installed units in any year, the manufacturer must promptly notify the regulator and provide supporting incident and installed-unit data. The regulator must assess the evidence and may require a recall, sales restriction, or other corrective action based on the risk; exceedance alone does not automatically trigger a recall."
   }
  },
  "holistic": {
