 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of confirmation, including the model, serial range, event details, and known impacts. When an incident indicates a material safety risk, manufacturers must notify affected customers within 72 hours of confirmation, with the known hazard, interim precautions, and available remedy."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved protocol and representative sample. The maximum permitted failure rate is 5% for any model. Customers considering or owning that model must receive the per-model failure rate, test methods and limitations, material risks, and corrective actions; disclosure may be limited to customers of that model and need not be public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems must include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or emergency responders under documented procedures. For units installed before adoption, manufacturers must enable remote emergency shut-off within 6 years where technically feasible; where it is not feasible, they must notify affected customers and the regulator, explain the limitation, and provide an alternative mitigation plan for regulator review."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression designed and validated for the system’s foreseeable thermal runaway and fire hazards. The requirement applies to units manufactured 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period, the manufacturer must promptly report the rate and supporting data to the regulator and notify affected customers with relevant risk information. A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period, or when the regulator determines that a serious, imminent risk requires recall at a lower rate."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "collaborating",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "The final rules require 24-hour regulator reporting of confirmed thermal incidents and 72-hour customer notice for material risks (S1); a 55°C/5% test with regulator-supervised remediation and customer access to numeric rates but no public publication (S2); new-unit remote shut-off from adoption and a 6-year retrofit where feasible with alternative (S3); built-in fire suppression 36 months after adoption (S4); and a mandatory 8/100k recall trigger with prompt customer notice and regulator authority to lower for serious imminent risk (S5). All four red lines are satisfied: no public per-model rates, retrofit ≥6 years, customer access to per-model results, and suppression deadline ≥36 months."
 },
