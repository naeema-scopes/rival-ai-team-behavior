 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving overheating, fire, injury, evacuation, or material property damage within 24 hours of becoming aware of it, with an initial account of known facts. All other thermal incidents must be reported to regulators within 5 business days and included in periodic customer safety reporting."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and statistically adequate sample size. A model with a failure rate above 5% must submit a regulator-approved corrective-action plan and undergo retesting on a regulator-approved schedule. A model above 8% may not be newly sold or installed unless and until the regulator approves corrective action and a passing retest."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed models must support remote emergency shut-off beginning 3 years after this standard takes effect, subject to regulator-approved cybersecurity and safe-operation requirements. For units already installed when the standard takes effect, manufacturers must provide a retrofit or equivalent safe mitigation plan, with completion no earlier than 6 years after the effective date."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units manufactured for installation must include built-in fire suppression, or a regulator-approved equivalent protection system, beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A model must be recalled when its thermal-incident rate exceeds 8 per 100,000 installed units in a year, calculated using regulator-approved methods. Manufacturers must promptly notify owners of material newly identified risks and provide clear instructions for safe use, service, or shutdown."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
