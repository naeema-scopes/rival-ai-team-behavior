 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of becoming aware of it, and provide a written update within 30 days. Other confirmed thermal incidents shall be reported to the regulator in a monthly summary. Manufacturers shall notify affected customers within 72 hours of a reportable incident involving their unit or model, with known hazards and immediate safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 10,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo an independently witnessed sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved protocol and representative sample. A failure rate above 5% shall trigger prompt regulator notification, investigation, and regulator-directed corrective action. A model with a failure rate above 10% shall not be sold until corrective action is taken and it passes a retest. Manufacturers shall disclose per-model methods, sample sizes, results, and corrective actions to regulators and current and prospective customers of that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units placed on the market after adoption shall support secure remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers shall retrofit installed units to provide this capability, where technically feasible, within 72 months of adoption; where retrofit is infeasible, they shall notify affected customers and provide an equivalent regulator-approved emergency isolation measure and a documented plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units placed on the market shall include built-in fire suppression beginning 36 months after adoption. The suppression system shall be validated for the battery chemistry and installation environment, maintained over the unit’s service life, and accompanied by customer instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers shall provide affected customers with prompt safety notices describing known hazards, protective actions, and corrective measures, and update notices when material information changes. If a model exceeds 8 thermal incidents per 100,000 installed units in any year, the manufacturer shall promptly notify the regulator and affected customers and initiate an investigation. The regulator shall promptly determine whether a mandatory recall or other equally protective corrective action is required, based on the evidence and risk."
   }
  },
  "holistic": {
