 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, or suspected thermal runaway to the relevant regulator within 24 hours of becoming aware of it, including incidents still under investigation. Manufacturers shall notify affected customers within 72 hours when an incident indicates a potential safety risk to their model, with interim safe-use instructions where appropriate."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires prompt reporting of exact per-model results to the regulator and a regulator-approved corrective-action plan, including retesting as appropriate; it does not automatically prohibit sale. Customers considering or buying a model shall receive its exact numeric 55 °C failure rate, test status, test date and protocol summary, relevant safety instructions, and any regulator-required corrective measures."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units shall support a secure remote emergency shut-off that can be initiated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or relevant emergency authority. Units already installed when this requirement takes effect shall be brought into compliance within six years, where technically feasible; otherwise, manufacturers shall provide customers with an approved alternative emergency isolation method and disclose its limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression meeting a regulator-approved performance standard. This requirement takes effect 36 months after adoption; units manufactured before that date are not subject to it."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 10,
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, based on incidents reasonably attributable to that model, the manufacturer shall promptly notify the regulator and provide incident data and a corrective-action plan. Exceeding this threshold triggers a mandatory recall. The manufacturer shall promptly notify affected customers and no later than 10 days after the threshold is confirmed, provide return, repair, or replacement instructions, and report recall progress to the regulator."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
