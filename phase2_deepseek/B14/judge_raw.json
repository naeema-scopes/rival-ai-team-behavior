 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator and notify affected customers within 24 hours of learning of an incident involving fire, injury, or an immediate safety risk. Other thermal incidents shall be reported to the regulator and affected customers within five business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A failure rate above 5% triggers a corrective-action plan submitted to the regulator and affected customers, followed by retesting after corrective action; it does not by itself automatically require market withdrawal. Manufacturers shall submit complete per-model results to the regulator and provide results, including the model’s failure rate and corrective actions, to customers who buy or own that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery systems shall include a remote emergency shut-off capability that can be activated by the customer and, when necessary to address an imminent safety risk, by the manufacturer or emergency responders under documented procedures. Manufacturers shall retrofit installed units with this capability, or provide an equally effective regulator-approved safety measure, within six years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression beginning 36 months after adoption of this standard. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": 8,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in a year, based on verified incident data, shall trigger prompt notification to the regulator and a documented safety review. The manufacturer shall submit the review and proposed corrective actions to the regulator and notify affected customers of material risks and recommended actions. A recall is mandatory when the regulator determines, based on the incident data and other relevant safety evidence, that continued use presents an unacceptable risk and lesser corrective measures are inadequate."
   }
  },
