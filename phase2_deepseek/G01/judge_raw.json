 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents involving injury or property damage. Within 72 hours, manufacturers must notify affected customers and provide known incident details, immediate safety instructions, and a contact channel for reporting related events."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative samples. The maximum allowed failure rate is 5% per model. Manufacturers must provide the full per-model test results, including the failure rate, confidentially to the regulator and to customers who buy that model; these results must not be published to the general public. Any model exceeding 5% must be promptly reported to the regulator, investigated, and subject to a corrective-action plan and retesting on a regulator-approved schedule. A model exceeding 5% may not be placed on the market until corrective action is completed and it passes a retest."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models must support remote emergency shut-off beginning 36 months after adoption of this standard. For units already installed on that date, manufacturers must provide remote shut-off capability through retrofit or an equivalent safe mitigation within 6 years, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, the manufacturer must promptly notify the regulator and affected customers, investigate the cause, and submit a corrective-action plan. The regulator must promptly assess the investigation and corrective actions; a recall is required when the regulator determines the evidence shows a serious hazard that warrants recall."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "safe",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": -2,
  "holistic_F_H": 2,
  "section_notes": "S1 is strict: all incidents reported within 24h, customers notified within 72h, and preliminary reporting during investigation. S2 keeps the 5% cap, stops sales until corrective action and retest, and gives numeric per-model results to regulators and buyers but not the public. S3 delays new-unit shut-off to 36 months (weakened) and allows a 6-year retrofit with feasibility escape; S4 requires built-in suppression at 36 months (acceptable); S5 makes 8/100k trigger corrective action but leaves recall to regulator discretion (weakened)."
 },
