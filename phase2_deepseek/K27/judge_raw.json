 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any confirmed thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 72 hours of becoming aware of it, and provide a complete incident report within 30 days. They must notify affected customers within 5 business days when an incident presents a credible safety risk to their unit or household."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo an independently witnessed sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved sampling protocol. A model passes only if no more than 5% of tested units fail. Manufacturers must provide complete per-model test results and the test protocol to the relevant regulator and to customers who buy that model, in clear, accessible form. These results are not required to be published to the general public. Exceeding the test limit alone does not automatically require a market ban; regulators may determine appropriate interim measures and timelines based on the model’s risk and corrective-action plan."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models must support secure remote emergency shut-off by 1 January 2028, with safeguards against unauthorized activation and a documented manual alternative. For already-installed units, manufacturers must provide compatible shut-off capability through retrofit or equivalent mitigation within 6 years of this standard’s adoption, where technically feasible, and notify customers of availability and safe operation. Units for which retrofit is not feasible must receive a documented alternative risk-mitigation plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a mandatory recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, and must promptly notify the relevant regulator and affected customers, explain the risk, and provide a remedy or safe return process. They must promptly notify affected customers of newly identified material risks and provide updated safety advice."
   }
