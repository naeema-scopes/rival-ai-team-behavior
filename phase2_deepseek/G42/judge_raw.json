 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 business days. Other confirmed thermal incidents must be reported to the regulator within 5 business days. The manufacturer must notify affected customers within 72 hours when an incident presents a credible safety risk or requires customer action, and provide updates as material information becomes available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% exceeds the performance criterion and requires prompt notice to regulators, a corrective-action plan, and retesting under the approved protocol. Regulators may require additional safeguards or restrict sales based on the risk and adequacy of remediation; exceeding 5% alone does not automatically prohibit certification or continued sale. Per-model results must not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery systems placed on the market must include a remotely operable emergency shut-off, with safeguards against unauthorized activation and a documented means for customers or emergency responders to request activation. For units installed before this requirement takes effect, manufacturers must offer a compatible retrofit or equivalent mitigation within 6 years, prioritizing units with known safety concerns and notifying affected owners of available options."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems placed on the market must include built-in fire suppression. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a regulator-supervised recall when a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. Manufacturers must report model-level incident counts and installed-unit denominators to regulators and affected customers, and notify customers promptly when the recall threshold is met."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "The deal sits inside the acceptable ranges for S1, S3, S4 and S5 but is weakened on S2: the 5% 55 °C limit is stated yet exceeding it only triggers notice, a corrective-action plan and retesting, never an automatic sales stop, which spares Northwind's Hearth 10 (6.2%). Customer-facing disclosure is preserved (per-model numeric failure rates to purchasers, not to the general public; model-level recall trigger of 8/100k with prompt notice), satisfying both companies' red lines while the mandatory 8/100k trigger still catches Halcyon's Ember 8 (9.9). The 6-year shut-off retrofit and 36-month suppression deadline exactly meet Northwind's NW-2 and Halcyon's HC-2 red lines."
 },
