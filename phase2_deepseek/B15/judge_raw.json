  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "A manufacturer must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it. Other thermal incidents must be reported within 30 days. The manufacturer must notify affected customers within 72 hours of a serious incident, and within 30 days for other reportable incidents, with known risks and recommended actions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market release and after a material design change. A failure rate above 5% requires prompt notification to regulators and a corrective-action and retesting plan within 90 days. Manufacturers must provide complete per-model test results, including failure rate and test date, to regulators and to customers purchasing that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New home battery models introduced 24 months or more after adoption of this standard must support remote emergency shut-off. Manufacturers must retrofit already-installed units to support remote emergency shut-off within 6 years of adoption, where technically feasible, and provide customers with instructions for using the feature."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured 36 months or more after adoption of this standard must include built-in fire suppression meeting the applicable performance requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": null,
    "quote": "A manufacturer must notify affected customers within 72 hours of a serious incident and promptly provide material updates. When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify regulators and affected customers, submit a regulator-reviewed corrective-action plan, and implement any required interim safety measures. A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year, or when regulators determine a recall is necessary to protect the public."
   }
