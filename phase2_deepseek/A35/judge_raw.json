 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, injury, evacuation, or material property damage to the relevant regulator within 24 hours of becoming aware of it, with a fuller incident report within 10 business days. Other confirmed thermal incidents shall be reported within 10 business days. Manufacturers shall notify affected customers within 5 business days when an incident indicates a material safety risk, and promptly provide updated information as the investigation proceeds."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model passes only if no more than 5% of tested units fail. Manufacturers shall provide full per-model results, test method, sample size, and test date to the regulator and directly to customers considering purchase of that model; individual-company per-model failure rates shall not be published to the general public. Regulators may publish aggregated or anonymized results. A model exceeding 5% shall undergo corrective action and a passing retest before further market placement."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units shall support remote emergency shut-off no later than 12 months after adoption. Manufacturers shall retrofit installed units to provide remote emergency shut-off, where technically feasible, within 6 years after adoption. Where retrofit is not feasible, the manufacturer shall notify affected customers and the regulator and provide an equivalent documented emergency response measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units shall include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers shall provide installation and maintenance instructions and disclose any relevant limitations to customers."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model’s rate exceeds 8 incidents per 100,000 installed units in a year, the manufacturer shall promptly notify regulators and affected customers and submit a corrective-action plan for regulator review. A mandatory recall is triggered if the rate exceeds 8 incidents per 100,000 installed units in a year, or if the regulator determines that a serious imminent risk requires recall. Recall remedies shall include repair, replacement, or refund."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "safe",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
