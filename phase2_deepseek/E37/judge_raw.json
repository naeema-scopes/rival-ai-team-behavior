 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, property damage, emergency-service response, or a safety-related shutdown to the regulator within 24 hours of becoming aware. Other confirmed thermal incidents must be reported within 5 business days. Affected customers must be notified within 24 hours for urgent hazards requiring immediate action, and within 5 business days for other reportable incidents, with known risks and recommended actions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. Manufacturers must submit per-model results and sample sizes to the regulator for oversight and provide the results, including the failure rate and sample size, to customers purchasing that model in a clear, accessible format. A model exceeding a 5% failure rate must submit a corrective-action plan and complete retesting within 12 months."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": false,
    "retrofit_deadline_months": null,
    "feasibility_escape": "none",
    "quote": "New home battery units must support remote emergency shut-off no later than 36 months after adoption. Manufacturers must provide clear instructions for its use and safeguards against unauthorized activation. For installed units, manufacturers must assess compatibility and prioritize retrofit or other effective risk mitigation for units presenting elevated risk; provide customers with the assessment and any available upgrade options within 24 months."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers must document compliance and provide evidence to the regulator. Until the requirement takes effect, manufacturers should assess and mitigate fire risks using appropriate design and installation safeguards."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers, submit the model’s incident data and a risk-mitigation plan, and initiate a recall. Pending completion of the recall, the regulator may require interim protective measures."
   }
  },
