 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, property damage, or emergency-service response to the relevant regulator within 5 business days after learning of it. A fatality, serious injury, or ongoing fire hazard must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Before purchase, customers must receive that model’s 55 °C test result, sample size, applicable limitations, and protective instructions; these results may not be withheld from customers, though they need not be published to the general public. A result above 5% requires a regulator-reviewed corrective-action plan, a defined retesting schedule, and any proportionate interim safeguards needed to protect the public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units must support remote emergency shut-off at installation. For units already installed when this standard is adopted, manufacturers must provide remote shut-off capability or an equivalent effective emergency isolation method within 6 years, prioritizing units with known safety risks and informing affected customers of the schedule and any interim precautions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when the verified rate for any model exceeds 8 thermal incidents per 100,000 installed units in a year. Verification must not delay prompt regulator and customer notification or necessary protective action."
   }
  },
