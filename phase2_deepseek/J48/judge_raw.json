 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 7,
    "scope": "serious_only",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, overheating requiring emergency response, injury, or property damage to the relevant regulator within 24 hours of learning of it, followed by a complete report within 10 business days. They must notify affected customers promptly, and no later than 5 business days after determining that the incident may indicate a safety risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter. The maximum allowed failure rate is 5%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "All new units must support remote emergency shut-off from the date of adoption. For already-installed units, manufacturers must provide an upgrade or replacement path and make commercially reasonable progress toward enabling remote shut-off, with a deadline of six years after adoption for technically compatible units."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a mandatory recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, based on model-specific rates. It must notify regulators and affected customers promptly and provide a remedy, including repair, replacement, or refund."
   }
  },
