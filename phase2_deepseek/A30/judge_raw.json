 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, emergency-service response, evacuation, or suspected safety-related property damage to the relevant regulator within 24 hours of learning of it, with a follow-up investigation report within 10 business days. All other suspected thermal incidents must be reported within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and statistically adequate sample size. A model meets the performance limit only if no more than 5% of tested units fail."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units manufactured 24 months after this standard takes effect must support remote emergency shut-off, with safeguards against unauthorized activation and a means for the customer or emergency responders to verify shut-off. For units already installed when the standard takes effect, manufacturers must provide a retrofit or equivalent compliant upgrade within 6 years, prioritizing units subject to a safety notice or elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months after this standard takes effect must include built-in fire suppression designed and validated for the unit’s foreseeable thermal events."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "The regulator must promptly verify a reported rate above 8 thermal incidents per 100,000 installed units in a year; verification must not delay interim protective measures where warranted. Once verified, the regulator must require a recall of that model, and the manufacturer must promptly notify affected customers and provide recall instructions."
   }
  },
  "holistic": {
