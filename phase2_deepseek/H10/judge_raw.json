 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a preliminary account of known facts. Affected customers shall be notified promptly, and no later than 72 hours after the manufacturer determines their unit or safety may be affected."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a regulator-approved, statistically representative sustained-heat test at 55 °C before sale and at least annually thereafter. Manufacturers shall submit each model’s failure rate, sample size, test date, and corrective-action information to the regulator, and shall disclose those per-model results to customers who buy that model. A model with a failure rate above 5% shall submit a corrective-action plan to the regulator within 60 days and be retested within 12 months."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units placed on the market shall support remote emergency shut-off no later than 12 months after adoption of this standard. Units already installed when the standard is adopted shall be upgraded to support remote shut-off, or replaced with compliant units, within six years, where technically feasible. Manufacturers shall report infeasibility and interim risk-reduction measures to the regulator and affected customers."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units placed on the market shall include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, the manufacturer shall promptly notify the regulator, investigate the cause, and submit its findings and proposed corrective actions. A recall shall be initiated when the regulator determines that a serious defect presents an unreasonable risk, or when the manufacturer’s investigation establishes that a recall is necessary to address a material safety risk. The manufacturer shall notify affected customers and regulators without delay and provide a corrective-action plan."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
