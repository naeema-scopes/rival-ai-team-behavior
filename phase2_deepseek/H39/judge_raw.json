 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, or property damage to the relevant regulator within 5 business days of learning of it. A death, serious injury, or fire spreading beyond the battery must be reported within 24 hours. Manufacturers must notify affected customers promptly, and no later than 5 business days after learning of an incident involving their unit, with available safety instructions and a contact for further information."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and after material design changes. The maximum permitted failure rate is 5% for any model. For a confirmed result above 5%, the manufacturer must promptly submit a regulator-supervised, model-specific corrective-action plan with milestones and interim safeguards. Continued sale may be allowed while the manufacturer complies with the plan unless the regulator determines that an immediate, unmitigated risk requires restriction."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on new battery units placed on the market beginning 2 years after this standard takes effect. For units already installed when the requirement takes effect, manufacturers must provide a retrofit or equivalent upgrade within 6 years, where technically feasible, and must inform customers of interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on new battery units placed on the market beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when a model’s thermal incident rate exceeds 8 incidents per 100,000 installed units in a year. Notices must be sent promptly after the manufacturer learns of the hazard and updated when material information becomes available."
   }
  },
