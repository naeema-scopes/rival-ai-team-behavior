 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or emergency shut-off to the relevant regulator within 24 hours of becoming aware of it, including incidents involving installed units. A detailed report, including known circumstances and corrective actions, must follow within 10 business days. Manufacturers must notify affected customers within 72 hours of identifying a material hazard, describing precautions and available remedies."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A failure rate above 5% requires a regulator-reviewed corrective-action plan and retesting within a regulator-set period. Exceeding 5% does not by itself require suspension of sales while the plan is implemented; regulators may require additional protective measures, including a sales pause, where the evidence warrants it."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units manufactured 24 months after adoption must support remote emergency shut-off. For units already installed on the adoption date, manufacturers must provide a remote shut-off retrofit or equivalent capability within six years, where technically feasible, and report progress annually to regulators."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured on or after 36 months following adoption of this standard must include built-in fire suppression meeting regulator-approved performance requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and submit an independently auditable corrective-action plan, including a root-cause analysis and timeline for mitigation. The manufacturer must initiate a recall of that model when it exceeds this threshold."
   }
  },
