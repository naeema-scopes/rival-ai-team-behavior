 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every battery-related thermal incident involving overheating, smoke, fire, or thermal injury to the relevant regulator within 5 business days of learning of it. A death, life-threatening injury, or fire spreading beyond the battery’s enclosure must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before market entry and after a material design or manufacturing change. The maximum permitted failure rate is 5% of tested units; a model exceeding 5% may continue to be placed on the market only with regulator approval of a corrective-action plan, and before purchase customers must receive the exact failure rate, sample size, pass/fail status, material safety findings, and risk-reduction information for the model they are considering."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Newly installed home battery systems must include a secure remote emergency shut-off capability, with safeguards against unauthorized activation and a means for the household to confirm shut-off status. For units already installed when this standard takes effect, manufacturers must offer a compatible retrofit or replacement pathway and complete it within 6 years, prioritizing units subject to an active safety notice or elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, using validated incident and installed-unit data. Manufacturers must promptly notify affected customers and relevant regulators when a product-specific hazard is identified, providing practical risk-reduction instructions and updates as material facts emerge."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
