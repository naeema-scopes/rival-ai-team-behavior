 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, smoke, or thermal runaway to the relevant regulator within 24 hours of learning of it, and provide an investigation update within 30 days. Manufacturers shall notify affected owners within 72 hours when an incident presents a credible safety risk or requires inspection, changed use, or other protective action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 10,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": true,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Before sale and at least annually thereafter, manufacturers shall test each model under a sustained-heat test at 55 °C using a regulator-approved, statistically representative protocol. Manufacturers shall provide per-model methods, sample sizes, failure rates, and corrective actions to the relevant regulator. Owners and prospective purchasers shall be provided the model’s test methods, sample sizes, failure rates, corrective actions, and protective instructions; individual-company per-model results shall not be published to the general public. A model with a failure rate greater than 5% shall require regulatory review, a corrective-action plan where warranted, and confirmatory testing within 12 months. Exceeding 5% alone shall not bar sale. A model shall not be newly offered for sale if its failure rate exceeds 10%, or if regulators determine that continued sale presents an imminent safety risk, until the issue is resolved."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units shall support secure remote emergency shut-off at installation. Manufacturers shall retrofit installed units that lack this capability within six years after adoption of this standard, where technically feasible, and shall notify owners of the retrofit schedule and any interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units shall include built-in fire suppression no later than 36 months after adoption of this standard. The suppression system shall be validated for the unit’s battery chemistry and enclosure, and manufacturers shall provide installation, inspection, and maintenance instructions to owners."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. The manufacturer shall promptly notify regulators and affected customers, stop sale of the affected model pending regulatory review, and provide a corrective action or remedy plan."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
