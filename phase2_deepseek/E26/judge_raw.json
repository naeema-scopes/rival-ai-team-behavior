 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of becoming aware of it, including incidents that appear contained or involve a third-party system. They must provide an initial notice to affected customers within 48 hours when a product may present a safety risk, followed by material updates as facts are confirmed. A detailed report is due within 30 days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 24,
    "interim_limit_pct": 7,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "For the first 24 months after adoption, the maximum failure rate is 7%; thereafter it is 5%. A model exceeding the applicable limit must undergo corrective action and retesting under a regulator-approved compliance plan and may not be represented as compliant until it meets the applicable limit. ... Before purchase, customers must receive the complete 55 °C test results, including methods and sample sizes, along with the model’s compliance status and any required corrective action. Regulators may publish aggregated results, but must not publish individual-company per-model failure rates to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All newly manufactured home battery systems must include remote emergency shut-off capability. Manufacturers must retrofit installed units to provide this capability, or provide an equivalent regulator-approved emergency control, within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery systems manufactured 36 months or more after adoption must include built-in fire suppression validated to a regulator-approved performance standard. ... Regulators may approve an equivalent protective design where testing demonstrates comparable or better fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, and notify regulators and affected customers without delay; regulators may require a recall at a lower rate when evidence indicates an imminent or serious risk. ... Manufacturers must promptly notify affected customers of a newly identified material safety risk, provide interim protective steps, and issue material updates as facts are confirmed."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
