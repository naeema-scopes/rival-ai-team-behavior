 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 3,
    "customer_notice_days": 5,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 72 hours of becoming aware of it. Any incident involving injury, evacuation, fire-service response, or material property damage must be reported within 24 hours. Manufacturers must notify affected customers within five calendar days of confirming a safety risk relevant to their unit."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol, with a representative sample and documented results. Per-model results, including the numerical failure rate and test methodology, must be submitted to regulators and provided to customers of that model in a clear safety summary before purchase; individual results need not be published to the general public. A failure rate above 5% requires prompt regulator review and a documented corrective-action and risk-mitigation plan; exceeding 5% alone does not automatically bar market placement."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All newly manufactured home battery systems must provide a clearly identified means of remote emergency shut-off accessible to the customer and, where technically feasible, emergency responders. For installed units, manufacturers must provide a compatible remote shut-off capability or an equivalent safe mitigation within six years of adoption, where technically feasible; units that cannot be upgraded safely must receive a documented alternative mitigation plan and customer instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression meeting a regulator-approved performance and safety protocol. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory safety-action trigger occurs when any model exceeds 8 confirmed thermal incidents per 100,000 installed units in a rolling 12-month period. The regulator must require a proportionate corrective action, which may include repair, retrofit, replacement, or recall; exceeding the threshold does not by itself impose an automatic market ban."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
