 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a complete incident report within 10 calendar days. They shall notify affected customers within 48 hours when an incident presents a credible safety risk to their model or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and statistically adequate sample. The maximum permitted failure rate is 8% per model. Models exceeding 5% shall submit a corrective-action plan to regulators and undergo follow-up testing; models exceeding 8% must be corrected and retested before further sale. Per-model results shall be provided confidentially to regulators and customers who own the affected model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units placed on the market shall support remote emergency shut-off. For units already installed when this requirement takes effect, manufacturers shall offer a retrofit or equivalent upgrade within six years, prioritizing units with elevated safety risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after adoption of this standard. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
