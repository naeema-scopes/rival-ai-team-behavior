 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the regulator within 24 hours of learning of it, and provide a complete incident report within 5 business days. They must promptly notify affected customers of an incident that may present a safety risk, and no later than 24 hours after notifying the regulator."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 36,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol. The maximum permitted failure rate is 5% for every model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery models placed on the market beginning two years after this standard takes effect must support remote emergency shut-off. For units already installed when the standard takes effect, manufacturers must provide a retrofit or replacement pathway and complete required upgrades within six years, prioritizing units presenting the greatest documented risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after this standard takes effect. Manufacturers must provide regulators with evidence that the suppression system is effective and does not introduce additional material safety risks."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year; the manufacturer must promptly notify regulators and affected customers, stop distribution, and implement the regulator-approved recall. Regulators may require a recall below that threshold when evidence indicates an imminent serious risk."
   }
  },
