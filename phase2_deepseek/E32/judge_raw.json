 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or material property damage to the relevant safety regulator within 24 hours of learning of it. Manufacturers must notify affected customers within 72 hours when an incident indicates a product-specific safety risk, and promptly provide any recommended precautions. Reports must not be delayed while the cause is being determined."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo 55 °C sustained-heat testing using a regulator-approved, statistically adequate sampling and test protocol. The maximum permitted failure rate is 5%. Before sale and upon retesting, manufacturers must submit per-model results, sample sizes, and test methods to the relevant safety regulator and make the complete per-model results available to prospective and current customers of that model. Results above 5% require a corrective-action plan and retesting within a regulator-set period; regulators may require further corrective action or restrict sales where results indicate an unreasonable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units must support secure remote emergency shut-off, with safeguards against unauthorized access and a means of local shut-off. For units already installed when this standard takes effect, manufacturers must provide a compliant retrofit or replacement within six years, prioritizing units presenting the greatest safety risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after this standard is adopted. Manufacturers must provide clear instructions on the system’s operation and limitations and maintain it in accordance with the product’s service schedule."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, notify the relevant regulator and affected customers, and provide a free repair, replacement, or refund. Manufacturers must promptly notify affected customers of newly identified product-specific safety risks and provide recommended precautions."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "safe",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
