 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal injury to the regulator within 24 hours of becoming aware of it, including incidents still under investigation. Manufacturers must notify affected customers within 72 hours when an incident indicates a potential safety risk to their model or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 24,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a documented, repeatable protocol and a representative sample. The maximum permitted failure rate is 5% per model. ... A model above the limit requires a regulator-approved corrective plan and retesting within 24 months. Exceeding the limit alone does not automatically prohibit sales; the regulator may impose proportionate interim restrictions where necessary to protect safety, including restricting sales if the plan is not met."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units placed on the market must support remote emergency shut-off. Manufacturers must retrofit already-installed units to provide this capability within six years of this standard taking effect, where technically feasible, and report progress annually to the regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured 36 months or more after this standard takes effect must include built-in fire suppression designed and validated to mitigate thermal runaway and prevent fire spread."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year; the manufacturer must notify the regulator and affected customers promptly and carry out a regulator-approved recall and remedy. The regulator shall determine whether distribution must stop during the remedy, based on the assessed risk and adequacy of interim protections."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
