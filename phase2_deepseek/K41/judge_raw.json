 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7.0,
    "customer_notice_days": 7.0,
    "scope": "serious_only",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any fire, thermal runaway, evacuation, injury, death, or property damage involving a home battery within 24 hours of learning of it. Other confirmed overheating incidents requiring emergency response or causing the battery to be taken out of service must be reported within 5 business days. Manufacturers must notify affected customers within 5 business days when an incident indicates a material safety risk to their model or requires inspection, restricted use, or corrective action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": true,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before market entry and after a material design change. A model meets the benchmark if no more than 5% of tested units fail. Manufacturers must submit complete per-model results, test methods, sample sizes, and corrective actions to the regulator, and provide those complete results to current and prospective customers in a clear, accessible form. Exceeding the benchmark requires prompt corrective action and regulator-supervised retesting, but does not itself automatically ban the model; the regulator should set a reasonable compliance period before any market restriction, unless immediate action is necessary to address an imminent risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery models placed on the market 2 years after adoption must support remote emergency shut-off, with safeguards against unauthorized activation and a locally operable alternative. For units already installed on the adoption date, manufacturers must provide a retrofit or equivalent safe alternative within 6 years, prioritizing units with identified safety concerns."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months or more after adoption must include built-in fire suppression meeting regulator-approved performance requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year. The manufacturer must notify affected customers and the regulator without undue delay, explain the risk and remedy, and report recall progress."
   }
  },
  "holistic": {
