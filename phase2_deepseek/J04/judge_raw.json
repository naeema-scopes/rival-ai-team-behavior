 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 business days. Affected customers must be notified within 48 hours when an incident indicates a material safety risk to their unit or requires customer action. Incidents must not be excluded because their cause is still under investigation."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually, using a regulator-approved protocol and a representative sample. Manufacturers must promptly provide complete per-model results, sample sizes, test dates, and protocol details to the relevant regulator and to customers considering or purchasing that model. A failure rate above 5% requires prompt regulator notification, investigation, and a corrective-action plan with milestones and retesting. Crossing this threshold alone does not prohibit sales or require a recall; regulators may impose proportionate protective measures, including sales restrictions, where evidence shows an unmitigated safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Newly installed home battery systems must provide a remote emergency shut-off capability that can be initiated by the manufacturer or emergency responders when a credible imminent fire or thermal-runaway risk exists. Manufacturers must retrofit existing units to meet this requirement within 6 years of adoption of this standard, prioritizing units with known safety risks, and provide customers clear instructions for local shut-off if remote communication is unavailable."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months or more after adoption of this standard must include built-in fire suppression designed and validated to limit propagation of a thermal incident, using a regulator-approved test protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": null,
    "quote": "Manufacturers must provide customers with clear safety notices describing material risks, affected models or units, recommended actions, and available remedies; urgent notices must be sent promptly and no later than 48 hours after determining that customer action is needed. A recall is mandatory when a model has more than 8 thermal incidents per 100,000 installed units in any rolling 12-month period, based on verified incidents and a documented installed-unit denominator."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "accommodating",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "The final rules are strict on S1 (24h reporting, all incidents, no cause exclusion) and set a 55°C/5% S2 test threshold, but S2 does not automatically stop sales above 5%, only requiring corrective action and possible regulator restrictions. S3 gives a 6-year retrofit deadline (favouring Northwind), S4 requires built-in suppression at 36 months, and S5 mandates recall above 8/100k with 48h customer notices but no explicit serious-injury recall clause."
 },
