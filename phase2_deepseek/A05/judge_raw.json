 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the responsible regulator within 24 hours of learning of it, with a preliminary account of known facts and affected models. Manufacturers must notify affected customers within 48 hours when an incident indicates a material safety risk, and promptly provide relevant precautions and any regulator-required actions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol. Manufacturers must submit per-model failure rates and test-method details to the responsible regulator and provide the exact per-model failure rate and test date to customers before sale. A failure rate above 5% requires prompt notice to the regulator, a corrective-action plan, and regulator-directed retesting; it does not by itself require market withdrawal if the regulator determines continued sale is safe subject to controls."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All newly manufactured home battery units must support remote emergency shut-off no later than 24 months after adoption. Manufacturers must retrofit installed units that do not support remote shut-off, or provide an equivalent regulator-approved emergency control, within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new home battery units manufactured from 36 months after adoption. The requirement must be met by a regulator-approved suppression system appropriate to the unit’s chemistry and installation environment."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must promptly notify regulators and affected owners, stop sales, and provide an effective remedy under the regulator’s direction."
   }
  },
  "holistic": {
