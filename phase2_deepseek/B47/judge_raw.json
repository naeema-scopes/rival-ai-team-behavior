 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 2,
    "scope": "serious_only",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery thermal runaway, fire, smoke event requiring emergency response, injury, evacuation, or material property damage within 24 hours of becoming aware. A fuller incident report, including known circumstances and affected model/serial range, is due within 10 calendar days; updates must be provided as material facts emerge. Manufacturers must notify owners of affected units within 48 hours when an incident indicates a potential safety risk requiring precautions, inspection, or service, and promptly provide updated instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo sustained-heat testing at 55 °C using a regulator-approved protocol and representative production units before sale and at least annually thereafter. The 5% failure rate is the presumptive maximum performance benchmark. A model exceeding 5% must be reported promptly to the relevant regulator with its results and a corrective-action plan. The regulator may allow continued sale under time-limited conditions, including enhanced monitoring, customer precautions, and retesting, where the manufacturer demonstrates that the conditions adequately control risk; otherwise, the regulator may restrict or suspend sales. New models must meet the 5% benchmark before sale. Manufacturers must submit each model’s results, sample size, protocol, and corrective-action plan confidentially to the relevant regulator. Complete per-model results must be provided to customers who own that model and to the relevant regulator; results need not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models placed on the market must provide a remotely accessible emergency shut-off function within 12 months of adoption. For installed units, manufacturers must provide and maintain a remote shut-off capability where supported; units without that capability must be upgraded or replaced within 72 months of adoption where technically feasible. If an upgrade is not feasible, the manufacturer must notify the owner, explain the limitation, and provide appropriate alternative emergency procedures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. Manufacturers must notify affected customers and the relevant regulator promptly, provide a safe remedy, and report completion and remaining affected units. Recalls and notices must not be delayed pending completion of an investigation."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "Final rules mandate 24-hour reporting for serious events but exclude minor overheating/smoke and lack an all-other-incident deadline, weakening S1. S2 uses a 55°C test and 5% presumptive benchmark with regulator discretion on continued sales, gives complete per-model results to customers but not the public, and leaves transition length unspecified. S3 requires new-unit shut-off within 12 months and retrofit within 72 months with an alternative if infeasible; S4 mandates built-in suppression at 36 months; S5 mandates recall above 8/100k with prompt notices and no transition, triggering for Halcyon's Ember 8."
 },
