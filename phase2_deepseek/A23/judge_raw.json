 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a preliminary account and unit/model identification. Manufacturers shall notify affected customers within 72 hours when an incident presents a plausible safety risk, and provide updates as the investigation proceeds."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo standardized, independently verifiable sustained-heat testing at 55 °C before sale and after a material design or manufacturing change. A result above 5% triggers prompt regulator notification, confirmatory testing by an accredited independent laboratory, and a corrective-action plan with a regulator-set remediation period. Exceeding 5% alone shall not automatically prohibit sales or withdraw compliance status; any restriction shall follow confirmatory testing and regulator review, except where imminent risk warrants immediate protective action."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units shall support a secure remote emergency shut-off function. Manufacturers shall provide a retrofit or equivalent protective measure for installed units that do not support remote shut-off, with a compliance plan submitted to regulators within 12 months and implementation completed within 72 months, subject to regulator-approved alternatives where technically infeasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression no sooner than 36 months after adoption of this standard. Manufacturers shall submit a compliance plan to regulators at least 12 months before the requirement takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in a year shall trigger mandatory regulator review and independent validation using consistent incident definitions and installation denominators. If confirmed, the manufacturer shall promptly submit a corrective-action plan and implement regulator-approved remedies, which may include a recall where needed to protect the public. Imminent risk requires immediate protective action, including recall where necessary."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "collaborating",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 1,
  "holistic_F_H": 1,
  "section_notes": "S1 is fully safe with 24-hour reporting for all incidents and 72-hour customer notice. S2 keeps 55°C and a 5% limit but weakens enforcement: above-limit sales are not automatically stopped, and the remediation period is open-ended with no interim cap. S3 requires immediate new-unit shut-off and a 72-month retrofit deadline with alternatives; S4 requires built-in suppression at 36 months; S5 sets an 8/100k review trigger but no mandatory recall, allowing open-ended corrective action and only 'promptly' notice."
 },
