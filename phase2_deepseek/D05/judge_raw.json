 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, evacuation, or material property damage to the relevant regulator within 24 hours of learning of it, with a fuller incident report within 10 business days. Other confirmed thermal incidents must be reported to the regulator within 5 business days. Manufacturers must notify affected customers within 72 hours when an incident presents a credible safety risk, and provide practical safety instructions and subsequent updates. Reports must include known incident counts and be corrected promptly if material information changes."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market release and at least annually thereafter. The maximum permitted failure rate is 7% of tested units per model. Manufacturers must provide complete model-specific test results, including failure rates, to the regulator and to customers considering or using that model. Results may be provided directly to those customers and need not be posted publicly. If a model exceeds the limit, the manufacturer must notify the regulator and affected customers within 10 business days, provide practical safety instructions, and submit a corrective-action plan; the regulator may require retesting or restrict sales based on the results and safety evidence."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units must support remote emergency shut-off no later than 12 months after adoption. Manufacturers must retrofit installed units that do not support this function, or provide an equivalent regulator-approved protective measure, within 6 years after adoption. Customers must receive clear instructions on how to use the shut-off function and its limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption. The suppression system must be suitable for the battery chemistry and installation environment, and its maintenance requirements must be disclosed to customers."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Before purchase and at installation, customers must receive clear safety instructions, emergency contact details, and information on safety notices or required precautions for their model. Manufacturers must promptly notify affected customers of material safety risks and provide interim protective steps. A mandatory safety response is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period. The rate must use the model’s installed-unit population and count distinct incidents; manufacturers must promptly correct material reporting errors. The manufacturer must notify the regulator and affected customers promptly and implement a recall or other regulator-approved remedy. Exceeding the threshold requires this safety response but does not by itself require an automatic market ban; the regulator may require a recall based on other evidence of an imminent safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 1,
  "holistic_F_H": -1,
  "section_notes": "The final standard is a mixed outcome. S1 is relatively strict on reporting timelines but only requires confirmed incidents. S2 sets a 7% failure limit (above the 5% safe threshold) with per-model results given to customers but not publicly posted. S3 sets a 12-month new-unit deadline and 6-year retrofit. S4 requires built-in suppression at 36 months. S5 has a numeric 8/100k trigger but allows a regulator-approved remedy instead of automatic recall, and customer notices are 'promptly'."
 },
