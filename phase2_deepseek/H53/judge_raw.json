 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of becoming aware of it, with a preliminary incident report within 5 business days. Affected customers must be notified within 48 hours when the incident indicates a material safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 36,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol. A model exceeding a 5% failure rate must submit a corrective-action plan and retest within 12 months. The regulator may allow up to 36 months from the initial test for a model to meet the 5% limit, with interim risk controls, monitoring, and sales restrictions as warranted by the risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Newly installed units must support remote emergency shut-off. Manufacturers must provide a retrofit pathway for already-installed units and complete required retrofits within 6 years of this standard taking effect, prioritizing units presenting the greatest safety risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a 12-month period, the manufacturer must promptly notify the regulator and submit a model-specific risk assessment and corrective-action plan. The regulator must promptly review the evidence, including incident severity, test results, and corrective-action effectiveness, and require a recall when the model presents an unreasonable safety risk that cannot be adequately addressed through warnings, repairs, or other corrective measures."
   }
  },
