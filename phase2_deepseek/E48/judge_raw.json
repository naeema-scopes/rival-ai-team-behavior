  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": false,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed battery-related overheating, thermal runaway, fire, or explosion to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 calendar days. They must notify affected customers within 72 hours, or sooner if the regulator determines an urgent warning is needed."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and after any safety-relevant design change. The maximum permitted failure rate is 5% of tested units for each model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "All new home battery units placed on the market after 24 months from adoption must support a secure remote emergency shut-off accessible to the manufacturer and emergency responders, with appropriate safeguards against unauthorized activation. Manufacturers must provide a feasible upgrade or retrofit path for installed units and complete retrofits within six years of adoption where technically supported."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units placed on the market beginning 36 months after adoption must include built-in fire suppression designed and validated for the unit’s foreseeable battery-fire hazards."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year; the manufacturer must promptly notify the regulator and affected customers, stop sale of the model while the recall is underway, and carry out the regulator-approved recall or corrective action. Manufacturers must promptly notify affected customers of material newly identified safety risks, changes in a model’s pass/fail status, and updated safety instructions."
   }
