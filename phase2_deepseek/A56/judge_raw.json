 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, including incidents involving injury or property damage. Manufacturers must notify affected customers within 72 hours when an incident indicates a material safety risk to their model or batch; urgent hazards require immediate notice."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% of tested units per model. A model exceeding 5% may continue to be sold only under a time-limited corrective-action authorization from the regulator, based on a safety assessment, interim risk controls, and a defined retest plan; the regulator may suspend the authorization or require further action if risks are not adequately controlled."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on all new units placed on the market beginning two years after adoption. For units already installed on the adoption date, manufacturers must provide a compatible shut-off retrofit or equivalent upgrade within six years, where technically feasible, and communicate safe interim measures to affected customers."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new units placed on the market beginning 36 months after adoption of this standard. Systems must be designed and tested to operate safely with the battery and must not create additional hazards."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Notices must be sent promptly when a material safety risk is identified, and immediately where urgent action is needed. A verified model-specific rate exceeding 8 per 100,000 during that period triggers a mandatory recall of that model."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 3,
  "holistic_F_H": -3,
  "section_notes": "Final rules set strict incident reporting (24h/72h) but limit scope to confirmed incidents. S2 keeps a 5% 55°C failure limit with a time-limited regulator corrective-action pathway, requires per-model results to customers and regulators, but no public per-model publication. S3 requires new-unit shut-off after 2 years and 6-year retrofit; S4 requires built-in suppression after 36 months; S5 mandates recall for verified model rates >8/100k with prompt notices."
 },
