 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 3,
    "scope": "serious_only",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal runaway, fire, or injury involving a home battery to the relevant regulator within 24 hours of learning of it, with a fuller incident report within 10 business days. They must notify affected customers within 72 hours when an incident presents a material safety risk, including immediate protective steps and contact information."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a prescribed representative sample. A failure rate above 5% requires prompt regulator notification, a time-bound corrective-action plan, and retesting on a regulator-approved timetable."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models must include a remote emergency shut-off capability. Manufacturers must provide an update or retrofit enabling this capability for installed units within 6 years of adoption, where technically feasible, and provide customers with clear instructions for its use."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 validated thermal incidents per 100,000 installed units in a year. The manufacturer must submit a time-bound recall and corrective-action plan for regulatory oversight; this process does not waive or delay the mandatory recall."
   }
  },
