 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents causing no injury or property damage. Manufacturers shall notify affected customers within 48 hours when an incident indicates a credible safety risk to units of the same model or batch, and promptly provide interim safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. The failure rate shall not exceed 5% for any model. The manufacturer shall provide the model’s results and failure rate to customers considering purchase and to owners of that model; individual-company per-model failure rates shall not be publicly published."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems shall include a secure remote emergency shut-off capability. Manufacturers shall provide a retrofit for already-installed units, or an equally effective safety remedy where retrofit is infeasible, within six years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems shall include built-in fire suppression no later than 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is required when any model exceeds 8 thermal incidents per 100,000 installed units in a year; manufacturers shall promptly notify regulators and affected customers and implement the regulator-approved recall remedy. The regulator shall determine a proportionate remedy, which may include repair, replacement, refund, or other protective action; a recall does not by itself require permanent market exclusion."
   }
  },
