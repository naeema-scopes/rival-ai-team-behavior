 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, emergency-service response, or material property damage to the regulator within 24 hours of learning of it, with an initial account and known unit/model details. Other thermal incidents must be reported within 30 days. Manufacturers must notify affected customers promptly—within 24 hours for an urgent risk requiring immediate action, and within 5 business days for other reportable incidents—using direct contact where reasonably available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55°C before market entry and at least annually thereafter, using a regulator-approved protocol and representative sample. The maximum permitted failure rate is 5% per model. Exceeding this limit requires prompt regulator notification, investigation, a documented corrective-action plan, and retesting on a defined schedule. Continued sale pending corrective action and retesting is permitted only with regulator-approved safeguards and a documented corrective plan. Full per-model results, including sample size and failure rate, must be submitted confidentially to regulators and provided to customers purchasing that model. Results must not be published to the general public as company-specific per-model failure rates."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models must include a remotely accessible emergency shut-off function before market entry. For units already installed when this standard is adopted, manufacturers must provide a compatible shut-off capability or an equivalent effective emergency isolation measure within 72 months, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression designed and validated for the battery system. This requirement applies to units manufactured 36 months after adoption of this standard or later."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": true,
    "quote": "The 8-incident-per-100,000 threshold must be calculated separately for each model, using that model’s annual thermal incidents and installed-unit population. When any model exceeds that threshold in a year, the manufacturer must promptly notify the regulator and affected customers and initiate a recall, with regulator oversight of recall implementation and interim protections. Manufacturers must also initiate a recall when otherwise necessary to address an imminent or serious safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
