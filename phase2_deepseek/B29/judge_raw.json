 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a fuller incident report within 10 business days. Affected customers must be notified within 48 hours when the incident presents a potential safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and adequate sample size. A model with a failure rate above 5% must not be sold until corrective action and retesting demonstrate a failure rate of 5% or less."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must retrofit already-installed units to support remote shut-off within six years of this standard taking effect, where technically feasible; they must notify affected customers of the schedule and any interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If any model’s thermal-incident rate exceeds 8 incidents per 100,000 installed units in any year, the manufacturer must promptly notify regulators and affected customers, submit documented incident and installed-unit data, investigate, and conduct a mandatory recall. When a safety issue may affect a unit, manufacturers must promptly notify affected customers with the risk, recommended actions, and available remedies."
   }
  },
  "holistic": {
