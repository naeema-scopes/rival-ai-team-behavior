 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a preliminary account and known unit/model information. Manufacturers must notify affected customers within 72 hours when an incident indicates a credible safety risk for their unit or model; urgent risks require immediate notice."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative samples, before market placement and at least annually thereafter. A failure rate above 5% requires prompt regulator review and a corrective-action plan. A rate above 7% requires regulator-directed corrective measures. Sales restrictions require a separate regulator finding of a material safety risk, not test failure rate alone."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support secure remote emergency shut-off, with safeguards against unauthorized activation and a locally accessible means of safe operation, beginning 24 months after adoption. For units already installed on that date, manufacturers must provide a retrofit or equivalent safe mitigation plan and complete implementation within 6 years."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. Any proposed alternative must be demonstrated to provide equivalent or greater fire-risk reduction and approved by the relevant regulator."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": null,
    "quote": "Urgent risks require immediate notice; other credible safety risks must be communicated within 72 hours of determination. A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
