 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents with no injury or property damage. A follow-up report with investigation findings and any corrective action is due within 30 days. The manufacturer must notify affected customers within 72 hours when the incident presents a credible safety risk to their unit or requires customer action; urgent hazards require immediate notice."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55°C using a regulator-recognized protocol, with results calculated from a statistically representative sample and retained for audit. Manufacturers must provide full per-model results to regulators and to customers who buy that model, including the test method, sample size, failure rate, and relevant limitations. Regulators may require corrective action, restrictions, or retesting based on test results and relevant incident evidence. No fixed failure-rate threshold alone automatically prohibits a model from being newly placed on the market."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units placed on the market must support remote emergency shut-off within 24 months after adoption, with a secure mechanism accessible to authorized emergency responders and the customer. Manufacturers must provide an upgrade plan for installed units and enable shut-off for units technically capable of receiving it within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new home battery units placed on the market beginning 36 months after adoption. The requirement applies to each model and must be verified through testing demonstrating that the suppression system operates as intended."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model’s verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any rolling 12-month period, the manufacturer must promptly notify the regulator and affected customers. The threshold triggers regulator investigation and a corrective-action determination; a mandatory recall with an effective remedy is required when that determination establishes a material safety risk requiring recall."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
