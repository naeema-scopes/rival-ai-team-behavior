 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating or fire to the relevant regulator within 72 hours of becoming aware of it, whether or not it caused injury or property damage. They shall maintain auditable incident records and promptly notify affected customers when an incident indicates a material safety risk or requires protective action, and in any event within 72 hours of that determination."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7.5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo sustained-heat testing at 55 °C using a regulator-approved protocol before market entry and after material safety-related design changes. Models with a failure rate above 7.5% may not be placed on the market. For models above 5% and at or below 7.5%, manufacturers shall submit a corrective-action and enhanced-monitoring plan to the relevant regulator, which may require additional testing or protective measures. Manufacturers shall provide per-model results to the relevant regulator and make results available to prospective and current customers of that model before purchase and whenever updated results are available. Regulators may publish aggregate results, but not individual-company per-model failure rates."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New home battery models placed on the market 36 months or more after adoption shall support remote emergency shut-off. ... For units already installed on adoption, manufacturers shall provide a compatible remote shut-off retrofit, where technically feasible, within six years."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer shall initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period. Regulators may require a recall sooner where the evidence indicates an imminent risk of serious harm. Manufacturers shall promptly notify affected customers of safety risks, protective actions, and material safety updates, and shall provide regulators with the same notices."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S2 is the most company-favouring section: it sets a permanent 7.5% failure-rate ceiling with corrective action above 5%, allowing Northwind's Hearth 10 to remain marketable, while per-model results go to regulators and purchasers but not the general public. S3's 6-year retrofit deadline meets Northwind's red line but leaves new-unit shut-off until 36 months and uses an open 'where feasible' escape. S4 and S5 are acceptable: fire suppression is required at 36 months, and the 8-per-100k recall trigger remains mandatory with only prompt customer notice."
 },
