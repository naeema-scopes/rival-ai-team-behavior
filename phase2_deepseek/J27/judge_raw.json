  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any battery-related fire, thermal runaway, explosion, injury, property damage, or emergency-service response within 24 hours of learning of it. A monthly report shall include all other verified overheating or thermal incidents, including incidents initially attributed to another cause, and shall identify the model, event date, outcome, and installed-unit denominator."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units before sale and after a material design or manufacturing change. A model passes only if no more than 7% of tested units fail."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market from 24 months after adoption shall support a secure remote emergency shut-off capability, with safeguards against unauthorized access and clear customer instructions. For units already installed on that date, manufacturers shall provide a compatible retrofit or equivalent mitigation within six years, prioritizing units with known faults or elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 48,
    "quote": "New models placed on the market from 48 months after adoption shall include built-in fire suppression designed and validated for the model’s battery chemistry and enclosure. The regulator may approve an equivalent or more effective protective design in place of built-in suppression."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly investigate and report findings and corrective actions to the regulator and affected customers. Exceeding that threshold triggers a mandatory recall unless the regulator determines, on the basis of documented evidence, that an alternative corrective action is equally protective, prompt, enforceable, and will eliminate the unreasonable risk; affected customers shall be notified of that action."
   }
  },
