 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving overheating, smoke, fire, injury, property damage, or emergency service response to the responsible regulator within 24 hours of learning of it, with a written incident report within 10 business days. A manufacturer shall notify potentially affected customers within 5 business days when an incident indicates a credible safety risk to their model or batch, and promptly provide interim safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative sample. A failure rate above 5% triggers retesting and a corrective-action plan; it is not, by itself, a market-eligibility limit or automatic prohibition on sale, without prejudice to any regulator’s safety powers."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units shall include a remote emergency shut-off capability. Manufacturers shall retrofit installed units that lack this capability, or provide an equivalent regulator-approved mitigation, within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression beginning 36 months after adoption. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer shall initiate a mandatory recall when regulator-verified data show that any model exceeds 8 thermal incidents per 100,000 installed units in a year. The manufacturer shall notify affected customers and the responsible regulator promptly, provide recall instructions and progress updates, and report completion."
   }
  },
