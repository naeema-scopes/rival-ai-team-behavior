 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, including incidents that caused no injury or property damage. If an incident presents a credible safety risk to users or nearby people, the manufacturer must notify affected customers and relevant emergency services within 72 hours of becoming aware of that risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C under a regulator-approved common protocol specifying sample selection and minimum sample size, test duration, failure criteria, and treatment of retests. A verified failure rate above 5% requires prompt corrective action and a regulator-approved plan with a deadline for retesting. While implementing that plan, sales may continue only under regulator oversight and any safeguards the regulator requires. If the model fails to meet the 5% maximum by the plan’s deadline, sales must be suspended until a compliant retest verifies a rate at or below 5%."
   },
   "S3_remote_shutoff": {
