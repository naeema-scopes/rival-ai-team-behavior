 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, and provide a complete incident report within 10 business days. They must notify affected customers within 72 hours when an incident indicates a material risk to users or nearby people, and provide safety instructions and updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55°C before market launch and at least annually thereafter, using a regulator-recognized protocol and representative production units. Manufacturers shall submit per-model results, including sample size and failure rate, to regulators and provide those results to customers who buy that model. The maximum allowed failure rate is 5%. A model exceeding 5% may not be newly placed on the market until corrective action is completed and a retest demonstrates a failure rate of 5% or less; the manufacturer must submit a corrective-action plan within 30 days and complete the retest within six months."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery systems placed on the market must support remote emergency shut-off. Manufacturers shall provide a secure, reliable shut-off capability and instructions for its use. Existing installed units that can practicably be retrofitted must be upgraded within six years of the standard’s effective date; units not compatible with retrofit must be disclosed to their owners and addressed through a regulator-approved safety plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems placed on the market must include built-in fire suppression beginning three years after the standard’s effective date. The suppression system must be suitable for the battery chemistry and designed to limit fire propagation and protect occupants and nearby people."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 12,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must notify regulators and affected customers and submit a corrective-action plan when a model exceeds 8 thermal incidents per 100,000 installed units in a year. A mandatory recall is required when a model exceeds 12 thermal incidents per 100,000 installed units in a year, or sooner if a regulator determines an imminent serious risk warrants it."
   }
  },
