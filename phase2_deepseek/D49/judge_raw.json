 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving fire, smoke, overheating, injury, property damage, or emergency shutdown to the responsible regulator within 24 hours of becoming aware of it, and submit a complete incident report within 10 calendar days. Notify affected customers within 24 hours when the incident indicates a material hazard to their unit or requires immediate protective action; otherwise notify them within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": 7,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. An interim maximum failure rate of 7% applies per model. A model exceeding the limit must promptly notify the regulator and submit a corrective-action plan, with regulator-approved restrictions or other protective measures where warranted. Manufacturers must report results, sample size, and uncertainty to the responsible regulator and provide the per-model results to customers who buy that model; these results may not be withheld from those customers as confidential. Individual-company per-model failure rates need not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed systems must support remote emergency shut-off, subject to safeguards against unauthorized activation and a safe local shut-off option. Existing installed units must be retrofitted or replaced to support the function within six years of this standard taking effect, where technically feasible; document any infeasibility and interim risk controls for the regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year, calculated for that model. The recall must provide an effective protective remedy for affected units, subject to regulator oversight; it does not by itself require a sales ban. Notify affected customers and the regulator promptly when corrective action or a safety notice is warranted."
   }
  },
  "holistic": {
