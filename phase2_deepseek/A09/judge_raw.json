 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any fire, thermal runaway, injury, evacuation, property damage, emergency-service response, or other safety incident involving a battery within 24 hours of learning of it. Manufacturers must notify affected customers within 72 hours of learning of a credible serious hazard, including incidents indicating a risk of fire, thermal runaway, or injury, and provide practical protective instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a standardized sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved method and representative sample. A result above 5% requires confirmation using the same approved method and a regulator-supervised corrective-action plan, with retesting within a period set by the regulator that allows remediation."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery models placed on the market 36 months or more after adoption must support a secure remote emergency shut-off capability, with safeguards against unauthorized activation and clear customer instructions. For units already installed on the adoption date, manufacturers must provide a compliant retrofit or replacement option within six years; customers must receive notice of the option and any associated safety instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured 36 months or more after adoption of this standard must include built-in fire suppression designed and validated for the unit’s foreseeable fire scenarios."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 3,
    "serious_injury_recall": null,
    "quote": "Manufacturers must provide customers with clear safety notices and practical protective instructions promptly upon learning of a credible serious hazard, and notify affected customers within 72 hours. A manufacturer must promptly inform the regulator and affected customers when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period."
   }
  },
