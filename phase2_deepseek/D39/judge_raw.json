 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery-related fire, thermal runaway, explosion, or injury requiring medical treatment to the relevant regulator within 24 hours of learning of it. Other confirmed thermal incidents, including overheating without fire or injury, must be reported within 5 business days. The manufacturer must notify the affected customer within 24 hours for a fire, thermal runaway, explosion, or serious injury, and within 5 business days for other confirmed thermal incidents."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and at least annually thereafter, with a statistically adequate sample and documented results. The maximum permitted failure rate is 5% for any model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units must support a secure remote emergency shut-off function at installation. Manufacturers must provide a safe, no-cost upgrade path for installed units that lack the function and complete retrofits within 6 years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months or more after this standard takes effect must include built-in fire suppression suitable for the battery chemistry and installation environment, validated under a regulator-approved protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 confirmed thermal incidents per 100,000 installed units in a 12-month period. The manufacturer must promptly notify the regulator and affected customers, stop sales, and initiate the recall without waiting for a further incident or test."
   }
  },
