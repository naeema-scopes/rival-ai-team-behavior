 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the regulator within 5 business days of learning of it. Incidents involving death, serious injury, fire spread beyond the battery, or an ongoing imminent hazard must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55°C before initial certification and at least annually thereafter, using a regulator-approved protocol and representative production units. A failure rate above 5% triggers regulatory notification, corrective action, and retesting; it is not an automatic market exclusion."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
