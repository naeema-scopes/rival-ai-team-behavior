 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any thermal incident involving overheating, smoke, fire, injury, property damage, or emergency-service response within 24 hours of becoming aware of it, with a documented investigation update within 30 days. Manufacturers shall notify affected customers of incidents posing a potential safety risk within 72 hours of determining that their unit or model may be affected, and provide safety instructions and subsequent material updates promptly."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C under a common, regulator-approved protocol before sale and at least annually thereafter. For the first five years after adoption, no more than 7% of tested units may fail; thereafter, the maximum failure rate shall be 5%. A model above the applicable limit shall be subject to regulator-supervised corrective action and retesting. For a model already on the market when the 5% limit takes effect, sales may continue under a regulator-approved corrective-action plan while the manufacturer makes documented progress toward compliance, provided the model’s annual thermal-incident rate remains at or below 8 per 100,000 installed units and the regulator finds no imminent or serious risk. Continued sales under such a plan shall have no fixed termination date, subject to at least annual regulator review; the regulator may suspend sales if progress is inadequate or risk increases. Per-model test methods, sample sizes, and results shall be submitted to regulators and provided to customers who own or buy that model, without requiring a request; individual-company per-model failure rates shall not be publicly published."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units shall include remote emergency shut-off capability. Manufacturers shall retrofit installed units that lack this capability within six years of adoption, prioritizing units with elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after adoption. The requirement shall apply to all newly manufactured units placed on the market after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year; the manufacturer shall notify the regulator and affected customers and initiate the recall without delay. Regulators may require a recall at any lower rate where the evidence indicates an imminent or serious risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
