 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, followed by a complete incident report within 10 calendar days. They must notify affected customers within 48 hours when an incident presents a credible safety risk, and promptly provide safety instructions and material updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-recognized protocol before sale and after any material design change. The maximum allowed failure rate is 5%; a model exceeding 5% may not be sold unless the regulator grants a specific conditional authorization finding that material risk is adequately addressed."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units placed on the market must include a remotely operable emergency shut-off that can be activated by the customer and, where necessary to address an imminent safety hazard, by the manufacturer or emergency responders. Manufacturers must provide a plan to retrofit installed units lacking this capability, prioritizing units with known safety concerns, and complete retrofits within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression meeting a regulator-recognized effectiveness and reliability test. This requirement applies to units manufactured 36 months after adoption of this standard or later."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 2,
    "serious_injury_recall": null,
    "quote": "When a newly identified hazard could materially affect safe use, manufacturers must notify affected customers within 48 hours of determining that a credible safety risk exists, with instructions and updates as they become available. If a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator, provide supporting data, and conduct a documented risk assessment."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 1,
  "holistic_F_H": 2,
  "section_notes": "S1 imposes strict all-incident reporting within 24 hours and customer notice within 48 hours with no phase-in. S2 sets a 5% permanent limit at 55 °C but permits above-5% sales under open-ended regulator conditional authorization, creating a significant loophole. S3 requires immediate new-unit shut-off and 72-month retrofit; S4 requires built-in suppression at 36 months; S5 makes the 8/100k trigger a notification/assessment threshold with discretionary recall and 48-hour customer notices."
 },
