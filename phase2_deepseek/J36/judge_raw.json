 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a follow-up report containing known causes and corrective actions within 10 business days. They shall notify affected customers within 48 hours when an incident indicates a material risk to their model or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved protocol and representative sample. Manufacturers shall submit per-model numerical results to the relevant regulator and provide those results to customers of that model in clear, accessible form, including with purchase information and after each annual test. A failure rate above 5% shall trigger prompt regulator notification and review, including assessment of field incident data and a corrective-action plan where warranted; it shall not automatically prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units shall include remote emergency shut-off capability. Manufacturers shall provide a retrofit plan for installed units and complete retrofits within six years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after this standard takes effect. Manufacturers shall provide customers clear instructions on the system’s operation, limitations, and maintenance. Regulators may approve an equivalent protective measure where evidence shows it provides at least equivalent risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in a year; regulators may also require a recall where other evidence indicates an unreasonable risk. Manufacturers shall promptly notify affected customers and regulators of a serious safety defect and provide corrective instructions."
   }
  },
  "holistic": {
