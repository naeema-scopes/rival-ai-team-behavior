 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, property damage, or emergency shutdown to the regulator within 24 hours of learning of it, with a preliminary account and affected model and unit information. Within 48 hours, manufacturers must notify known owners of the affected model of incidents presenting a credible safety risk, including immediate precautions and how to obtain support."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo sustained-heat testing at 55 °C using a regulator-approved protocol and representative production units. A failure rate above 5% triggers regulator review and a corrective-action plan, but is not an automatic market ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed home battery systems must include a remotely accessible emergency shut-off function. Existing installed units that lack this capability must be upgraded or replaced within 6 years of adoption, where technically feasible; manufacturers must notify affected owners of the timeline and interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected owners when an incident or investigation indicates a credible safety risk, providing the affected model, known hazard, immediate precautions, and how to obtain support. A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
