 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, fire, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of learning of it, with an initial account of known facts. Manufacturers must notify affected customers within 72 hours when an incident indicates a credible safety risk to their unit or requires customer action; notifications must state the hazard, recommended action, and how to obtain assistance."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved protocol and representative samples. A failure rate of 5% is a corrective-action benchmark, not an automatic bar to sale. Manufacturers must provide each model’s results, including test date, sample size, and failure rate, to the relevant regulator and to customers considering or owning that model, in clear, accessible form."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units must support secure remote emergency shut-off within 12 months of adoption. Existing installed units must be brought into compliance within 6 years of adoption where technically feasible; otherwise, the manufacturer must provide the regulator with a risk-mitigation plan and notify affected customers of any limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression meeting a regulator-approved performance and reliability protocol. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "A model-specific rolling 12-month rate exceeding 8 thermal incidents per 100,000 installed units must be promptly reported to the regulator for validation. Once validated, exceeding this threshold triggers a mandatory recall. Following a recall decision, the manufacturer must notify affected customers within 72 hours, with instructions for safe shutdown, repair, or replacement."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
