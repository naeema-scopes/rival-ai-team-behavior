 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Initial reports are due within 24 hours of learning of an incident involving injury, fire, evacuation, or emergency response, and within five business days for other reportable incidents. When an incident indicates a relevant safety risk to other units of the same model, manufacturers must promptly notify affected customers of the known risk and any interim precautions, without waiting for confirmation of a defect."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
