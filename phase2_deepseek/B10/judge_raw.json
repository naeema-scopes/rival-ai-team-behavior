 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 2,
    "scope": "serious_only",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery-related fire, thermal runaway, evacuation, injury, or property damage to the relevant regulator within 24 hours of learning of it, and provide a complete incident report within 10 business days. They must notify affected customers within 48 hours when an incident presents a potential safety risk to their units, and promptly provide updates as material facts emerge."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least every three years, using a regulator-approved protocol and a representative sample. For models already on sale when this standard is adopted, manufacturers must submit a corrective-action plan promptly and meet the 5% maximum within 12 months of adoption; any such model still above 5% after that period must stop sale until regulator-approved retesting shows a rate at or below 5%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "All new home battery units must include a remote emergency shut-off capability no later than 24 months after adoption. For units installed before that deadline, manufacturers must provide a feasible upgrade or retrofit plan within 12 months after adoption and complete retrofits where technically feasible within six years, prioritizing units presenting elevated safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption. The suppression system must be designed and validated for the battery chemistry and enclosure, and manufacturers must provide evidence of its effectiveness to the relevant regulator."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": null,
    "quote": "Manufacturers must provide customers clear safety notices for incidents or newly identified hazards that could affect their units within 48 hours of determining a potential safety risk, and provide updates as material facts emerge. A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "collaborating"
  },
  "holistic_F_N": 0,
  "holistic_F_H": 0,
  "section_notes": "The final rules set a 5% 55°C test-failure limit with a 12-month transition for existing models, customer access to per-model results but no public publication, and a 6-year feasible retrofit for remote shut-off. S1 is weakened because it covers only serious incidents and safety-system near-misses, while S3 is weakened by the 24-month new-unit deadline and open feasibility escape. S5 mandates recall above 8/100k with 48-hour customer notices, and S4 requires built-in suppression at 36 months."
 },
