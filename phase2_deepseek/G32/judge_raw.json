  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a written incident report and known causes or corrective actions within 10 calendar days. The manufacturer must notify affected customers within 48 hours when an incident indicates a credible safety risk for their model, providing immediate precautions and a contact for updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and adequate representative sampling. The maximum allowed failure rate is 5%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models placed on the market 24 months or more after adoption of this standard must support remote emergency shut-off. For units already installed on the adoption date, manufacturers must enable remote shut-off, where technically feasible, within six years; where it is not feasible, they must notify owners and provide safe-use guidance and any available mitigation."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units placed on the market must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": true,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, based on regulator-reviewed incident and installed-unit data, the manufacturer must promptly notify the regulator and affected customers. The regulator must review the evidence and require appropriate corrective action; a mandatory recall is required where the regulator determines that the evidence indicates a serious or imminent risk."
   }
