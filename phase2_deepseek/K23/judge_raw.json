 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, including incidents involving injury or property damage. The manufacturer shall notify affected customers within 48 hours when an incident indicates a potential safety risk to their model or batch, and promptly provide protective instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 24,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55°C using a regulator-approved protocol and representative sample before sale and after material design changes. The maximum permitted failure rate is 5%. A model exceeding this limit shall enter a regulator-approved corrective-action plan and retest within 24 months. Exceeding the limit alone shall not bar sales during that period; the regulator may require interim safeguards or restrict sales where evidence indicates an imminent safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models placed on the market after this standard takes effect shall support remote emergency shut-off. Manufacturers shall retrofit already-installed units to support remote emergency shut-off within six years, where technically feasible, and shall provide customers clear instructions on how to use the feature."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression shall be required on all new units manufactured 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers shall provide customers clear safety notices promptly when new evidence indicates a material risk affecting their model or batch, including protective instructions and any corrective action. A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period, based on regulator-validated data."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
