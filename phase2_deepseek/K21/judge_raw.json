 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving fire, smoke, overheating, or emergency-service response within 24 hours of learning of it, whether or not injury or property damage occurred. The manufacturer must notify the affected customer within 24 hours when the incident involves that customer’s unit and provide safety instructions promptly."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units before sale, and after a material thermal-safety design change. The maximum permitted failure rate is 7% of tested units per model. Before sale and after required retesting, manufacturers must provide regulators and purchasing customers the complete per-model results, including failure rate, sample size, and test protocol, together with relevant safety implications."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units manufactured 24 months after this standard takes effect must support remote emergency shut-off, with suitable safeguards against unauthorized activation. For already-installed units, manufacturers must provide a compatible retrofit or equivalent mitigation within six years of the effective date, where technically feasible, and notify customers of its availability and any limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect. The suppression system must be designed, installed, and maintained to applicable safety requirements and must not create additional unreasonable hazards."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year; the manufacturer must promptly notify affected customers and regulators and provide safe repair, replacement, or refund options. Recalls and safety notices must not be delayed to preserve sales."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
