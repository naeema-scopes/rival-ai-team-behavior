 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, including incidents for which the cause is not yet established. The manufacturer must notify the affected customer within 24 hours when the incident presents an ongoing safety risk, and otherwise within 5 business days, with instructions for safe handling and support."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 18,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative sample. The maximum allowed failure rate is 5%. A model exceeding 5% must not be newly placed on the market; for models already on the market, the manufacturer must submit a regulator-approved corrective-action plan within 90 days and pass a retest within 18 months; sales may continue during this period subject to the plan and any interim safety measures required by the regulator."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market from 24 months after this standard takes effect must support a secure remote emergency shut-off capability, with safeguards against unauthorized activation and a documented means for the customer or emergency responders to request activation. For units already installed on the effective date, manufacturers must provide a retrofit or equivalent safe mitigation plan within 6 years."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units placed on the market from 36 months after this standard is adopted must include built-in fire suppression designed and validated for the battery system’s foreseeable thermal events."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, calculated using complete incident data, including incidents reported or corrected under S1, and that model’s installed-unit denominator. Regulators must be notified of the trigger and recall plan; customers must receive prompt notice and instructions for return, repair, or other safe remedy."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
