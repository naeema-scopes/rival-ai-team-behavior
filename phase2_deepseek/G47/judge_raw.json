 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal event involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a substantive incident report within 10 business days. They must notify affected customers within 72 hours when an event indicates a credible safety risk, and promptly provide relevant safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a standardized 55 °C sustained-heat test before sale and after a material design or manufacturing change, using a representative sample and documented protocol. A failure rate above 5% per model triggers regulator notification, investigation, and a corrective-action plan. The maximum permitted failure rate is 7%; above 7%, the regulator may require proportionate measures, including suspension of further sales until compliance is verified."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed systems must support remote emergency shut-off by their installation date, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must provide a secure retrofit capability for existing systems and complete retrofits within six years of this standard taking effect, prioritizing systems with identified safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 30,
    "serious_injury_recall": null,
    "quote": "Manufacturers must provide customers with clear safety notices about identified model-specific hazards, recommended precautions, and actions to take; urgent notices must be sent promptly, and other material safety notices within 30 days of confirmation. If a model’s confirmed annual thermal-incident rate exceeds 8 per 100,000 installed units, the manufacturer must promptly notify the regulator and provide supporting data. The regulator must review the evidence and may require proportionate corrective action, enhanced customer notices, or a recall."
   }
  },
