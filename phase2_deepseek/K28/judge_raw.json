 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 business days. They must notify the affected household within 24 hours and provide safety instructions; where the incident could pose a continuing risk to nearby people or property, they must also promptly notify relevant emergency services and affected neighbours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale, at least annually thereafter, and after a material safety-related design change. A failure rate above 5% requires prompt regulator notification and a corrective-action plan with follow-up testing on a regulator-set schedule; it does not by itself require sales suspension."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units must support remote emergency shut-off. Manufacturers must retrofit installed units that do not support the function, or provide an equivalent regulator-approved safety measure, within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption. The suppression system must be validated for the unit’s battery chemistry and installation conditions, and maintained in working order throughout the product’s service life."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year; the manufacturer must notify the regulator and affected customers without delay and begin the recall process."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
