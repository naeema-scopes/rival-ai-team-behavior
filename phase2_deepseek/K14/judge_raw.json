 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents initially reported by customers or third parties. Manufacturers must notify affected customers within 72 hours when an incident indicates a credible safety risk for their model, and provide material updates promptly."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and after material design changes, using a statistically representative sample and a documented protocol. A failure rate above 5% requires prompt notice to the regulator, a corrective-action plan, and retesting within a regulator-approved period."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units placed on the market must support remote emergency shut-off, with appropriate safeguards against unauthorized activation. For already-installed units that do not support the function, manufacturers must provide a retrofit or equivalent upgrade within six years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model exceeds 8 thermal incidents per 100,000 installed units in a year, calculated using all known and substantiated incidents and the installed-unit denominator, the manufacturer must promptly notify the regulator and affected customers and submit a corrective-action plan. Regulators must promptly assess the model and determine proportionate measures, which may include a recall, based on the evidence and the effectiveness of corrective action."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
