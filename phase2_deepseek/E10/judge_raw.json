 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every known thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a preliminary incident report. The manufacturer shall notify affected customers within 24 hours when an incident indicates a potential material safety risk, and otherwise within five business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. The maximum allowed failure rate is 5%. A rate above 5% requires prompt notice to the regulator and affected customers and a corrective-action and retesting plan within 30 days; the regulator shall assess the evidence and risk and determine proportionate corrective action, retesting, and any interim sales safeguards; exceeding 5% does not by itself require an automatic ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market beginning three years after adoption shall support remote emergency shut-off, subject to safeguards against unauthorized activation and clear customer instructions. Manufacturers shall provide a plan to retrofit already-installed units where technically feasible, with completion no earlier than six years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after adoption. The requirement shall use a regulator-approved performance standard and allow equivalent designs that provide comparable protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
