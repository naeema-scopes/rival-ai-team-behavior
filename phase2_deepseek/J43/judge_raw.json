 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any fire, thermal runaway, or overheating event causing injury, property damage, evacuation, or emergency-service response to the relevant regulator within 24 hours of learning of it, with a written update within 10 days. Other confirmed thermal incidents must be reported within 30 days. Affected customers must be notified within 72 hours when a reported event indicates a safety risk requiring action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Results above 5% require prompt notification to the regulator and a corrective-action plan, with confirmatory testing where appropriate. The maximum allowed failure rate is 7% of tested units for any model. Results and test methods must be provided to the relevant regulator and made available to customers on request; individual-company per-model failure rates are not required to be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must include remote emergency shut-off capability beginning two years after this standard takes effect. Manufacturers must provide a safe retrofit or equivalent upgrade for installed units within six years, prioritizing units with known safety issues."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect. Suppression systems must be tested for compatibility with the battery and must not create additional hazards during normal operation or emergency response."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model's verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers and submit a corrective-action plan. A manufacturer must initiate a recall when a model's verified thermal-incident rate exceeds 10 incidents per 100,000 installed units in a year, or when the regulator determines that a serious hazard otherwise warrants recall. Manufacturers must notify the regulator and affected customers without undue delay when a recall is initiated."
   }
  },
