  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery thermal incident involving fire, injury, emergency-service response, or material property damage within 24 hours of learning of it. Other overheating or thermal-fault incidents must be reported within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol, with a statistically adequate sample and failures defined by the protocol. A model exceeding 5% may remain on sale only under a regulator-approved corrective-action and retesting plan, with progress reported at least annually; the regulator may set interim safeguards or restrictions based on the evidence, severity, and remediation progress."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units installed after adoption must include a remote emergency shut-off function that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or emergency responders under documented safeguards. For units already installed at adoption, manufacturers must provide a compatible retrofit or equivalent safe alternative within 6 years, prioritizing units that lack local isolation or present elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression, or an independently validated equivalent built-in fire-mitigation system, for units first installed 36 months after adoption or later."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period. The manufacturer must notify the regulator immediately upon determining that the threshold is exceeded and begin customer notification and recall actions within 5 business days."
   }
  },
