 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 72 hours of learning of it, with a follow-up report containing the investigation findings within 30 days. They must notify the affected customer within 24 hours of learning of an incident involving that customer’s unit, and promptly provide safety instructions. Incidents must not be omitted because the cause is still under investigation."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5%. A rate above 5% requires prompt corrective action, a regulator-reviewed remediation plan, and at least annual retesting. A model above 5% may remain on sale for up to 12 months under regulator-supervised interim safeguards while remediation is completed; it must demonstrate a rate of 5% or less by the end of that period. Customers must receive the complete results for the model they buy, along with required corrective actions and safety precautions. Individual-company per-model failure rates are not to be publicly published."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units must support a secure remote emergency shut-off capability. Manufacturers must provide a retrofit plan for installed units and complete retrofits within six years of the standard’s effective date where technically feasible, prioritizing units with elevated safety risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. Units already installed before the effective date are not subject to a retrofit requirement under this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected customers and regulators of a newly identified material safety risk and provide interim precautions. A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year; it must notify regulators and affected customers without delay, explain the risk and remedy, and report recall progress to regulators."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S1 requires reporting all incidents within 72 hours and customer notice within 24 hours, with no cause exception. S2 sets a 55°C test, 5% maximum failure rate, a 12-month supervised remediation period, customer access to per-model results, and no public publication. S3 mandates new-unit shut-off and a 6-year retrofit but includes an open technical-feasibility escape. S4 requires built-in fire suppression after 36 months. S5 mandates recall at 8 incidents per 100,000 with immediate notice and no serious-injury clause."
 },
