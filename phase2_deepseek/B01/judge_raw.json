 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal runaway to the responsible regulator within 72 hours of learning of it, including incidents that cause no injury or property damage. Manufacturers must notify affected customers promptly, and no later than 24 hours after learning of an incident that indicates an ongoing risk to them or nearby people."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "pass_fail_only",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A failure rate above 5% is a safety-action trigger, not an automatic market ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market must support a secure remote emergency shut-off function that can be activated by the customer or authorized emergency responders, with safeguards against unauthorized activation. For units already installed when this standard takes effect, manufacturers must provide a compatible retrofit or replacement pathway and complete the retrofit within six years."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units placed on the market must include built-in fire suppression no earlier than 36 months after adoption of this standard. The regulator may approve an equivalent design or a time-limited exemption where the manufacturer demonstrates that the alternative provides comparable protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly report the rate and supporting data to the regulator and notify affected customers. A recall is required at that threshold unless the regulator promptly approves a documented alternative protective action that provides equivalent protection, based on the evidence."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
