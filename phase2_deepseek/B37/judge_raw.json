 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the regulator any thermal incident involving overheating, fire, or suspected thermal runaway within 24 hours of becoming aware of it, with an initial account of the event and any known injuries or property damage. A fuller report, including the investigation findings and corrective actions, shall be submitted within 30 days, with updates when material new information becomes available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 18,
    "interim_limit_pct": 7,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "New models must have a failure rate no greater than 5% before sale. For models already on sale when this standard takes effect, the maximum failure rate is 7%; results above 5% shall be reported promptly to the regulator with a documented corrective-action plan, retesting at least every six months, and any interim risk controls required by the regulator. Manufacturers shall take corrective action to bring such models to 5% or below within 18 months, subject to regulator-approved interim controls."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All newly installed battery systems shall support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers shall retrofit existing installed units to support remote shut-off within six years of this standard taking effect, where technically feasible, and shall provide customers with safe interim guidance until retrofit is complete."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery systems shall include built-in fire suppression. This requirement shall apply to units manufactured 36 months after this standard is adopted, allowing manufacturers time to validate designs and update production."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers shall promptly notify affected customers of a thermal incident involving their unit, including the known hazard, steps to reduce risk, and how to obtain support. A mandatory recall is triggered when a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, based on verified incident and installation data."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "accommodating",
