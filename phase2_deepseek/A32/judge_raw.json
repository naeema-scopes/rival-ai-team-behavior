 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 3,
    "scope": "serious_only",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of learning of it, with a complete follow-up report within 10 business days. Customers with affected units shall receive a prompt safety notice within 72 hours of confirmed material risk, including immediate precautions and support contacts."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo sustained-heat testing at 55 °C using a regulator-approved protocol and an independent laboratory, across a statistically adequate sample. Results above the 5% benchmark shall trigger regulator review and a time-bound corrective-action plan proportionate to risk; they shall not by themselves automatically bar further sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units shall provide a secure remote emergency shut-off capability, with a safe local shut-off option that remains available if communications fail. For units already installed when this standard takes effect, manufacturers shall provide a retrofit or equivalent remedy within six years, prioritizing units with elevated risk and notifying affected customers of interim precautions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units manufactured 36 months or more after this standard is adopted shall include built-in fire suppression meeting regulator-approved performance requirements. Manufacturers shall disclose suppression capabilities and limitations to customers."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, the regulator shall promptly verify the model-specific rate using manufacturer records. Once verified, the manufacturer shall initiate a recall of that model and promptly notify affected customers of the risk, required precautions, and recall remedy."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
