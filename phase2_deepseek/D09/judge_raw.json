 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 10,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any death, serious injury, fire, thermal runaway, or event requiring emergency-service response involving a covered battery to the relevant regulator within 24 hours of becoming aware of it, with a written incident report within 10 calendar days. Other overheating or safety incidents must be reported to the regulator within 10 calendar days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each battery model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative samples before sale and at least annually thereafter. A failure rate above 5% requires prompt regulator notification, a corrective-action plan, and retesting. Exceeding 5% alone does not automatically prohibit sale; regulators will determine proportionate interim measures based on verified risk, test uncertainty, and remediation, and may authorize continued sale subject to time-limited protective conditions and monitoring."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New battery systems must include remote emergency shut-off capability. For systems installed before adoption, manufacturers must provide shut-off capability through retrofit or equivalent safe upgrade within six years, unless the regulator approves an alternative for a specific system where retrofit is infeasible or creates greater safety risk."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New battery systems must include built-in fire suppression. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected customers of a material safety risk and provide updated instructions or corrective actions. A manufacturer must initiate a mandatory recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, based on the best available verified data; it must notify the regulator and affected customers without delay and provide a remedy plan."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S1 mandates strict incident reporting with 24-hour serious and 10-day other deadlines, plus prompt customer notice. S2 sets a 55°C test and 5% failure threshold but exceeding it does not automatically stop sales, only triggers regulator review and corrective action; customers get the failure rate but no public disclosure. S3 requires remote shut-off on new units and retrofit within 6 years, with regulator-approved alternatives. S4 requires built-in suppression within 36 months, with equivalent allowed. S5 mandates recall at 8 incidents/100k with immediate notice, no transition, and no corrective alternative."
 },
