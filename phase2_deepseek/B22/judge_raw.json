 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every confirmed thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 5 calendar days of learning of it. Incidents involving death, serious injury, active fire, or an ongoing hazard shall be reported within 24 hours. Manufacturers shall notify affected customers within 5 calendar days when an incident indicates a material safety risk to their model, and promptly provide safety instructions and material updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 6,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C before market entry and at least annually thereafter, using a regulator-approved protocol. A model meets the standard only if no more than 5% of tested units fail. If a pre-market or in-market test shows a failure rate above 5%, the manufacturer shall notify the regulator within 30 days and submit a corrective-action plan within 60 days, including a retest schedule. Corrective actions and retesting shall be completed within 6 months."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units manufactured 24 months or more after this section takes effect shall support remote emergency shut-off. For units already installed when the requirement takes effect, manufacturers shall provide a compliant retrofit or replacement within 6 years, prioritizing units presenting elevated safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months or more after this standard takes effect shall include built-in fire suppression meeting a regulator-approved performance standard. Manufacturers shall document compliance and provide installation and maintenance instructions to customers."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 5,
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, calculated using the model’s installed-unit population and confirmed thermal incidents, the manufacturer shall promptly notify regulators and affected customers, submit a corrective-action plan and timeline, and initiate a mandatory recall. Initial notice shall be sent within 5 calendar days after determining that a material hazard exists, with updates as material information becomes available."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
