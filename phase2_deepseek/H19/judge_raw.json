 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 72 hours of learning of it. A preliminary report is acceptable, with material updates provided within 30 days. The manufacturer must notify affected customers within five business days when the incident may indicate a safety risk for their unit or model; urgent risks require notice as soon as practicable and no later than 24 hours after confirmation."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 36,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% for new models. A model exceeding 5% must not be newly placed on the market until corrective action and a passing retest are documented. For models already marketed when this standard takes effect, manufacturers must submit a regulator-reviewed corrective-action plan within 12 months and meet the 5% limit within 36 months. During that transition, continued placement is permitted only under the approved plan and any interim safeguards required by the regulator; regulators may restrict sales sooner if warranted by risk. Per-model test results, including sample size and failure rate, must be submitted to regulators and provided to customers who buy that model. Individual company per-model failure rates must not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market must support remote emergency shut-off no later than three years after this standard takes effect. For units already installed on that date, manufacturers must provide a compatible retrofit or other effective upgrade within six years, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units placed on the market must include built-in fire suppression beginning 36 months after this standard takes effect. Suppression systems must be designed and tested to applicable regulator-approved safety requirements and must not impair essential battery safety monitoring or emergency shut-off."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when a model exceeds 8 confirmed thermal incidents per 100,000 installed units in any 12-month period. Notices must be sent promptly when a material safety risk is identified, and no later than five business days after confirmation; urgent risks must be communicated as soon as practicable and within 24 hours."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
