 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any thermal incident involving overheating, fire, injury, death, evacuation, or property damage within 24 hours of becoming aware of it, with a fuller investigation report within 10 business days. Manufacturers shall notify affected customers within 24 hours when an incident indicates a material safety risk to their model or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C before sale and at least annually thereafter, and after a material design change or regulator request; manufacturers shall provide per-model results, including failure rates, to the relevant regulator and to customers buying that model; results may be withheld from the general public. A failure rate above 5% requires prompt regulator notification, a corrective-action plan with a defined timetable, and retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly manufactured units shall include remote emergency shut-off capability no later than 24 months after this standard takes effect. For units already installed on that date, manufacturers shall provide a compatible retrofit or replacement pathway and complete required retrofits within 6 years, prioritizing units with identified safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression, or an independently verified equivalent built-in fire-mitigation system, for units manufactured 36 months after this standard takes effect. Manufacturers shall provide regulators with evidence of effectiveness and shall not represent a system as equivalent without supporting test results."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must notify the regulator promptly and initiate a recall or equivalent regulator-approved corrective action, including customer notification and effective risk mitigation. This trigger requires corrective action; it does not by itself impose a permanent market ban."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
