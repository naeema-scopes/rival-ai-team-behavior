  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "An event involving injury, fire, evacuation, or an active risk to people or property shall be reported within 24 hours of discovery; other reportable events shall be reported within five business days. Manufacturers shall notify affected customers within 24 hours when an event indicates an immediate safety risk, and within five business days for other material risks, with clear protective instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market release and at least annually thereafter, using a regulator-approved protocol and representative production units. A model with a failure rate above 7% shall not be newly installed unless the regulator authorizes a time-limited corrective-action plan. The parties shall review this interim threshold after two years against safety evidence and may adopt a 5% limit with an appropriate transition period."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market must support secure remote emergency shut-off. For already-installed units, manufacturers shall provide compatible shut-off capability through retrofit or replacement within six years of this standard’s effective date, where technically feasible, and inform owners of any limitations and interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression designed to limit fire propagation and protect occupants and nearby members of the public. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers shall promptly notify affected customers of a material battery safety risk, provide clear instructions for safe use and emergency response, and update customers as risks or remedies change. A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
  },
