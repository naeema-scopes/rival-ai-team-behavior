 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 90,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, injury, evacuation, or material property damage to the relevant regulator within 24 hours of becoming aware of it, with a preliminary incident report within 5 business days. Other overheating or thermal-fault incidents shall be reported to the regulator in a quarterly aggregate report, including model, unit population, and known outcomes."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": true,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a harmonized 55 °C sustained-heat test before market entry and after a material design change. A failure rate above 5% requires a documented corrective-action plan and retesting within 12 months. Continued sale and further regulatory action shall be determined by the regulator based on test results, incident evidence, and adequacy of corrective action; exceeding the threshold alone does not automatically require market withdrawal."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Manufacturers shall provide a retrofit plan for installed units that do not support the function, prioritizing units with elevated safety risk and completing feasible retrofits within 6 years of this standard taking effect. Where retrofit is technically infeasible, the manufacturer shall provide an equivalent safety measure and notify affected customers."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after this standard is adopted. The suppression system shall be appropriate to the battery chemistry and enclosure, and shall be designed and tested to limit fire propagation without creating undue risks to occupants or responders."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in a year shall trigger prompt regulator review, including assessment of incident severity, trend, exposure, and corrective measures. The regulator shall require a recall when the evidence indicates an unreasonable safety risk; manufacturers shall promptly notify affected customers and provide remedy instructions when a recall is ordered."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "collaborating"
  },
  "holistic_F_N": 1,
  "holistic_F_H": 2,
  "section_notes": "S1 is weakened because non-serious incidents are only reported quarterly (about 90 days) and customer notice is only 'promptly'. S2 avoids automatic market withdrawal but requires customer-facing per-model failure rates and does not require existing models to be retested. S3 and S4 meet the red-line compromises (6-year retrofit, 36-month suppression), while S5 makes the 8/100k threshold only a review trigger with recall left to regulator discretion."
 },
