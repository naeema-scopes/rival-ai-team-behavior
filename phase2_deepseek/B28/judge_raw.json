 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a fuller incident report within 10 business days. They must notify affected customers and, where a credible risk extends beyond the affected customer, provide a safety notice to customers and relevant emergency responders within 72 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before initial market placement and after a material design or manufacturing change. The maximum permitted failure rate is 5% for any model. Manufacturers must provide complete per-model test results, including failure rates, to the relevant regulator and, before purchase, to customers considering that model. A model exceeding the limit must not be newly placed on the market until corrective action and successful retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "Newly manufactured units must support remote emergency shut-off where technically feasible, with safeguards against unauthorized activation and clear customer instructions. For already-installed units, manufacturers must provide compatible retrofit or replacement options and complete required upgrades within six years of the rule’s effective date."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers must provide customers clear instructions on the system’s operation, limitations, and maintenance. Earlier implementation is encouraged but not required."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected customers of newly identified material risks and corrective actions, and issue safety notices when a credible risk may affect other customers or the public. When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers, provide interim protective instructions, and initiate a recall."
   }
  },
