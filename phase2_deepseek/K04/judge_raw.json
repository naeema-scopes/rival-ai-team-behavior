 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a complete investigation and final incident report submitted within 30 days. Manufacturers must notify affected customers within 72 hours when an incident indicates a credible safety risk to their model or product batch, and provide interim protective instructions where appropriate."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a validated sustained-heat test at 55 °C before sale and at least annually thereafter, using a representative sample and a documented, reproducible protocol. Manufacturers must submit per-model test methods, sample sizes, failure rates, and corrective actions confidentially to the relevant regulator. A model with a failure rate above 5% must submit a corrective-action plan and implement interim safety measures as directed by the regulator; the regulator may require retesting and further mitigation based on the results. Manufacturers must disclose the model’s test method, sample size, and failure rate to customers and prospective purchasers of that model, and promptly notify affected customers of material safety risks with protective instructions and corrective actions. Disclosure of a model’s results to its customers does not require public release of individual-company results."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units must support remote emergency shut-off at the time of sale. Manufacturers must retrofit installed units that do not support remote shut-off within six years after adoption, prioritizing units presenting higher assessed risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": 8,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator, submit a model-specific investigation and corrective-action plan, and notify affected customers of the risk and protective steps. The regulator must promptly assess the evidence and may require a mandatory recall where the risk warrants it; a recall is mandatory when the regulator determines that continued use presents an imminent serious safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
