 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, evacuation, or emergency-service response to the relevant regulator within 24 hours of learning of it. Other confirmed thermal incidents must be reported to the regulator within 5 business days. Manufacturers must notify affected customers within 72 hours for incidents involving fire, injury, evacuation, or emergency-service response, and within 10 business days for other confirmed thermal incidents."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before certification and at least annually thereafter, using a regulator-approved sample and protocol. A model exceeds the 5% acceptance criterion if more than 5% of tested units fail. Before purchase, current and prospective customers must receive the model’s current test status and its complete per-model test results, including the measured failure rate; these results must also be available to existing customers."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support remote emergency shut-off, with safeguards against unauthorized activation and a local means of safe operation. Manufacturers must provide a retrofit pathway for installed units that are technically compatible, completing required retrofits within 6 years of this standard taking effect. Where retrofitting is infeasible, the manufacturer must notify the owner and provide safe alternative mitigation."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard is adopted. The system must be designed and validated to applicable regulator-approved performance and maintenance requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator, investigate the causes, and submit a corrective-action plan. The manufacturer must initiate a recall for that model, promptly contact affected customers, provide a remedy, and give safe-use instructions."
   }
  },
  "holistic": {
