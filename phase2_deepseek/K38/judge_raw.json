 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every confirmed thermal incident involving overheating, smoke, fire, or thermal injury to the relevant regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. Manufacturers shall notify affected customers within 72 hours when an incident presents a credible safety risk to their unit or household, and provide updates as material facts emerge. Suspected incidents shall be logged and investigated; uncertainty does not defer the initial report."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "regulators_only",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. Before sale and at least annually thereafter, the manufacturer shall submit the per-model test protocol, sample size, results, and corrective actions to the regulator and the standard's compliance reviewer. Per-model results shall not be published to the general public. A model with a failure rate above 5% shall undergo regulator-supervised corrective action and retesting on a specified timetable. A model shall not be sold if its failure rate exceeds 7%; it may resume sale only after retesting establishes a rate of 7% or less."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units shall include a secure remote emergency shut-off function no later than 24 months after this standard takes effect. For units already installed when the standard takes effect, manufacturers shall make a compatible retrofit available and complete required retrofits within 6 years, prioritizing units with known safety concerns."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression in accordance with a regulator-approved performance and maintenance protocol. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, calculated using a regulator-approved method. Manufacturers shall promptly notify affected customers and regulators of newly identified material risks and provide instructions for protective action."
   }
  },
