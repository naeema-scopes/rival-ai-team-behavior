 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": null,
    "customer_notice_days": 7,
    "scope": "serious_only",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, emergency-service response, or material property damage to the relevant regulator within 72 hours of learning of it, with a complete incident report within 10 business days. Manufacturers must notify affected customers within five business days when an incident presents a plausible safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% per model triggers a regulator-supervised corrective-action plan and retesting, but is not by itself a prohibition on sale or continued market availability. Manufacturers must provide the per-model failure rate and test summary to prospective buyers before purchase and to existing customers, and disclose material changes or corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New models must include a remote emergency shut-off capability no later than 24 months after adoption. Manufacturers must provide a safe software or hardware upgrade for installed units that lack this capability, completing upgrades within 72 months where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must provide customers with clear safety notices about incidents or hazards that may affect their unit, including recommended precautions and any action required, as soon as practicable and no later than five business days after determining that the notice is warranted."
   }
  },
