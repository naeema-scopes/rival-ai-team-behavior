 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled heating, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a written incident report within 5 business days. They must notify affected customers within 72 hours when an incident presents a credible safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 36,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a standardized sustained-heat test at 55 °C before sale and at least annually thereafter, using a representative sample. A model with a failure rate above 5% must have a regulator-reviewed corrective-action plan, enhanced testing, and retesting at least annually; it must achieve a failure rate of 5% or less within 36 months. If it has not met that limit by the deadline, new sales and installations must pause until it does. Regulators may require an earlier pause if the rate exceeds 8% or they determine there is an imminent unreasonable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must support remote emergency shut-off beginning 2 years after this standard takes effect. Manufacturers must provide a safe, no-cost retrofit pathway for compatible installed units and complete required retrofits within 6 years, prioritizing units with elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify regulators and affected customers, provide a safe remedy or other protective action as directed, and undergo regulator-led safety review. A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
