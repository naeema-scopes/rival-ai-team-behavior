 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a fuller incident report within 10 calendar days. Manufacturers shall notify affected customers promptly, and no later than 48 hours after determining that the incident indicates a potential safety risk, providing known risks and protective actions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a documented, reproducible protocol and a representative sample. Manufacturers shall submit complete per-model results, including failure rates, to the relevant regulator and provide those complete results to customers considering or owning that model; results above a 5% failure-rate benchmark shall prompt regulator review and a corrective-action and retesting plan, but the benchmark shall not by itself require an automatic market ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units shall support remote emergency shut-off within 12 months of adoption of this standard. Manufacturers shall submit a documented retrofit plan for installed units within 12 months of adoption and complete retrofits within 6 years, subject to regulator-approved safety exemptions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression no earlier than 36 months after adoption of this standard. Before that effective date, manufacturers shall assess suppression options and provide regulators with an implementation plan."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the regulator shall promptly verify attribution and denominator, issue a public safety notice, and require a recall unless the regulator documents that an alternative corrective action will adequately mitigate the risk. Affected customers shall be promptly notified of the recall or alternative action and its required protective steps."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S1 is strict (24h reporting, 48h customer notice, no phase-in). S2 sets a 55°C test and 5% benchmark but no automatic sales stop, and gives per-model results to customers and regulators but not the public. S3 requires new-unit shut-off in 12 months and 6-year retrofits with regulator-approved exemptions; S4 requires built-in suppression at 36 months; S5 sets an 8/100k trigger but allows an open-ended regulator-approved corrective alternative, with prompt notices."
 },
