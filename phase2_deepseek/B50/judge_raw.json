 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, property damage, or emergency service response to the relevant regulator within 24 hours of learning of it, with a preliminary account of known facts. Affected customers shall be notified within 24 hours when an incident presents an immediate safety risk, and otherwise within five calendar days, with clear protective steps and contact information."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "pass_fail_only",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol before market entry and at least annually thereafter. A failure rate above 5% shall trigger prompt notice to the regulator and a regulator-supervised investigation and proportionate corrective-action plan, including retesting and a timetable for improvement; it shall not by itself require immediate market withdrawal."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed systems shall support remote emergency shut-off. Manufacturers shall provide a plan to enable this capability on compatible installed systems, with completion no sooner than six years after this standard takes effect; units that cannot be retrofitted shall be identified to owners and the regulator, with safe alternatives specified."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "Built-in fire suppression shall be required on new units manufactured beginning three years after this standard takes effect, subject to regulator-approved equivalent safety measures where appropriate."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly notify the regulator and affected customers, provide protective instructions, and submit incident and remedy information for review. The regulator shall promptly assess the risk, considering incident severity and trend, and determine whether a recall or other corrective action is required; any required action shall include a timetable for remedy or replacement."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
