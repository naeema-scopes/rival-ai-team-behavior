 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "The initial report must be made within 24 hours of learning of the incident, with available details; a follow-up report containing investigation findings and corrective actions is due within 30 days, and material new information must be reported promptly. Manufacturers must notify affected customers within 72 hours of learning of a credible material safety risk, including relevant precautions and available support."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter. A model exceeding a 5% failure rate among tested units must promptly submit a corrective-action plan and retest on a regulator-approved schedule."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support a secure remote emergency shut-off capability no later than 24 months after this standard takes effect. For units already installed, manufacturers must provide the capability through retrofit or an equivalent approved measure within 6 years, where technically feasible, and must notify customers of the schedule and any limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect. The regulator may approve a time-limited alternative safety measure where a manufacturer demonstrates that suppression is technically infeasible for a unit design and that the alternative provides equivalent protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, the manufacturer must promptly notify the regulator and affected customers and provide the underlying rate and available incident information. Exceeding this threshold triggers a mandatory recall."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S1 requires 24-hour reporting of all incidents, follow-up within 30 days, and customer notice within 72 hours. S2 mandates 55°C testing and gives customers numeric per-model results but does not stop sales above 5%, only requiring corrective action. S3 sets 24 months for new units and 6 years for retrofits; S4 requires built-in suppression at 36 months; S5 makes recall mandatory at 8/100k with prompt notices."
 },
