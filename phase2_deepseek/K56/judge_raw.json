 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with an initial report even if the investigation is incomplete. The manufacturer must notify affected customers within 72 hours of determining that their unit may present a safety risk, and provide updates as the investigation proceeds."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market release and at least annually thereafter, using a regulator-recognized protocol and representative samples. A model passes if no more than 5% of tested units fail. For a model already on the market that exceeds the limit, the regulator may authorize continued sale for up to 12 months while corrective action and retesting are completed, subject to regulator-set interim safeguards and any additional customer notices the regulator determines necessary."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units must include a secure remote emergency shut-off capability before sale. Manufacturers must retrofit installed units that lack this capability within six years of adoption, where technically feasible, and provide affected customers with safe interim guidance."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression meeting a regulator-recognized performance and reliability protocol, beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. The manufacturer must promptly notify affected customers and regulators, explain the remedy and any immediate safety steps, and make the remedy available without charge."
   }
  },
