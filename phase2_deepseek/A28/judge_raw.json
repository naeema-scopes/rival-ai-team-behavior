 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": null,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every known thermal incident involving a product to the relevant regulator within 24 hours of learning of it, including incidents involving injury, fire, overheating, or property damage. A manufacturer must not delay reporting while investigating or confirming the cause."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and adequate sample size, at least annually and after a material design change. A model exceeding a 5% failure rate must submit a corrective-action plan and retest within 12 months; exceeding 5% alone does not require withdrawal from sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units placed on the market must support remote emergency shut-off no later than 24 months after adoption. For units already installed on the adoption date, manufacturers must provide a remote shut-off capability through a safe retrofit or compatible system update within 6 years, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units placed on the market must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 1,
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify regulators, submit the model’s incident data, initiate a recall of that model, and notify affected customers with instructions for protective action. Manufacturers must promptly notify affected customers of a confirmed thermal incident involving their unit, and no later than 24 hours after learning of it, with the known safety risk and practical steps to reduce risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
