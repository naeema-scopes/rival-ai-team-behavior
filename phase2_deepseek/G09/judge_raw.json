 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving overheating, fire, smoke, or thermal runaway to the relevant regulator within 24 hours of learning of it, and submit a written incident report with known facts and corrective actions within 10 calendar days. Manufacturers shall notify affected customers within 72 hours when an incident indicates a credible safety risk to their product or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Customers who buy a model shall receive that model’s failure rate, sample size, and test method, and these results shall be updated when retesting materially changes them. A model exceeding a 5% failure rate shall undergo corrective action and retesting under regulator oversight; regulators may restrict sales if safety concerns remain unresolved."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units placed on the market shall support remote emergency shut-off no later than 12 months after adoption of this standard. Existing installed units shall be upgraded or otherwise provided with an equivalent remote shut-off capability within 6 years after adoption, where technically feasible; manufacturers shall document units for which this is not feasible and provide an alternative emergency isolation method."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If available data indicate that a model may exceed 8 thermal incidents per 100,000 installed units in a rolling 12-month period, the manufacturer shall promptly notify the regulator and affected customers and provide interim protective measures. The regulator shall verify the counts and denominator within 10 business days of receiving the notice; if the verified rate exceeds 8 per 100,000, it shall require a recall or an equally protective corrective action with a specified timetable."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
