 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the relevant regulator within 24 hours of learning of it. Other confirmed thermal incidents must be reported within 5 business days. The manufacturer must notify affected customers within 5 business days when an incident presents a credible safety risk to their product or requires a safety action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model’s failure rate must not exceed 7%. Exceeding this limit requires prompt notification to the regulator, a corrective-action and retesting plan, and any additional safeguards or sales restrictions required by the regulator based on demonstrated risk. Manufacturers must submit per-model results, sample size, and protocol to the regulator and provide the results to customers of that model in plain language."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": false,
    "retrofit_deadline_months": null,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units must support remote emergency shut-off by 24 months after adoption of this standard. Existing installed units that do not support remote shut-off are not required to be retrofitted, but manufacturers must disclose that limitation to their owners and provide safe, practical emergency isolation instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Customers must receive clear safety notices promptly when a product presents a credible safety risk. A mandatory recall is triggered when the regulator confirms that a model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must promptly notify affected customers and regulators of a recall and provide instructions for safe handling, repair, or replacement."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S1 is strong on reporting timelines but uses a confirmed-incident scope; S2 keeps 55°C testing yet weakens the cap to 7% with no automatic sales stop while giving customers results; S3 requires new-unit shut-off at 24 months but no retrofit; S4 requires built-in suppression at 36 months; and S5 mandates recall at 8/100k with only prompt notices and no serious-injury clause."
 },
