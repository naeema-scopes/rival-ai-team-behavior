 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Initial reports are due within 24 hours of learning of the event; a fuller report, including known circumstances and corrective actions, is due within 10 business days. Manufacturers shall notify affected customers within 5 business days when an incident indicates a material safety risk, and promptly provide updated instructions as facts develop."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and statistically adequate sample size. A failure rate above 5% shall trigger prompt regulator review, validation of the test results, and a corrective-action plan; it shall not by itself automatically bar a model from sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New models shall include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or emergency responders. For installed units lacking the capability, manufacturers shall offer a retrofit or equivalent safe remediation within 72 months after adoption, prioritizing units subject to a safety notice."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression, or an independently verified equivalent built-in measure that limits fire propagation, beginning 36 months after adoption. The requirement shall not prevent regulators from requiring earlier corrective measures for a model presenting an imminent safety risk."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 verified thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly notify the regulator and provide incident records and denominator data for review. A verified exceedance shall trigger a mandatory recall only when the regulator determines the risk presents a material danger that cannot be adequately mitigated by other measures."
   }
  },
  "holistic": {
