 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving fire, smoke, or uncontrolled overheating to the relevant regulator within 24 hours of learning of it, with a full incident report within 10 business days. They must notify the affected customer within 48 hours, provide immediate safety instructions, and notify customers of nearby units if the incident may indicate a hazard shared by those units."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a standardized sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved sample size and test protocol. No more than 5% of tested units of any model may fail."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery systems must include a secure remote emergency shut-off capability no later than 24 months after this standard takes effect. Manufacturers must retrofit compatible capability to already-installed units within six years of the effective date, or document to the regulator why a unit cannot safely be retrofitted and provide an equivalent protective measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after this standard is adopted. The suppression system must be suitable for the battery chemistry and installation, and must be tested to a regulator-approved protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model’s thermal-incident rate exceeds 8 incidents per 100,000 installed units in a 12-month period. Notices must be sent promptly and through direct channels where available; public notices must also be issued when affected units cannot be reliably identified or reached."
   }
  },
  "holistic": {
