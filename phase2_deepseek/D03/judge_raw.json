 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or material property damage to the responsible regulator within 24 hours of learning of it, with a written incident report including known circumstances and affected model within 10 calendar days. Manufacturers shall notify affected customers within 48 hours when an incident indicates a potential material risk to their unit, and provide updates as material facts emerge. Reports shall not be withheld because an investigation is ongoing; manufacturers may supplement them as facts are confirmed."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo sustained-heat testing at 55 °C using a regulator-approved protocol and representative samples. The maximum permitted failure rate is 5% for each model; a model above that limit shall not be newly marketed until corrective action and retesting demonstrate compliance. Per-model results shall be provided directly to customers who buy that model and to prospective customers before purchase. Results shall not be published or otherwise made available for general public access; regulators may disclose aggregated or anonymized results."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units shall include a remote emergency shut-off capability that can be activated by the customer and, where an imminent safety risk warrants it, by the manufacturer with prompt customer notification. Manufacturers shall provide a secure, no-cost retrofit for installed units lacking this capability within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. The manufacturer shall promptly notify regulators and affected customers, stop sale of the affected model while the recall is in effect, and provide an effective remedy, including repair, replacement, or refund, subject to regulator oversight. Manufacturers shall provide affected customers timely safety notices identifying the model, known hazard, recommended precautions, and available corrective actions, and shall update notices as material facts emerge."
   }
  },
