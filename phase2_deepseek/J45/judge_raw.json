 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving overheating, smoke, fire, injury, or property damage within 24 hours of becoming aware of it, with a preliminary incident report within 5 business days and updates as material facts emerge. Manufacturers must notify affected customers promptly when an incident indicates a material safety risk, and no later than 5 business days after that risk is confirmed."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 7% of tested units. Results above 5% require a regulator-approved corrective-action plan and retesting; results above 7% require corrective action and retesting before further sales, subject to regulator review."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units placed on the market must support remote emergency shut-off no later than 12 months after adoption of this standard. Manufacturers must provide an upgrade or retrofit plan for installed units that lack this capability, with completion no later than six years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": null,
    "quote": "Notices must be sent no later than 5 business days after the risk is confirmed. A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
