 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 5 calendar days of learning of it. Incidents involving death, serious injury, or an active risk of fire must be reported within 24 hours. Manufacturers must notify affected customers within 5 calendar days when an incident indicates a safety risk relevant to their product, and promptly provide any material updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and after a material design change. The performance benchmark is a failure rate of no more than 5%. A model exceeding 5% must promptly submit a regulator-reviewed corrective-action plan and be retested within 12 months. Exceeding the benchmark alone does not automatically prohibit sales; the regulator may require interim safeguards, restrict sales, or take other action based on the failure rate, incident evidence, and adequacy of corrective action."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 60,
    "feasibility_escape": "none",
    "quote": "New home battery systems must include a remotely accessible emergency shut-off function that can be activated by the customer and, during an imminent safety emergency, by the manufacturer or an authorized emergency responder. For installed units without this capability, manufacturers must offer a retrofit or equivalent safety mitigation within 60 months of adoption, prioritizing units with known safety concerns."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required for new home battery systems manufactured on or after 36 months following adoption of this standard. The suppression system must be suitable for the battery chemistry and designed to reduce the risk of fire spread beyond the unit."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected customers of material newly identified safety risks and provide updates as corrective actions develop. A manufacturer must initiate a regulator-reviewed recall when a model exceeds 10 thermal incidents per 100,000 installed units in a year, calculated using verified model-level incident counts and installed-unit exposure. Regulators may require a recall or other corrective action below that threshold based on incident severity, trend, statistical uncertainty, or evidence of ongoing risk."
   }
  },
