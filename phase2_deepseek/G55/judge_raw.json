 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a preliminary account of known facts. Affected customers must be notified within 48 hours of learning of an incident involving their unit or a material risk to their safety."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before market introduction, at least every two years thereafter, and after a material design change. The failure rate must not exceed 7% of tested units for any model. Models exceeding the 7% limit must not be placed on the market or continue to be sold until corrective action is verified by retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery models placed on the market after adoption must include a remote emergency shut-off capability. Manufacturers must enable that capability for installed units that support it and provide a safe retrofit or equivalent mitigation plan for other installed units within six years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months or more after adoption must include built-in fire suppression appropriate to the battery chemistry and installation."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
