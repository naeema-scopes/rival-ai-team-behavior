 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, property damage, or emergency service response to the relevant regulator within 5 calendar days of learning of it. Incidents involving death, serious injury, or an active threat to nearby occupants must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and after a material design or manufacturing change, using a documented, regulator-accepted sampling protocol. A failure rate above 5% requires prompt regulator notification and a corrective-action plan, including retesting and any needed customer safety instructions. The regulator will determine whether sales restrictions or other protective measures are necessary based on the evidence and risk; exceeding 5% alone does not automatically prohibit sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must retrofit already-installed units to provide this capability within 6 years of this standard’s effective date, where technically feasible, and report progress and any infeasibility to the regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard’s effective date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model’s verified annual thermal-incident rate exceeds 8 incidents per 100,000 installed units, the manufacturer must promptly notify the regulator and affected customers, submit the supporting incident data, and initiate a recall of that model. The regulator may require additional protective actions and oversee the recall."
   }
  },
