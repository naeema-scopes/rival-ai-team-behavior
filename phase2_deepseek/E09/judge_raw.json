 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any fire, thermal runaway, or other thermal incident involving a covered battery to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 business days. They must notify the affected customer within 24 hours when the incident involves that customer’s unit or presents an immediate safety risk, and promptly provide any protective instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and after any material design change. The maximum permitted failure rate is 5% of tested units for each model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Newly manufactured systems must include a secure remote emergency shut-off capability, with clear customer instructions and safeguards against unauthorized activation. For units already installed, manufacturers must provide a retrofit or equivalent safe upgrade within six years of this standard taking effect, prioritizing units presenting the greatest risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Newly manufactured battery systems must include built-in fire suppression. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period; the manufacturer must promptly notify the regulator and affected customers, stop sales, and carry out the regulator-approved recall."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
