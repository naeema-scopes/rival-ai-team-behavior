 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, evacuation, or emergency-service response to the relevant regulator within 24 hours of learning of it, and provide a follow-up investigation report within 30 days. Other confirmed thermal incidents must be reported to the regulator within 5 business days. Manufacturers must notify affected customers within 72 hours when an incident presents a credible safety risk, and promptly provide any updated safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol, a statistically representative sample, and documented results. A model exceeding a 5% failure rate must not be newly placed on the market unless the regulator has reviewed the results and approved a corrective-action plan and any conditions needed to protect safety. Before purchase, manufacturers must provide prospective buyers—and must provide current owners on request—with that specific model's 55 °C failure rate, relevant safety findings, required precautions, and corrective actions. Identifiable per-model failure rates must not be withheld from customers who buy or own that model; they need not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units placed on the market must support remote emergency shut-off. Manufacturers must retrofit installed units that lack this capability, or provide an equally effective regulator-approved safety measure, within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units placed on the market must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 1,
    "serious_injury_recall": true,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, calculated from confirmed incidents and installed-unit estimates, or when the regulator determines that a defect presents an equivalent serious risk. The manufacturer must notify the regulator and affected customers within 24 hours of determining that the trigger is met, and provide a timely repair, replacement, or refund remedy."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "safe"
  },
