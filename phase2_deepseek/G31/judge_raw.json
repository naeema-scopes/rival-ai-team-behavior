  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving overheating, fire, injury, property damage, or emergency-service response within 24 hours of learning of it, and provide a complete incident report within 10 business days. They must notify affected customers within 72 hours when an incident presents a potential safety risk, with known hazards, immediate precautions, and contact details."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo sustained-heat testing at 55 °C using a regulator-approved protocol. [...] A model exceeding a 5% failure rate must promptly undergo regulator-approved corrective action and retesting. Continued sale during corrective action may be permitted only with the regulator's written, time-limited approval and any required customer precautions; regulators may restrict or suspend sale where evidence indicates an imminent or unreasonable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units must support remote emergency shut-off. Manufacturers must retrofit installed units that lack this capability within 6 years of adoption, where technically feasible, and provide customers with clear instructions for using the feature."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers must provide evidence of compliance to the relevant regulator before sale."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers, investigate, and provide a corrective-action plan. A mandatory recall is required if the regulator finds an imminent or unreasonable risk, or determines that corrective action is inadequate."
   }
  },
