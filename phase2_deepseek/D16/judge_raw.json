 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal runaway, fire, smoke event, or overheating incident involving a unit to the responsible regulator within 24 hours of learning of it, including incidents involving injury, property damage, or no apparent harm. The manufacturer must notify the affected customer within 24 hours when the event involves their unit, and promptly provide safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each battery model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative samples. The target maximum failure rate is 5% for any model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems must provide a secure remote emergency shut-off capability that can be activated by the customer and, where an imminent safety hazard warrants it, by the manufacturer or responsible emergency authority under documented procedures. For installed units, manufacturers must enable or retrofit remote shut-off within 72 months of adoption where technically feasible; where it is not feasible, they must notify the owner, explain the limitation, and provide an alternative emergency isolation method and instructions."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "All new home battery systems manufactured for sale must include built-in fire suppression conforming to a regulator-approved effectiveness and safety test. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in that period, the manufacturer must promptly report the exceedance to the regulator, initiate corrective action, and conduct a mandatory recall of that model. Notices must promptly reach known owners and be accessible to neighbours and the public, and explain the hazard, affected units, immediate precautions, and remedy."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
