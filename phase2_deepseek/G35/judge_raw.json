 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, followed by a written report within 10 calendar days with known circumstances and corrective actions. If an incident presents an immediate risk to other users or the public, notify affected customers and relevant emergency authorities as soon as practicable and no later than 24 hours after assessing the risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved, consistent protocol before sale and at least annually thereafter. No more than 8% of tested units of a model may fail; a model exceeding this limit may not be newly sold until corrective action and a passing retest. Manufacturers shall provide complete per-model results, including failure rate and test date, to regulators and to customers buying that model, before purchase."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units placed on the market shall support remote emergency shut-off that can be activated by the manufacturer or an authorized emergency responder when necessary to address an imminent safety risk. For units already installed when this standard is adopted, manufacturers shall enable remote shut-off where technically feasible within 6 years, or provide regulators and affected customers a documented alternative emergency-safety plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
