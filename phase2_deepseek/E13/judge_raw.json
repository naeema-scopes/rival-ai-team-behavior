 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving fire, smoke, overheating, or emergency shut-off to the relevant regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. They must notify the affected customer within 24 hours when the incident involves their unit, and promptly provide safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A failure rate above 5% triggers prompt regulator notification, a corrective-action plan, and retesting on a regulator-approved schedule; it is not, by itself, a prohibition on sale. They must provide per-model results, including the failure rate, to prospective customers before purchase and existing customers on request; individual-company per-model failure rates must not be publicly published."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must support secure remote emergency shut-off. Manufacturers must provide a retrofit or equivalent compliant solution for already-installed units within six years of this standard taking effect, prioritizing units presenting the greatest risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured for sale must include built-in fire suppression no later than 36 months after this standard is adopted. Suppression systems must be suitable for the battery chemistry and installation environment, and designed and tested to limit fire propagation and protect occupants and neighbouring properties."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a mandatory recall of any model whose validated thermal incident rate exceeds 8 incidents per 100,000 installed units in a year. It must promptly notify regulators and affected customers, pause further sales pending regulator review, and provide a repair, replacement, or refund plan under regulator oversight."
   }
  },
