 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the regulator any thermal incident involving fire, smoke, uncontrolled overheating, injury, property damage, or emergency response within 24 hours of learning of it, with a fuller investigation report within 30 days. Affected customers must be notified promptly when an incident presents a credible safety risk to their unit or requires action; notices must include practical steps to reduce risk and a contact for assistance."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must be tested under a sustained-heat test at 55 °C. The failure rate must not exceed 5% of tested units for any model. Before purchase, customers shall receive the exact per-model 55 °C test failure rate, pass/fail status, material safety limitations, any required corrective actions, and an explanation of the applicable 5% limit."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off shall be required on all new home battery units from 24 months after adoption of this standard. For units already installed, manufacturers shall offer a retrofit or equivalent safe solution and complete it within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in a year; regulators may also order a recall where evidence indicates an equivalent serious safety risk. Manufacturers shall promptly notify affected owners and, where a hazard may affect nearby people, provide appropriate notice to relevant local authorities and the public."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
