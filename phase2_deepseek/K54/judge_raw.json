  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the responsible regulator within 24 hours of learning of it. Manufacturers must notify affected customers within 72 hours of learning of a credible safety hazard, including when to stop use and how to obtain assistance."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. The maximum permitted failure rate for a model newly placed on the market is 5%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New models placed on the market 24 months or more after adoption must support a secure remote emergency shut-off that can be activated by the manufacturer or responsible emergency services when a credible imminent thermal hazard exists. For units already installed at adoption, manufacturers must provide a retrofit or equivalent risk-control plan within 12 months and complete implementation within 72 months, prioritizing higher-risk units."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption must include built-in fire suppression validated for the unit’s battery chemistry and enclosure, or an equivalent built-in measure demonstrated to limit fire propagation."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model’s annual thermal-incident rate exceeds 8 per 100,000 installed units, the manufacturer must notify the regulator within 24 hours, provide the underlying incident and denominator data, and submit a corrective-action and risk assessment within 30 days. The regulator must promptly assess whether to require a recall or other protective measures; a recall is mandatory when the regulator determines it is necessary to address an unacceptable risk."
   }
  },
