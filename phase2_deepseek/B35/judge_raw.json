 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 72 hours of becoming aware of it, including incidents initially reported by customers or installers. Manufacturers must notify affected customers promptly, and no later than 48 hours after determining that a product or condition presents a material safety risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter. The parties recognize the currently discussed maximum failure rate of 5% per model; a model exceeding that limit must promptly submit a corrective-action plan and be retested within six months, with regulator-directed interim protections. Exceeding the limit alone does not automatically require market withdrawal."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models must include a remotely operable emergency shut-off. Manufacturers must retrofit installed units to support remote emergency shut-off, where technically feasible, within six years after adoption; where infeasible, they must notify affected customers and regulators, explain the limitation, and provide an equivalent protective measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when a model’s verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any rolling 12-month period; notify regulators and affected customers promptly, and no later than 48 hours after confirming the threshold is exceeded. Regulators may require an earlier recall or other protective action where evidence shows an imminent risk."
   }
  },
