 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, emergency-service response, or property damage to the relevant regulator within 5 business days after becoming aware of it, including incidents that do not meet a separate injury or damage threshold. Any incident involving death, serious injury, or an ongoing threat to occupants or neighbours must be reported immediately and no later than 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a documented sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved protocol and representative production units. A failure rate above 5% requires prompt regulator notification, a corrective-action plan, and regulator review of appropriate risk controls and retesting; it does not by itself automatically prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must include a secure remote emergency shut-off capability, with appropriate safeguards against unauthorized activation. Manufacturers must provide a plan to retrofit compatible already-installed units within 6 years of this standard taking effect; where a unit cannot be safely retrofitted, the customer must be informed and offered an equivalent safety measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after this standard is adopted. Manufacturers must provide customers with clear instructions on the system’s operation, limitations, and maintenance."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. When triggered, manufacturers must notify regulators and affected customers without delay, stop placing the affected model on the market, and provide a regulator-approved recall and remedy plan."
   }
  },
