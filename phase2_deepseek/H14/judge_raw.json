 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator every thermal incident involving fire, smoke, uncontrolled overheating, injury, or material property damage, whether or not the cause is known, within 5 business days of becoming aware of it. Incidents presenting an ongoing risk of injury or fire shall be reported promptly and no later than 24 hours after awareness. Manufacturers shall notify affected customers as soon as practicable, and within 5 business days when a continuing safety risk is identified."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. Manufacturers shall provide complete per-model results to the relevant regulator and to customers who buy or own that model. Regulators may publish non-identifying aggregate results. A model complies only if no more than 5% of tested units fail."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems shall include remote emergency shut-off capability. Manufacturers shall make a good-faith effort to retrofit installed units that can support the capability, and shall enable it within 6 years after adoption of this standard. Where retrofit is not technically feasible, the manufacturer shall document the reason and provide customers with clear emergency isolation instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems shall include built-in fire suppression beginning 36 months after adoption of this standard. The suppression system shall be appropriate to the battery chemistry and enclosure and shall be validated as part of the model’s safety testing."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Customers shall receive clear safety and emergency-use instructions at purchase, including recognized warning signs and how to contact the manufacturer. Manufacturers shall promptly notify affected customers of a material safety hazard and provide updates as new information becomes available. A model-wide recall is required when that model exceeds 10 thermal incidents per 100,000 installed units in a year. Manufacturers shall report model-level incident counts and installed-unit denominators to the regulator using a consistent annual reporting period; the regulator may verify the calculation and require an earlier recall whenever a defect presents an unacceptable risk of serious harm."
   }
