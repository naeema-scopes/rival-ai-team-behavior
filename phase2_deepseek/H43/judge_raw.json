 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of confirmation, including incidents involving injury or property damage. The affected customer must be notified within 24 hours of confirmation; where the incident may pose an immediate risk to other users or nearby people, the manufacturer must also promptly issue an appropriate safety alert."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved, statistically representative protocol. A model with a failure rate above 5% must promptly undergo regulator-supervised corrective action and retesting, with appropriate interim protections where warranted. Exceeding 5% alone does not require an automatic sales ban or recall; regulators may require further corrective action or market restrictions based on evidence of an unacceptable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All newly manufactured home battery systems must support a secure remote emergency shut-off capability that can be activated by the manufacturer or relevant emergency responders when necessary to address an imminent safety risk. Existing installed units must be brought into compliance, where technically feasible, within 6 years after adoption; manufacturers must notify owners of units that cannot be upgraded and provide applicable safe-use instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression meeting regulator-approved performance and safety requirements. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected customers of newly identified material risks and provide updated instructions or corrective measures. Regulators must investigate when a model has more than 8 confirmed thermal incidents per 100,000 installed units during any rolling 12-month period. After investigation, regulators must order a recall or equivalent market restriction when the evidence establishes that continued sale or use presents an unacceptable safety risk; they may require interim protective measures while investigating. The 8-per-100,000 threshold triggers investigation, not an automatic recall."
   }
  },
