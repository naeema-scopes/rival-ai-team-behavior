    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C before certification and at least annually thereafter, using a regulator-approved protocol and representative units. A model with a failure rate above 5% shall be subject to a regulator-approved corrective-action plan and retesting; continued sales may proceed while the plan is followed unless the regulator determines suspension is necessary to protect the public."
   },
