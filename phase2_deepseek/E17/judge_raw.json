 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, smoke, fire, injury, or property damage to the appropriate regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. They must promptly notify the affected customer and, where there may be a hazard to nearby people or property, provide appropriate safety instructions to customers and relevant emergency responders. Reporting obligations apply even when the cause is not yet established."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A model with a failure rate above 5% must be reported to the regulator and placed under a regulator-approved, time-bound corrective-action plan, including retesting and any interim safeguards the regulator determines necessary. Exceeding 5% alone does not automatically prohibit sale; the regulator may restrict or suspend sales if needed to address an unacceptable risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. For units already installed, manufacturers must provide a retrofit or equivalent safe mitigation plan; the completion deadline must be at least six years after this standard takes effect, with priority given to higher-risk units and progress reported annually to regulators."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after this standard is adopted. Manufacturers must provide customers with instructions on the system’s operation, limitations, and maintenance, and report any suppression-system failures associated with a thermal incident to the regulator."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model exceeds 8 thermal incidents per 100,000 installed units in a year, using regulator-validated incident and installation data, the manufacturer must promptly notify the regulator and conduct a regulator-supervised risk assessment. The regulator must require a time-bound corrective-action plan and may require a recall when the assessment finds that a recall is necessary to address an unacceptable risk, including where corrective actions cannot adequately mitigate the hazard."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
