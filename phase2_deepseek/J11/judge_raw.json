 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, thermal runaway, injury, or property damage to the relevant regulator within 24 hours of learning of it, with an initial account of known facts. Affected customers must be notified within 48 hours when the incident indicates a potential safety risk to their unit or household."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a harmonized sustained-heat test at 55 °C before market introduction, at least annually, and after a material design or manufacturing change, using a representative sample. A model with a failure rate above 5% must undergo a documented risk assessment and corrective-action plan with regulator oversight; exceeding 5% alone does not automatically prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery models must include remote emergency shut-off capability that can be activated by the manufacturer or an authorized emergency responder to address an imminent safety risk. Units already installed when this standard is adopted must be brought into compliance within 6 years, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. Regulators may approve an equivalent built-in mitigation technology where evidence demonstrates comparable protection against fire propagation and risk to occupants and neighbours."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units of that model in a year, the regulator must promptly review the evidence and require appropriate interim protections. The regulator must order a recall when it determines that a material safety risk cannot be adequately addressed by less disruptive corrective measures; exceeding the threshold alone does not automatically require a recall."
   }
  },
  "holistic": {
