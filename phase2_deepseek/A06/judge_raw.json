  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident, including overheating or fire, to the relevant regulator within 24 hours of learning of it, with a follow-up report within 30 days. They must notify affected customers within 72 hours when an incident presents a credible safety risk to their unit or household, and provide updates as material information becomes available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter. A model exceeds the allowable failure rate if more than 7% of tested units fail."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models must include a remote emergency shut-off capability. Manufacturers must retrofit already-installed units with this capability within 6 years of this section taking effect, where technically feasible, and must notify owners of any units that cannot be retrofitted."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after this section takes effect. Manufacturers must disclose to customers whether a unit includes built-in fire suppression and provide any applicable safety instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model’s verified thermal incident rate exceeds 8 incidents per 100,000 installed units in a year, the manufacturer must promptly notify regulators and affected customers, submit a corrective-action plan, and undergo independent review. A mandatory recall is required if the regulator confirms an ongoing serious risk or the manufacturer fails to implement effective corrective action."
   }
