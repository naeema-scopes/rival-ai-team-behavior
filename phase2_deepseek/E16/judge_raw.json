 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 2,
    "scope": "serious_only",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal runaway, fire, explosion, or event involving emergency venting of a battery to the relevant regulator within 24 hours of becoming aware of it, and provide a written incident report within 10 business days. They must notify affected customers within 48 hours when an incident indicates a credible safety risk to other units of the same model, including interim precautions and how to obtain support."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units before sale and after a material design change. Before purchase, customers must receive the 55 °C test result and failure rate for the model they are considering, with the sample size and test date; results for other models need not be publicly disclosed. A model with a failure rate above 5% must submit a corrective-action plan and undergo retesting at least annually; regulators may restrict sales where the results or other evidence show an unacceptable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery systems must support remote emergency shut-off, with secure access for the customer and authorized emergency responders. For installed units that lack this capability, manufacturers must complete a retrofit or equivalent safe mitigation plan within 6 years of adoption, prioritizing units with known safety risks. Where retrofit is infeasible, manufacturers must notify affected customers and regulators and explain alternative protections."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression no later than 36 months after adoption of this standard. Manufacturers must demonstrate through regulator-approved testing that the system is suitable for the battery chemistry and enclosure and does not create additional hazards."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, manufacturers must promptly notify regulators and affected customers, provide the model-level data and a corrective-action plan, and initiate a recall. Manufacturers must notify customers without delay and provide progress updates until the risk is addressed."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
