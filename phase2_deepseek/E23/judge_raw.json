 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a fuller incident report within 10 business days. They must notify affected customers within 72 hours when an incident indicates a material risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative samples. The maximum permitted failure rate is 5% per model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support remote emergency shut-off. For units already installed, manufacturers must provide a retrofit or equivalent safe mitigation within six years of the standard taking effect, prioritizing units presenting the highest documented risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model’s confirmed thermal-incident rate exceeds 8 incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator, provide supporting data, and submit a corrective-action plan. The regulator must promptly assess the evidence and risk and determine whether a recall or other protective measures are required; exceeding the threshold alone does not automatically trigger a recall."
   }
  },
