  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report each thermal incident involving overheating, smoke, fire, injury, or material property damage to the relevant regulator within 72 hours of learning of it, with a supplemental investigation report within 30 days. They must notify affected customers within 5 business days when an incident indicates a credible safety risk to their product or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before initial market placement and after material design changes. A failure rate above 5% triggers regulator-directed corrective action and retesting; it does not, by itself, automatically bar market placement or require withdrawal. Before purchase, customers must receive the model’s test results, including observed failure rate and material limitations. Per-model results must not be publicly published by manufacturers or regulators."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models placed on the market 24 months after adoption must provide a secure remote emergency shut-off capability, with safeguards against unauthorized activation and a local means of disconnection. Manufacturers must make a compatible retrofit available for installed units where technically feasible and complete retrofits within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured for sale 36 months after adoption of this standard must include built-in fire suppression appropriate to the battery chemistry and installation. Existing installed units are not subject to a retrofit mandate under this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when a regulator-verified model rate exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. Manufacturers must notify regulators and affected customers without delay and provide a remedy plan."
   }
  },
