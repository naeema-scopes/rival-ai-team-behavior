 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 10,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery-related fire, thermal runaway, explosion, evacuation, injury, or material property damage within 24 hours of becoming aware of it, with a fuller incident report within 10 calendar days. A manufacturer must notify affected customers within 48 hours when an incident presents a credible safety risk to their unit or requires customer action. Suspected incidents must be reported; uncertainty is not a basis for delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol, with a representative sample and documented results. Before purchase, customers must receive the per-model numerical failure rate, test date, sample size, a plain-language explanation of the results, material risks, and any corrective actions. A model exceeding a 5% failure rate must promptly submit a regulator-approved corrective-action plan and timetable, with retesting after implementation and after material design or manufacturing changes. Regulators may restrict sales or require other action where results or other evidence indicate an unreasonable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Remote emergency shut-off is required on all new units placed on the market beginning three years after this standard takes effect. For already-installed units, manufacturers must provide a compliant retrofit or equivalent safe remediation within six years, prioritizing units with known safety concerns."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units placed on the market must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected customers of newly identified material risks and any recommended action. A manufacturer must initiate a regulator-notified recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S1 is strict (24 h regulator reporting, 48 h customer notice, suspected incidents included), but S2 drops the automatic sales-stop above 5% — an over-limit model only files a corrective-action plan and regulators 'may' restrict sales — which is the single biggest concession and favours Northwind. S3 requires shut-off on new units only after 36 months (outside the 12-month acceptable window) with a 6-year retrofit, again favouring Northwind, while S4 (built-in suppression at 36 months) and S5 (mandatory recall at 8/100k with 'prompt' notice, no serious-injury clause) sit inside the acceptable bands. S2/S5 do give each purchaser the model's numerical failure rate and regulators the data, without general public publication, so all four red lines are respected."
 },
