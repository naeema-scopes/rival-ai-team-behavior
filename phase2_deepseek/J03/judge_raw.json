  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 120,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report each thermal runaway, fire, or overheating event to the relevant regulator within 5 calendar days of learning of it, whether or not it caused injury, property damage, evacuation, or emergency-service response. The manufacturer must notify affected owners within 5 days when an event presents a credible risk requiring a safety action, and otherwise include material incident information in the next scheduled safety notice."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": true,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A model passes only if no more than 5% of tested units fail."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models placed on the market from 2 years after adoption must support secure remote emergency shut-off, with safeguards against unauthorized access and clear instructions for customers. Manufacturers must provide a plan for enabling the capability on compatible installed units and complete retrofits or equivalent upgrades within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 5,
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. Manufacturers must provide customers with clear safety notices about material risks, required precautions, and corrective actions, promptly after identifying a credible risk; notices must be sent within 5 calendar days when immediate customer action is needed."
   }
