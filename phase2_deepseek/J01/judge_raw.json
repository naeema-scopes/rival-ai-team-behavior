 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": "immediate",
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every confirmed thermal incident involving a home battery to the relevant regulator within 24 hours of becoming aware of it, including incidents involving fire, injury, evacuation, or emergency-service response. Manufacturers shall promptly notify affected customers when an incident indicates a material safety risk or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 24,
    "interim_limit_pct": 7,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 7% for any model. If a model exceeds 5%, the manufacturer shall promptly notify the regulator and affected customers, submit a regulator-approved corrective-action plan and enhanced monitoring measures, and conduct a confirmatory test within 12 months."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery models placed on the market 24 months after adoption shall support remote emergency shut-off, with safeguards against unauthorized activation and a means for customers or emergency responders to verify shut-off status. For installed units, manufacturers shall provide a feasible retrofit or replacement plan for units that can support the feature within 72 months of adoption; where retrofitting is not technically feasible, they shall disclose that limitation and provide alternative emergency-response instructions within 72 months of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Home battery units manufactured for sale 36 months or more after adoption shall include built-in fire suppression meeting a regulator-approved performance test."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in a year, based on validated incident and installed-base data; manufacturers shall promptly report the exceedance to regulators and customers and initiate the recall without delay. Manufacturers shall provide customers with model-specific 55 °C test results, clear installation and emergency-response instructions, and prompt safety notices when an incident or new evidence indicates a material risk or customer action is needed."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
