 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any death, serious injury, fire, thermal runaway, or emergency service response involving a battery to the relevant regulator within 24 hours of learning of it, and notify affected customers within 72 hours. Other overheating or thermal incidents shall be reported to the regulator within five business days and included in a quarterly customer-facing incident summary."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 48,
    "interim_limit_pct": 8,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "For the first two years after this standard takes effect, a model’s failure rate shall not exceed 8%; thereafter it shall not exceed 5%. A model above the applicable limit may receive one extension of up to two years, provided the manufacturer submits a documented corrective-action plan and retesting shows measurable improvement."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New home battery units shall support remote emergency shut-off no later than 12 months after this standard is adopted. Manufacturers shall retrofit installed units to provide this capability within six years, where technically feasible, and document any units that cannot be retrofitted for regulator review."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All newly manufactured home battery units shall include built-in fire suppression beginning 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period; regulators may also require a recall where the incident pattern presents an imminent or otherwise unacceptable risk. Manufacturers shall notify regulators and affected customers promptly and provide repair, replacement, or refund instructions."
   }
  },
  "holistic": {
