  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Initial notice is due within 24 hours of learning of the event; a preliminary investigation report is due within 10 business days, with material updates provided promptly. Manufacturers must notify affected customers within 72 hours when an incident reveals a credible product safety risk, providing safety instructions and updates as the investigation proceeds."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each battery model must undergo a sustained-heat test at 55 °C before market entry and at least annually thereafter, using a regulator-approved protocol and independent laboratory. A model with a failure rate above 5% must submit a corrective-action plan and be retested within 12 months. Exceeding 5% alone does not automatically prohibit sales; regulators may restrict new sales or require further safeguards if the model remains above the limit after retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "For installed systems lacking this capability, manufacturers must provide a safe retrofit or equivalent risk-reduction measure within 6 years of adoption, prioritizing systems with known safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must immediately notify the regulator and initiate an independent review, while providing affected customers with interim safety information. A recall or other corrective action must be required when the review confirms an unacceptable safety risk; regulators may order a recall at any time where evidence shows an imminent serious risk, regardless of the rate."
   }
  },
