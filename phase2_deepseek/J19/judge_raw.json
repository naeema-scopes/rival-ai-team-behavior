 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery-related fire, thermal runaway, explosion, evacuation, or injury within 24 hours of learning of it, and any other confirmed thermal incident within 5 business days. Within 5 business days, manufacturers must notify affected customers of an incident involving their unit or model when it presents a credible safety risk, with interim protective instructions where appropriate."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a standardized 55 °C sustained-heat test before sale and at least annually thereafter, using a regulator-approved sample size and failure definition; manufacturers must submit each model’s results, sample sizes, failures, and corrective actions to the regulator, and provide the per-model results to customers who buy or own that model; these results are not required to be publicly disclosed. A failure rate above 5% triggers a corrective-action plan within 90 days and retesting on a regulator-approved schedule, with interim safeguards where warranted; exceeding 5% alone does not automatically prohibit sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems placed on the market must include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or emergency responders under documented safeguards. For systems already installed when this requirement is adopted, manufacturers must provide a compatible retrofit or replacement plan within 18 months and complete implementation within 72 months, prioritizing units and locations presenting greater risk. If a unit cannot reasonably be retrofitted, the manufacturer must notify its owner and provide an equivalent protective measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression. This requirement applies to units manufactured or imported for sale beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a model-level recall when that model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, or when the regulator determines that a defect presents an equivalent serious risk. Manufacturers must notify affected customers promptly, and no later than 5 business days after confirming a safety risk, with specific protective instructions and available remedies."
   }
  },
