 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the regulator any thermal incident involving fire, injury, emergency-service response, or material property damage within 24 hours of becoming aware of it, with a written incident report within 10 calendar days. Other confirmed thermal incidents must be reported within 5 business days. Manufacturers must notify affected customers within 24 hours when an incident indicates an immediate safety risk, and otherwise within 5 business days, providing known hazards and interim safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo sustained-heat testing at 55 °C before market entry and at least annually thereafter, using a regulator-approved protocol and a representative sample. A failure rate above 5% requires a corrective-action plan submitted to the regulator within 30 days and follow-up testing within 12 months; regulators may require additional safeguards based on the evidence."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must support remote emergency shut-off. Manufacturers must provide a retrofit path for compatible installed units and complete required retrofits within 6 years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. When the threshold is reached, the manufacturer must notify the regulator and affected customers promptly and explain the remedy and timeline."
   }
  },
