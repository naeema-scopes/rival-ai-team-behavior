 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, or emergency evacuation to the responsible regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. They must notify affected customers and, where there is a credible risk to nearby people or property, relevant local emergency authorities within 72 hours."
   },
   "S2_thermal_testing": {
