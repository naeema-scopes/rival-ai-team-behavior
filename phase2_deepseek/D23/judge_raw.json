 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every battery-related overheating, fire, or thermal runaway incident to the relevant regulator within 5 business days of learning of it, and immediately, within 24 hours, when the incident involves a fire, injury, death, evacuation, or material property damage. Manufacturers shall notify the affected customer within 5 business days, or within 24 hours for the serious incidents listed above, and provide any immediate safe-use instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 6.5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A model passes if no more than 6.5% of tested units fail. Manufacturers shall submit per-model test methods, sample sizes, and failure rates confidentially to the regulator and provide the results to customers who buy that model, before purchase where practicable and promptly after testing or retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units shall support remote emergency shut-off no later than 24 months after adoption. Manufacturers shall submit a regulator-approved retrofit plan for installed units that do not support the function, prioritizing units with elevated safety risks, and complete retrofits within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery units shall include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers shall document compliance using a regulator-approved verification method."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly notify regulators and affected customers, investigate, submit a corrective-action plan, and provide interim safety instructions. If the verified rate exceeds 8 per 100,000 in a year, the manufacturer shall initiate a recall of the affected model."
   }
  },
  "holistic": {
