 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, including incidents initially suspected to involve installation or external causes. Manufacturers shall notify affected customers within 48 hours when an incident presents a credible safety risk to their model or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 18,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A model above the 7% ceiling shall have 18 months to implement corrective measures and pass a retest; during that period, the manufacturer shall disclose the result and corrective-action timeline to affected customers and the regulator."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New home battery units shall support a secure remote emergency shut-off capability that can be activated by the manufacturer or emergency responders when necessary to address an imminent safety risk. Manufacturers shall provide existing installed units with this capability, where technically feasible, within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression beginning 36 months after adoption. Manufacturers shall document the suppression system’s performance and maintenance requirements and provide these to customers."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 14,
    "serious_injury_recall": null,
    "quote": "A notice requiring urgent action shall be sent within 48 hours of the manufacturer becoming aware of the risk; other material safety notices shall be sent within 10 business days. If a model exceeds 8 thermal incidents per 100,000 installed units in any year, the manufacturer shall promptly notify the regulator and affected customers, and the regulator shall conduct a documented model-specific safety review."
   }
  },
  "holistic": {
