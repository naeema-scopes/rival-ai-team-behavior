 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report each thermal incident involving fire, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of learning of it, with a full incident report within 10 business days. Other confirmed thermal incidents must be reported to the regulator within 10 business days. Affected customers must be notified promptly, and no later than 5 business days after the manufacturer determines that a product or safety action may affect them."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market launch and at least annually thereafter, using a regulator-approved protocol. A model with a failure rate above 5% must submit a corrective-action plan to the regulator and undergo retesting within 12 months; exceeding 5% alone does not automatically prohibit sale. Manufacturers must provide complete per-model test results to regulators and the customers who buy that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units must support remote emergency shut-off. Manufacturers must retrofit installed units that do not support the function, or provide an equivalent regulator-approved emergency shut-off measure, within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption. The requirement applies to units manufactured on or after that date; manufacturers must provide customers with information about the suppression system and its maintenance."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period, subject to regulator verification using a consistent denominator and reporting method, the manufacturer must promptly investigate, submit findings to the regulator, and notify affected customers. A verified exceedance triggers a mandatory recall. The manufacturer must promptly notify affected customers and regulators of the recall, explain the hazard and remedy, and provide status updates until it is complete."
   }
  },
