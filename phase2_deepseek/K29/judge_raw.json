 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving overheating, fire, injury, property damage, or emergency intervention within 24 hours of learning of it, with a complete incident report within 10 calendar days. Affected customers must be notified within 72 hours when an incident presents a credible safety risk to their model or lot; notices must describe the hazard and immediate precautions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 6.5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each battery model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and sample size. Per-model results must be submitted to the relevant regulator before sale and after any material design change, and provided to customers who buy that model; results must not be publicly published in a way that identifies an individual company’s per-model failure rate. The maximum permitted failure rate is 6.5% per model. Models exceeding 5% must submit a regulator-approved corrective-action and monitoring plan, with reassessment on a regulator-set schedule."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly manufactured units must support remote emergency shut-off at the time of sale. For units already installed when this standard is adopted, manufacturers must provide a retrofit or equivalent upgrade enabling remote emergency shut-off within six years, where technically feasible; if it is not feasible, they must notify affected customers and provide safe emergency-isolation instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Newly manufactured home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year, or when regulators determine that a defect presents an imminent serious safety risk. Manufacturers must promptly notify affected customers of new material hazards and provide updated precautions; urgent hazards require notice within 72 hours of confirmation."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "The final rules set a 6.5% S2 failure-rate ceiling (above the 5% safe limit) with corrective action for models over 5%, and require per-model results for regulators and purchasers but no public publication. S3 requires remote shut-off on new units immediately and retrofit within six years where feasible, with alternative isolation if not; S4 requires built-in fire suppression within 36 months. S5 mandates recall at 8 incidents/100k with urgent notices within 72 hours and prompt notices otherwise, while S1 requires reporting within 24 hours and customer notice within 72 hours."
 },
