 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with an initial account of the event and any known safety implications. Manufacturers must notify affected customers within 48 hours when an incident indicates a credible risk requiring a warning or action to protect people or property."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo sustained-heat testing at 55 °C using a regulator-approved protocol. A model exceeding the 5% failure-rate benchmark must undergo regulator-supervised review and corrective-action planning, taking account of test uncertainty and real-world safety evidence."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units must support remote emergency shut-off, with safeguards against unauthorized activation and a locally accessible shut-off method. Manufacturers must retrofit installed units that lack this capability within six years of adoption, prioritizing units presenting the greatest safety risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers must provide regulators with evidence that the suppression system is effective and does not introduce other material safety risks."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model exceeds 8 validated thermal incidents per 100,000 installed units in a year. Manufacturers must report incident counts and installed-unit denominators to regulators, who may require interim protective measures while validating the data."
   }
  },
