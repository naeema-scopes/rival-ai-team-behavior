 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, property damage, or emergency intervention to the relevant regulator within 24 hours of becoming aware of it, with a follow-up investigation report within 30 days. Affected customers shall be notified within 72 hours when an incident presents a credible safety risk to their model or requires action; notices shall describe the hazard and steps to take."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C before sale and after any material design change. The maximum allowed failure rate is 5% of tested units."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New models placed on the market shall support remote emergency shut-off, with safeguards against unauthorized activation and a locally operable alternative. Manufacturers shall retrofit installed units that do not support remote shut-off within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly notify the regulator and affected customers, provide the regulator with model-level incident counts and installed-unit denominators, and initiate a mandatory recall."
   }
