 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or suspected thermal runaway to the relevant regulator within 72 hours of becoming aware of it, including incidents still under investigation. Manufacturers must notify affected customers within 5 business days when an incident presents a credible safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and at least once every three years thereafter. A model’s failure rate must not exceed 8%. Manufacturers must submit complete per-model results to the regulator and provide those results to customers of that model before purchase and to existing customers upon request; individual company per-model results are not required to be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support remote emergency shut-off no later than 24 months after the standard takes effect, where safe operation and connectivity permit. For units already installed, manufacturers must provide a retrofit or equivalent safety upgrade within 6 years after the standard takes effect. Where retrofit is not technically feasible, the manufacturer must provide customers with an alternative risk-reduction measure and instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard is adopted. Manufacturers must provide customers and regulators with clear information about the suppression system, its limitations, and maintenance requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When verified incident data indicate that a model may exceed 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and provide supporting data. A recall is mandatory when the regulator verifies that a model exceeds 8 thermal incidents per 100,000 installed units in a year. Recall notices must promptly reach affected customers."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 3,
  "holistic_F_H": -2,
  "section_notes": "The final rules adopt a 55°C test with an 8% failure ceiling and no automatic sales stop, favoring Northwind's Hearth 10 while preserving customer access to per-model results but not public publication. S3 sets a 24-month new-unit shut-off deadline and a 6-year retrofit window with a feasibility alternative, and S4 delays built-in suppression to 36 months. S5 creates a mandatory recall at 8 incidents per 100,000 upon regulator verification, which would affect Halcyon's Ember 8, with 'promptly' customer notices."
 },
