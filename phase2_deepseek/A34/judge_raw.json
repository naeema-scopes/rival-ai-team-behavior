 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery-related fire, thermal runaway, injury, evacuation, or emergency-service response to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 business days. Any other confirmed thermal incident must be reported to the regulator within 5 business days. Manufacturers must notify affected customers promptly, and no later than 5 business days after confirming a material hazard, including immediate safety instructions and how to report related incidents."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo an independently witnessed 55 °C sustained-heat test using a regulator-approved protocol and representative production units before sale and at least annually. Test results and sample sizes must be submitted confidentially to regulators and disclosed to customers buying that model in clear, accessible form; this section does not require publication of individual-company, per-model failure rates to the general public. A model exceeding a 5% failure rate must undergo a corrective-action plan and retest within a regulator-set period, with interim risk controls as appropriate. Sales may continue during remediation unless the regulator determines that an imminent safety risk warrants restricting sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units must include a remote emergency shut-off capability no later than 12 months after adoption of this standard. For units already installed, manufacturers must provide a retrofit or equivalent safe shut-off solution within 6 years after adoption, prioritizing units with known hazards and notifying affected customers of the schedule."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured 36 months or more after adoption of this standard must include built-in fire suppression meeting regulator-approved performance requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When verified data show that any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and provide supporting data. Exceeding this threshold requires a mandatory recall and prompt notification to affected customers with instructions. Per-model incident rates and test results must be provided to regulators and affected customers, not published to the general public."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S1 requires mandatory reporting of serious incidents within 24 hours and other confirmed incidents within 5 business days, with customer notice within 5 business days of confirming a material hazard. S2 sets a 55°C test and a 5% failure-rate threshold, but allows sales to continue during a regulator-set remediation period unless imminent risk triggers restrictions, and it keeps per-model results confidential from the general public but disclosed to customers. S3 requires new-unit shut-off within 12 months and retrofit/equivalence within 6 years; S4 requires built-in suppression at 36 months; S5 makes recall mandatory above 8 incidents per 100,000 per year with prompt customer notice, while keeping per-model data from public publication."
