 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed battery-related thermal incident, including overheating, thermal runaway, or fire, to the relevant regulator within 72 hours of learning of it, whether or not it required emergency response, medical treatment, evacuation, or caused property damage. They must notify affected customers within 5 business days, and promptly provide any new material safety information."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and after a material design change. A test result above 5% failure requires regulator review and a corrective-action plan, but does not by itself prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models must support remote emergency shut-off before sale. Manufacturers must enable the function on all installed units capable of receiving it within six years after adoption, including through software updates where feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must track thermal incidents by model and notify the regulator if a model’s annual thermal-incident rate exceeds 8 per 100,000 units of that model installed. A threshold exceedance triggers regulator review of model-specific evidence and corrective action; the regulator may order a recall when warranted by that review."
   }
  },
