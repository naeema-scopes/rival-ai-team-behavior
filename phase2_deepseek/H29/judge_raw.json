 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a follow-up report containing investigation findings within 30 days. They shall notify affected customers within 72 hours when an incident presents a credible safety risk to their model, and provide updates when material information changes."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Customers who own or are considering a model shall receive that model’s exact 55 °C test failure rate and any protective actions, informed by validated results. A failure rate above 5% shall trigger confidential regulator review and a corrective-action plan; any further restrictions shall be based on validated test results and incident data."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units shall include remote emergency shut-off capability no later than two years after this standard takes effect. Manufacturers shall provide a plan to retrofit already-installed units with remote shut-off capability within six years after the effective date, prioritizing higher-risk units and providing customers with safety instructions while retrofits are pending."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression for units manufactured beginning 36 months after this standard takes effect. The regulator shall publish minimum performance and verification requirements before that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 confirmed thermal incidents per 100,000 installed units in a year, the regulator shall promptly validate the incident and installed-unit data, investigate the model’s risk, and require proportionate protective measures as warranted. The regulator shall require a recall when validated evidence shows that a recall is necessary to address an unacceptable safety risk; it shall publish its determination and the basis for its actions."
   }
  },
  "holistic": {
