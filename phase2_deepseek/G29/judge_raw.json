 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every known thermal incident involving a battery, including overheating, thermal runaway, smoke, or fire, to the relevant regulator within 24 hours of becoming aware of it, regardless of whether injury or property damage occurred. Manufacturers shall notify affected customers within 72 hours when an incident indicates a potential safety risk to their model, and promptly update those customers as material information becomes available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each battery model shall undergo sustained-heat testing at 55 °C using a regulator-approved protocol and representative production units. A failure rate of no more than 5% is the performance benchmark. Manufacturers shall submit full per-model results, sample sizes, and corrective-action plans to the relevant regulator, and disclose the per-model failure rate and test date to customers buying that model. A model exceeding the benchmark shall undergo corrective action and retesting. The regulator shall review the results and determine appropriate measures, including whether continued market access is safe; exceeding the benchmark alone does not automatically prohibit market access."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems shall include a remote emergency shut-off capability within 12 months of adoption. Manufacturers shall assess installed units lacking this capability and complete feasible retrofits within 6 years of adoption, prioritizing units presenting the greatest safety risk. Where retrofit is infeasible, manufacturers shall notify affected customers and the regulator, explain the limitation, and provide an alternative safety measure or operating guidance."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery systems shall include built-in fire suppression beginning no earlier than 36 months after adoption. The regulator shall establish performance and verification requirements and may approve equivalent protective measures where they provide comparable safety."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly notify the regulator and provide the incident and installed-unit data for review. The regulator shall assess the evidence, including incident severity, trends, and corrective actions, and determine whether a recall or other protective measures are warranted. Manufacturers shall promptly notify affected customers and regulators of any recall or other required safety action."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 1,
  "holistic_F_H": 1,
  "section_notes": "S1 is the strictest section: every known incident (overheating, smoke, fire, no damage needed) must reach the regulator within 24 hours, with 72-hour customer notice, no phase-in and no confirmed-cause or serious-only narrowing. S2 keeps the 55 °C / 5% benchmark and gives numeric per-model failure rates to purchasers (not the general public), but exceeding the benchmark only triggers corrective action, retesting and regulator review - there is no automatic sales stop, so it rates weakened on the code's sales-stop criterion. S3 (12-month new-unit deadline, 6-year feasible retrofit with alternative measures) and S4 (built-in suppression from 36 months, regulator-approved equivalents) sit inside the acceptable ranges, while S5 leaves recall discretionary: 8/100k only triggers regulator review, with no mandatory recall and only 'prompt' customer notice."
 },
