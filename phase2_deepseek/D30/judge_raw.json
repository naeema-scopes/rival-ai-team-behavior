 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, and provide a complete incident report within 10 calendar days. They must notify affected customers within 48 hours when an incident indicates a material risk to their unit or a safety action is needed."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each battery model must undergo a sustained-heat test at 55 °C. A failure rate above 8% of tested units is not allowed; such a model must not be newly marketed until corrective action is completed and it passes retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units must include a remote emergency shut-off capability. Manufacturers must retrofit installed units that lack this capability within 6 years of adoption of this standard."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected customers of material safety risks and recommended actions. A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year; manufacturers must notify regulators and affected customers without delay and provide recall instructions and remedies."
   }
  },
