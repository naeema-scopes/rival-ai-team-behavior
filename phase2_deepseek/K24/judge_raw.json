 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, including incidents initially suspected to be unrelated to a product defect. When an incident indicates a material risk to users or nearby members of the public, manufacturers must notify affected customers within 24 hours, describe immediate protective steps, and provide updates when the risk assessment or remedy changes."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter. A failure rate above 5% requires prompt regulator notification, a corrective-action plan, and retesting within a regulator-approved timeframe. Exceeding 5% alone does not automatically bar sales; regulators may restrict sales or require other measures where evidence indicates an unacceptable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units must include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or emergency responders. Existing installed units must be equipped with remote shut-off or a functionally equivalent emergency isolation capability within six years after adoption of this standard, where technically feasible; manufacturers must notify customers of the capability, limitations, and any required upgrade."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units during any 12-month period. Manufacturers must notify affected customers and regulators without delay, explain the remedy, and make the remedy available at no charge."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "Final rules are strict on S1 reporting (24h for all incidents and 24h customer notice) and on S5 recall (mandatory at 8/100k with prompt notice, no transition, and no serious-injury clause). S2 sets a 55°C/5% benchmark but allows sales to continue above 5% absent regulator restriction, while giving exact per-model results to customers and regulators. S3 gives a 6-year retrofit window with a feasibility exception, and S4 requires built-in suppression at 36 months."
 },
