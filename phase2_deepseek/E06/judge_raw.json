 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, smoke, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, followed by a written incident report within 10 business days. They must notify affected customers within 5 business days when an incident indicates a material safety risk, and promptly provide any immediate protective instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5%. A model exceeding 5% must promptly undergo corrective action and retesting under regulator oversight. Exceeding the limit alone does not require stopping new sales: the regulator must assess demonstrated safety risk and may approve a time-limited corrective-action plan and impose proportionate interim restrictions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed units must support secure remote emergency shut-off, with clear customer instructions and safeguards against unauthorized activation. Manufacturers must provide a retrofit pathway for units already installed and complete retrofits within 6 years of this section taking effect. Where a retrofit is not technically feasible, the manufacturer must notify the owner and regulator, provide appropriate risk-reduction instructions, and offer a practical remedy."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression designed to limit fire propagation and protect occupants and neighbouring properties. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a regulator-supervised recall when a model exceeds 8 thermal incidents per 100,000 installed units in any year. The manufacturer must report the trigger and proposed recall actions to the regulator without delay and notify affected customers within 5 business days."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
