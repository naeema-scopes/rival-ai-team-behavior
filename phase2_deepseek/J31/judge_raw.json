 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any thermal incident involving fire, smoke, uncontrolled overheating, injury, property damage, or emergency-service response within 24 hours of becoming aware of it, with a preliminary incident report within 5 business days and a final investigation report within 30 days. They shall notify affected customers within 5 business days when an incident indicates a material safety risk to their model or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "regulators_only",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C before market entry and at least annually thereafter, using a regulator-approved protocol and statistically representative units. A result above 5% requires prompt regulator notification, corrective action, and remediation and retesting within 90 days. No model may enter or remain on the market if its 55 °C test failure rate exceeds 8%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models placed on the market beginning three years after adoption shall support remote emergency shut-off, with safeguards against unauthorized activation and clear customer notification. Manufacturers shall retrofit already-installed units where technically and safely feasible, completing retrofits within six years of adoption. Where a retrofit is not feasible, manufacturers shall provide affected customers with an alternative safety measure and instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New models placed on the market beginning three years after adoption shall include built-in fire suppression appropriate to the battery chemistry and system design, validated under a regulator-approved protocol. Regulators may grant a time-limited, model-specific exemption where the manufacturer demonstrates that an alternative measure provides equivalent or better protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When available data indicate that a model may exceed 8 thermal incidents per 100,000 installed units in a rolling 12-month period, the manufacturer shall notify the regulator within 5 business days and provide the incident count, installed-unit denominator, and known reporting gaps. A verified rate above 8 per 100,000 requires the regulator to determine promptly whether a recall or other protective action is necessary, considering incident severity, trend, underreporting, and feasible risk controls. Regulators may order a recall or other protective action at any rate where the evidence warrants it."
   }
  },
