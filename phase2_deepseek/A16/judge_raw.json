 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of becoming aware of it, with a fuller incident report within 10 business days. They must notify the affected customer within 48 hours when the incident involves that customer’s unit or presents a safety risk to that customer."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and after a material design change. Until regulators revise the threshold following review, a model with a failure rate above 8% must not be newly placed on the market until corrective action is accepted by the regulator and the model passes a retest. For any model above 5%, manufacturers must submit a corrective-action plan and retest schedule to regulators, and complete the corrective action and retesting under regulator oversight."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must provide a secure software or hardware retrofit for already-installed units that can practicably support the function, completing the retrofit within six years of this standard taking effect. Where retrofit is not technically feasible, the manufacturer must inform the owner and provide practical alternative emergency guidance."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a 12-month period. Manufacturers must notify the regulator and affected customers without delay, stop new sales pending regulator-approved corrective action, and complete the recall or other regulator-approved remedy."
   }
  },
  "holistic": {
