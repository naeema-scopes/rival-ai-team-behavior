 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of becoming aware of it, and provide a complete incident report within 10 calendar days. The manufacturer shall notify affected customers within 72 hours when an incident presents a material safety risk to their units or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55°C under a common regulator-approved protocol before sale and at least annually thereafter. Manufacturers shall submit exact per-model protocols and results to the relevant regulator and provide the exact failure rate and test date to customers considering purchase of that model. The maximum allowed failure rate is 5% for any model. A failure rate above 5% requires prompt regulator notification, a corrective-action plan, and retesting on a regulator-approved schedule. The regulator shall determine proportionate interim measures based on risk; an exceedance alone does not automatically require permanent market withdrawal."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models shall include a remote emergency shut-off capability. For units already installed, manufacturers shall provide the capability through retrofit or another regulator-approved equivalent within 6 years of adoption where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression, or a regulator-approved equivalent fire-mitigation system, beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": true,
    "quote": "A manufacturer shall initiate a regulator-supervised recall when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, or when the regulator determines a defect presents an imminent risk of serious injury or fire. The regulator shall determine risk-appropriate customer remedies, which may include repair, replacement, or refund; a recall under this section does not by itself require a permanent market ban. Manufacturers shall promptly notify affected customers of material newly identified hazards and provide updated safety instructions."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
