 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal injury to the relevant regulator within 5 business days of learning of it. Incidents involving fire, injury, evacuation, or emergency-service response must be reported within 24 hours. The manufacturer must notify affected owners within 5 business days, and promptly provide safety instructions; where an immediate hazard is suspected, notify owners without delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each battery model must undergo independent 55 °C sustained-heat testing under a regulator-approved protocol before sale and after a material design change. A failure rate above 5% requires prompt regulator notification and a regulator-approved corrective-action plan, with follow-up testing on a defined timetable; it does not by itself require an automatic sales ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must include a remote emergency shut-off capability that can be activated by the owner and, when necessary to address an imminent safety hazard, by the manufacturer or emergency responders under a documented procedure. Manufacturers must provide a secure software or hardware retrofit for installed units lacking this capability, completing the retrofit within 6 years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression for units manufactured 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must notify affected customers promptly of newly identified hazards and provide clear instructions for safe use, repair, or shutdown. A model must be recalled when its thermal incident rate exceeds 8 incidents per 100,000 installed units in any year; the manufacturer must promptly notify regulators and affected customers, stop new sales, and provide a timely repair, replacement, or refund plan."
   }
  },
