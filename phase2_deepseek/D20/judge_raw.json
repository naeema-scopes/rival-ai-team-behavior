 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the appropriate regulator within 24 hours of learning of it, with a complete incident report within 10 business days. Affected customers must be notified within 48 hours when an incident indicates a credible safety risk to their unit or requires an immediate safety action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and a representative sample before sale, at least annually, and after material design changes. A failure rate above 5% is an action threshold requiring a corrective-action plan and retesting on a regulator-set schedule; it is not, by itself, an automatic sales ban or market-access cutoff."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must include a remotely accessible emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer with prompt customer notification. Manufacturers must retrofit already-installed units to add this capability within six years of this standard’s effective date, where technically feasible, and provide customers a safe interim procedure until retrofit is complete."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after this standard’s adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 model-specific installed-unit exposure during a year. The denominator must reflect that model’s installed fleet at risk over the reporting year, using a documented, regulator-reviewable method; manufacturers must document incident counting and attribution."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
