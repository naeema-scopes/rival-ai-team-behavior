 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 2,
    "scope": "serious_only",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any death, serious injury, fire, thermal runaway, or other incident presenting a credible risk of fire or injury to the relevant regulator within 24 hours of learning of it, and provide a completed incident report within 10 calendar days. They must notify affected customers within 48 hours when an incident indicates a material safety risk, including immediate precautions and support contact information."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo an independently witnessed sustained-heat test at 55 °C before initial certification and at least once every three years thereafter, using a regulator-prescribed protocol and sample size. The maximum permitted failure rate is 5% from the effective date of this standard."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly certified home battery models must include a remote emergency shut-off capability that can be activated by the manufacturer or an authorized emergency responder when necessary to address an imminent risk of fire or injury. Manufacturers must retrofit installed units to provide remote emergency shut-off within six years after this standard takes effect, where technically feasible; any units not retrofitted must be disclosed to their owners and the relevant local fire authority."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured for sale must include built-in fire suppression meeting regulator-prescribed performance and reliability requirements, beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
