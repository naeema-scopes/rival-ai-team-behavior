 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, and provide a complete incident report within 10 business days. They must notify affected customers within 48 hours when an incident presents a potential safety risk, including known hazards and immediate precautions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 72,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market entry and at least annually thereafter, using a consistent, independently verifiable protocol. The maximum allowed failure rate is 5%. Models marketed before adoption must be allowed a six-year compliance period to meet the 5% limit, with interim milestones, monitoring, and risk-appropriate corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Existing installed units that lack remote shut-off must be upgraded or replaced within six years of adoption where technically feasible; manufacturers must notify affected owners of any limitations and available interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All newly manufactured home battery systems must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must notify affected customers and regulators when a model exceeds 8 thermal incidents per 100,000 installed units in any year. Exceeding that rate triggers a mandatory recall of the affected model; manufacturers must promptly stop sales, notify affected customers, and provide a repair, replacement, or refund plan, subject to regulator oversight."
   }
  },
