  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, property damage, or emergency shutdown to the relevant regulator within 24 hours of becoming aware of it. They must notify affected customers within 72 hours when an incident indicates a material safety risk or requires inspection, changed use, or corrective action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a common, regulator-approved protocol. A failure rate above 5% requires prompt regulator notification, a risk assessment, and a corrective-action plan with milestones."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Manufacturers must make the capability available on all new units within 12 months of adoption. For units already installed, manufacturers must provide a retrofit or equivalent safe mitigation plan and complete implementation within 72 months, prioritizing units with elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression no sooner than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, the manufacturer must promptly notify regulators and affected customers and submit a risk assessment and proposed corrective-action plan. Regulators must determine whether a recall or other interim protective measures are warranted based on the verified rate, severity and circumstances of incidents, and effectiveness of available remedies."
   }
  },
