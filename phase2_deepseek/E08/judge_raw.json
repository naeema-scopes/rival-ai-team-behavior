 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery-related overheating, thermal event, fire, thermal runaway, or injury to the relevant regulator within 24 hours of becoming aware of it, and provide a completed incident report within 10 business days. Customers whose unit is involved must be notified promptly and receive safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and at least annually thereafter. The maximum permitted failure rate is 5% of tested units. A model exceeding that rate must be reported to the regulator and subjected to a corrective-action plan and retesting; exceeding the limit alone does not automatically require market withdrawal. Per-model test results, sample sizes, and corrective actions must be provided to regulators and disclosed to customers considering or owning that model, in clear and accessible form."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must support secure remote emergency shut-off. Manufacturers must provide a retrofit path for installed units that do not support the feature, with retrofit completion required no earlier than six years after this standard takes effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model’s verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any year, the manufacturer must promptly notify affected customers and carry out a regulator-supervised recall, providing an appropriate repair, replacement, refund, or other effective remedy. Regulators may require interim protective measures while the risk and remedy are assessed."
   }
  },
