  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Incidents involving fire, injury, evacuation, or property damage must be reported within 24 hours of discovery; other thermal incidents must be reported within five business days. Affected customers must be notified within 48 hours for urgent incidents and within five business days for other reportable incidents."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol. A failure rate above 5% requires a regulator-reviewed corrective-action plan and retesting; it does not by itself prohibit sale or require withdrawal."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units must include a remote emergency shut-off capability no later than 12 months after adoption. Manufacturers must retrofit installed units that lack this capability within six years after adoption, where technically feasible, and must notify affected customers of the capability and how to use it."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": 8,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the relevant regulator and provide the underlying incident-rate data and a corrective-action plan. The regulator must review the evidence and determine whether a recall is required, taking account of the severity and circumstances of incidents, data quality, and the effectiveness of corrective actions."
   }
  },
