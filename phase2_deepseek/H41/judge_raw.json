 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, property damage, or emergency-service response to the regulator within 24 hours of learning of it, with a preliminary account and known impacts. Other confirmed thermal incidents must be reported within 5 business days. Manufacturers must notify affected customers within 24 hours when an incident presents an immediate safety risk, and otherwise within 5 business days of confirming a relevant product hazard."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 24,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5% for any model. For a model above 5%, the manufacturer must promptly submit a corrective-action plan and complete corrective action and compliant retesting within 24 months. During that period, the regulator may require interim protections or restrict sales where needed to address a serious hazard. After 24 months, a model still above 5% may not be newly sold until compliant retesting demonstrates a rate of 5% or less."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units must include a remotely accessible emergency shut-off capability no later than 12 months after adoption. Manufacturers must provide a safe retrofit or equivalent shut-off capability for installed units within 6 years after adoption, prioritizing units with known safety concerns."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
