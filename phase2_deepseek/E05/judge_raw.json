 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any fire, thermal runaway, or overheating event that causes injury, property damage, evacuation, or emergency-service response within 24 hours of learning of it. Other confirmed thermal incidents must be reported within 10 business days. Manufacturers must notify the affected customer within 24 hours for events involving injury, fire, evacuation, or an immediate safety risk, and within 10 business days for other confirmed thermal incidents."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A model with a failure rate above 5% must promptly implement corrective action and retest. A model may not be sold if its failure rate exceeds 7%; sales may resume after a retest demonstrates a rate at or below 7%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market must include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent hazard, by the manufacturer or emergency responders under regulator-approved safeguards. For units already installed, manufacturers must provide a retrofit or equivalent compliant upgrade within six years of this standard taking effect; where a retrofit is infeasible, the regulator may approve an alternative safety measure."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after this standard takes effect. Regulators may approve an equivalent protective measure where built-in suppression is technically infeasible, provided the measure offers comparable protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 14,
    "serious_injury_recall": null,
    "quote": "If a model’s verified rate exceeds 8 incidents per 100,000 installed units in any rolling 12-month period, the manufacturer must promptly notify regulators and affected customers, investigate, and initiate a recall. Manufacturers must provide customers clear safety notices for confirmed thermal incidents involving their unit, including known hazards, immediate precautions, and contact information, within the timelines in S1."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
