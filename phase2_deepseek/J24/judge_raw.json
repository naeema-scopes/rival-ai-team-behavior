 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of learning of it, and provide affected customers with a safety notice within 48 hours. Other overheating incidents requiring repair or causing a unit to shut down shall be reported to the regulator within 30 days and summarized to affected customers within 30 days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a standardized sustained-heat test at 55 °C using a regulator-approved protocol and representative sample. Manufacturers shall submit each model's numerical failure rate and supporting results to the relevant regulator, and shall provide the numerical per-model failure rate and relevant safety information to customers considering or owning that model. A failure rate above 5% triggers regulator notification, a corrective-action plan, and retesting within 12 months; it does not by itself prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units manufactured 12 months or more after adoption of this standard shall support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers shall provide a retrofit plan for installed units and complete retrofit or an equivalent regulator-approved safety measure within six years of adoption. Regulators may approve technically equivalent measures where remote shut-off is infeasible."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured 36 months or more after adoption of this standard shall include built-in fire suppression meeting a regulator-approved performance test. Regulators shall publish the test method and may approve equivalent suppression technologies that provide comparable protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "bounded",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "If a model's verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any rolling 12-month period, the manufacturer shall notify the regulator and affected customers within 48 hours and submit the supporting data and proposed corrective actions for expedited review. The manufacturer shall initiate a recall of that model; the regulator may approve an equally protective immediate measure instead where it finds that measure adequately protects customers and the public."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
