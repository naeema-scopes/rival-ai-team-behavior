 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, smoke, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of learning of it. Other confirmed thermal incidents shall be reported within 5 business days. ... Manufacturers shall notify affected customers within 72 hours after learning of an incident presenting a credible safety risk, and otherwise within 10 business days, with known hazards and immediate safety steps."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 36,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55°C using a jointly agreed, representative protocol and adequate sample size. The failure rate shall not exceed 5% of tested units. ... For models already in production when this standard is adopted that exceed the limit, manufacturers shall notify the regulator promptly, submit a corrective-action plan within 90 days, and achieve compliance through retesting within 36 months of adoption."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units manufactured 24 months after adoption of this standard shall include remote emergency shut-off accessible to the manufacturer and, where feasible, the customer. Manufacturers shall provide a safe software or hardware retrofit for installed units within 6 years after adoption, prioritizing units with known safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months after adoption of this standard shall include built-in fire suppression or an independently verified equivalent fire-mitigation system."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer shall initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, calculated using that model’s installed-unit count, or when the regulator determines that a defect presents an imminent or otherwise unacceptable risk. ... Manufacturers shall promptly notify affected customers of material new hazards, incidents indicating a credible safety risk, and corrective actions, using direct notice where reasonably practicable."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S1 requires strong incident reporting (24h serious, 5 business days other) with customer notice, but only confirmed other incidents. S2 sets a 5% 55°C failure cap with a 36-month transition for existing models, no interim numeric cap, and confidential per-model results to purchasers/regulators. S3 requires new-unit shut-off at 24 months and a 6-year retrofit; S4 requires built-in suppression or validated equivalent within 36 months; S5 mandates recall at 8/100k with prompt notices and no serious-injury clause."
 },
