 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 24 hours of confirmation, including incidents initially reported by customers or service providers. Within 72 hours, manufacturers must notify affected customers whose units or model may be implicated, provide known safety precautions, and explain how to report further incidents."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and a representative sample, with retesting after a material design or manufacturing change and at least every three years. A model with a failure rate above 5% must have a regulator-approved corrective-action plan and retest schedule; exceeding this level alone does not automatically prohibit sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required for all new units installed 12 months after adoption. Manufacturers must retrofit or otherwise enable remote shut-off for existing units within six years after adoption where technically feasible, and must provide customers with clear instructions for using it."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured for installation must include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers must document the suppression system’s design, maintenance requirements, and performance evidence and provide this information to the relevant regulator."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "bounded",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when a model exceeds 10 thermal incidents per 100,000 installed units in a year, or when the regulator determines that a defect presents an imminent risk of serious injury or fire. Manufacturers must promptly provide affected customers with a safety notice when a regulator identifies a material model-specific risk, when the model exceeds 8 thermal incidents per 100,000 installed units in a year, or when a safety notice is otherwise required under S1."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
