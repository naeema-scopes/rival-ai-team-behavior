 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, property damage, or emergency shut-off to the relevant regulator within 24 hours of learning of it, with a preliminary account and known impacts. Other thermal incidents must be reported within 5 business days. Affected customers must be notified directly within 24 hours for an incident presenting an imminent safety risk, and within 5 business days for other reportable incidents."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol, with a statistically adequate sample and results reported at least annually. The maximum permitted failure rate is 5% per model. A model exceeding that limit must be reported to the regulator within 30 days with a corrective-action plan and retested within 12 months."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 18,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery models must include remote emergency shut-off capability for units manufactured 18 months after adoption of this standard. For units already installed, manufacturers must offer and complete a compatible retrofit, or an equivalent regulator-approved safety measure, within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on new home battery units manufactured 3 years after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 1,
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year; the manufacturer must notify the regulator and affected customers within 24 hours of confirming the threshold is exceeded and promptly implement the regulator-approved recall."
   }
  },
