 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving a covered unit to the relevant regulator within 24 hours of confirmation, including incidents involving overheating, fire, injury, or property damage. Manufacturers must notify the affected customer within 24 hours of confirmation and provide known hazards and protective actions; if the customer cannot be identified promptly, notice must be sent as soon as practicable."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a documented, regulator-approved protocol and representative sample. The failure rate must not exceed 8% of tested units."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units must support a secure remote emergency shut-off function. For units already installed when this standard takes effect, manufacturers must provide the function by retrofit or an equivalent safe upgrade within six years, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption of this standard. Regulators may approve an equivalent protective design where evidence demonstrates comparable or greater fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 1,
    "serious_injury_recall": null,
    "quote": "Manufacturers must notify affected customers within 24 hours of confirming a thermal incident involving their unit, and promptly notify them of any other material safety risk and recommended protective actions. A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in a rolling year, calculated using a consistent, regulator-approved method, or when the regulator determines an imminent serious risk warrants recall."
   }
  },
