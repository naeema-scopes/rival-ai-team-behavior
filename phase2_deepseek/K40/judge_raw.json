 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every known thermal incident involving overheating, smoke, fire, or thermal runaway to the appropriate regulator within 24 hours of becoming aware of it. Manufacturers must notify the affected customer within 72 hours of becoming aware of an incident involving that customer’s unit, with safety instructions and a contact for follow-up."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a documented sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-recognized protocol and a representative sample. A model’s measured failure rate must not exceed 7%; a model above that limit may not be newly sold until it passes a subsequent test and the regulator has reviewed its corrective-action plan. Manufacturers must report each model’s failure rate, sample size, protocol, and test date to the appropriate regulator and make those per-model results available to customers purchasing that model."
   },
   "S3_remote_shutoff": {
