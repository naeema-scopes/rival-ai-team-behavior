  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 business days. Manufacturers shall notify affected customers within 48 hours when an incident indicates a potential product safety risk, and promptly provide safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved, representative sampling and test protocol. A failure rate above 5% is an intervention threshold, not a permitted-maximum or pass/fail limit."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Newly installed systems shall support a secure remote emergency shut-off, with safeguards against unauthorized activation and a local means of operation. For systems already installed when this requirement takes effect, manufacturers shall provide compliant retrofit capability or an equivalent regulator-approved safety measure within six years."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer shall initiate a mandatory recall when any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period. The recall shall be implemented through an effective regulator-approved corrective action; the trigger alone does not automatically prohibit further sales or require market withdrawal, without limiting regulators’ authority to impose additional safeguards for an imminent serious safety risk."
   }
