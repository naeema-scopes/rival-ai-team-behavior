 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving fire, smoke, thermal runaway, injury, property damage, or emergency-service response within 24 hours of learning of it, with a fuller report within 10 calendar days. Other confirmed thermal incidents and material safety defects must be reported within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55°C before market entry and at least annually thereafter, using a regulator-approved protocol. A failure rate above 5% requires the manufacturer to submit a corrective-action plan and retest schedule to the regulator within 30 days."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market 24 months after adoption must support a secure remote emergency shut-off capability, with safeguards against unauthorized activation and a clear customer override or restoration process where safe. For installed units, manufacturers must provide the capability through a retrofit or compatible replacement within 72 months after adoption where technically feasible; where infeasible, they must notify customers and regulators, explain the limitation, and provide an equivalent risk-mitigation plan."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption must include built-in fire suppression validated for the battery chemistry and enclosure, or an alternative built-in measure demonstrated through regulator-approved testing to provide equivalent mitigation of fire propagation."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When the regulator verifies that a model exceeds 8 thermal incidents per 100,000 installed units in a rolling year, a mandatory recall is triggered; uncertainty or data-quality review must not waive a verified exceedance. Manufacturers must promptly provide the regulator a recall plan and take any interim risk-reduction measures directed by the regulator; affected customers must be notified without delay."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
