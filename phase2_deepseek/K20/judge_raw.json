 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. They shall notify the affected customer within 24 hours when the incident involves that customer’s unit, and promptly provide any safety precautions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A failure rate above 5% shall trigger regulator-supervised safety review, corrective action, and retesting; it shall not by itself prohibit sale. Results shall be provided to customers considering or owning that model, but shall not be published for the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units shall support secure remote emergency shut-off. Manufacturers shall provide a retrofit plan for installed units and complete retrofits within six years of this standard taking effect, prioritizing units with elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers shall promptly notify affected customers of material safety risks, incident trends, and required precautions, and shall update notices when material facts change. If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly notify the regulator and affected customers and initiate a recall."
   }
  },
