 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, or fire to the relevant regulator within 24 hours of becoming aware of it, including incidents for which the cause is not yet known. Manufacturers must notify affected owners within 48 hours when an incident indicates a credible safety risk or requires immediate precautions; otherwise, they must provide an incident-related safety notice within 30 days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C under a common, regulator-approved protocol. Manufacturers must provide regulators the complete per-model results, including sample size and numerical failure rate, and provide those same complete results directly to customers considering or owning that model. Individual-company per-model failure rates need not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New battery systems placed on the market from 24 months after this standard takes effect must support secure remote emergency shut-off, with safeguards against unauthorized activation. For units installed before that date, manufacturers must provide a compatible retrofit or an equivalent safe alternative within 6 years of the standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery systems placed on the market from 36 months after this standard takes effect must include built-in fire suppression designed to limit the spread of a thermal event."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected customers of safety risks, required precautions, and corrective actions, and must provide an annual safety notice describing relevant incidents and available safety updates. When a model’s verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and provide supporting data; the regulator must assess the evidence, incident severity, uncertainty, and available corrective measures and may require a recall or other protective action."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": 1,
  "section_notes": "S1 is strict: all thermal incidents are reported to regulators within 24 hours, with customer notices within 48 hours for credible risks. S2 requires a 55 °C test and gives complete numerical results to customers and regulators but not to the public, and it imposes no fixed failure-rate cap, leaving market restrictions to regulator discretion. S3 delays new-unit shut-off to 24 months and allows 6 years for retrofit; S4 requires built-in suppression from 36 months; S5 sets an 8/100k trigger for regulator review but recall remains discretionary, and customer notices are only 'promptly'."
 },
