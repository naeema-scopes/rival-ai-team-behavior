 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the regulator any thermal event involving fire, smoke, uncontrolled overheating, injury, or material property damage within 24 hours of learning of it. Manufacturers must notify affected customers of a hazard or protective action without delay and no later than 24 hours after notifying the regulator."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol, with a statistically adequate sample. A result above 5% failure triggers a regulator review and a manufacturer risk assessment; exceeding 5% alone does not automatically prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models placed on the market after adoption must support remote emergency shut-off, with safeguards against unauthorized activation and a locally accessible means of shutdown. Manufacturers must provide secure remote-shutoff capability for existing installed units where technically feasible within six years after adoption, prioritizing models with elevated safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no earlier than 36 months after adoption of this standard. The regulator may approve equivalent built-in mitigation measures that provide comparable protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in that period, or when the regulator determines that a serious defect presents an imminent risk. Manufacturers must notify the regulator and affected customers without delay and provide the recall remedy and instructions."
   }
  },
