 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "serious_only",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any death, serious injury, fire, or thermal runaway involving a home battery to the relevant regulator within 24 hours of becoming aware of it, with a preliminary incident report within 5 business days and a complete investigation report within 30 days. Other thermal incidents presenting a credible fire or injury risk must be reported to the regulator within 5 business days. Manufacturers must promptly notify affected customers when an incident indicates a material safety risk, and in any event within 5 business days of confirming that risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market entry and at least annually thereafter, using a regulator-accepted protocol and a representative sample. The maximum permitted failure rate is 7% of tested units per model. Customers considering or purchasing a model must receive that model’s numerical result, sample size, compliance status, material safety risks, and relevant corrective actions; these results need not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units must include a secure remote emergency shut-off capability no later than 24 months after this standard takes effect, with a safe local means of operation retained. For units already installed, manufacturers must provide a retrofit or equivalent upgrade within 6 years of the effective date where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": true,
    "quote": "A manufacturer must initiate a regulator-supervised recall of any model when its verified thermal-incident rate exceeds 8 incidents per 100,000 installed units for that model in a year. Manufacturers must provide customers clear safety notices promptly upon confirming a material safety risk... A recall is also required when the regulator determines that a serious safety defect presents an unreasonable risk, regardless of the rate."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
