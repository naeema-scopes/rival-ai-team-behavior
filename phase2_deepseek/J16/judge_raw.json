 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 2,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, property damage, evacuation, or emergency-service response to the relevant regulator within 24 hours of becoming aware of it, with a detailed report within 10 business days. Other confirmed thermal incidents must be reported within 10 business days. Manufacturers must notify affected customers within 48 hours when an incident presents an immediate safety risk, and otherwise within 10 business days of determining that customer action is warranted."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a standardized 55 °C sustained-heat test before market launch and at least annually thereafter. Customers purchasing a model must receive its numerical per-model failure rate directly and privately, along with clear, actionable safety information; numerical results must not be publicly disclosed. The maximum permitted failure rate is 8% for any model. A model exceeding the limit must undergo prompt investigation and corrective action, with regulator-approved retesting; regulators may impose proportionate sales restrictions based on demonstrated risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models introduced 3 years after adoption of this standard must include remote emergency shut-off. For units installed before that date, manufacturers must provide a retrofit pathway and complete required retrofits within 6 years of adoption, prioritizing units with known safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured for sale must include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers must provide regulators with evidence that the suppression system is effective and does not introduce other material safety risks."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period, manufacturers must promptly notify regulators and affected customers and initiate a mandatory recall of that model. Manufacturers must provide incident data and a corrective-action plan and cooperate with expedited regulator oversight."
   }
  },
