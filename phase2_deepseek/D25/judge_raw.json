 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a detailed follow-up within 10 business days. They must notify affected customers within 72 hours when an incident indicates a credible safety risk, and promptly provide safety instructions and updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and statistically adequate sample. A model exceeding the 5% failure-rate benchmark must submit a corrective-action plan and undergo retesting; regulators may restrict marketing or installation if the manufacturer fails to mitigate the risk or evidence indicates serious or imminent danger."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support secure remote emergency shut-off, with safeguards against unauthorized access and clear customer instructions. Manufacturers must retrofit already-installed units to provide this capability within six years of the standard’s effective date, prioritizing units subject to safety alerts or elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after the standard’s adoption. The suppression system must be suitable for the battery chemistry and installation environment, and manufacturers must provide maintenance and replacement instructions to customers."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must notify the regulator and affected customers promptly upon determining that the trigger is exceeded, provide a corrective-action and recall plan, and report completion progress."
   }
  },
