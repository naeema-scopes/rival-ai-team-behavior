 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal injury to the relevant regulator within 24 hours of learning of it, with a written incident report and available preliminary facts within 5 business days. They must notify affected customers within 48 hours when an incident presents a potential safety risk to their model or installation, and provide updates as material facts become available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A failure rate above 5% requires regulator review, a documented corrective-action plan, and retesting on a regulator-set schedule."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems must include a remote emergency shut-off capability that can be activated by the customer and, where an imminent hazard warrants it, by the manufacturer or emergency responders under documented safeguards. Existing installed units must be brought into compliance, where technically feasible, within 6 years of adoption; if retrofitting is infeasible, the manufacturer must provide an equivalent documented emergency-safety plan and notify the affected customer."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression beginning 36 months after adoption of this standard. Regulators may approve an equivalent or alternative protective design where evidence demonstrates comparable or better fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A model with a verified rate exceeding 8 thermal incidents per 100,000 installed units in any 12-month period must be recalled. Pending verification and implementation of a recall, regulators may require interim protective measures; manufacturers must promptly notify affected customers and provide necessary safety instructions."
   }
  },
