   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, or thermal injury to the relevant regulator within 5 calendar days of becoming aware of it. Incidents involving fire, injury, evacuation, or an immediate continuing hazard shall be reported within 24 hours. Manufacturers shall notify affected owners within 5 calendar days, and within 24 hours when immediate protective action is warranted."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and after a material design change. Before purchase, customers shall receive the model’s test protocol, pass/fail result, and measured failure rate. A model exceeding a 5% failure rate shall trigger regulator notification, a documented corrective-action plan, and retesting within a regulator-set period based on risk; the regulator may restrict sales or require other measures if the risk warrants it."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New battery systems placed on the market 24 months after adoption shall support a secure remote emergency shut-off capability... For already-installed units, manufacturers shall provide compatible remote shut-off capability, where technically feasible, within 6 years after adoption... Units not practically retrofittable shall receive an equivalent documented safety measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery systems shall include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 5,
    "serious_injury_recall": null,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly report the rate and supporting incident data to the regulator, initiate a recall, and promptly notify affected customers with remedy instructions. The regulator may require additional proportionate corrective action."
   }
