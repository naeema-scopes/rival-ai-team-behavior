 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every confirmed thermal event involving overheating, smoke, fire, or thermal injury to the relevant regulator within 24 hours of confirmation, and provide a complete incident report within 10 business days. They shall notify affected customers within 48 hours when an incident indicates a credible product-specific safety risk or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "regulators_only",
    "public_publication": false,
    "quote": "Manufacturers shall submit per-model results and sample sizes to the regulator; these individual-company results shall not be publicly disclosed. A failure rate above 5% requires a corrective-action plan submitted to the regulator and follow-up testing within 12 months; it does not by itself require market withdrawal."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units shall support secure remote emergency shut-off by 24 months after adoption, with safeguards against unauthorized activation and a clear customer notification and manual override procedure. Manufacturers shall retrofit already-installed units to support remote shut-off within 6 years after adoption where technically feasible; where retrofitting is infeasible, they shall provide an equivalent documented risk-reduction measure and notify affected customers."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression no later than 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 2,
    "serious_injury_recall": null,
    "quote": "A manufacturer shall notify affected customers within 48 hours after identifying a credible product-specific safety risk requiring customer action. When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly notify regulators and affected customers. Regulators shall assess the evidence and may require corrective action, suspension, or recall, including a recall where warranted by the risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
