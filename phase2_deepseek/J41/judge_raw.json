 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. They must notify affected customers within 48 hours when an incident indicates a credible product-specific safety risk, and promptly provide any updated instructions or corrective action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": true,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a regulator-accepted sustained-heat test at 55 °C using a representative sample and a documented, reproducible protocol. New models must not exceed a 5% failure rate. A model already marketed when this standard takes effect that exceeds 5% may remain available under regulator-approved risk controls and enhanced incident monitoring while the regulator reviews its safety case."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Newly installed systems must support secure remote emergency shut-off by the date this standard takes effect, with a safe local shut-off available if communications fail. For already-installed systems, manufacturers must provide compatible remote shut-off capability or an equivalent safe corrective measure within six years of the effective date."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New models placed on the market 36 months or more after adoption of this standard must include built-in fire suppression, validated for the battery chemistry and enclosure. Regulators may approve an equivalent protective design where the manufacturer demonstrates an equal or greater reduction in fire risk."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model’s confirmed thermal-incident rate exceeds 8 incidents per 100,000 installed units in a year, the manufacturer must promptly report it to regulators and notify affected customers. Regulators must promptly review the evidence and may require interim protective measures while the rate or cause is verified. Following review, regulators must require a recall or other effective corrective remedy proportionate to the verified risk and the demonstrated effectiveness of alternatives."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
