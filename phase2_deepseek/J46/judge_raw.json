 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 72 hours of learning of it, with a complete incident report within 30 days. They must notify affected customers within 5 days when an incident indicates a material safety risk, and promptly provide safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter, using a representative sample and a common test protocol. The maximum permitted failure rate is 7% per model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must include remote emergency shut-off capability. Manufacturers must retrofit already-installed units to enable remote emergency shut-off within 6 years of this standard taking effect, prioritizing units with elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 48,
    "quote": "All new units must include built-in fire suppression beginning 48 months after this standard takes effect. The suppression system must be designed and tested to reduce the risk of fire propagation without creating additional hazards, and manufacturers must provide installation, maintenance, and safe-operation instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model’s verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any 12-month period, the manufacturer must promptly notify the regulator and submit the model for review. The regulator must assess the evidence and require proportionate protective action, which may include recall, safe shutdown, repair, replacement, or refund, with prompt notice and clear instructions to affected customers."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
