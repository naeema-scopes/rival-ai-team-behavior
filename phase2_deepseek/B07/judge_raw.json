 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving fire, injury, emergency-service response, or suspected battery failure to the relevant regulator within 24 hours of learning of it, and notify affected customers within 72 hours when the incident indicates a material safety risk. Other overheating or thermal-protection incidents shall be reported to regulators within five business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 3,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires a corrective-action plan and a passing retest within 90 days; the model may remain on sale during that period unless the regulator determines an immediate sales suspension is necessary. A model that fails to achieve a rate of 5% or less on retest may not be sold until it passes. Manufacturers shall provide the per-model result and material corrective-action information to customers who own or are offered that model; individual-company results shall not be published for the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed systems shall support remote emergency shut-off no later than 2 years after this standard takes effect. Existing installed systems shall be retrofitted or otherwise brought into compliance within 6 years, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured for sale shall include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in a year shall trigger regulator review, customer notice, and a manufacturer corrective-action and mitigation plan. Regulators shall assess the evidence and may require a recall where a serious risk cannot be adequately controlled; a recall is mandatory when the regulator determines continued use presents an unacceptable risk or required corrective action has failed."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
