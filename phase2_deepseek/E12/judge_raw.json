 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of becoming aware of it, with a follow-up report containing known cause and corrective actions within 10 business days. The manufacturer must notify the affected customer within 24 hours where the incident involves an immediate safety risk, and otherwise within 5 business days. Reports must include all known incidents; manufacturers must not omit incidents because the cause is still under investigation."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a consistent regulator-approved protocol. The maximum failure rate is 5%. Manufacturers must submit exact per-model results to the relevant regulator before sale and after material design changes or required retesting. Before purchase, prospective purchasers must be given the model’s exact per-model failure rate and test results, pass/fail status, and a plain-language safety summary explaining material risks and protective steps. Existing owners must be given access to the exact per-model failure rate and test results, pass/fail status, and safety summary. These model-specific results must be provided directly to prospective purchasers and existing owners and need not be disclosed to the general public. A model exceeding the 5% maximum must be reported promptly to the regulator and undergo corrective action and retesting. The regulator shall determine proportionate interim measures, including any sales restriction, based on the results and associated risk. Results must be retained and made available to the regulator on request."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units must support remote emergency shut-off beginning 12 months after adoption of this standard. Manufacturers must retrofit installed units to support remote emergency shut-off within six years after adoption, where technically feasible; any units not retrofitted must be clearly identified to their owners, who must receive emergency shut-off instructions and available alternatives. Shut-off capability must be tested at installation and at regular maintenance intervals. Remote shut-off must be used only for an emergency or safety-related response, with prompt notice to the affected customer when practicable."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers must document compliance and provide the documentation to the relevant regulator before sale."
   },
