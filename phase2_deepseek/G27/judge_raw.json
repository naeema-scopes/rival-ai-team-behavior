 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the responsible regulator within 24 hours of learning of it, with a complete incident report within 10 calendar days. They shall notify affected customers within 72 hours when an incident indicates a potential safety hazard, and promptly provide any updated instructions or warnings."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 6,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units; the maximum allowed failure rate is 5% for any model. If a model exceeds the limit, the manufacturer shall submit a corrective-action plan within 30 days and complete retesting within 180 days, during which sales may continue unless the regulator determines that continued sale presents an imminent safety risk, and a model that fails the retest shall not be newly sold until it passes; per-model failure rates and test results shall not be published to the general public, but current and prospective customers for a model shall receive that model’s failure rate and material safety information, with precautions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Each newly manufactured home battery system shall include a remotely accessible emergency shut-off function that can isolate the battery from charging and discharging while preserving functions needed for safe monitoring. For systems already installed when this standard is adopted, manufacturers shall provide a feasible retrofit or equivalent safe isolation method within 6 years, where technically practicable, and inform owners of units that cannot be upgraded."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems manufactured 36 months or more after adoption of this standard shall include built-in fire suppression designed and validated to limit fire propagation and protect occupants and neighbouring properties."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly submit supporting incident and installed-unit data to the responsible regulator. Exceeding this threshold triggers a mandatory, regulator-overseen recall of that model. The recall shall promptly provide an effective remedy, which may include repair, replacement, return, or safe-use restrictions, as appropriate to the hazard; it does not by itself require delisting if the regulator determines an effective remedy protects households and neighbours. Manufacturers shall promptly carry out the recall and notify affected customers with instructions for safe use, shutdown, return, repair, or replacement."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
