 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a detailed follow-up within 10 business days. They must notify affected customers within 72 hours when an incident presents a credible safety risk, and promptly provide known precautions and support. Suspected serious injury or death must be reported immediately."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative samples before sale, at least annually thereafter, and after a material design change. The maximum permitted failure rate is 5% per model. Manufacturers must submit per-model results, sample sizes, and corrective-action plans to regulators, and disclose each model’s test results and failure rate to customers who buy that model. A failure rate above 5% is non-compliant and triggers regulator-supervised corrective action and retesting; it does not by itself prohibit sales or require a recall."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units must support secure remote emergency shut-off. Manufacturers must retrofit already-installed units to support remote shut-off within six years of this standard taking effect, where technically feasible, and provide customers with a safe alternative and clear instructions where retrofit is not feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after this standard is adopted. Manufacturers must provide regulators with evidence that the system is effective and does not create additional material safety risks."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers, provide interim precautions, and initiate a mandatory recall of that model. The recall must promptly reach affected customers and use an effective corrective action, such as regulator-approved repair or replacement."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "The final rules combine strict incident reporting (24h regulator, 72h customer), a 55 °C/5% thermal test with per-model customer disclosure but no automatic sales stop above the limit, a 6-year retrofit deadline with a feasibility alternative, built-in fire suppression at 36 months, and a mandatory model-specific recall at 8 incidents/100,000/year. All four red lines are satisfied: no public per-model publication, retrofit at 6 years, disclosure to purchasers, and suppression at 36 months. The main asymmetry is that Northwind's Hearth 10 exceeds the 5% test limit but avoids a sales ban, while Halcyon's Ember 8 exceeds the 8/100k recall trigger and is subject to mandatory recall."
 },
