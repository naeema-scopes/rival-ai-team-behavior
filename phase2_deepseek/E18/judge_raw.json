 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a full incident report within 10 business days. They must notify affected customers within 72 hours when the incident presents a credible safety risk, and promptly provide safety instructions and material updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers prompt regulator notification, independent confirmatory testing, and a corrective-action plan on a regulator-set timeline; it is not, by itself, an automatic sales ban. Manufacturers must provide per-model results, sample sizes, and methods to the regulator and make them available to customers who purchase or own that model; public publication is not required."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units must support remote emergency shut-off. Manufacturers must retrofit installed units that do not support this function within 6 years of adoption, prioritizing units with elevated risk and providing a documented retrofit schedule."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption. The suppression system must be appropriate to the battery chemistry and installation, independently validated, and maintained according to the manufacturer's instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a model’s thermal-incident rate exceeds 8 per 100,000 installed units during any 12-month period, the manufacturer must promptly notify the regulator and provide supporting data and methodology; a confirmed exceedance does not, by itself, automatically trigger a recall, but the regulator must order a recall when its review finds the model presents an unacceptable safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
