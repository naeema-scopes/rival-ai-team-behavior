 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 120,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every fire, thermal runaway, or other incident involving overheating to the relevant regulator within 5 business days of learning of it, whether or not it caused injury, property damage, evacuation, or emergency-service response. A fatality or incident presenting an ongoing serious hazard must be reported within 24 hours. Manufacturers must notify affected owners within 5 business days when an incident indicates a material safety risk to their model, and provide any regulator-required follow-up information promptly."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market entry and at least annually thereafter, using a regulator-approved protocol and representative sample. The maximum permitted failure rate is 8% per model. A model exceeding the limit must submit a corrective-action plan to the regulator within 60 days and pass a retest within 12 months."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery models placed on the market after 24 months from adoption must support secure remote emergency shut-off, with safeguards against unauthorized access and clear customer instructions. For units already installed on the adoption date, manufacturers must offer compatible upgrades or replacements and complete the retrofit program within 6 years, prioritizing units subject to safety alerts or located in higher-risk settings. Where a retrofit is not technically feasible, the manufacturer must provide an equivalent safety measure or replacement."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units placed on the market 36 months or more after adoption must include built-in fire suppression designed to limit fire propagation, validated through a regulator-approved test protocol, and maintained according to the manufacturer’s instructions. Any claimed exemption must be supported by evidence of an equally effective built-in fire-mitigation measure and approved by the regulator."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When a verified model-specific rate exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly refer the matter to the regulator for review, including data quality and statistical uncertainty, and implement any interim protections required. A regulator-supervised recall is mandatory when a verified rate exceeds 10 per 100,000 in a year or the regulator determines that the model presents an unacceptable safety risk. The recall plan must specify customer notification, safe shutdown or other interim protections, and repair, replacement, or refund."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
