 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, and provide a follow-up report with known cause and corrective actions within 30 days. The manufacturer must notify the affected customer within 24 hours when the incident presents an ongoing safety risk, and otherwise within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-accepted protocol, with sample size, test conditions, failures, and failure rate recorded. A model with a failure rate above 5% may remain on the market only with regulator authorization, subject to those safeguards and retesting at intervals set by the regulator."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery systems must support a secure remote emergency shut-off capability that can be activated by the manufacturer or an authorized emergency responder when continued operation presents an imminent safety risk. Manufacturers must retrofit installed units with this capability within 6 years of adoption, where technically feasible; for units that cannot be retrofitted, they must provide an equally effective mitigation or replacement at no cost to the customer."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery systems manufactured 36 months or more after adoption must include built-in fire suppression designed and validated to reduce the risk of fire spread."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a recall when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, or when regulators determine that a defect presents an equivalent serious risk. The manufacturer must notify regulators and affected customers without undue delay, explain the hazard and remedy, and provide the remedy at no cost."
   }
  },
