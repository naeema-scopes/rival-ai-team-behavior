    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55°C before sale and at least annually thereafter, using a regulator-approved protocol and statistically adequate sample. A model’s failure rate must not exceed 8%. Any result above 8% requires prompt submission of a corrective-action plan to the regulator and retesting within 6 months; regulators may restrict sales if the model remains above 8%. Customers considering or purchasing a model must receive its numerical failure rate, test outcome, any applicable corrective-action plan, and any sales restriction."
   },
