 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal event involving fire, smoke, or uncontrolled overheating that causes injury, property damage, emergency-service response, or material risk to a person to the relevant regulator within 24 hours of learning of it, with a complete report within 10 business days. Other confirmed thermal events shall be reported within 30 days. Manufacturers shall notify affected customers within 5 business days of identifying a credible product-specific hazard, and promptly provide updates as the investigation proceeds."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-accepted protocol before market entry and at least annually thereafter, using a representative sample sized under that protocol. A failure rate above 5% shall trigger prompt regulator review of the test protocol, results, uncertainty, and model-specific risks. The manufacturer shall submit complete per-model results and a corrective-action proposal confidentially to the regulator, and provide the complete results to customers who own or are considering purchasing that model. Results need not be released publicly."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off shall be required on new units placed on the market beginning 24 months after this standard takes effect. For units already installed, manufacturers shall provide a technically feasible retrofit or equivalent mitigation plan within 6 years of the effective date, prioritizing units with elevated risk. Where retrofit is infeasible, the manufacturer shall notify affected customers and provide safe-use guidance."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after this standard takes effect. The suppression system shall be designed and validated under a regulator-accepted protocol for the hazards presented by the unit, and maintained in accordance with manufacturer instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer shall initiate a mandatory recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year. The manufacturer shall notify the regulator and affected customers without delay, explain the hazard and remedy, and provide the remedy at no cost."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
