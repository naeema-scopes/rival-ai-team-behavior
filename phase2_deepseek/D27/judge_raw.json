 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or suspected thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents involving injury, property damage, or potential risk to neighbours. Manufacturers must notify affected customers within 48 hours of learning that an incident indicates a potential safety risk to their unit or model, with immediate notice where continued use presents an imminent danger."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 8% for any model. Manufacturers must provide complete per-model test results to the relevant regulator and disclose the model’s failure rate to purchasers before sale; public reporting of individual-company per-model failure rates is not permitted, and public reporting must be aggregate-only."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must retrofit installed units that do not support this capability within 6 years after adoption, where technically feasible; if retrofit is not feasible, they must notify affected customers and provide an equally effective mitigation approved by the regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption. The requirement applies to units manufactured on or after that date, using a regulator-approved design and test protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when a model’s thermal-incident rate exceeds 8 incidents per 100,000 installed units in any 12-month period. Manufacturers must promptly notify the regulator and affected customers, stop sales, and implement a regulator-approved recall and remedy; notices must explain the risk, actions customers should take, and available repair, replacement, or refund."
   }
  },
