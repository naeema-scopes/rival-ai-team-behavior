 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery thermal incident involving fire, smoke, uncontrolled overheating, emergency intervention, injury, or property damage within 24 hours of learning of it. They must provide a completed incident report, including known circumstances and affected model and batch, within 10 calendar days, and promptly update it as material facts become known. Manufacturers must notify affected customers within 72 hours of learning of an incident that presents a potential safety risk to them, with interim protective instructions where appropriate."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before market entry, at least annually thereafter, and after a material design change. The maximum allowed failure rate is 5% of tested units per model. Manufacturers must submit test protocols, sample sizes, per-model failure rates, and corrective actions to the relevant regulator in confidence, and must provide the per-model numerical failure rate and test results to customers of that model in accessible form; those results need not be published publicly."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units must include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or emergency responders under documented safeguards. Existing installed units must be brought into compliance within 72 months of adoption where technically feasible; otherwise, the manufacturer must notify the owner and regulator, explain the limitation, and provide an equivalent risk-mitigation plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. The suppression system must be suitable for the battery chemistry and enclosure, and its performance must be validated under the applicable regulator-approved fire and thermal test protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model exceeds 8 incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator, provide supporting data and proposed corrective actions, and notify affected customers of the risk and protective instructions. The regulator must promptly verify the reported rate and assess incident severity, data quality, and the adequacy of corrective actions. Following verification, the regulator must promptly require a recall or other effective protective measures proportionate to the risk, and may require a recall or other protective measures below the threshold whenever warranted."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": -2,
  "holistic_F_H": 2,
  "section_notes": "S1 is strong, requiring 24-hour reporting of a broad set of incidents, 10-day detailed reports, and 72-hour customer notice. S2 sets a 5% failure cap at 55°C with numerical results to customers but not public, and allows a corrective-action period for existing models. S3 requires remote shut-off on new units and a 72-month retrofit with feasibility escape; S4 requires built-in suppression from 36 months. S5 sets an 8/100k trigger but leaves recall to regulator discretion (recall or other measures), which is the main weakened section."
 },
