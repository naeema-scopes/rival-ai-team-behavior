 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, fire, smoke, or injury to the relevant regulator within 24 hours of learning of it, and provide a complete incident report within 10 calendar days. They must notify affected customers within 72 hours, including known hazards and immediate safety steps."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55°C before sale and at least annually thereafter, using a regulator-approved protocol and representative production units. A model exceeding a 5% failure rate must be reported promptly to the regulator with a risk-based corrective-action plan; exceeding 5% alone does not automatically prohibit sales; regulators may set interim safeguards or restrict sales where warranted by the risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New models introduced 3 years after adoption must support remote emergency shut-off. Manufacturers must provide a retrofit plan for installed units and complete retrofits within 6 years of adoption, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. Regulators may approve an equivalent protective design where it provides comparable fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": null,
    "quote": "Any model exceeding 8 thermal incidents per 100,000 installed units in a year must be promptly reported to regulators and trigger a mandatory recall. Manufacturers must notify affected customers within 72 hours after identifying an urgent hazard."
   }
  },
