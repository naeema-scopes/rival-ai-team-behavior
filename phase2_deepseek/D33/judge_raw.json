 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving overheating, fire, injury, evacuation, or property damage within 24 hours of becoming aware of it, followed by a complete incident report within 10 calendar days. Manufacturers must notify affected customers within 48 hours of identifying a credible product-related thermal hazard, and provide material updates promptly."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": null,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo an independently witnessed sustained-heat test at 55 °C before sale and at least annually thereafter, using a regulator-approved protocol and representative production units. The maximum allowed failure rate is 5%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All newly manufactured home battery systems must include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety hazard, by the manufacturer or emergency responders. Manufacturers must provide a retrofit path for installed units and complete retrofits, or offer replacement where retrofitting is impracticable, within 6 years of adoption of this standard."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression meeting a regulator-approved performance and reliability protocol. This requirement applies to units manufactured 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a mandatory recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year. The manufacturer must notify the relevant regulator and affected customers promptly, explain the risk and remedy, and report progress until the recall is complete."
   }
  },
