  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 4,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report each incident to the relevant regulator within 24 hours of becoming aware of it; an incident involving fire, injury, evacuation, or emergency-service response must be reported immediately and no later than 4 hours after awareness. Manufacturers must notify affected customers within 72 hours, and immediately when continued use presents an urgent hazard."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate exceeding the 5% benchmark requires a documented corrective-action plan and evidence-based regulator review; regulators may impose proportionate safeguards based on risk. Before purchase and within 30 days after each retest, customers must receive the test date, sample size, protocol, the model’s actual 55 °C failure rate, whether it exceeds the 5% benchmark, and any applicable corrective actions or safeguards."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery models must include a remotely operable emergency shut-off that can place the unit in a safe state, subject to safeguards against unauthorized access and loss of essential local safety functions. Manufacturers must provide existing installed units with this capability, through retrofit or an equivalent safe solution, within 72 months of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression designed and validated for the unit’s foreseeable battery-fire hazards. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year, or when the regulator determines that continued use presents an imminent serious risk. Manufacturers must notify affected customers without delay and provide safe repair, replacement, or refund instructions."
   }
