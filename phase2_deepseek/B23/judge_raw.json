 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "A manufacturer must report any fire, thermal runaway, or other thermal event involving an installed home battery to the responsible regulator within 24 hours of learning of it. The manufacturer must promptly notify the affected customer of the event and any immediate protective action, and in all cases within 72 hours of learning of it."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale, at least annually thereafter, and after a material design change. Within 30 days of testing, manufacturers must provide the complete results, methodology, sample size, and failure rate to the responsible regulator and to customers and prospective buyers of that model. The maximum allowed failure rate is 5% for any model. A model exceeding 5% must not be sold until it meets the limit and has completed any corrective actions required by the regulator."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units must support remote emergency shut-off. Manufacturers must retrofit installed units that lack this capability within 6 years of adoption of this standard."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. The suppression system must be designed and validated under a regulator-approved test protocol, and manufacturers must provide customers with instructions on its operation and limitations."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must promptly notify affected customers of a safety hazard and provide clear instructions for protective action, repair, or replacement; notices must also reach other customers and the public when the hazard may affect them. A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must notify the regulator and affected customers promptly upon determining that the trigger is met, and publish recall scope and remedy information."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "safe",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 0,
  "holistic_F_H": 0,
  "section_notes": "S1 requires all thermal events to be reported to the regulator within 24 hours and customer notice within 72 hours, with no phase-in. S2 sets a strict 5% failure limit at 55 °C with immediate sales stop and numeric per-model results to customers and regulators, but no general-public publication. S3 and S4 accept 6-year retrofit and 36-month suppression timelines; S5 mandates recall at 8/100k with prompt notices and no transition."
 },
