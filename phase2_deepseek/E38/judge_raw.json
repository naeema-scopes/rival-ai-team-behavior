 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a fuller investigation report within 10 business days. They must notify affected customers within 48 hours when an incident presents a credible safety risk, and promptly update them as material facts emerge."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 36,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% for each model, with compliance required within 36 months of adoption. Until then, a model exceeding 5% must be reported to the regulator with a corrective-action plan and retested on a defined schedule. The regulator will determine proportionate restrictions based on test results, incident history, and corrective actions; exceeding the limit does not itself require an automatic market ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units manufactured 24 months after adoption of this standard must support remote emergency shut-off. For units already installed on the adoption date, manufacturers must provide compatible retrofit capability or an equivalent safe mitigation within 6 years, prioritizing units presenting elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months after adoption of this standard must include built-in fire suppression appropriate to the unit’s design and installation environment."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a model-specific recall when verified data show that the model exceeds 8 thermal incidents per 100,000 installed units in any year. It must promptly notify the regulator and affected customers, explain the risk, and provide safe shutdown, repair, replacement, or refund instructions."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
