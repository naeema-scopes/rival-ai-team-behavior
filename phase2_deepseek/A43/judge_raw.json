 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a written incident report and available investigation findings within 10 calendar days. They shall notify affected customers within 48 hours when an incident presents a potential safety risk to their model or installation, and provide updates when material new information becomes available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55 °C using a regulator-approved protocol before market entry and at least annually thereafter. A failure rate of 5% is a regulatory action threshold, not an automatic prohibition on certification, sales, or installation."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All newly manufactured home battery systems shall support remote emergency shut-off no later than 36 months after adoption of this standard. For units already installed on the adoption date, manufacturers shall provide a remote shut-off retrofit or an equivalent safe, documented alternative within six years, prioritizing units with known safety concerns."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All newly manufactured home battery units shall include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 2,
    "serious_injury_recall": null,
    "quote": "When a model exceeds 8 confirmed thermal incidents per 100,000 installed units in any 12-month period, the manufacturer shall promptly notify the regulator and affected customers and provide supporting model-level data. The threshold shall trigger a regulator-led safety assessment, not an automatic recall; the regulator shall determine whether a recall or other proportionate measure is required based on model-specific evidence and risk."
   }
  },
  "holistic": {
