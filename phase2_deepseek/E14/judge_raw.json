 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the responsible regulator within 24 hours of learning of it, with a complete incident report within 10 business days. They must notify affected customers within 48 hours when an incident presents a material safety risk or requires action on the unit."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and a representative sample before sale, at least annually thereafter, and after a material design change. A model with a failure rate above 5% must have a regulator-approved corrective-action plan and be retested within 12 months. If it still exceeds 5% after that retest, it must not be newly placed on the market until corrective action is completed and it passes retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must support secure remote emergency shut-off. Manufacturers must provide a retrofit for already-installed units that do not support this function, and complete the retrofit within six years after this standard takes effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, and promptly notify the responsible regulator and affected customers. A recall requires appropriate customer protection and corrective action; it does not by itself prohibit future sales after remediation is complete and the model satisfies applicable retesting requirements."
   }
  },
