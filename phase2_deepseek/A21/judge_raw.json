 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any confirmed thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it. Manufacturers must notify the affected customer within 72 hours, and promptly provide any immediate safety instructions; where the incident may pose a risk to nearby people or property, the manufacturer must also notify the relevant local emergency or safety authority."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Before a model is offered for sale, and at least annually thereafter, the manufacturer must test a representative sample of that model under a sustained-heat test at 55 °C using a documented, regulator-accepted protocol. Complete per-model results must be provided to the regulator and to customers who buy that model; a failure rate above 5% requires regulator review; above 8% requires a corrective-action plan submitted to the regulator."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery models placed on the market after adoption must support a secure remote emergency shut-off. For units already installed at adoption, manufacturers must enable remote shut-off where technically supported within 6 years, and retrofit or replace units that cannot support it within 6 years, subject to regulator-approved safety plans and customer notice."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption. Any proposed alternative system must demonstrate equivalent or better fire-risk reduction and receive regulator approval before sale."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model’s verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any 12-month period, the manufacturer must promptly notify the regulator and affected customers and submit a risk assessment and corrective-action plan. Exceeding the threshold requires regulator review but does not by itself automatically require a recall; the regulator must determine appropriate measures, including recall where necessary to address the risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
