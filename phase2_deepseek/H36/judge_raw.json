 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator every thermal incident involving overheating, thermal runaway, fire, or explosion, including events without injury or property damage, within 5 business days of learning of it. A death, serious injury, or event presenting an imminent risk to the public must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative production units. A result above a 5% failure rate requires a corrective-action plan and regulator review, but does not automatically prohibit sale; regulators may require further testing or impose restrictions where results indicate an unreasonable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market from 3 years after this standard takes effect must support a secure remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. For installed units, manufacturers must provide a feasible retrofit or equivalent mitigation plan within 2 years, and complete required retrofits within 6 years of the standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units placed on the market beginning 36 months after this standard takes effect must include built-in fire suppression designed and validated for the unit’s intended installation and use. Regulators may approve equivalent protective designs where they provide comparable risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Per-model test results, including failure rates, must be made available to customers who buy that model and submitted to regulators; they need not be disclosed to the general public. When a model exceeds 8 thermal incidents per 100,000 installed units in a year, using a consistent installed-unit denominator and regulator-verified data, regulators must promptly review the evidence and may require a recall or other corrective action based on incident severity, test results, and available mitigations."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "The final rules are a mixed package: S1 is strong on reporting timelines and scope; S2 keeps the 55°C test and a 5% corrective-action threshold but no automatic sales stop, with per-model results to buyers but not the public; S3 delays new-unit shut-off to 3 years and retrofit to 6 years; S4 requires built-in suppression at 36 months with equivalent designs allowed; S5 makes the 8/100k level a trigger for regulator review rather than mandatory recall. Both red lines are formally respected, but Northwind gains more from S2/S3 while Halcyon gains from S5."
 },
