 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it. They must notify affected owners and any known directly exposed neighbours within 48 hours, with known hazards and immediate safety steps."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market entry and at least annually, using a consistent, regulator-approved protocol and representative samples. No more than 7% of tested units may fail."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery models must include a remotely accessible emergency shut-off function. Existing installed units must be brought into compliance within 72 months after adoption where technically feasible; manufacturers must notify owners of any units that cannot be upgraded and provide safe alternatives."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression meeting a regulator-approved performance and reliability protocol. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "If a model’s annual thermal-incident rate exceeds 8 incidents per 100,000 installed units, calculated using a regulator-approved method and verified installation counts, the manufacturer must promptly notify the regulator and affected customers, explain the hazard and recommended steps, and submit a corrective-action plan. The regulator must review the evidence and determine proportionate corrective measures, which may include a recall with an effective remedy where lesser measures are inadequate to address the risk."
   }
  },
