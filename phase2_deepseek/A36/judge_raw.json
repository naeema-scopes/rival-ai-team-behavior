 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 2,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 48 hours of learning of it, including incidents initially reported by customers or installers. A preliminary report is due within 24 hours where an incident involves a fatality, serious injury, or fire spreading beyond the battery installation. Manufacturers shall provide affected customers with a safety notice within 5 calendar days of identifying a credible product-related hazard, and promptly update the notice as material facts become known."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model shall undergo a sustained-heat test at 55°C using a regulator-approved protocol before sale and after a material design or manufacturing change. The maximum allowed failure rate is 7% for any model. Manufacturers shall submit per-model test methods, sample sizes, failure rates, and corrective actions to regulators, and provide results for the relevant model to its customers at no charge and without requiring a request. Results need not be published to the general public. If a model exceeds 7%, the manufacturer shall notify the regulator and submit a corrective-action plan within 30 days. The regulator shall set a retest deadline appropriate to the risk, not exceeding 12 months, and may require interim safeguards or restrict sales based on test results, incident data, or other evidence of unacceptable safety risk. Continued sale after the retest deadline requires regulator review of corrective actions and retest results."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery models placed on the market 24 months or more after adoption shall support remote emergency shut-off, with safeguards against unauthorized activation and clear instructions for customers and emergency responders. Manufacturers shall provide a secure software update enabling this function for installed units designed to support it within 6 years of adoption. For installed units that cannot support the function, manufacturers shall notify affected customers and provide safe shutdown instructions and an upgrade or replacement pathway within 6 years."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Home battery units manufactured 36 months or more after adoption shall include built-in fire suppression meeting a regulator-approved performance and reliability protocol. Manufacturers shall document suppression performance and maintenance requirements in customer materials. Units manufactured before that date are not required to be retrofitted solely to meet this provision."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
