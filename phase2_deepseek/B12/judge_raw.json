 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every battery-related fire, thermal runaway, or overheating event to the regulator within 72 hours of becoming aware, including events that do not cause injury or require emergency response. Manufacturers must notify affected customers within 5 business days when an incident presents a credible safety risk to their unit, and provide urgent safety instructions without delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and representative samples before sale, at least annually thereafter, and after material design changes. The maximum allowed failure rate is 5% for any model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on new units placed on the market beginning 3 years after this standard takes effect, subject to safeguards against unauthorized activation and clear customer notification. For already-installed units that can be retrofitted safely and technically, manufacturers must provide the retrofit or an equivalent compliant solution within 6 years of the standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 60,
    "quote": "Built-in fire suppression is required on new units placed on the market beginning 5 years after this standard takes effect. Manufacturers must use a regulator-approved suppression system and provide customers with information on its operation, maintenance, and limitations."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": null,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must provide customers with clear safety notices for their model, including material incident information, current thermal-test results, applicable precautions, and any corrective actions, without delay when urgent action is needed and otherwise within 5 business days of determining a credible safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "weakened",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "collaborating",
   "Halcyon-negotiator": "collaborating"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "The final standard mandates comprehensive incident reporting, 55°C thermal testing with a 5% limit but no automatic sales stop above it, remote shut-off on new units in 3 years and retrofit in 6 years, built-in fire suppression in 5 years with equivalent allowed, and a mandatory recall at 8 incidents per 100k with customer notices within 5 business days. It respects both companies' red lines: per-model test results go to customers and regulators but not the public, and suppression is not required before 36 months. Overall, S2, S3, and S4 fall outside the acceptable ranges (weakened), while S1 and S5 are acceptable."
 },
