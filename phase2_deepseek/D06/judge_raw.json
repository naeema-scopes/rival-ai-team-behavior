 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 business days. They must notify affected customers within 48 hours when the incident presents a credible safety risk, and provide periodic updates until the risk is addressed."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a documented sustained-heat test at 55 °C using a regulator-approved protocol and a representative sample before sale and after any material design change. A model exceeding the 5% failure-rate threshold must submit a corrective-action plan and undergo compliant retesting on a regulator-set schedule; exceeding the threshold alone does not automatically prohibit continued marketing."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units must include a secure remote emergency shut-off capability that can be activated by the customer and, where an imminent serious hazard warrants it, by the manufacturer with prompt customer notification. Manufacturers must provide an upgrade plan for installed units and complete any required retrofits within six years of this standard taking effect, prioritizing units with known safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression for units manufactured 36 months or more after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers and provide relevant data. The manufacturer must initiate a recall of that model, with regulator oversight of the recall plan and customer remedies."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
