 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with an initial account of known facts. The affected customer must be notified within 24 hours when the event involves a credible safety risk to that customer or their household; customers must be kept informed of material safety findings and actions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before sale and at least annually thereafter, using a documented, reproducible protocol and a statistically adequate sample. A failure rate above 5% requires prompt regulator notification and a corrective-action plan with a retest timetable."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must include remote emergency shut-off capability. Manufacturers must retrofit installed units that lack this capability within six years of adoption, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. The suppression system must be designed and validated for the battery’s likely fire hazards and must not create an additional unreasonable safety risk."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "Manufacturers must provide customers clear safety notices describing relevant hazards, safe operation, and any required corrective actions, promptly after identifying a credible safety risk. A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year; manufacturers must promptly report the exceedance and implement the recall under regulator oversight."
   }
  },
