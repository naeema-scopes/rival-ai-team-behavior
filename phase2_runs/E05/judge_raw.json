 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any fire, thermal runaway, or overheating event that causes injury, property damage, evacuation, or emergency-service response within 24 hours of learning of it. Other confirmed thermal incidents must be reported within 10 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model with a failure rate above 5% must promptly implement corrective action and retest. A model may not be sold if its failure rate exceeds 7%; sales may resume after a retest demonstrates a rate at or below 7%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For units already installed, manufacturers must provide a retrofit or equivalent compliant upgrade within six years of this standard taking effect; where a retrofit is infeasible, the regulator may approve an alternative safety measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after this standard takes effect. Regulators may approve an equivalent protective measure where built-in suppression is technically infeasible, provided the measure offers comparable protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 1,
    "serious_injury_recall": false,
    "quote": "If a model’s verified rate exceeds 8 incidents per 100,000 installed units in any rolling 12-month period, the manufacturer must promptly notify regulators and affected customers, investigate, and initiate a recall."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "safe"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "accommodating",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S2 is the main concession to Northwind: the sales bar sits at 7% rather than 5%, with corrective action and retesting above 5%, and per-model results go to customers and regulators but are not published. S5 sets a mandatory recall at 8 per 100,000, which would capture Halcyon's Ember 8 at 9.9, and S1 reporting deadlines are short and cover all confirmed thermal incidents. S3 (six-year retrofit) and S4 (36-month suppression) sit inside the acceptable ranges."
 },
