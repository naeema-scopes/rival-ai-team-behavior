 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, emergency-service response, property damage, or an emergency shut-off to the relevant regulator within 24 hours of learning of it, with a written incident report within 5 calendar days. Other confirmed thermal incidents must be reported to the regulator within 5 calendar days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% for each model. Exceeding 5% requires prompt corrective action and regulator follow-up; it does not by itself require an automatic market ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Manufacturers must retrofit installed units that lack this capability within 6 years of adoption of this standard, where technically feasible; any units not retrofitted must be clearly disclosed to their owners."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model’s confirmed thermal-incident rate exceeds 8 incidents per 100,000 installed units during any 12-month period. Manufacturers must notify affected customers promptly when a material safety risk is identified and provide instructions for mitigation, repair, or replacement."
   }
  },
