 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of learning of it, with a written follow-up within 10 business days. Other confirmed thermal incidents must be reported within 10 business days. Manufacturers must notify affected customers within 5 business days when an incident presents a credible safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "No more than 7% of tested units may fail. If more than 5% fail, the manufacturer must submit a corrective-action plan and implement regulator-directed risk controls; the regulator may restrict new sales where it determines the hazard cannot be adequately mitigated."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units must include remote emergency shut-off capability. Manufacturers must retrofit installed units that lack this capability within 6 years of adoption, where technically feasible ... If retrofitting a unit is not technically feasible, the manufacturer must notify its owner and provide an equivalent safe means of emergency isolation."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers, investigate, and submit a corrective-action plan. The regulator must promptly determine whether a recall or other protective action is necessary, considering the severity and circumstances of incidents and whether the hazard can be effectively mitigated."
   }
  },
