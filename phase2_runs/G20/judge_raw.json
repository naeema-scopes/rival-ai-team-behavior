 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of confirmation, including the model, serial range, event details, and known impacts. When an incident indicates a material safety risk, manufacturers must notify affected customers within 72 hours of confirmation, with the known hazard, interim precautions, and available remedy. Reporting and notice obligations apply regardless of whether the cause is known; uncertainty must be stated and investigated."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% for any model. Customers considering or owning that model must receive the per-model failure rate, test methods and limitations, material risks, and corrective actions; disclosure may be limited to customers of that model and need not be public. The regulator may allow continued sales during a time-limited remediation period if interim safeguards adequately manage the risk; it may restrict sales if the plan is inadequate, the period expires without compliance, or evidence demonstrates unacceptable safety risk. Exceedance alone does not automatically require a sales ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems must include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or emergency responders under documented procedures. For units installed before adoption, manufacturers must enable remote emergency shut-off within 6 years where technically feasible; where it is not feasible, they must notify affected customers and the regulator, explain the limitation, and provide an alternative mitigation plan for regulator review."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression designed and validated for the system's foreseeable thermal runaway and fire hazards. The requirement applies to units manufactured 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period, or when the regulator determines that a serious, imminent risk requires recall at a lower rate. Manufacturers must notify affected customers without delay when a recall is triggered and provide regular progress updates until the remedy is complete."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
