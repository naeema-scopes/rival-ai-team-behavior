  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, including incidents under investigation. They shall provide affected customers with an initial safety notice within 72 hours, describing immediate precautions and how to report related events."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model meets the 5% benchmark if no more than 5% of tested units fail. Exceeding the benchmark requires a corrective-action plan and retesting within 12 months; it does not by itself require market withdrawal, and the regulator may require additional protective measures based on the risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units shall include a remote emergency shut-off capability, with a safe means for an authorized emergency responder or the customer to activate it, beginning three years after adoption. Manufacturers shall provide an implementation plan for installed units and complete any required retrofits within six years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression no later than 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer shall initiate a mandatory recall of any model whose thermal-incident rate exceeds 8 incidents per 100,000 installed units in any year, notify the regulator and affected customers promptly, and provide safe repair, replacement, or refund options. Notices shall be issued promptly when a material hazard is identified and updated as findings change."
   }
