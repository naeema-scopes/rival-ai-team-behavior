  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, smoke, fire, injury, or material property damage to the regulator within 24 hours of learning of it, with a written incident report within 10 calendar days. They must notify affected customers within 48 hours when an incident indicates a potential safety risk, and promptly provide updates as facts are confirmed. Suspected incidents must be reported; reporting does not depend on a completed investigation."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires prompt notice to the regulator and affected customers, a corrective-action plan, and retesting within six months. Regulators may impose proportionate restrictions, including sales restrictions, where evidence shows adequate safety cannot be demonstrated; exceeding 5% alone does not automatically prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Existing installed units that can be retrofitted must be upgraded within six years of adoption. Manufacturers must notify owners of units that cannot be upgraded and provide appropriate alternative emergency guidance."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when a model exceeds 8 thermal incidents per 100,000 installed units in a year, using model-specific incident and installed-unit data verified by the regulator. The manufacturer must promptly notify the regulator and affected customers and implement the regulator-approved recall, which may use an appropriate corrective remedy; the threshold itself does not prescribe a particular remedy or automatically require a sales ban."
   }
