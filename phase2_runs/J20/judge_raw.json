 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the regulator within 24 hours of learning of it, with a preliminary account of the event and affected model. Manufacturers must notify affected customers promptly when an incident indicates a material safety hazard, and no later than 72 hours after determining that customers may be at risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5% per model. Customers who buy that model must receive its exact per-model failure percentage, whether it met the limit, and all actionable safety information. A model exceeding the limit must receive a regulator-approved corrective-action plan and retest schedule; ... withdrawal from sale reserved for cases where the regulator finds an immediate serious risk or corrective action fails."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units manufactured 24 months or more after this standard takes effect must include remote emergency shut-off. For units already installed when the standard takes effect, manufacturers must provide a retrofit or equivalent compliant upgrade within six years."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after this standard takes effect must include built-in fire suppression designed and validated for the battery system."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers, and the regulator must promptly review the evidence and require appropriate corrective action. A recall is mandatory when the regulator determines that the model presents a serious safety risk or that corrective action has failed."
   }
  },
