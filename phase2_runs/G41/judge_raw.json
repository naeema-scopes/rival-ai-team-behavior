 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with an initial account of known impacts and response actions. Affected customers must be notified within 24 hours when an incident presents an ongoing or serious safety risk, and otherwise within 5 business days. Reports must identify the model and installed-unit population and may not omit incidents because their cause is still under investigation."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model exceeding a 5% failure rate must submit a corrective-action plan and be retested within 12 months. Regulators may require interim safeguards based on results; exceeding the threshold alone does not automatically require a market ban. Manufacturers shall provide per-model test results, including failure rates, to the relevant regulator and to customers who buy that model, and retain results for audit."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed home battery systems shall support remote emergency shut-off beginning 24 months after adoption of this standard. Manufacturers shall provide a safe retrofit path for installed units where technically feasible. No installed unit shall be required to receive a retrofit sooner than six years after adoption; manufacturers shall prioritize units with elevated risk and provide customers with interim safety instructions."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression beginning 36 months after adoption of this standard. Regulators may approve an equivalent fire-mitigation design where it provides comparable protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. When the trigger is met, the manufacturer shall promptly notify regulators and affected customers, stop distribution of the affected model, and provide a regulator-approved remedy, including repair, replacement, or refund."
   }
  },
