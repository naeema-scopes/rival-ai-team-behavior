 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with an initial account of known facts. Within 24 hours, manufacturers must notify the affected household and any other person known to face an immediate safety risk, providing known hazards and protective steps."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires prompt notification to the regulator and a corrective-action plan within 30 days; it is a review trigger, not an automatic market prohibition. Manufacturers must also provide the relevant model's latest complete test results to prospective customers before purchase and to existing customers of that model within 30 days of testing."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For units already installed, manufacturers must provide and enable remote emergency shut-off within 6 years of adoption of this standard, where technically feasible, and notify owners of the schedule and safe-use instructions. If a unit cannot be upgraded, the manufacturer must document the reason, notify its owner, and provide an alternative emergency isolation procedure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must promptly notify regulators and affected customers when the trigger is met, explain the risk and remedies, and report recall progress."
   }
  },
  "holistic": {
