 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal runaway, fire, overheating event, or injury/property-damage event involving a home battery to the relevant regulator within 24 hours of becoming aware, with a preliminary incident report within 5 business days and a final investigation report within 30 days. Affected customers must be notified within 48 hours when the event may indicate a hazard in their unit or model."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers prompt reporting of the results to the regulator and a regulator-approved corrective-action and retesting plan; it is not by itself an automatic market ban. Manufacturers must provide per-model results, including the failure rate and test date, to regulators and to customers who buy or own that model. Results need not be published publicly."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market must support secure remote emergency shut-off, with safeguards against unauthorized access and clear instructions for customers and emergency responders. Manufacturers must provide a retrofit program for installed units, prioritizing higher-risk units, and complete it within 6 years of the standard taking effect. Where retrofit is impracticable, the manufacturer must provide an effective alternative safety measure and notify affected customers."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption of this standard. Until the requirement takes effect, manufacturers must document their fire-mitigation measures and provide customers with relevant safety instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Customers who buy or own a model must receive that model's 55 °C test failure rate and test date. A model exceeding 8 thermal incidents per 100,000 installed units in a year triggers a mandatory, proportionate recall. The regulator shall determine the appropriate remedy—repair, replacement, or removal—and timeline based on verified model-specific evidence, while ensuring affected customers are protected."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
