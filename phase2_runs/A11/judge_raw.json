 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any confirmed thermal incident involving overheating, smoke, fire, injury, or property damage within 24 hours of becoming aware of it, followed by a complete incident report within 10 calendar days. Affected customers must be notified within 72 hours when an incident presents a credible safety risk to them or requires inspection, service, or a change in use; notices must describe the hazard and protective steps."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers regulator review and a corrective-action plan with a specified completion timeline; it does not by itself prohibit sale. Numerical per-model failure-rate estimates and supporting results must be available to regulators and to customers considering or owning that model; they need not be released to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market must include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer or relevant emergency authority. Units already installed when this standard is adopted must be brought into compliance within 6 years, where technically feasible; otherwise, the manufacturer must notify affected customers and provide an approved equivalent protective measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "They must promptly notify affected customers of newly identified material hazards and provide updates on corrective actions. A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year; regulators may also require corrective action or recall where incident severity or other evidence indicates an imminent risk, regardless of the rate."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -1,
  "section_notes": "The final S2 removes the automatic sales stop for models above 5% (review and corrective action only), which protects Northwind's Hearth 10 at 6.2%, and numerical per-model results go to regulators and to customers considering or owning the model, not the public. S5 mandates recall above 8 per 100,000, which the Ember 8 at 9.9 exceeds, with no transition window. S3 gives a 6-year retrofit (within the acceptable range) and S4 a 36-month suppression start. For S1 the 24-hour deadline applies to all confirmed incidents, so I recorded other_report_days as 1; the 10-day complete report is not captured in the schema."
 },
