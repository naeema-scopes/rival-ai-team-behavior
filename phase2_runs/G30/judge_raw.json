 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of discovery, including known model, serial number, location, and incident details. They shall notify affected customers within 72 hours of discovering an incident that presents a potential safety risk, sooner if an imminent risk requires it."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5% per model, consistent with the regulator threshold under discussion. Exceeding the limit shall not automatically require a sales pause. Unless the regulator determines that an imminent or otherwise unmitigated risk requires a pause, the manufacturer may continue sales while implementing regulator-approved interim safeguards and corrective action."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units shall include a remotely accessible emergency shut-off capability. Manufacturers shall retrofit installed units to support remote emergency shut-off, or provide an equivalent safe mitigation where retrofit is not technically feasible, within six years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units shall include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when a validated model-specific rate exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers shall promptly notify affected customers of a material thermal hazard ... issue the notice within 72 hours after confirming the hazard, or sooner when an imminent risk requires it."
   }
