 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the regulator any thermal incident involving overheating, fire, injury, property damage, or emergency service response within 24 hours of learning of it. An incident is reportable upon credible indication of a thermal event; reporting shall not be delayed pending confirmation of cause, and incidents learned of through customers or emergency responders are included. Within 72 hours of learning of an incident that presents a potential safety risk, the manufacturer shall notify affected customers and provide appropriate safety instructions."
