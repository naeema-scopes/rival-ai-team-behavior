 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or thermal runaway to the regulator within 24 hours of learning of it, including incidents involving injury, property damage, or suspected product malfunction. They must notify affected customers within 72 hours when an incident indicates a material safety risk or requires customer action, and provide follow-up information as it becomes available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 24,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The failure rate must not exceed 5%. For models already on the market when this standard takes effect, the regulator shall provide up to 24 months for corrective action and retesting before imposing sales restrictions, unless it determines that an immediate restriction is necessary to address an imminent safety risk. Any restriction must be based on the model's test results, demonstrated risk, and progress and adequacy of remediation; exceeding the limit alone does not automatically require a permanent market ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery systems must support secure remote emergency shut-off. Manufacturers must provide a safe shut-off capability for installed units that can technically support it within 72 months after adoption. Where a unit cannot be upgraded, the manufacturer must document the reason and provide the customer with an alternative emergency response procedure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All newly manufactured home battery systems must include built-in fire suppression designed to limit fire propagation and protect occupants and nearby property. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. The manufacturer must notify the regulator immediately upon determining the threshold is exceeded and promptly inform affected customers of the recall and remedy."
   }
  },
