 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a written incident report and known unit/model details within 5 business days. They must notify affected customers within 48 hours when an incident indicates a potential safety risk, and provide updates as material information becomes available. Reports must include incidents regardless of whether the cause is confirmed; manufacturers must not omit incidents because an investigation is pending."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol before sale and after a material design change. A failure rate above 5% triggers prompt regulator review and required corrective action proportionate to the risk; the maximum permitted failure rate is 7%. A model above 7% may not be sold until corrective action is completed and a regulator confirms compliance through retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on new home battery units manufactured 36 months after adoption of this standard. For units already installed on the adoption date, manufacturers must provide remote shut-off capability through retrofit or replacement within 6 years, where technically feasible, and notify customers of the schedule and any interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new home battery units manufactured 36 months after adoption of this standard. This requirement does not replace other applicable fire-safety measures."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": null,
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 verified thermal incidents per 100,000 installed units in a year, the regulator must promptly review the data and risk, and require proportionate corrective action, which may include a recall where warranted. Manufacturers must cooperate with the review and notify affected customers of material safety risks and required actions."
   }
  },
