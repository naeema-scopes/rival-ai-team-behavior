 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 2.8,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving fire, smoke, uncontrolled heating, injury, or property damage to the relevant regulator within 5 business days of learning of it. Any fatality, life-threatening injury, or active risk to the public must be reported within 24 hours. The manufacturer must notify the affected customer within 2 business days after learning of an incident involving their unit."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model's failure rate must not exceed 8%. If a model exceeds the limit, the manufacturer must promptly submit a corrective-action plan for regulator review; the regulator may require additional testing or other proportionate measures. Manufacturers must provide customers of each model with that model's test results, including its failure rate and any corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New models placed on the market from 2 years after adoption must support secure remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must provide a retrofit pathway for installed units and complete retrofit or an equivalent safety measure within 6 years after adoption, prioritizing units with known safety concerns."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption must include built-in fire suppression meeting applicable performance and safety requirements. This requirement does not prevent earlier adoption or other appropriate fire-risk mitigation."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If a model's thermal incident rate exceeds 8 per 100,000 installed units in any year, the regulator must require a model-specific recall. The recall must include an effective remedy, which may be a regulator-approved corrective action such as repair, replacement, or a safety update, and appropriate customer notification."
   }
  },
