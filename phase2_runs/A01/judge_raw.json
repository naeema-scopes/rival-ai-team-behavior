 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery thermal runaway, fire, explosion, or overheating event requiring emergency services, medical care, evacuation, or causing property damage to the relevant regulator within 24 hours of learning of it. The manufacturer must notify affected customers within 72 hours, providing known hazards and immediate safety steps, and update them as material facts emerge. Less severe thermal incidents must be reported to the regulator and affected customers within 30 days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model fails this standard if more than 7% of tested units fail. Models exceeding 5% must submit a corrective-action plan to the regulator within 30 days and complete a retest within 12 months. The regulator may require additional safeguards or restrict sales if risks remain unaddressed."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units must support remote emergency shut-off no later than 36 months after adoption. For units already installed when the standard is adopted, manufacturers must provide a retrofit plan and complete retrofits within 6 years, where technically feasible; customers must be notified of interim safety steps and any unit-specific limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must notify affected customers within 72 hours of learning of a serious thermal incident involving their model and update notices as material facts emerge. Manufacturers must promptly notify regulators and affected customers of a recall and provide instructions for repair, replacement, or safe decommissioning."
   }
  },
