 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator every battery-related overheating, fire, smoke, thermal runaway, or emergency shutdown, whether or not injury or property damage occurred. An initial report is due within 72 hours of learning of the incident, followed by a complete investigation report within 30 days. Customers whose unit was involved must be notified within 5 business days, with known hazards and immediate safety steps."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "regulators_only",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5% per model. A model exceeding 5% is non-compliant: the manufacturer must promptly notify the regulator and submit a corrective-action plan. The regulator shall set proportionate safeguards and a retesting timeline based on risk; sales may continue subject to those safeguards unless the regulator determines a pause is necessary. Full per-model results, including failure rates, must be provided confidentially to the regulator."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New battery systems must provide a remote emergency shut-off capability. Manufacturers must enable the capability on compatible installed units and provide a safe retrofit or replacement plan for units that lack it, completing the program within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on new battery systems manufactured 36 months or more after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in any 12-month period triggers prompt regulator notification and a regulator-led risk review, initiated within 30 days. The regulator must require a recall when the review determines that the model presents an unacceptable risk. Manufacturers must promptly notify affected customers of any recall and provide instructions for safe shutdown, removal, or other protective action."
   }
  },
