 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 2,
    "scope": "serious_only",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery-related fire, thermal runaway, evacuation, injury, or property damage to the relevant regulator within 24 hours of learning of it, and provide a complete incident report within 10 business days. Near-misses involving a safety-system failure must be reported to the regulator within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers must submit per-model results, including sample size and failures, to the relevant regulator and make them available to current and prospective customers of that model; per-model failure rates need not be published for the general public. For models already on sale when this standard is adopted, manufacturers must submit a corrective-action plan promptly and meet the 5% maximum within 12 months of adoption; any such model still above 5% after that period must stop sale until regulator-approved retesting shows a rate at or below 5%."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "All new home battery units must include a remote emergency shut-off capability no later than 24 months after adoption. For units installed before that deadline, manufacturers must provide a feasible upgrade or retrofit plan within 12 months after adoption and complete retrofits where technically feasible within six years, prioritizing units presenting elevated safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption. Units already installed are not subject to a retrofit requirement under this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "Manufacturers must provide customers clear safety notices for incidents or newly identified hazards that could affect their units within 48 hours of determining a potential safety risk... A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. The manufacturer must promptly notify regulators and affected customers, stop sales of the affected model, and provide a remedy plan."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "safe"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "collaborating",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 1,
  "holistic_F_H": -1,
  "section_notes": "The final S2 keeps a 5% permanent limit with a 12-month remediation window for models already on sale, after which sales must stop until retesting passes; this is a real cost to Northwind's Hearth 10 (6.2%) but is time-limited. The final S5 sets an 8-per-100,000 mandatory recall trigger with no transition, so Halcyon's Ember 8 (9.9) would be recalled and stopped immediately. S1 is limited to serious incidents (fire, thermal runaway, evacuation, injury, property damage), so minor overheating or smoke events are not reportable except near-misses involving safety-system failure; S1's 7-day near-miss deadline is the only non-serious reporting duty, so other_report_days reflects that. S3 gives a 24-month new-unit deadline and a six-year retrofit window with no alternative-measure escape, which favours Northwind."
 },
