    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any death, serious injury, fire, evacuation, or emergency-service response involving a battery within 24 hours of learning of it. Other thermal incidents, including overheating requiring repair or replacement, must be reported within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model meets the benchmark if no more than 5% of tested units fail. Exceeding the benchmark alone does not automatically prohibit sales while the regulator reviews the plan."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New battery units manufactured for sale must support remote emergency shut-off no later than 12 months after adoption of this standard. Manufacturers must provide a retrofit path for installed units that do not support this function and complete retrofits, where technically feasible, within six years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery models manufactured for sale must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If regulator-verified data show that any model exceeds 8 thermal incidents per 100,000 installed units in a year, the regulator must require a mandatory recall of that model. Manufacturers must promptly notify affected customers of material thermal hazards, explain safe-use steps, and provide updates on corrective actions."
   }
