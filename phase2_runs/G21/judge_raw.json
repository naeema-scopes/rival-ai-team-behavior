 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, fire, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of learning of it, with an initial account of known facts. Within 24 hours, manufacturers must also notify affected customers and provide clear instructions on immediate precautions and how to obtain assistance. Reports and notices must not be delayed while causation is investigated."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "No model may be placed on the market if more than 8% of tested units fail. Before purchase, customers must receive the per-model test methods, sample sizes, and results for the model they are considering, along with clear model-specific safety information and any regulator-required safety warnings. Non-identifying aggregated information may be published publicly; identified per-model failure rates need not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models placed on the market 24 months after adoption must include a remotely accessible emergency shut-off function, with safeguards against unauthorized activation and clear instructions for customers. For installed units lacking this function, manufacturers must provide an upgrade or other effective mitigation plan within 6 years after adoption, where technically feasible, and report progress to regulators."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption must include built-in fire suppression designed and validated for the battery system."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, the manufacturer must promptly notify regulators, investigate, and submit a documented corrective-action plan. A recall is mandatory when a model exceeds 10 thermal incidents per 100,000 installed units in any 12-month period."
   }
  },
