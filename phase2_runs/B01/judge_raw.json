 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal runaway to the responsible regulator within 72 hours of learning of it, including incidents that cause no injury or property damage. Manufacturers must notify affected customers promptly, and no later than 24 hours after learning of an incident that indicates an ongoing risk to them or nearby people."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% is a safety-action trigger, not an automatic market ban. Individual-company per-model failure rates need not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For units already installed when this standard takes effect, manufacturers must provide a compatible retrofit or replacement pathway and complete the retrofit within six years. Where a unit cannot safely or technically be retrofitted, the manufacturer must notify its owner and provide an alternative risk-mitigation plan."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units placed on the market must include built-in fire suppression no earlier than 36 months after adoption of this standard. The regulator may approve an equivalent design or a time-limited exemption where the manufacturer demonstrates that the alternative provides comparable protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly report the rate and supporting data to the regulator and notify affected customers. A recall is required at that threshold unless the regulator promptly approves a documented alternative protective action that provides equivalent protection, based on the evidence."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 1,
  "holistic_F_H": 1,
  "section_notes": "S2 converts the 5% limit into a safety-action trigger with no mandatory sales stop, which removes the threat of a market ban for Northwind's Hearth 10 (6.2%). S5 makes recall mandatory at 8 per 100,000 but lets the regulator approve an open-ended alternative protective action in place of recall, which gives Halcyon's Ember 8 (9.9) a route around recall. S3 (6-year retrofit with an alternative plan) and S4 (built-in suppression from 36 months) sit within the acceptable ranges and favour the respective companies' constraints."
 },
