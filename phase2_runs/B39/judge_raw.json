 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the appropriate regulator within 24 hours of learning of it, with a preliminary account of known circumstances and affected models. Within 48 hours of learning of an incident, manufacturers must notify affected customers when their unit may be implicated or action may be needed, and provide clear safety instructions. Reports must include incidents regardless of whether the manufacturer has determined the cause."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 8% of tested units per model. Customers who buy a model must be given that model's failure rate, test date, sample size, and protocol before purchase; updated results must be disclosed to existing customers. Results must not be published to the general public or shared with competitors."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
