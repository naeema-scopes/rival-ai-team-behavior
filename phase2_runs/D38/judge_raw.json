 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, smoke, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it. Manufacturers must notify affected customers within 72 hours when an incident indicates a credible safety risk, and provide safety instructions and material updates promptly."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "No more than 5% of tested units may fail. For a model already on the market at adoption, the manufacturer must promptly submit a corrective-action plan and may continue sales for up to 12 months while implementing corrective measures, subject to regulator-approved interim protections and any customer notices the regulator requires."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New models placed on the market 12 months or more after adoption must support remote emergency shut-off. Manufacturers must retrofit installed units that do not support this capability, or provide an equivalent regulator-approved mitigation, within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured 36 months or more after adoption must include built-in fire suppression designed to limit propagation of a thermal event. Requirements for existing installed units are not created by this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units during a year triggers a mandatory recall. Manufacturers must promptly report the trigger and cooperate with the assessment; the regulator may require interim protections or stop-sales while verifying the trigger and implementing the recall."
   }
  },
  "holistic": {
