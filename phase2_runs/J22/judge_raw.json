 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, evacuation, or emergency-service response to the relevant regulator within 24 hours of becoming aware of it, with a preliminary incident record. Other confirmed thermal incidents must be reported within 5 business days. Affected customers must be notified within 72 hours for serious incidents and within 10 business days for other confirmed incidents."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Exceeding the benchmark alone does not automatically prohibit sale; the regulator may impose proportionate restrictions if the manufacturer fails to implement adequate corrective action or the regulator finds an inadequately mitigated serious risk. Per-model failure rates must not be published for the general public under this standard."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": false,
    "retrofit_deadline_months": null,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models placed on the market 24 months or more after adoption must support remote emergency shut-off. Within 6 years after adoption, manufacturers must assess whether installed units that lack the function can be safely upgraded and offer an upgrade where technically feasible. This section does not require manufacturers to retrofit installed units."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption must include built-in fire suppression designed to reduce the risk of fire propagation. Existing installed units are not subject to retrofit under this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model's verified thermal incident rate exceeds 8 per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers. The regulator must promptly review the verified rate and require a time-bound corrective-action plan; it must order a recall when evidence shows that a recall is necessary to address an inadequately mitigated serious risk."
   }
  },
