 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 2,
    "scope": "serious_only",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery-related fire, thermal runaway, or other thermal event causing injury, property damage, evacuation, or emergency-service response within 24 hours of learning of it. Manufacturers must notify affected customers within 48 hours when an event presents a credible safety risk requiring customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 36,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model's failure rate must not exceed 5%. For models already on the market when this standard takes effect, manufacturers must submit a corrective-action plan to the regulator within six months and demonstrate compliance within 36 months. Manufacturers must provide per-model results, sample size, protocol, and corrective actions to the regulator and customers purchasing that model before purchase. Results must not be withheld from those customers; regulators may publish aggregated results, but not company-specific per-model failure rates."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market must support a secure remote emergency shut-off capability. Manufacturers must provide a retrofit plan for installed units and complete technically feasible retrofits within six years of this standard taking effect. Where retrofit is not feasible, the manufacturer must notify affected customers and provide an equivalent risk-mitigation measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units placed on the market must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, calculated using reported and subsequently substantiated incidents, a mandatory recall is triggered. Manufacturers must promptly notify affected customers of new safety risks and provide clear protective actions; urgent notices requiring immediate action must be sent without undue delay."
   }
  },
