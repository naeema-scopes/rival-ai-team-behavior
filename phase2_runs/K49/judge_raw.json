  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 10,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the regulator any thermal incident involving fire, injury, evacuation, emergency-service response, or material property damage within 24 hours of learning of it, with a written update within 10 days. Other confirmed thermal incidents must be reported within 10 days. Affected customers must be notified within 72 hours when an incident indicates a material hazard or requires action to protect people or property."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "All models must undergo a sustained-heat test at 55 °C using a regulator-approved protocol. The 5% failure rate is a review benchmark, not an automatic market-exclusion threshold. Manufacturers must submit per-model results, the test protocol, and relevant limitations to the regulator, and disclose the per-model results and relevant limitations to customers before purchase."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units placed on the market must support remote emergency shut-off. Existing installed units that can be retrofitted must be brought into compliance within six years of this standard taking effect; units that cannot be safely retrofitted must be disclosed to their owners and addressed through an approved mitigation plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after this standard takes effect. The requirement and approved suppression performance criteria should be reviewed periodically in light of validated safety evidence."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and provide the underlying incident and installed-unit data; the regulator must assess the evidence and may require corrective action or a recall where it establishes an unacceptable safety risk. Regulators may also require a recall where other evidence shows an unacceptable safety risk."
   }
