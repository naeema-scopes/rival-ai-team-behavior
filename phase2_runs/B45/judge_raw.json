 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": null,
    "customer_notice_days": 5,
    "scope": "serious_only",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery-related fire, thermal runaway, or injury requiring medical treatment to the relevant regulator within 72 hours of becoming aware. Affected customers must be notified within five calendar days when an incident indicates a material safety risk or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": 8,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The allowable failure rate is 8% on an interim basis. Regulators must review the limit within two years using evidence on test performance and real-world incidents, and may revise it through a transparent process. Manufacturers must submit per-model results, sample sizes, and test methods to the relevant regulator and provide those exact per-model results, sample sizes, and test methods to customers buying that model in an accessible format."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Manufacturers must provide a retrofit program for installed units that lack this capability, completed within six years after this standard takes effect. Where a unit cannot reasonably be retrofitted, the manufacturer must offer an equivalent safety measure or replacement."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 5,
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and provide model-level incident data. The regulator must promptly assess the risk and may require corrective action, including a recall. A recall is mandatory when the regulator determines that the risk warrants one or the manufacturer fails to complete required corrective action."
   }
  },
