    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units shall support remote emergency shut-off at installation. Manufacturers shall retrofit installed units to support remote emergency shut-off within six years after adoption, where technically feasible, and provide an alternative documented emergency response plan to the regulator for units that cannot be retrofitted."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units manufactured 36 months or more after adoption shall include built-in fire suppression meeting regulator-approved performance requirements."
