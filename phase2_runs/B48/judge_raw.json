    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model passes only if no more than 5% of tested units fail. Manufacturers shall provide complete per-model results, including exact failure rates, to the relevant regulator and to customers before purchase and while they own the model, and retain complete results for audit."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
