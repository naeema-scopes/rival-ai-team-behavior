 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 72 hours of becoming aware of it, with an initial report even if the cause is unknown. Manufacturers must notify affected customers within five days when an incident presents a credible safety risk, and promptly provide safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model exceeds the performance benchmark if more than 5% of tested units fail. Regulators should consider the test results, incident evidence, and effectiveness of interim risk controls when determining proportionate measures; sales restrictions are appropriate where the model remains above the benchmark and the evidence indicates material safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units placed on the market from three years after adoption must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer notification when shut-off occurs. For already-installed units, manufacturers must provide compatible remote shut-off capability or an equivalent safe mitigation within six years after adoption, prioritizing higher-risk units and notifying owners of the schedule."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units placed on the market 36 months after adoption or later must include built-in fire suppression designed and validated for the unit's battery chemistry and enclosure. The regulator may approve an equivalent protective design where it provides comparable fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, based on regulator-validated data, a mandatory recall is triggered. Manufacturers must promptly notify affected customers and the regulator of required actions."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 1,
  "holistic_F_H": -1,
  "section_notes": "The final S2 sets a 5% benchmark that triggers corrective action and retesting but never forces a sales stop, which protects Northwind's Hearth 10 (6.2%) from an automatic ban and keeps per-model rates off the public record. S5 makes an 8-per-100,000 model-specific recall mandatory with no transition or corrective alternative, which exposes Halcyon's Ember 8 (9.9) while Northwind's 6.4 flagship falls below it. S3 (retrofit within six years, new units from year three) and S4 (suppression from month 36, with equivalents allowed) both sit within or near the acceptable ranges."
 },
