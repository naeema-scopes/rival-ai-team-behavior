 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a written incident report within five business days. They must notify the affected unit’s customer within 48 hours, or sooner when needed to reduce an immediate safety risk, and provide known hazards, safe-use or isolation instructions, and available corrective actions. Incidents must not be omitted because they were not independently verified."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires a documented corrective-action plan submitted to regulators within 60 days and retesting within six months; it does not by itself prohibit continued sale while the plan is being implemented. Results and relevant safety guidance must be provided to customers of the tested model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required for all new units placed on the market beginning 24 months after this standard takes effect. Manufacturers must provide a retrofit pathway for installed units and complete retrofits within six years of the effective date, where technically feasible. Any unit that cannot be retrofitted must be disclosed to its owner with safe isolation instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new units placed on the market beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must notify regulators, submit supporting data and a corrective-action plan within 30 days, and contact affected customers without undue delay with appropriate safety guidance. Exceeding this threshold triggers mandatory regulatory review and corrective action; it does not by itself require a recall. Regulators may order a recall or other protective measures based on the evidence and risk."
   }
