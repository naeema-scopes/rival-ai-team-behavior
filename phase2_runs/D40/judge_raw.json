  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 72 hours of becoming aware of it, with a complete investigation update within 30 days. The affected customer shall be notified within 24 hours of confirmation, or sooner if immediate action is needed to protect people or property."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% per model. A model exceeding 5% shall promptly undergo corrective action and retesting, with the regulator determining any interim sales restrictions based on the evidence and risk; exceedance alone does not automatically require a market-wide ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New battery systems shall support remote emergency shut-off by installation. For already-installed units, manufacturers shall provide retrofit capability or an equivalent effective risk-reduction measure within six years, prioritizing units with elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery systems shall include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers shall provide regulators with implementation plans and may adopt the requirement earlier."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model's thermal incident rate exceeds 8 incidents per 100,000 installed units in a year, the manufacturer shall promptly notify regulators and affected customers, investigate, and propose corrective action. Regulators shall promptly assess the evidence and risk and may require a recall or other protective measures; a recall is required when the regulator determines it is necessary to protect customers or the public."
   }
  },
