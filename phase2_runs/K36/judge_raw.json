 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report each confirmed thermal incident involving overheating, fire, injury, or property damage to the regulator within 24 hours of learning of it, including incidents initially reported by customers or installers. Within 72 hours, manufacturers must notify affected owners when the incident indicates a material safety risk or requires a change in use."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model fails this requirement if more than 5% of tested units fail. The regulator will determine any sales restrictions based on the model's risk; exceeding the test limit alone does not automatically prohibit sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "For units already installed on the adoption date, manufacturers must provide a secure remote shut-off capability through a retrofit or replacement within 72 months, where technically feasible, and report progress and any exceptions to the regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption. The regulator may approve a narrowly scoped, time-limited exception where a manufacturer demonstrates that a compliant design is not yet technically feasible, provided equivalent risk controls and a transition plan are in place."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. Manufacturers must report incident rates and recall actions to the regulator and notify affected owners without delay."
   }
  },
