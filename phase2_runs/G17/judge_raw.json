 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled heating, injury, or property damage to the relevant regulator within 5 business days after learning of it. Incidents involving death, serious injury, evacuation, or an active threat to neighbouring properties must be reported within 24 hours. Reports must include known circumstances and be updated as the investigation proceeds."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Results above 5% require prompt regulator review and a corrective-action plan, including retesting and any interim safeguards the regulator determines necessary. A model must not be automatically barred from sale solely for exceeding 5%; continued sale is subject to regulator oversight and protective measures proportionate to the demonstrated risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed systems must support remote emergency shut-off by 1 January 2029, subject to safeguards against unauthorized operation and provision for safe local operation. For units already installed when this standard takes effect, manufacturers must provide a compatible retrofit or equivalent mitigation within 6 years, where technically feasible, and notify owners of the available options and any limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. Manufacturers must promptly notify the regulator and affected customers, explain the remedy and timeline, and report progress until the recall is complete."
   }
  },
