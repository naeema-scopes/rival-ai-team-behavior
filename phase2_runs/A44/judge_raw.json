 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a preliminary account and available unit/model information. Manufacturers shall notify affected customers within 72 hours when an incident indicates a credible safety risk, and promptly provide safe-use instructions and any necessary protective action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 7% of tested units per model. Models exceeding 5% shall undergo an independent review, corrective-action plan, and repeat testing within 12 months; models exceeding 7% may not be newly marketed until they pass."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Remote emergency shut-off is required on new units manufactured beginning 24 months after this standard takes effect. Manufacturers shall provide a retrofit path for installed units and complete retrofits within 6 years, prioritizing units with elevated risk and notifying affected customers of availability and safe-use guidance."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new units manufactured beginning 36 months after this standard takes effect. Manufacturers shall provide customers with safe-use and maintenance instructions for the suppression system."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when a model exceeds 8 thermal incidents per 100,000 installed units in a year, or when the regulator determines that the model presents an imminent serious safety risk. Upon a recall trigger, manufacturers shall promptly notify the regulator and affected customers, explain the remedy, and provide regular progress updates until the recall is complete."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
