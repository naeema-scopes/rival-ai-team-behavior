 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any fire, thermal runaway, evacuation, injury, or property-damage event involving a home battery within 24 hours of becoming aware of it. Other overheating or safety incidents requiring emergency service or product repair must be reported within 5 business days. Affected customers must be notified within 5 business days of an incident involving their unit, with urgent hazards communicated immediately."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model exceeding a 5% failure rate must promptly undergo corrective action and retesting; the regulator may require additional safeguards or restrict new installations based on the evidence. Exceeding the threshold alone does not automatically prohibit sale or installation."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Remote emergency shut-off is required on all new home battery units installed 12 months or more after adoption of this standard. Manufacturers must provide a retrofit pathway for installed units that lack the capability and complete retrofits within 72 months after adoption, prioritizing units with elevated safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new home battery units manufactured 36 months or more after adoption of this standard. The requirement applies to all models and must be verified through documented testing and certification."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, the manufacturer must promptly notify the regulator and provide supporting incident records, including the installed-unit denominator and incident dates. Once the threshold is verified, the manufacturer must initiate a recall without delay."
   }
  },
