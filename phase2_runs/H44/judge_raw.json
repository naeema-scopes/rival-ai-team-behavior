  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving fire, smoke, uncontrolled overheating, or emergency intervention to the relevant regulator within 24 hours of learning of it, with a fuller incident report within 10 business days. Affected customers must be notified within 72 hours when an incident presents a credible safety risk to their unit or requires inspection, service, or precautions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 10,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "pass_fail_only",
    "public_publication": false,
    "quote": "A model passes if no more than 10% of tested units fail. Customers who buy a model receive its pass/fail status, but not its per-model failure rate."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on all newly manufactured units no later than 24 months after adoption. Manufacturers must provide a plan for enabling remote shut-off on installed units where technically feasible, and complete upgrades or provide an equally effective safety mitigation within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on new units manufactured 36 months or more after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers and submit the relevant incident data. This threshold triggers expedited regulator review and a documented corrective-action assessment; the regulator will determine whether a recall is necessary based on the risk and evidence."
   }
