 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any thermal incident involving fire, smoke, uncontrolled overheating, injury, evacuation, or emergency-service response within 24 hours of becoming aware of it, with a fuller incident report within 10 business days. Other confirmed thermal incidents shall be reported within 10 business days. Manufacturers shall notify affected customers promptly, and no later than 5 business days after determining that a safety action or precaution is warranted; urgent risks require notice without delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 8% per model. Per-model results, including failure rates, shall be provided to regulators and to customers buying that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units placed on the market shall include remote emergency shut-off capability no later than 36 months after adoption. For units already installed on the adoption date, manufacturers shall provide a compliant retrofit or replacement path and complete it within 6 years, prioritizing units with known safety concerns."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption of this standard shall include built-in fire suppression designed and validated for the battery system."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Exceeding this threshold shall trigger a mandatory recall of that model unless the regulator promptly approves an alternative corrective action that provides equally protective risk control. Any such approval shall include a public rationale and follow-up monitoring."
   }
  },
