   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every known thermal incident involving overheating, smoke, fire, or thermal runaway to the appropriate regulator within 24 hours of becoming aware of it. Manufacturers must notify the affected customer within 72 hours of becoming aware of an incident involving that customer's unit, with safety instructions and a contact for follow-up."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model's measured failure rate must not exceed 7%; a model above that limit may not be newly sold until it passes a subsequent test and the regulator has reviewed its corrective-action plan. Manufacturers must report each model's failure rate, sample size, protocol, and test date to the appropriate regulator and make those per-model results available to customers purchasing that model. Results need not be disclosed publicly or to customers of other models."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units manufactured 24 months after this standard takes effect must support remote emergency shut-off, subject to regulator-approved safeguards against unauthorized activation. For already-installed units, manufacturers must offer compatible remote shut-off retrofits where feasible and complete required retrofits within 6 years after the standard takes effect; regulators may approve an alternative safety measure where retrofit is infeasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months after this standard takes effect must include built-in fire suppression designed and validated for the unit's battery chemistry and installation conditions. The regulator may approve an equivalent protective measure where built-in suppression is technically infeasible, provided the manufacturer demonstrates equivalent safety."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers and submit incident data, a risk assessment, and a corrective-action plan. The regulator must promptly review the evidence and order a regulator-supervised recall when the evidence establishes an unacceptable ongoing risk; pending review, it may require sales suspension or other interim protections."
   }
