 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every fire, thermal runaway, or other incident involving overheating to the relevant regulator within 5 business days of learning of it, whether or not it caused injury, property damage, evacuation, or emergency-service response. A fatality or incident presenting an ongoing serious hazard must be reported within 24 hours. Manufacturers must notify affected owners within 5 business days when an incident indicates a material safety risk to their model."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 8% per model. Manufacturers must provide the responsible regulator with per-model results, including the failure rate and test date, and must provide those results to customers who purchase that model before purchase. A model exceeding the limit must submit a corrective-action plan to the regulator within 60 days and pass a retest within 12 months. Pending retest, the regulator may require proportionate interim protections based on the risk; failure to meet the retest deadline may result in suspension of new sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery models placed on the market after 24 months from adoption must support secure remote emergency shut-off, with safeguards against unauthorized access and clear customer instructions. For units already installed on the adoption date, manufacturers must offer compatible upgrades or replacements and complete the retrofit program within 6 years. Where a retrofit is not technically feasible, the manufacturer must provide an equivalent safety measure or replacement."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units placed on the market 36 months or more after adoption must include built-in fire suppression designed to limit fire propagation, validated through a regulator-approved test protocol, and maintained according to the manufacturer's instructions. Any claimed exemption must be supported by evidence of an equally effective built-in fire-mitigation measure and approved by the regulator."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a verified model-specific rate exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly refer the matter to the regulator for review, including data quality and statistical uncertainty, and implement any interim protections required. A regulator-supervised recall is mandatory when a verified rate exceeds 10 per 100,000 in a year or the regulator determines that the model presents an unacceptable safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
