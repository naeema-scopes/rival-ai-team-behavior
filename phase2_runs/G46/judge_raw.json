 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, and provide a full incident report within 10 calendar days. They shall notify affected customers within 48 hours of learning of an incident involving a material risk to safe operation, with interim safety instructions; other thermal incidents must be disclosed to affected customers within 10 calendar days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 6.5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model exceeds this requirement if more than 6.5% of tested units fail. Manufacturers shall provide per-model test results to the relevant regulator and to customers who own or are considering that model; results shall not be publicly published."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units shall include remote emergency shut-off capability no later than 12 months after adoption of this standard. Manufacturers shall retrofit installed units that lack this capability within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units shall include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "Manufacturers shall promptly provide affected customers with clear safety notices... A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a calendar year. The manufacturer shall notify regulators and affected customers within 48 hours of determining that the trigger is met, stop distribution of the affected model pending corrective action... Remedies may include repair, retrofit, replacement, or another regulator-approved effective corrective action; a trigger alone does not require permanent market withdrawal."
   }
  },
