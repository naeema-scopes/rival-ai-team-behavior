 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every fire, thermal runaway, or other confirmed thermal incident involving a home battery to the responsible regulator within 24 hours of learning of it, including incidents with no injury or property damage. Manufacturers must notify affected customers within 48 hours when an incident indicates a credible safety risk, and promptly provide any updated instructions or warnings. Reports must not be withheld because an investigation is ongoing."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 60,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "During the first 60 months after adoption, a failure rate above 5% requires a regulator-approved corrective-action plan, interim protections proportionate to risk, and retesting on a regulator-set schedule. After that transition period, each model must meet a maximum failure rate of 5%. A rate above 5% does not by itself require withdrawal or a sales restriction; regulators should determine any such action based on verified incident records, the adequacy of protections, and progress under corrective-action plans."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units placed on the market 12 months or more after adoption must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must retrofit installed units to support remote shut-off within 72 months after adoption where technically feasible; where infeasible, they must notify affected customers and regulators, explain the limitation, and provide an appropriate alternative emergency protection plan."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months or more after adoption must include built-in fire suppression designed and tested for the unit's foreseeable thermal-fire hazards. Regulators may approve an equivalent protective design where it provides comparable or better safety performance."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly notify affected customers of material safety risks and provide updated precautions and repair information. A mandatory recall is triggered when a model exceeds 8 thermal incidents per 100,000 installed units in a year, using verified incident and installation data. A recall does not by itself require a sales ban."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
