 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, property damage, or emergency-service response to the regulator and notify affected customers within 24 hours after learning of it. Other credible thermal safety incidents shall be reported to the regulator within five business days; affected customers shall be notified promptly when the incident indicates a material risk or requires action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": 8,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model with a failure rate above 5% shall promptly implement corrective action and undergo retesting. While corrective action is underway, sales may continue if the manufacturer reports progress to the regulator and provides any necessary customer precautions; sales shall be suspended if the failure rate exceeds 8% or corrective action is not completed within a regulator-set period. Manufacturers shall submit per-model results to the regulator and provide exact results to customers who buy that model, with an explanation of the protocol and corrective actions. Results shall not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units shall support remote emergency shut-off. Manufacturers shall retrofit already-installed units to support remote emergency shut-off within six years of this standard taking effect, where technically feasible. Any unit that cannot be retrofitted shall be identified to its owner, with safe-use instructions and an explanation of the limitation."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after this standard takes effect. Manufacturers shall provide installation and maintenance instructions and disclose any limitations of the suppression system to customers."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 1,
    "serious_injury_recall": false,
    "quote": "A manufacturer shall notify affected customers and the regulator within 24 hours of a serious imminent hazard and within five business days of other material safety findings. A recall is mandatory when any individual model exceeds 8 thermal incidents per 100,000 installed units of that model in a year; the threshold shall be calculated separately for each model, not by aggregating incidents across a manufacturer's models. The manufacturer shall promptly notify the regulator and affected customers and provide remedy instructions, including applicable repair, replacement, or refund options."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
