 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any fire, thermal runaway, or other overheating incident involving a home battery to the relevant regulator within 5 business days after learning of it. An incident involving death, injury, evacuation, or property damage shall be reported within 24 hours. Reports to regulators shall not be delayed pending completion of an investigation."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5%. Exceeding 5% requires prompt regulator notification, investigation, and a corrective-action plan. The regulator shall assess the results and risk, may require interim protective measures, and shall determine whether sales must be suspended pending correction and retesting; continued sales may be allowed only under regulator-approved safeguards."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market 24 months after adoption shall support secure remote emergency shut-off, with customer safeguards and a local means of emergency operation. Manufacturers shall provide a retrofit or equivalent upgrade for installed units within 6 years after adoption where technically feasible, prioritizing higher-risk units. Where a retrofit is not feasible, the manufacturer shall notify the owner and regulator and provide an effective alternative safety measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after adoption. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer shall initiate a regulator-supervised recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers shall notify affected customers without delay, provide safe-use or shutdown instructions, and report recall progress and corrective actions to regulators."
   }
  },
  "holistic": {
