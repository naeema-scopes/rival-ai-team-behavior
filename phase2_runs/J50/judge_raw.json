    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving overheating, fire, or suspected thermal runaway within 5 calendar days of learning of it. An incident presenting an imminent risk of injury or spread of fire must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Results must be provided to customers considering or owning the model, but individual-company per-model failure rates must not be published to the general public. A failure rate above 5% requires a regulator-reviewed corrective-action plan and follow-up testing; it does not by itself bar certification or sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Manufacturers must provide a safe, secure shut-off capability for installed units that lack it within 6 years of adoption, where technically feasible; if it is not feasible for a unit, the manufacturer must notify its owner and regulator and provide an equivalent safety measure or replacement plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. The requirement must be verified through testing under a regulator-approved protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 5,
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in any year triggers prompt regulator verification, investigation, and a manufacturer corrective-action plan with a defined timetable. Following verification, the regulator must require a recall when the evidence indicates an unacceptable safety risk, or when the manufacturer fails to complete adequate corrective action on time."
   }
