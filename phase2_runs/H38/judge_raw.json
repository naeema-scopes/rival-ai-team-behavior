  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any fire, thermal runaway, or other thermal event causing injury, property damage, evacuation, or emergency-service response within 24 hours of learning of it. Other confirmed thermal incidents must be reported within 10 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 10,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% must be reported to the regulator within 24 hours, with a corrective-action plan submitted within 30 days. A failure rate above 10% requires suspension of sales until retesting demonstrates a rate of 10% or less, unless the regulator authorizes otherwise based on a documented risk assessment."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must include a secure remote emergency shut-off capability starting 2 years after adoption, subject to safeguards against unauthorized activation and a means of local emergency operation. Manufacturers must provide an upgrade plan for installed units and complete feasible retrofits within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. The suppression system must meet a jointly agreed performance and maintenance standard and must not create unreasonable risks during normal use or emergency response."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period, the manufacturer must notify the regulator within 24 hours and provide the data needed for a documented risk assessment. A recall is mandatory if the regulator determines that the model presents an unacceptable safety risk; the manufacturer must then promptly notify affected customers, stop distribution as directed, and submit a regulator-approved recall and remediation plan."
   }
