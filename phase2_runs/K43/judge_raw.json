 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any thermal incident involving overheating, fire, injury, or material property damage within 24 hours of learning of it, followed by a detailed report within 10 calendar days. They shall promptly notify the affected customer of an incident involving that customer's unit, provide safety instructions, and update the customer when material findings or corrective actions become available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model's failure rate must not exceed 5%. Manufacturers shall submit per-model protocols, sample sizes, and failure rates to regulators and disclose the per-model failure rate to customers who buy that model, with a clear explanation of the test and any corrective actions; these disclosures do not require publication to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For units already installed on the adoption date, manufacturers shall provide a compatible retrofit or other effective remote shut-off capability within 72 months, where technically feasible; any units not made compatible shall be identified to their owners and the regulator, with safe alternative shutdown instructions."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units placed on the market 36 months or more after adoption shall include built-in fire suppression designed to mitigate thermal runaway and reduce fire spread. The regulator may approve an equivalent protective design where the manufacturer demonstrates that it provides comparable or greater protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 1,
    "serious_injury_recall": false,
    "quote": "Manufacturers shall notify affected customers of a thermal incident involving their unit within 24 hours of learning of it and provide clear safety instructions. A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in a year, subject to regulator verification of the rate and installed-unit denominator."
   }
  },
