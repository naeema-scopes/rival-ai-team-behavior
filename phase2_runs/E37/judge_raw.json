    "feasibility_escape": "none",
    "quote": "New home battery units must support remote emergency shut-off no later than 36 months after adoption. For installed units, manufacturers must assess compatibility and prioritize retrofit or other effective risk mitigation for units presenting elevated risk; provide customers with the assessment and any available upgrade options within 24 months."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
