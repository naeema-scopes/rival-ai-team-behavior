    "public_publication": false,
    "quote": "A model exceeding a 5% failure rate must submit a corrective-action plan and complete retesting within 12 months. Manufacturers must submit per-model results and sample sizes to the regulator for oversight and provide the results, including the failure rate and sample size, to customers purchasing that model in a clear, accessible format."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
