 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every known battery overheating or fire event to the regulator within 24 hours of learning of it, including events that cause no injury or property damage, and must report any other thermal event that presents a credible risk of serious harm. Manufacturers must notify affected customers within 72 hours when an event indicates a material safety risk, and provide interim precautions and updates on corrective action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers must submit complete per-model results, including failure rates, to the regulator and disclose those results to customers buying that model before sale, in clear context alongside relevant safety information. No result alone, including a failure rate above 5%, automatically bars a model from sale; any sales restriction or other enforcement measure must be based on the regulator's assessment of that model's risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems placed on the market from 1 January 2028 must support a secure remote emergency shut-off accessible to the manufacturer and authorized emergency responders. For systems already installed on that date, manufacturers must provide a remote shut-off retrofit or equivalent safety upgrade within six years, where technically feasible, and notify owners of the schedule and any interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery systems placed on the market must include built-in fire suppression beginning 36 months after adoption of this standard. The regulator may approve equivalent protection where a manufacturer demonstrates that suppression is technically unsuitable or that an alternative provides equivalent or greater protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and provide the underlying data. The regulator must promptly investigate and determine whether a recall or other corrective action is required based on the model's risk and all relevant safety evidence. If a recall is ordered, the manufacturer must promptly notify affected customers and provide corrective-action instructions."
   }
