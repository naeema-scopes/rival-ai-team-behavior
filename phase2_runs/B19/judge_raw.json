  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 2,
    "scope": "serious_only",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any thermal incident involving fire, injury, evacuation, emergency-service response, or material property damage within 24 hours of learning of it, and submit a complete incident report within 10 calendar days. Other overheating incidents requiring service or safety-related shutdown shall be reported within 30 days. Manufacturers shall notify affected customers within 48 hours of learning of an incident that presents a credible ongoing safety risk, and promptly provide any regulator-required safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A result above 5% shall require a corrective-action plan and follow-up testing within a regulator-set period; it shall not by itself prohibit sale. The manufacturer shall also provide those results to customers who buy that model, in a clear and accessible format."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models shall include a remote emergency shut-off capability beginning 24 months after adoption of this standard. Existing installed units shall be upgraded where technically feasible within 72 months after adoption; manufacturers shall inform regulators of the number and share of units upgraded and any technical barriers."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "A model-specific thermal incident rate exceeding 8 incidents per 100,000 installed units in any 12-month period, calculated from validated incident and exposure data, shall trigger prompt regulator review and a mandatory customer-facing recall or other regulator-approved safety remedy. A rate exceedance alone does not require an automatic sales prohibition; regulators may order one where necessary to protect public safety."
   }
