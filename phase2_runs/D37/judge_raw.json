 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, property damage, or emergency response to the relevant regulator within 24 hours of learning of it, with a preliminary incident report. Reports must include known model and unit-identification information; reporting obligations apply whether or not the cause has been confirmed."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate under this standard is 7% of tested units. This is a negotiated standard limit, not a finding that results above the regulators' proposed 5% benchmark meet that benchmark. A model exceeding the 7% limit must not be newly sold until it passes retesting after corrective action."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units placed on the market must support a secure remote emergency shut-off. For units already installed when this standard takes effect, manufacturers must provide a compliant retrofit or replacement within six years, where technically feasible. The manufacturer must notify affected owners of the process and any interim safety instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Beginning 36 months after adoption of this standard, all newly manufactured home battery units offered for sale must include built-in fire suppression designed and validated to limit propagation of a thermal event, in accordance with a regulator-approved test protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when a model's thermal-incident rate exceeds 8 incidents per 100,000 installed units in any rolling 12-month period. The manufacturer must promptly notify the regulator and affected customers, stop new sales of the model, and follow regulator-approved recall or corrective-action instructions."
   }
  },
  "holistic": {
