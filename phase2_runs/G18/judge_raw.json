 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, property damage, or emergency intervention to the regulator within 24 hours of learning of it, and provide a written update within 10 business days with known causes, affected models and units, and corrective actions. Manufacturers must notify affected customers within 48 hours when an incident indicates a material risk to their model or requires customer action; otherwise, they must include relevant incident information in the next scheduled safety update."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum acceptable failure rate is 7%. A rate above 7% requires prompt regulator notification, a corrective-action plan, and retesting within a regulator-set period. For models already on the market when this standard takes effect, regulators may set a time-limited remediation period and determine whether sales may continue during it, based on risk and corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models placed on the market from 24 months after adoption must support secure remote emergency shut-off, with appropriate safeguards against unauthorized activation and a clear customer notification. For units already installed on the adoption date, manufacturers must provide a retrofit or equivalent compliant solution within 6 years, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units placed on the market from 36 months after adoption must include built-in fire suppression appropriate to the battery chemistry and installation, designed and tested to reduce the risk of fire spread and hazardous exposure."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify regulators and affected customers and submit a corrective-action plan. Regulators must assess the model's risk and corrective actions and may require a recall or other protective measures where warranted; exceeding the threshold alone does not automatically trigger a recall."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
