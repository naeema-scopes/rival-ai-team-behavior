 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery-related fire, thermal runaway, evacuation, serious injury, or death within 24 hours of learning of it. Other confirmed thermal incidents must be reported within 5 business days. Manufacturers must notify affected customers of a serious hazard or required safety action within 24 hours of notifying the regulator, and notify customers of other reportable thermal incidents or emerging model-level patterns within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 6,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers prompt notification to regulators, a corrective-action plan within 30 days, and retesting within 6 months. A model may continue to be sold during this period unless regulators determine that an immediate restriction is necessary to address an imminent serious risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly manufactured home battery systems must support remote emergency shut-off beginning 2 years after this standard takes effect. For units already installed on that date, manufacturers must provide a retrofit pathway and complete retrofits within 6 years where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 1,
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, using a consistent incident definition and verified installed-unit denominator, the manufacturer must notify regulators and affected customers within 24 hours and initiate a mandatory recall without delay."
   }
  },
