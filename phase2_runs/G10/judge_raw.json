 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or material property damage to the responsible regulator within 24 hours of learning of it, with a written incident report within 10 calendar days. The manufacturer shall notify affected customers within 48 hours when an incident indicates a safety risk relevant to their model or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model’s failure rate shall not exceed 5%. A model exceeding 5% shall not be newly sold until it passes a retest or the regulator approves an alternative risk-control plan. Before purchase, customers shall receive the model’s full per-model test results, including its failure rate and test protocol, along with compliance status and applicable safety measures. Individual companies’ per-model failure rates shall not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems shall include remote emergency shut-off capability for installations beginning 12 months after adoption. For units already installed at adoption, manufacturers shall provide a retrofit or equivalent upgrade within 72 months, where technically feasible; any unit not upgraded shall receive clear customer instructions for local emergency isolation."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems manufactured for sale or installation shall include built-in fire suppression beginning 36 months after adoption. Units placed on the market before the effective date are not required to be retrofitted under this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is required when a model’s rate exceeds 10 incidents per 100,000 installed units in any 12-month period, or whenever the regulator determines that an imminent serious hazard exists, regardless of the rate. For rates above 8 through 10, the regulator may require a recall or approve an alternative risk-control plan only if it adequately protects customers and the public."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "safe",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 50,
  "conflict_styles": {
