 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every battery-related fire, thermal runaway, or overheating incident to the relevant regulator within 24 hours of becoming aware of it, including incidents without injury or property damage. They must provide affected customers with an initial safety notice within 72 hours, including immediate precautions and how to report symptoms or damage."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each battery model must undergo the prescribed sustained-heat test at 55 °C. A failure rate above 5% requires a corrective-action plan submitted to the regulator and retesting within a regulator-approved period."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Newly manufactured battery systems must include a secure remote emergency shut-off capability. Manufacturers must retrofit compatible systems already installed, or provide an equivalent safe mitigation approved by the regulator, within six years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery systems must include built-in fire suppression beginning 36 months after this standard takes effect. Regulators may approve an equivalent or alternative measure where appropriate."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, calculated for that model from the preceding 12 months; company-wide rates must not substitute for model-specific rates. It must notify the regulator and affected customers without delay, explain the risk and remedy, and report recall progress."
   }
  },
