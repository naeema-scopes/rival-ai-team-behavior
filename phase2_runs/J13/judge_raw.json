  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Reports of fire, injury, or an active risk to people or property are due within 24 hours of discovery; other thermal-incident reports are due within 5 business days. Within 5 business days, manufacturers must notify affected customers when an incident may indicate a safety risk, and provide prompt updates on protective actions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The 5% failure rate is the regulatory performance threshold under discussion. The regulator must determine proportionate measures based on the level of risk and verified evidence; exceeding the threshold alone does not automatically require a permanent sales ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on all newly manufactured units beginning 24 months after this standard takes effect. Units already installed must be retrofitted, where technically feasible, within 6 years; manufacturers must notify owners of retrofit availability, costs, and any safety limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect. Regulators may approve an equivalent protective design where the manufacturer demonstrates that it provides comparable or greater fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units during a rolling 12-month period triggers a mandatory recall. Within 24 hours of verification, manufacturers must notify regulators and affected customers and initiate the recall."
   }
  },
