 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "A manufacturer must report every battery-related thermal incident involving overheating, smoke, fire, or emergency thermal shutdown to the relevant regulator within 72 hours of becoming aware of it, including incidents for which the cause is not yet established. The manufacturer must notify affected customers promptly, and no later than 72 hours after determining that an incident presents a material safety risk, with practical safety instructions and a contact channel."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model with a failure rate above 5% must submit a corrective-action plan to the regulator and undergo retesting within 90 days; exceeding 5% does not by itself prohibit sale or require a recall. Manufacturers must provide customers and prospective buyers with the model's 55 °C test failure rate, test date, and any relevant precautions or corrective actions in plain language. Per-model test results must not be published for the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New battery models placed on the market after adoption must support remote emergency shut-off. Manufacturers must retrofit installed units that do not support the function, or provide an equivalent safety mitigation approved by the regulator, within six years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New battery units must include built-in fire suppression beginning 36 months after adoption. Regulators may approve an equivalent mitigation for a specific design where evidence demonstrates comparable protection for households and neighbours."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in a year, as verified by the regulator, must be recalled promptly; the manufacturer must notify affected customers and provide the regulator with requested data and corrective-action details. Manufacturers must provide customers with clear safety instructions at purchase and promptly notify affected customers of material hazards, recommended precautions, and corrective actions."
   }
  },
