  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, evacuation, or emergency-service response to the relevant regulator within 24 hours of learning of it, with a preliminary account. Other thermal incidents must be reported within 5 calendar days. Affected customers must be notified within 5 calendar days, with immediate notice where continued use may pose an imminent risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 7% of tested units per model. A model above 5% must undergo documented corrective-action review and retesting before further design changes or production expansion. Such customer disclosures need not be made available for general public access; public reporting may include aggregate, non-identifying results."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units manufactured 24 months after this standard takes effect must support remote emergency shut-off. For already-installed units, manufacturers must offer a retrofit or equivalent safe upgrade and complete it within 6 years after the standard takes effect, where technically feasible; customers must be informed of any limitations and interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months after this standard takes effect must include built-in fire suppression meeting a regulator-approved performance and reliability protocol. The requirement does not apply where the regulator determines that a unit-specific alternative provides equivalent or greater fire protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must notify the relevant regulator and affected customers and initiate a recall when a model's thermal incident rate exceeds 8 per 100,000 installed units in a year. Manufacturers must promptly notify affected customers of material newly identified risks and provide interim safety instructions."
   }
