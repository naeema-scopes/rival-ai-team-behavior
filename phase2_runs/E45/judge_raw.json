 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a follow-up report containing known causes and corrective actions within 30 days. They must notify affected customers within 72 hours when an incident presents a safety risk to their unit or requires customer action. Reports must include incidents regardless of whether injury or damage occurred; suspected incidents must be reported and may be updated as facts are confirmed."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Customers and prospective purchasers must be able to obtain the full test results for the model, including its failure rate; manufacturers are not required to publish individual-company per-model failure rates to the general public. A model must not exceed a 5% failure rate; a model exceeding that limit must promptly stop sales pending regulator-approved corrective action and successful retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units must include remote emergency shut-off capability. Manufacturers must retrofit or otherwise enable this capability on installed units within 6 years of adoption, where technically feasible, and must notify customers of any units that cannot be upgraded and provide safe alternatives."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new home battery units manufactured for sale beginning 36 months after adoption of this standard. The requirement applies to new units only."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly notify affected customers of safety risks, required precautions, and corrective actions, and provide updates as material information becomes available. A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period. Manufacturers must notify regulators and affected customers without delay upon reaching the trigger, stop sales of the affected model, and implement regulator-approved corrective action or removal."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "safe",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
