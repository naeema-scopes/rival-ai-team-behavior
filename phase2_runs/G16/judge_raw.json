 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 48,
    "other_report_days": 2,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 48 hours of learning of it, with a follow-up investigation report within 30 days. Affected customers must be notified promptly when an incident indicates a potential safety risk, and no later than five days after that determination. Manufacturers shall retain records and report incidents even when the cause is uncertain."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A result above 5% triggers regulator review and a corrective-action plan; any sales restriction shall be determined by the regulator based on evidence and risk. Customers considering or owning a model shall receive its individual 55 °C failure rate, test date, a plain-language summary of its safety status, clear safety instructions, and any required actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units placed on the market from 24 months after adoption shall support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. For units already installed on the adoption date, manufacturers shall provide a retrofit or equivalent safe alternative within six years, prioritizing units with elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression beginning 36 months after adoption of this standard. The requirement applies to all models placed on the market from that date; manufacturers shall document the system's effectiveness and maintenance requirements in the product safety materials."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 confirmed thermal incidents per 100,000 installed units in any rolling 12-month period shall trigger prompt regulator review of verified counts, denominators, attribution, and risk. The regulator shall determine whether a recall or other corrective action is required based on that evidence."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "collaborating",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": 1,
  "section_notes": "S1 is strong: all thermal incidents must be reported within 48 hours, including while the cause is uncertain, and customers are notified within five days of a determination. S2 and S5 are the weakest sections: the 5% test failure rate and the 8-per-100,000 incident rate both trigger only regulator review, with no mandatory sales stop and no mandatory recall, so models above the thresholds can stay on sale. Customers do receive per-model 55 °C failure rates under S2, which is the disclosure Halcyon required."
 },
