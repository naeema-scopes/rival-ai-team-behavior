 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, fire, or suspected thermal runaway to the relevant regulator within 24 hours of becoming aware of it, and provide a written follow-up within 10 business days. Customers whose units are affected by an incident or identified safety risk must be notified promptly, and no later than 72 hours after the manufacturer becomes aware, with known hazards and immediate protective steps clearly stated."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 24,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% of tested units per model. Manufacturers must provide complete per-model results to the relevant regulator and disclose those results to current and prospective customers of that model. General-public publication is not required. ... exceeding the limit alone does not automatically prohibit further placements."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units must include a remote emergency shut-off capability ... Existing installed units must be brought into compliance, where technically feasible, within six years of adoption; manufacturers must report units that cannot be retrofitted and the reasons to the regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly provide affected customers with clear safety notices describing known hazards and protective steps, and notify customers of a recall without undue delay. If any model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, a recall is mandatory."
   }
  },
