 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any fire, thermal runaway, or other thermal incident involving a home battery within 5 business days of learning of it; an incident involving injury, evacuation, or material property damage must be reported within 24 hours. Manufacturers must notify affected customers within 5 business days when an incident presents a safety risk or requires inspection, updated instructions, or corrective action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": true,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "No more than 5% of tested units for any model may fail. For models already on the market when this standard takes effect, manufacturers must submit per-model results, a risk assessment, and a corrective-action and retesting schedule to the regulator within 90 days. Such models may continue to be sold while the regulator reviews the submission and sets a proportionate compliance deadline, unless the regulator determines that interim safeguards or restrictions are warranted by risk. Manufacturers must submit per-model results, including failure rates and sample sizes, to the regulator and provide them to customers purchasing that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support secure remote emergency shut-off by 1 January 2029, with safeguards against unauthorized activation and clear customer instructions. For units already installed on that date, manufacturers must provide compatible remote shut-off through retrofit or replacement within 6 years, where technically feasible; they must notify customers of any limitations and interim safety measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression starting 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and provide supporting data and a corrective-action plan. The regulator must require a recall of that model and determine the recall's scope and timing. Manufacturers must promptly notify affected customers of any recall and explain the actions they should take."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
