 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any battery-related fire, thermal runaway, or overheating event requiring emergency-service response, causing injury or property damage, or requiring evacuation, within 24 hours of learning of it. Other confirmed thermal incidents shall be reported within 5 business days. Manufacturers shall notify affected customers within 5 business days of confirming a safety risk that could require a change in use or service, and immediately where continued use presents an imminent serious risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A result above the 5% benchmark triggers regulator review and a corrective-action plan with retesting on a regulator-approved schedule. The benchmark is a safety trigger for review and remediation, not by itself an automatic market ban; regulators may impose proportionate measures based on evidence and risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New home battery units shall support a remotely initiated emergency shut-off no later than 36 months after adoption of this standard. For units already installed, manufacturers shall provide remote shut-off capability through retrofit or replacement within 6 years after adoption, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression no later than 36 months after adoption of this standard. The transition period does not limit regulators' authority to require earlier measures for a specific model where evidence indicates an imminent serious risk."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a 12-month period, the manufacturer shall promptly notify regulators and customers who own or are considering that model, and submit the incident data and a corrective-action plan for review. The threshold triggers a regulator risk assessment, not an automatic recall or stop-sale."
   }
  },
