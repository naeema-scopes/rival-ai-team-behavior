 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 120,
    "other_report_days": 5,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving a home battery to the regulator within 5 calendar days of learning of it, and notify the affected customer within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires the manufacturer to submit a regulator-approved corrective-action plan, provide appropriate interim risk controls and customer safety information, and retest within 12 months. Exceeding 5% alone does not automatically prohibit sales; sales may continue during corrective action unless regulators determine that restrictions are warranted by the risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models placed on the market beginning 3 years after adoption must support remote emergency shut-off, with safeguards against unauthorized activation. For units installed before that date, manufacturers must provide a compatible remote shut-off retrofit or equivalent safe upgrade within 6 years after adoption, where technically feasible, and inform customers of its availability and any limitations."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
