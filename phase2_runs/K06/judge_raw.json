 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving overheating, smoke, fire, or thermal injury to the relevant regulator within 24 hours of becoming aware of it, including incidents initially reported by customers or service personnel. Manufacturers must notify affected customers within 72 hours when an incident presents a credible safety risk to their unit or household, and provide follow-up instructions promptly."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% for any model. Manufacturers must provide per-model results and test methods to regulators and disclose the per-model failure rate and a clear safety summary to customers purchasing that model; results must not be publicly published by company or model. Regulators may restrict sales if corrective action is inadequate or testing identifies an imminent serious risk; exceeding the test limit alone does not automatically ban a model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
