  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of becoming aware of it, including incidents initially classified as near misses. Manufacturers shall promptly notify affected customers directly when an incident involving their unit or newly identified information presents a potential safety risk, with clear precautions and available remedies."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate of 5% is the benchmark for corrective action, not an automatic bar to sale. Manufacturers shall submit per-model results, including failure rates and test protocols, to the regulator and provide the results to customers who buy that model in clear, accessible form; results shall not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For units already installed when this standard is adopted, manufacturers shall provide the capability through retrofit or an equivalent verified safety measure within 72 months, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression, or an independently verified equivalent built-in fire-mitigation system, beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer shall notify the regulator when a model reaches 8 thermal incidents per 100,000 installed units in a year; the regulator shall assess the evidence and may require a recall where warranted. Customers shall receive clear safety instructions at purchase and prompt, direct notice of newly identified hazards affecting their unit, including recommended precautions and available remedies."
   }
