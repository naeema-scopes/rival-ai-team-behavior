 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": "immediate",
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of learning of it, with a fuller account within 10 business days. Other confirmed overheating incidents shall be reported within 10 business days. Manufacturers shall promptly notify affected customers when an incident indicates a material safety risk, and provide regulators with periodic incident summaries and corrective actions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Regulators may require proportionate interim safeguards or restrict sales where a documented risk assessment warrants it; exceeding the threshold alone does not automatically prohibit sales. Per-model test results, including failure rates, shall be provided to the relevant regulator and to customers who buy that model, and shall not be publicly disclosed as individual-company results."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units shall support remote emergency shut-off no later than 36 months after adoption of this standard... For already-installed units, manufacturers shall provide compatible remote shut-off capability or an equivalent safety upgrade within six years after adoption, where technically feasible; regulators may approve alternative risk-reduction measures where a retrofit is infeasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured for sale shall include built-in fire suppression no later than 36 months after adoption of this standard. Existing installed units are not subject to retrofit under this requirement."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers shall promptly notify regulators and affected customers of a recall, explain the remedy and timeline, and provide periodic completion updates."
   }
  },
