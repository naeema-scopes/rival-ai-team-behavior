  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery-related fire, thermal runaway, explosion, or injury to the relevant regulator within 24 hours of becoming aware of it, with a preliminary account of known facts. Other confirmed overheating events must be reported within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% per model. Exceeding the limit requires corrective action and regulator review, but does not automatically require withdrawal of units already in service, suspend new sales, or impose a permanent market ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For units already installed when this standard takes effect, manufacturers must offer an upgrade or other technically feasible means of remote shut-off within 6 years. Where retrofitting is infeasible, the manufacturer must document the reason and provide an equivalent risk-reduction measure and customer guidance."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery systems must include built-in fire suppression. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 1,
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly notify affected customers of material safety risks, incidents, and corrective actions, using the timelines in S1. A manufacturer must initiate a recall of any model whose thermal-incident rate exceeds 8 per 100,000 installed units in a year, notify the relevant regulator and affected customers, and provide safe-use or shutdown instructions while the recall is implemented."
   }
