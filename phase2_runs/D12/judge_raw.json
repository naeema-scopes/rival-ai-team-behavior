 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it. They must notify affected customers within 48 hours, with known hazards and immediate safety steps; urgent risks require immediate notice. Reports must include known incident circumstances and follow-up findings, and must not omit incidents because they were not independently verified."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo sustained-heat testing at 55 °C using a representative sample and a documented, consistently applied protocol. No more than 5% of tested units for any model may fail. Before sale and after material design changes, manufacturers must provide per-model test results and the test protocol to the relevant regulator and to customers who buy that model. A model that exceeds the 5% failure limit must not be sold until corrective action is taken and a subsequent test demonstrates compliance."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All newly installed home battery systems must support remote emergency shut-off. Existing installed units that lack this capability must be upgraded or replaced within six years of this standard taking effect, where technically feasible; customers must be informed of interim safe-use instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after this standard takes effect. Until the requirement takes effect, manufacturers must disclose whether a unit includes built-in suppression and provide appropriate fire-safety instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model with more than 8 thermal incidents per 100,000 installed units in any rolling 12-month period must be recalled; the manufacturer must promptly notify regulators and affected customers, stop sales, and provide a remedy and safe-use or removal instructions. Manufacturers must promptly notify affected customers of new material safety findings and provide updated instructions."
   }
  },
