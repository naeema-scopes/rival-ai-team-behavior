 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report each thermal incident involving fire, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of learning of it, with a full incident report within 10 business days. Other confirmed thermal incidents must be reported to the regulator within 10 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model with a failure rate above 5% must submit a corrective-action plan to the regulator and undergo retesting within 12 months; exceeding 5% alone does not automatically prohibit sale. Customers must receive their model's failure rate and a plain-language explanation of the results; regulators may publish appropriately aggregated industry data."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units must support remote emergency shut-off. Manufacturers must retrofit installed units that do not support the function, or provide an equivalent regulator-approved emergency shut-off measure, within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period, subject to regulator verification using a consistent denominator and reporting method, the manufacturer must promptly investigate, submit findings to the regulator, and notify affected customers. A verified exceedance triggers a mandatory recall."
   }
  },
