 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, and provide a written incident report within 10 business days. They shall notify affected customers within 48 hours when the incident presents a potential safety risk, and promptly update them as material facts emerge."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% is an action threshold requiring the manufacturer to submit a corrective-action plan and retest on a regulator-approved schedule; it is not, by itself, an automatic sales ban. Manufacturers shall provide exact per-model results confidentially to regulators and disclose the exact results for each model to its owners and prospective customers."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "All new units must include a remote emergency shut-off capability. Manufacturers shall retrofit installed units that lack this capability, where technically feasible, within six years of adoption of this standard."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new units manufactured 36 months or more after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, the manufacturer shall notify the regulator within 24 hours and provide supporting records and calculations. Exceeding this threshold triggers a mandatory recall; the manufacturer shall promptly notify affected customers, provide recall instructions and an effective remedy, and comply with any regulator-directed sales suspension."
   }
  },
  "holistic": {
