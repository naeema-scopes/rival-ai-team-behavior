 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving a battery, including overheating, fire, injury, emergency-service response, or property damage, to the regulator within 24 hours of learning of it, with a preliminary account and available exposure data. Manufacturers must notify affected customers within 48 hours after identifying a material safety risk, explaining known hazards and immediate protective steps; they must provide updates as corrective actions develop."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model passes only if no more than 7% of tested units fail. Before purchase, customers must receive the model’s actual test results, including its failure rate, along with material risks and corrective actions. These results must be provided directly to relevant customers and the regulator; individual-company per-model failure rates must not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support remote emergency shut-off beginning 36 months after adoption. Manufacturers must, within 6 years after adoption, retrofit installed units that can be safely and feasibly upgraded, and publish a model-specific retrofit plan and schedule for other units."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Any model exceeding 8 verified thermal incidents per 100,000 installed units in a year must be recalled. Manufacturers must promptly notify affected customers of a newly identified material safety risk and provide updates on corrective action."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
