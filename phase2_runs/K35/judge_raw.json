 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a written update within 10 business days. Manufacturers must notify affected customers within 72 hours when an incident presents a credible safety risk to them or nearby households, and provide any immediate protective instructions without delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": 8,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate for new certification is 5%. A model above 5% must not receive new certification or be newly placed on the market unless the regulator approves a temporary transition plan for a result above 5% and no higher than 8%. Any such plan must specify corrective actions, enhanced incident monitoring, and a retest deadline no later than 12 months after approval; ... Manufacturers must submit results and any corrective-action plan to regulators and provide per-model results to customers before purchase; results must not be publicly published."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For units already installed on the date of adoption, manufacturers must provide compatible remote shut-off capability within 6 years where technically feasible; otherwise they must notify affected customers and the regulator of the limitation and provide an alternative risk-reduction plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Home battery units manufactured for sale 36 months or more after adoption must include built-in fire suppression designed and validated to reduce the risk of fire spread from a thermal event. The requirement applies to new units and does not require retrofit of units installed before its effective date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly notify affected customers of material new safety information and provide practical protective steps. ... A mandatory recall is triggered when a model exceeds 8 thermal incidents per 100,000 installed units in that period; regulators may also require a recall or other corrective action where evidence indicates an imminent risk, regardless of that rate."
   }
  },
