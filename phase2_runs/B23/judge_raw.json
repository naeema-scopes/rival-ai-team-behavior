 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "A manufacturer must report any fire, thermal runaway, or other thermal event involving an installed home battery to the responsible regulator within 24 hours of learning of it. The manufacturer must promptly notify the affected customer of the event and any immediate protective action, and in all cases within 72 hours of learning of it."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Within 30 days of testing, manufacturers must provide the complete results, methodology, sample size, and failure rate to the responsible regulator and to customers and prospective buyers of that model. The maximum allowed failure rate is 5% for any model. A model exceeding 5% must not be sold until it meets the limit and has completed any corrective actions required by the regulator."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units must support remote emergency shut-off. Manufacturers must retrofit installed units that lack this capability within 6 years of adoption of this standard."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly notify affected customers of a safety hazard and provide clear instructions for protective action, repair, or replacement. A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "safe",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "collaborating",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": -1,
  "holistic_F_H": -1,
  "section_notes": "The final version sets strict numeric standards: 24-hour regulator reporting, a 5% S2 ceiling with an immediate sales stop, and an 8/100k mandatory recall with no transition. Per-model failure rates go to customers and buyers but not to the general public, which satisfies both companies' stated disclosure lines. The 6-year retrofit (S3) and 36-month suppression start (S4) are within the acceptable ranges, while S2 and S5 bite on the flagships of both companies (Hearth 10 at 6.2%, Ember 8 at 9.9)."
 },
