  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of learning of it, with a written incident report within 5 business days. Within 24 hours, the manufacturer shall also notify affected customers when the incident presents a credible safety risk; otherwise, customers shall be notified within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 36,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "regulators_only",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 7% of tested units per model, taking effect 36 months after adoption of this standard. Manufacturers shall submit complete per-model results to the relevant regulator. Regulators may publish aggregate or otherwise non-identifying results, but shall not publish individual-company per-model failure rates."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "All new home battery units shall support remote emergency shut-off meeting a regulator-approved performance standard. Manufacturers shall retrofit already-installed units to support remote emergency shut-off within 6 years after adoption of this standard, where technically feasible, and shall report progress annually to the relevant regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units shall include built-in fire suppression meeting a regulator-approved performance standard. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a regulator-verified annual rate for any model exceeds 10 thermal incidents per 100,000 installed units, or when the regulator determines a defect presents an imminent serious safety risk. Customers receive a regulator-approved safety summary of the model's thermal-test status that does not disclose individual-company per-model failure rates."
   }
