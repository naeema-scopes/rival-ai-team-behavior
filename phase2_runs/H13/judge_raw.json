    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model's failure rate must not exceed 8%. Exceeding the limit alone does not automatically require stopping sales; regulators may require additional measures based on the results and risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units must support remote emergency shut-off no later than 24 months after the standard takes effect, where safe operation and connectivity permit. For units already installed, manufacturers must provide a retrofit or equivalent safety upgrade within 6 years after the standard takes effect."
   },
