 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the regulator any fire, thermal runaway, or overheating incident involving injury, property damage, evacuation, emergency-service response, or suspected product defect within 24 hours of learning of it. Other thermal incidents shall be reported within 10 business days. Manufacturers shall notify affected customers within 72 hours when an incident indicates a material safety risk, and provide updates as the investigation proceeds."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% per model. Manufacturers shall submit full per-model results, methods, and sample sizes to the regulator. Exceeding the limit alone shall not automatically prohibit sales, though the regulator may restrict new sales if the manufacturer fails to meet the plan."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models shall support remote emergency shut-off no later than 36 months after adoption. Manufacturers shall retrofit already-installed units to support remote emergency shut-off within six years after adoption, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer shall initiate a recall when a model's annual thermal-incident rate exceeds 8 incidents per 100,000 installed units. Manufacturers shall promptly notify affected customers of material safety risks and provide clear instructions for safe use, service, or cessation of use."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -1,
  "section_notes": "The final S2 keeps the 5% limit and per-model results confidential to regulators and purchasers, but removes the automatic sales stop, so a model above 5% (e.g., Hearth 10 at 6.2%) can keep selling indefinitely while under a corrective-action plan. S5 imposes a mandatory recall at 8 per 100,000 with no transition, which directly hits Ember 8 at 9.9, while S4 suppression is delayed to 36 months and S3 gives six years for retrofit. S1 reporting is strong (24h serious, 14-day other, all incidents), which constrains both companies' unreported incidents."
