 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving fire, smoke, injury, property damage, or an emergency shutdown to the regulator within 24 hours of becoming aware of it, and provide a full incident report within 10 calendar days. Incidents involving death, serious injury, or fire spreading beyond the battery shall also be reported to affected customers and households within 24 hours; other affected customers shall be notified within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 7% for any model. Individual-company per-model failure rates shall not be publicly published; regulators may publish anonymized or aggregated results."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units manufactured 24 months or more after adoption shall support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers shall retrofit already-installed units with remote shut-off capability within 6 years of adoption where technically feasible, prioritizing units with known safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after adoption. Manufacturers shall submit evidence of the suppression system's safety and effectiveness to the regulator."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when a model's independently validated annual thermal-incident rate exceeds 8 incidents per 100,000 installed units. Manufacturers shall promptly notify affected customers of material safety risks, incidents indicating a potential defect, and corrective actions, using direct contact where reasonably available and public notices otherwise."
   }
  },
