  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any fire, thermal runaway, overheating event requiring emergency-service response, or event causing injury or property damage to the relevant regulator within 24 hours of learning of it. Other confirmed thermal incidents must be reported within 5 business days, including incidents whose cause is still under investigation."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo the prescribed sustained-heat test at 55 °C before sale and at least annually... Regulators shall determine proportionate risk controls based on the test evidence and other relevant safety information; exceeding the benchmark alone does not automatically require a sales ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": null,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units must support secure remote emergency shut-off no later than 24 months after this standard takes effect... any required retrofit deadline for existing units must be no earlier than 6 years after the standard takes effect."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after this standard takes effect. The standard may permit an equivalent alternative only where the manufacturer demonstrates to the regulator that it provides comparable protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers, and the regulator must assess the evidence and require proportionate corrective action, including a recall where warranted by the risk."
   }
  },
