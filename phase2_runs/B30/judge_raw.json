  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "A report is due within 24 hours of the manufacturer becoming aware of the incident, with material updates provided promptly as facts are confirmed. Manufacturers must notify affected customers within 72 hours when an incident indicates a potential safety hazard to their unit or requires customer action; notices must state the hazard, recommended immediate precautions, and how to obtain assistance."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers regulator-supervised corrective-action review; it is not by itself an automatic ban on sales. Manufacturers must retain the protocol, sample size, results, and corrective actions, and provide complete per-model results, including model, test date, failure rate, and method, to the relevant regulator and to customers who buy that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "For installed units that lack this capability, manufacturers must provide a retrofit or equivalent safe mitigation within six years of adoption, prioritizing units with known hazards."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "Customers must receive clear safety notices about hazards affecting their model, including the hazard, precautions, and any action required, within 72 hours of the manufacturer learning information indicating a potential safety hazard. A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
