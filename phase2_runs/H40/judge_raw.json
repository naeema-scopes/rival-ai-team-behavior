 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents initially reported by customers or installers. The manufacturer must notify affected customers promptly and no later than 72 hours after learning of a potentially relevant hazard, with immediate notice where continued use presents an imminent risk. Reports must not be withheld because an investigation is ongoing."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers prompt regulator notification and a corrective-action and retesting plan; it is not, by itself, an automatic prohibition on sale. Customers must receive the model's test failure rate and a clear results summary directly before purchase and when materially updated. Individual company per-model failure rates must not be published or made available through a public database."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units must support remote emergency shut-off... Manufacturers must retrofit installed units that lack this capability within six years after adoption, where technically feasible; if a unit cannot be safely retrofitted, the manufacturer must notify its owner and regulator and provide an equivalent protective measure or replacement plan within that period."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression designed for the battery's foreseeable thermal hazards. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, using the installed-unit count and incident data for that model. Manufacturers must promptly notify affected customers of material newly identified safety risks and provide updated instructions."
   }
  },
