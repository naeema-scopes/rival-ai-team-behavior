    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, and provide a complete incident report within 10 business days. The manufacturer shall notify affected customers within 72 hours when an incident indicates a credible safety risk to their model, including interim precautions and available support. Suspected incidents shall be reported; manufacturers shall not delay reporting pending confirmation of cause."
   },
   "S2_thermal_testing": {
