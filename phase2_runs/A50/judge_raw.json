    "public_publication": false,
    "quote": "A failure rate above 5% shall prompt corrective action and confirmatory testing, but shall not by itself require a sales ban. Before purchase, prospective customers shall receive material safety findings and precautions relevant to safe use, including notice when a model exceeds the applicable failure-rate limit."
   },
   "S3_remote_shutoff": {
