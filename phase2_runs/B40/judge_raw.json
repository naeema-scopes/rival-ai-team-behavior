 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 168,
    "other_report_days": 7,
    "customer_notice_days": 14,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the relevant regulator within 5 business days of learning of it, and notify affected customers within 10 business days when the incident may indicate a safety risk. Imminent hazards must be reported to regulators and affected customers without delay, and no later than 24 hours after discovery."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers regulator notification, a corrective-action plan, and retesting on a regulator-approved schedule; it does not by itself prohibit continued production. Before purchase, purchasers must receive the full test results, including the failure rate, for the model they are considering."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units placed on the market 2 years after this standard takes effect must support secure remote emergency shut-off. Manufacturers must provide a practical retrofit for installed units that can support the function, completing the retrofit within 6 years after the effective date."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units placed on the market 36 months after this standard takes effect must include built-in fire suppression meeting a regulator-approved safety and reliability protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model's verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in a year, the manufacturer must promptly notify regulators and provide incident and corrective-action data. Regulators shall assess the evidence, including incident severity, test results, and corrective actions, and may require a recall or other protective action where warranted."
   }
  },
  "holistic": {
   "S1_incident_reporting": "weakened",
