 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, with a preliminary account and known safety risks. Manufacturers shall notify affected customers promptly when an incident indicates a material safety risk, and no later than 72 hours after that determination."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The target maximum failure rate is 5%. A model exceeding 5% shall promptly notify the regulator and affected customers, submit a corrective-action plan with milestones, and undergo enhanced testing and monitoring. Exceedance alone shall not require market withdrawal while the regulator-supervised plan is being followed; regulators may require interim protective measures where warranted by risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units shall support remote emergency shut-off when installed from three years after this standard takes effect. For units already installed on that date, manufacturers shall provide a retrofit or equivalent safe mitigation within six years, prioritizing units with known elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression for units manufactured or installed on or after 36 months following this standard's adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "A manufacturer shall initiate a regulator-supervised mandatory recall when a model's verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any 12-month period. They shall notify affected customers promptly, and no later than 72 hours after identifying a material safety risk, and provide applicable corrective-action instructions."
   }
  },
