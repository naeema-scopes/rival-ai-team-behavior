 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Incidents involving fire, injury, or a credible risk of imminent harm must be reported within 24 hours of discovery; all other thermal incidents must be reported within 5 business days. Manufacturers must notify affected customers within 72 hours of discovering a material safety risk, or sooner where necessary to prevent imminent harm, and provide safety instructions and a contact for questions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Before purchase, customers must receive the actual per-model test results, including the failure rate, as well as known material safety risks and operating guidance. A model with a failure rate above 5% may not be newly placed on the market; the manufacturer must take corrective action and retest before resuming market placement."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Units installed before this requirement takes effect must be upgraded or replaced to provide the capability within 6 years after adoption, where technically feasible; any unit that cannot be upgraded must be disclosed to its owner and the regulator, with a safe alternative or replacement plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator and affected customers, submit supporting incident data. The regulator must assess the evidence and require proportionate corrective action, including a recall where the evidence indicates serious or imminent safety risk."
   }
  },
