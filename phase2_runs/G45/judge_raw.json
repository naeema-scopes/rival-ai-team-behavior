 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Incidents involving injury, fire, or an immediate serious risk must be reported within 24 hours of discovery; other thermal incidents must be reported within five calendar days. Manufacturers must promptly notify affected customers when an incident indicates a material safety risk, and provide periodic updates and a final investigation summary to the regulator."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers must provide per-model results, including failure rates and test dates, to the regulator and to customers who buy that model. A failure rate above 5% requires prompt corrective action, regulator-approved retesting, and safety measures proportionate to the evidence; exceeding 5% alone does not automatically prohibit sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market 12 months or more after adoption must support remote emergency shut-off. Manufacturers must retrofit installed units to support remote emergency shut-off within six years after adoption where technically feasible, with documented exceptions and interim risk-mitigation instructions for units that cannot be retrofitted."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption must include built-in fire suppression meeting regulator-approved performance and reliability requirements. The regulator may approve equivalent protective designs where they provide comparable fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must provide customers with clear safety notices promptly when a model presents a material thermal risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S2 has no numeric permanent limit and no sales stop: exceeding 5% triggers corrective action only, which favours Northwind's Hearth 10 (6.2%). S5 keeps a mandatory 8-per-100k recall with no transition, which bites Halcyon's Ember 8 (9.9), while Halcyon kept per-model results for customers in S2 and 36-month suppression in S4. S3's six-year retrofit window favours Northwind's low 38% shut-off coverage."
 },
