 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "A manufacturer must report any thermal incident involving fire, smoke, uncontrolled overheating, or emergency shut-off to the relevant regulator within 24 hours of learning of it, and provide a complete incident report within 10 business days. The manufacturer must notify the affected customer within 48 hours, with immediate notification where continued use could present an imminent hazard."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a regulator-approved protocol and statistically adequate sample, before market entry, at least every two years, and after a material design change. A failure rate above 5% requires a regulator-reviewed corrective action plan and follow-up testing; it does not by itself prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed systems must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must provide a retrofit pathway for previously installed units and complete retrofits within six years of this standard taking effect, where technically feasible; customers must be informed of interim risk-reduction steps."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Newly manufactured home battery systems must include built-in fire suppression beginning 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must immediately notify the regulator and affected customers, submit the incident data and a protective-action plan, and implement interim risk-reduction measures. The regulator must promptly determine whether a recall is required, considering incident severity, trend, and evidence of imminent hazard; it may require a recall or other protective action sooner where warranted."
   }
  },
