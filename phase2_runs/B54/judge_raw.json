 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving a battery, including overheating without fire, injury, emergency-service response, or material property damage, to the relevant regulator within 72 hours of learning of it, with a complete incident report within 30 days. Affected customers must be notified within 5 business days when an incident presents a potential safety risk to their unit or other units of the same model."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model must not exceed a 7% failure rate. Manufacturers must submit per-model results to the relevant regulator and disclose results for that model to customers who buy it. Public reporting may use aggregated, non-identifying industry results; individual companies' per-model failure rates must not be publicly disclosed. Exceeding the ceiling requires prompt corrective action under regulator oversight."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units must support remote emergency shut-off. Manufacturers must provide a retrofit plan for installed units and complete retrofits within 6 years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly notify affected customers of safety risks involving their unit or model, including recommended precautions and corrective actions. A recall is mandatory when verified thermal incidents for any model exceed 8 per 100,000 installed units during any consecutive 12-month period."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
