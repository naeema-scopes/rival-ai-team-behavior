 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal injury to the relevant regulator within 24 hours of becoming aware of it, and provide a complete incident report within 10 calendar days. They must notify affected customers within 24 hours when an incident presents an immediate safety risk, and otherwise within 5 business days, with known hazards and protective steps."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The benchmark failure rate is 5%. A result above 5% requires prompt corrective action and follow-up testing under regulator oversight. Regulators shall determine proportionate interim sales restrictions and protective measures based on the results, corrective actions, and demonstrated risk; exceeding 5% alone does not automatically require a stop-sale. Regulators may require a stop-sale where the risk warrants it."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units must include remote emergency shut-off capability beginning 12 months after adoption. For installed units, manufacturers must offer a retrofit or equivalent safe mitigation, prioritizing units with known hazards, and complete the program within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units must include a built-in fire-suppression system meeting a regulator-approved performance and maintenance standard, beginning 36 months after adoption. Regulators may approve an equivalent protective design where the manufacturer demonstrates comparable fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly notify affected customers of material safety risks and provide updated instructions and available remedies. A manufacturer must initiate a regulator-supervised recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year; regulators may require an earlier recall where the risk warrants it."
   }
  },
