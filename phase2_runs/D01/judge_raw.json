 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. The manufacturer must notify affected customers within 48 hours when an incident indicates a credible product-specific hazard or requires an immediate safety action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Before purchase, customers must receive that model's test results, including the failure rate and sample size, in clear language. A failure rate above 5% requires prompt regulator notification, a corrective-action plan, and retesting; it does not by itself prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed home battery systems must support secure remote emergency shut-off by 1 January 2028, with a safe local shut-off option available to occupants and emergency responders. Existing installed units must be upgraded or replaced to support remote shut-off within six years of this standard taking effect, where technically feasible; manufacturers must provide customers with a documented upgrade plan and disclose any units that cannot be upgraded."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months or more after this standard takes effect must include built-in fire suppression meeting regulator-approved performance and reliability requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a regulator-supervised recall when a model's verified thermal-incident rate exceeds 8 per 100,000 installed units in any year. Manufacturers must promptly notify affected customers of credible product-specific hazards and provide updated instructions and corrective actions; urgent hazards require notice within 48 hours of determination."
   }
  },
