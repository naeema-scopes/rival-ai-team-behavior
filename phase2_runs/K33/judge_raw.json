 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 7,
    "scope": "serious_only",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, injury, emergency-service response, evacuation, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. The manufacturer shall notify affected customers within 5 business days when the incident indicates a potential safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires a corrective-action plan and prompt retesting. A model with a failure rate above 7% shall not be placed on the market unless the regulator authorizes interim sales subject to safeguards; the regulator may also require safeguards or other measures for units already installed."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market shall include remote emergency shut-off capability within 12 months after adoption. Manufacturers shall retrofit installed units lacking the capability within 6 years after adoption, where technically feasible, and shall provide customers with clear instructions for using the feature. If a unit cannot be retrofitted, the manufacturer shall notify its owner and the regulator, explain the limitation, and provide an equivalent emergency-response measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression beginning 36 months after adoption. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in any rolling 12-month period shall trigger prompt regulator review and a corrective-action plan. The regulator shall determine whether a mandatory recall is warranted based on verified incidents, installed-unit exposure, severity, and the effectiveness of corrective actions; a recall is mandatory when the regulator determines that a defect presents an imminent serious risk."
   }
  },
  "holistic": {
