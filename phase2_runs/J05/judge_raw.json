 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any thermal incident involving overheating, fire, injury, evacuation, or material property damage within 24 hours of becoming aware of it, with a follow-up report containing known causes and corrective actions within 30 days. Manufacturers shall notify affected customers within 72 hours of becoming aware of a thermal incident involving their model, and promptly provide safety instructions and updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 60,
    "interim_limit_pct": 8,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Before purchase, prospective customers shall be given the model’s numerical 55 °C failure rate directly, together with its test status against the applicable limit, material hazards, required precautions, and any corrective-action or remediation status. A model with a failure rate above 5% shall have a regulator-approved corrective-action plan and be retested within 12 months; it shall not be newly marketed if it exceeds 8%, or if the regulator determines that an imminent risk requires sales restrictions. Exceeding 5% alone shall not require a sales restriction. Manufacturers shall submit a staged compliance plan within 12 months and comply with the 5% limit within 60 months of this standard taking effect."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units shall include a remote emergency shut-off capability before sale. For installed units lacking this capability, manufacturers shall complete a retrofit or equivalent risk-reduction plan within 6 years of this standard taking effect. Manufacturers shall submit an implementation schedule to the regulator within 12 months; the regulator may approve an alternative based on technical infeasibility and equivalent protection."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression meeting a regulator-approved performance and reliability protocol. This requirement shall apply to units manufactured beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, using verified incident and installed-unit data; the manufacturer shall promptly notify regulators and affected customers, stop new sales, and provide an effective remedy. Regulators may require a recall below this threshold where the evidence indicates an unreasonable safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
