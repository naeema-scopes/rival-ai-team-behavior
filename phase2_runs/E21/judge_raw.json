 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Initial reports are due within 24 hours of awareness; a complete incident report is due within 10 business days. Manufacturers must notify affected customers within 48 hours of awareness when an incident presents a material safety risk, and otherwise within 5 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 24,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "For models exceeding 5%, the regulator may allow up to 24 months for corrective action and retesting, with interim risk controls and customer notices as warranted. Regulators may publish aggregate results, but not individual-company per-model failure rates."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Manufacturers must retrofit installed units to support remote shut-off within 6 years of this standard taking effect, where technically feasible; the regulator must approve documented alternative risk controls when retrofit is infeasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year, based on regulator-verified incident and installation data. Manufacturers must provide customers clear safety notices about material risks, incidents affecting their model, and recommended protective actions without undue delay."
   }
  },
