   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, property damage, or emergency intervention to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 business days. They must notify affected customers within 48 hours when the incident indicates a credible safety risk, and promptly provide safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "If a regulator-verified retest still exceeds 5%, the regulator must determine whether new sales should be suspended, taking account of the test results, incident record, corrective actions, and interim safeguards; it may permit continued sales under enforceable conditions where the evidence does not show serious risk. Customers considering or owning a model must receive its actual per-model test results, including the failure rate, sample size, test method, and material corrective actions, directly through customer-facing channels; a general safety summary alone is insufficient."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models must include remote emergency shut-off capability. For units already installed when this standard is adopted, manufacturers must provide a compatible retrofit or other effective remote shut-off solution within 6 years. A manufacturer seeking an extension for a specific unit or installation must document technical infeasibility to the regulator, which may approve only a limited, reasoned exception and require interim risk controls."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers must provide evidence that the suppression system is suitable for the battery chemistry and installation environment, and disclose its maintenance requirements and limitations to customers."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Regulators may also require a recall or other corrective action when evidence shows an imminent or serious risk, regardless of the numerical trigger. Manufacturers must notify affected customers directly and provide instructions and remedies."
   }
