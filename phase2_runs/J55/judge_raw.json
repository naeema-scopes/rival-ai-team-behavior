 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a written incident report within 10 calendar days. Manufacturers must notify affected customers within 48 hours when an incident presents a potential safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted observed failure rate is 7% per model. Results, sample sizes, and corrective actions must be made available to customers of that model; company-specific per-model failure rates must not be published to the general public. Regulators must assess the risk and may impose interim safeguards or restrict sale where needed to protect safety; exceeding the limit does not by itself require permanent market withdrawal."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 60,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market 24 months or more after adoption must support remote emergency shut-off. For installed units, manufacturers must provide an upgrade or other compliant mitigation within 60 months after adoption where technically feasible; otherwise they must notify affected owners and the regulator of the limitation and mitigation plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units placed on the market 36 months or more after adoption must include built-in fire suppression designed and validated for the unit’s battery chemistry and enclosure. The requirement does not apply retroactively to units already installed."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in a year, based on validated incident and installed-unit data. The manufacturer must promptly notify regulators and affected customers, explain the risk and required action, and submit a recall and remedy plan to the regulator."
   }
  },
