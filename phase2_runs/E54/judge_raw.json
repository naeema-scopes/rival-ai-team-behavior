 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a written incident report within 10 calendar days. Affected customers must be notified within 72 hours when the incident presents a credible safety risk to them; ... Reports must identify known incidents, including incidents not previously reported, and may be corrected as investigations develop."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model’s failure rate must not exceed 5%. Manufacturers must submit full per-model results, sample sizes, and corrective actions to the relevant regulator, and disclose the numerical per-model failure rate and test date to customers buying or already owning that model. A model exceeding the limit may not be newly sold until it passes retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "For already-installed units lacking this capability, manufacturers must complete retrofit or an approved equivalent safety measure within six years of this standard’s effective date, prioritizing higher-risk units."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must notify the regulator and affected customers promptly and initiate a recall, including a remedy plan and schedule. The regulator may require a broader or faster recall where the risk warrants it."
   }
  },
  "holistic": {
