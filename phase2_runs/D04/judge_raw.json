 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal event involving fire, smoke, uncontrolled overheating, injury, property damage, emergency-service response, or a safety-related shutdown within 24 hours of learning of it, with a written preliminary report within 5 business days. Any other suspected thermal incident must be reported within 10 business days. Customers whose unit is involved must be notified directly within 5 business days, or sooner where an immediate hazard warrants it."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Exceeding 5% alone does not require a sales ban; the regulator may restrict sales if the manufacturer fails to provide or implement an adequate plan, or if the regulator finds an unreasonable safety risk. Manufacturers must submit per-model results, sample size, protocol, and corrective-action records to the regulator and provide the per-model test results directly to customers who buy or are considering buying that model. Results need not be published for the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support secure remote emergency shut-off, with safeguards against unauthorized access and a local means of operation. Manufacturers must provide a retrofit pathway for installed units that lack this capability and complete retrofits within 6 years of this standard taking effect. Where retrofitting is technically infeasible, the manufacturer must notify affected customers and the regulator, explain the limitation, and provide an equivalent risk-reduction measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must promptly notify the regulator and affected customers, explain the risk and remedy, and provide safe shutdown or other interim instructions where needed. A recall is also required when the regulator determines that a serious defect creates an unreasonable risk, regardless of the incident-rate threshold; a recall requires an effective safety remedy and does not by itself mandate a permanent sales ban."
   }
  },
