    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Manufacturers must provide a safe, no-cost upgrade path for installed units that lack the function and complete retrofits within 6 years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months or more after this standard takes effect must include built-in fire suppression suitable for the battery chemistry and installation environment, validated under a regulator-approved protocol."
   },
