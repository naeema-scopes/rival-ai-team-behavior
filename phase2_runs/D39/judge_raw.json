    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% for any model. A model exceeding that limit may not be newly sold until it passes a confirmatory test and corrective action is accepted by the regulator."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
