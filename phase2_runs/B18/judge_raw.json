 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a detailed follow-up within 10 business days. They must notify affected customers within 48 hours when an incident presents a credible safety risk, and promptly provide updated instructions as facts develop."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers must provide per-model test methods, sample sizes, and results to the relevant regulator and to customers who buy that model, and retain records for audit. Results above a 5% failure rate require a corrective-action plan and retesting; regulators may require evidence-based interim safeguards. A test result alone does not automatically prohibit continued sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units must support a secure remote emergency shut-off function no later than 12 months after adoption. Existing installed units must be brought into compliance, through retrofit or replacement where technically feasible, within 72 months after adoption. A unit without the function must have an equivalent documented emergency isolation procedure until compliance."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption. Regulators may approve an equivalent built-in mitigation design where evidence demonstrates comparable fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": true,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly submit its incident data and corrective-action plan to the regulator and initiate a recall. A manufacturer must also initiate a recall when regulators determine that a serious defect presents an imminent risk of death or significant injury."
   }
