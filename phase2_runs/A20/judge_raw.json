 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery-related fire, thermal runaway, injury, or emergency-service response to the regulator within 5 calendar days after learning of it, and provide a follow-up investigation report within 30 days. A serious incident involving death, life-threatening injury, or an ongoing hazard must be reported within 24 hours. Manufacturers must notify affected customers promptly when an incident indicates a material safety risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers must submit numerical per-model results to regulators and disclose the numerical failure rate to customers who buy that model. Exceeding 5% alone does not automatically prohibit sale; regulators shall determine proportionate measures based on demonstrated risk and progress on corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For units already installed, manufacturers must provide a compatible remote shut-off capability or an equivalent safe retrofit within 6 years after adoption of this standard, where technically feasible; otherwise, they must notify affected customers and regulators and provide a documented risk-mitigation plan."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured for sale must include built-in fire suppression beginning 36 months after adoption of this standard. Regulators may approve an equivalent fire-mitigation design where evidence demonstrates comparable or better safety performance."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If a model's thermal-incident rate exceeds 8 incidents per 100,000 units of that model installed during a year, the manufacturer must promptly notify the regulator and provide supporting data. A recall is mandatory when the regulator determines that a serious risk cannot be adequately controlled through corrective measures, or that required corrective measures have not been completed."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "collaborating",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 1,
  "holistic_F_H": 1,
  "section_notes": "S2 keeps numerical per-model rates for regulators and customers but removes any automatic sales stop above 5%, which protects Northwind's Hearth 10 from a ban. S5 replaces the numeric 8-per-100k recall trigger with regulator review and an open-ended corrective-action alternative, which largely shields Halcyon's Ember 8 (9.9/100k). S1 is strong (5-day and 24-hour reporting, all incidents), while S3 (6-year retrofit) and S4 (36-month suppression) sit within the acceptable ranges."
 },
