 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, or emergency evacuation to the responsible regulator within 24 hours of becoming aware of it, with a complete incident report within 10 business days. They must notify affected customers and, where there is a credible risk to nearby people or property, relevant local emergency authorities within 72 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "pass_fail_only",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% per model. Exceeding the limit requires regulator oversight and proportionate interim safeguards, but does not by itself require market withdrawal or a ban. Before purchase, customers must receive a safety-relevant summary stating whether the model meets the limit; exact per-model failure rates and sample sizes are not customer-facing."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units must include a remote emergency shut-off capability that can be activated by the customer and, where necessary to address an imminent safety risk, by the manufacturer under regulator oversight. Units already installed must be brought into compliance within six years of adoption, unless the regulator approves an equivalent safety measure or determines retrofit is impracticable."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression no later than 36 months after adoption of this standard. Regulators may approve an equivalent protective measure where built-in suppression is technically unsuitable, provided it delivers comparable safety protection."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall or other regulator-directed protective action is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must promptly notify the regulator and affected customers, investigate the cause, and implement the recall or other regulator-approved remedy without delay."
   }
