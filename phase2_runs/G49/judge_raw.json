 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every confirmed thermal incident involving a home battery—including overheating, smoke, fire, or thermal runaway—to the relevant regulator within 24 hours of becoming aware of it, and provide a complete incident report within 10 days. Manufacturers shall notify the affected customer within 24 hours, or as soon as contact is practicable, and provide known hazards, immediate safety steps, and a contact for assistance."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model's failure rate shall not exceed 7%. Results, including per-model failure rates, shall be submitted to the regulator and provided to customers who buy that model; they shall not be publicly disclosed. The regulator shall assess test results, incident evidence, and remediation and may require sales restrictions or other corrective measures where warranted; exceeding 5% does not itself impose an automatic sales ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New home battery models introduced 24 months after this standard takes effect shall support remote emergency shut-off. For units already installed when the standard takes effect, manufacturers shall provide a retrofit or equivalent upgrade within 6 years where technically feasible, with clear instructions and no charge to the customer."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units manufactured 36 months or more after this standard takes effect shall include built-in fire suppression meeting a regulator-approved performance protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in any rolling 12-month period shall trigger prompt regulator notification and a documented safety review. The regulator shall assess incident evidence and the manufacturer's corrective-action plan and may require a recall, sales restrictions, or other protective measures where warranted."
   }
  },
