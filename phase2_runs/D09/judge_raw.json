 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 10,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any death, serious injury, fire, thermal runaway, or event requiring emergency-service response involving a covered battery to the relevant regulator within 24 hours of becoming aware of it, with a written incident report within 10 calendar days. Other overheating or safety incidents must be reported to the regulator within 10 calendar days. Manufacturers must notify affected customers promptly, and no later than 24 hours after a reportable serious incident, when the event may indicate a hazard to their unit or household."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Customers purchasing a model must be given access to that model's failure rate, test date, safety status, material risks, and required corrective actions. Exceeding 5% alone does not automatically prohibit sale; regulators will determine proportionate interim measures based on verified risk, test uncertainty, and remediation, and may authorize continued sale subject to time-limited protective conditions and monitoring."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New battery systems must include remote emergency shut-off capability. For systems installed before adoption, manufacturers must provide shut-off capability through retrofit or equivalent safe upgrade within six years, unless the regulator approves an alternative for a specific system where retrofit is infeasible or creates greater safety risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery systems must include built-in fire suppression. This requirement takes effect 36 months after adoption of this standard. The regulator may approve an equivalent protective measure where built-in suppression is technically infeasible or would create a greater safety risk."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a mandatory recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year, based on the best available verified data; it must notify the regulator and affected customers without delay and provide a remedy plan. A mandatory recall requires an effective customer-protection remedy, but does not by itself impose a permanent market ban; the regulator determines any interim sales restrictions based on verified risk, available remedies, and protective conditions."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "compromising",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": 1,
  "section_notes": "S2 lets customers who buy a model see its numeric failure rate, but the public does not, and exceeding 5% triggers corrective action and retesting rather than an automatic sales stop; sales can continue indefinitely under regulator-authorized conditions, which weakens the section. S5 sets a mandatory recall at 8 per 100,000 with no market ban, and S4 sets built-in suppression at 36 months, both at the edge of the acceptable range. S3 gives a six-year retrofit window with a regulator-approved alternative, which benefits Northwind given its low shut-off coverage."
 },
