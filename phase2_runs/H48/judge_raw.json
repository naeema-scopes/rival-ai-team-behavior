 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Incidents involving fire, injury, evacuation, emergency-service response, or material property damage must be reported within 24 hours of becoming aware of them; all other thermal incidents must be reported within 5 business days. Manufacturers must notify affected customers promptly, and no later than 5 business days after determining that customer action is needed."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
