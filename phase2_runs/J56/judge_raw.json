    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% is an intervention threshold, not a permitted-maximum or pass/fail limit. Exceeding 5% alone does not make a model non-compliant or automatically require market withdrawal. Manufacturers shall submit per-model results, including sample size, failures, and protocol, to the relevant regulator and provide them to customers of that model before sale and after material design changes; results shall not be publicly disclosed by the standard."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Newly installed systems shall support a secure remote emergency shut-off, with safeguards against unauthorized activation and a local means of operation. For systems already installed when this requirement takes effect, manufacturers shall provide compliant retrofit capability or an equivalent regulator-approved safety measure within six years."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression no later than 36 months after adoption of this standard."
