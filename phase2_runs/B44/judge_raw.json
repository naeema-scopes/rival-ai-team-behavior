  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a full incident report within 10 business days. They must notify affected customers within 48 hours when an incident indicates a credible safety risk, and promptly provide safety instructions and material updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "No more than 5% of tested units may fail. Individual-company per-model failure rates must not be publicly disclosed; public reporting may provide aggregated results. The regulator may set deadlines, require interim safeguards, and authorize continued sales under conditions while remediation is underway if it determines this is safe."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery systems must include a remote emergency shut-off capability no later than 24 months after adoption. For units already installed at adoption, manufacturers must offer a compatible retrofit where feasible and complete any required retrofit within 6 years; if a retrofit is not feasible, they must promptly notify the customer and provide alternative emergency-isolation instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression beginning 36 months after adoption. The suppression system must be validated for the battery chemistry and installation configuration and maintained in accordance with manufacturer instructions."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly report the rate to the regulator, notify affected customers, and initiate a recall, following regulator-supervised implementation. The regulator may require interim safeguards and verify recall effectiveness."
   }
