 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 2,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery-related fire, thermal runaway, or other incident involving injury, property damage, evacuation, or emergency-service response to the relevant regulator within 24 hours of learning of it. Other confirmed thermal incidents must be reported within 5 business days. Reporting is required even when the cause is not yet known."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers must provide results, including sample size and failure rate, to the relevant regulator and to customers who buy that model; per-model results need not be published publicly. A failure rate above 5% requires a corrective-action plan and interim risk controls submitted to the regulator within 30 days, followed by remediation and retesting within 12 months. At retest, a model above 5% may not be offered for sale until it meets the maximum."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must provide a plan to enable the capability on compatible installed units, and complete deployment within 72 months of adoption. Where a unit cannot be upgraded, the manufacturer must notify its owner and the relevant regulator and provide an equivalent safety measure or replacement plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. The suppression system must be appropriate to the unit's battery chemistry and validated not to create additional hazards."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Notify affected customers promptly when a material safety risk requires action, and provide updates as information changes. A manufacturer must initiate a mandatory recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Regulators may also require a recall where incident evidence indicates an imminent or otherwise material safety risk."
   }
  },
