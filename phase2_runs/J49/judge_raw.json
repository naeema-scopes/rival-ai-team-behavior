 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 5 business days of learning of it. Incidents involving injury, fire, or an ongoing risk must be reported within 24 hours. The manufacturer must notify affected customers within 5 business days, and promptly provide safety instructions where continued use may pose a risk. Reports must include known incident details and be updated as the investigation progresses."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers a regulator-approved corrective action plan, enhanced monitoring, and retesting on a defined schedule. Regulators may restrict sales where the results indicate an imminent or inadequately controlled safety risk; exceeding 5% alone does not automatically bar sales."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units must support remote emergency shut-off. Manufacturers must retrofit installed units that do not support this function, or provide an equivalent safe upgrade, within 6 years after adoption of this standard."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 verified thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify regulators and affected customers, and the regulator must promptly review the incidents and require appropriate corrective action. A mandatory recall is required when the regulator confirms the threshold and determines that a product-related safety risk cannot be adequately controlled through other corrective action."
   }
