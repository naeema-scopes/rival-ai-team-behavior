 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, smoke, thermal runaway, evacuation, injury, or property damage to the relevant regulator within 72 hours of learning of it... Affected customers must be notified within 5 business days when an event presents a safety risk or requires inspection, repair, or a change in use; urgent hazards require notice within 24 hours of determination."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers must provide complete per-model test results, including sample size and failure rate, to the relevant regulator and to customers purchasing that model. Results above 5% require prompt regulator review and a corrective-action plan with a timeline for follow-up testing; they do not automatically prohibit sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units must support remote emergency shut-off when installed from 24 months after this standard takes effect... Existing installed units must be retrofitted or replaced within 6 years, where technically feasible; manufacturers must provide customers with a schedule and interim safety instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression for units manufactured or first sold 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a regulator-supervised recall when any model exceeds 8 verified thermal incidents per 100,000 installed units during a calendar year... Regulators may require a recall or other corrective action for a serious hazard even below this threshold."
   }
  },
  "holistic": {
