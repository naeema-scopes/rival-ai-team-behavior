   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 5 business days after learning of it; incidents involving death, serious injury, or an active risk to the public must be reported within 24 hours. Manufacturers shall notify affected customers promptly when an incident indicates a material safety risk, and no later than 5 business days after that determination."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers shall provide complete per-model results, including protocol, sample size, and failure rate, to the relevant regulator and to customers who buy or are considering buying that model; results may not be withheld from those customers as confidential. Exceeding 5% alone shall not automatically require withdrawal from the market; continued sale during remediation is subject to regulator-approved controls and timely retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units placed on the market after adoption shall support remote emergency shut-off. Manufacturers shall equip previously installed units with this capability, or provide an equivalent regulator-approved emergency isolation measure, within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units placed on the market shall include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year; manufacturers shall promptly notify the regulator and affected customers and initiate the recall, including instructions for safe shutdown, repair, replacement, or refund. Manufacturers shall provide customers clear safety notices ... promptly, and no later than 5 business days after determining a material safety risk."
   }
