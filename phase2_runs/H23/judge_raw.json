    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Regulators shall determine whether a recall or other corrective action is required based on the totality of evidence, including incident rates, severity, testing, trends, and the adequacy of corrective actions. Regulators retain authority to require a recall or other corrective action whenever the evidence warrants it."
   }
