    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, property damage, or emergency shutdown to the relevant regulator within 24 hours of becoming aware of it, with an initial account of known facts. They must provide affected customers with a safety notice within 48 hours when the incident presents a potential risk to their unit or household."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model's failure rate must not exceed 5% of tested units. A model exceeding this limit must undergo corrective action and retesting before further units are placed on the market. Manufacturers must submit identified per-model results, including failure rates and test dates, to the relevant regulator and provide those results to customers of that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must provide a secure retrofit or equivalent remote shut-off capability for units already installed within six years of adoption, where technically feasible, and notify customers of any limitations and available protective alternatives."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression for units manufactured on or after three years from adoption. Manufacturers must document that the suppression system is suitable for the unit and provide customers with instructions for its operation and maintenance."
   },
