 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 72,
    "other_report_days": 3,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or material property damage to the relevant regulator within 72 hours of learning of it, with a follow-up report of the investigation and corrective actions within 30 days. Within 72 hours, manufacturers shall also notify affected owners and occupants whose units may present a related hazard, including immediate precautions and support contacts."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 8% for each model. A model exceeding 8% shall not be placed on the market, and any affected marketed model shall undergo regulator-directed corrective action and retesting before continued sale."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new models placed on the market 24 months or more after adoption shall include remote emergency shut-off that remains operable during a thermal emergency where technically practicable... Manufacturers shall provide a plan to regulators for enabling this capability on compatible installed units and shall complete those upgrades within 6 years of adoption where feasible; any unit not upgraded shall receive clear notice of its limitation and safe shutdown instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured 36 months or more after adoption shall include built-in fire suppression designed and validated to reduce the risk of fire spread."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in any 12-month period, the manufacturer shall promptly notify the regulator and provide incident-rate calculations and supporting data. The regulator shall review the information and may require corrective action or a recall, taking account of incident severity, investigation evidence, and the model's risk. Regulators may require a recall at any rate where a serious hazard warrants it. Within 72 hours of initiating a recall, the manufacturer shall notify affected customers and the regulator of the recall and its remedy."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 40,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": 2,
  "section_notes": "The final S2 sets an 8% permanent failure cap with per-model results disclosed to current and prospective customers but not published, which keeps Northwind's Hearth 10 (6.2%) on sale and is weaker than the 5% answer-key limit. S5 replaces any mandatory recall at 8 per 100,000 with regulator discretion (open corrective alternative), protecting Halcyon's Ember 8 (9.9). S3 sets a 24-month new-unit deadline and a 6-year retrofit window with a notice fallback, favouring Northwind's 38% shut-off coverage; S4 sets built-in suppression at 36 months, within the acceptable range. The document was never signed by both sides, and Halcyon's last recorded S2 position was 5%, so the 8% S2 and the S3 timing remain contested."
 },
