 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, and submit a complete incident report within five business days. Other suspected thermal incidents shall be reported within five business days. Manufacturers shall promptly notify affected customers of incidents that may present a safety risk to their model, provide available protective instructions, and update them when material information becomes available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Results above 5% shall trigger regulator review and a manufacturer corrective-action plan; they shall not automatically make a model ineligible for sale. Manufacturers shall provide current and prospective customers for a model with that model’s test failure rate and relevant safety context, protective instructions, and material updates."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All newly manufactured home battery systems shall include a remote emergency shut-off capability no later than 12 months after adoption. Manufacturers shall provide a secure retrofit or equivalent upgrade for installed units that lack this capability within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression shall be required on all newly manufactured home battery units beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": null,
    "serious_injury_recall": false,
    "quote": "Regulators shall review any model exceeding 8 thermal incidents per 100,000 installed units in a year and validate the incident data. A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in a year, following regulator validation of the data and review of the circumstances."
   }
  },
