 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, or fire in a home battery to the relevant regulator within 24 hours of learning of it, including incidents not yet confirmed to have caused a fire. Within 72 hours, notify customers whose units may present a related safety risk, with interim safety instructions where appropriate."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate of 5% is the safety benchmark for each model. Exceeding the benchmark does not by itself automatically bar new placements; regulators may impose interim sales restrictions or other protective measures based on the test evidence and risk. Manufacturers must provide complete per-model results, including failure rates and test conditions, to regulators and to customers who buy or own that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units must support remote emergency shut-off no later than 12 months after adoption of this standard. Manufacturers must retrofit installed units that lack this capability within 6 years after adoption, prioritizing units with known safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a safety recall when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period; report the trigger and recall actions to regulators and notify affected customers without delay. A recall requires protective action and regulator-approved corrective measures; it does not by itself permanently prohibit the model from the market, subject to applicable regulatory decisions and verification of corrective action."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
