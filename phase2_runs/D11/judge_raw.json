  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the regulator within five business days of learning of it. Any incident involving fire, injury, evacuation, or an immediate risk to occupants or neighbours must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5%. Exceeding 5% alone does not automatically prohibit sales: the regulator will set remediation and retesting deadlines and may impose proportionate interim sales conditions based on the evidence and risk, including restrictions where needed to protect the public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery units must include a secure remote emergency shut-off function beginning 12 months after adoption of this standard. For units already installed at adoption, manufacturers must provide a compatible remote shut-off capability or an equivalent means of emergency isolation within six years, with customer notice and instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly report the exceedance to the regulator and submit incident data and a proposed corrective-action plan. A recall is mandatory when a model exceeds this threshold."
   }
  },
