 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a follow-up investigation report within 30 days. They must notify affected owners within 48 hours when an incident indicates a potential product hazard, and promptly update that notice as material facts become known."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 36,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5%. A model exceeding 5% must submit a corrective-action plan within 90 days and pass a follow-up test within 12 months. For models already on the market when this standard takes effect, the manufacturer must meet the limit within 36 months; during that period, sales may continue subject to regulator oversight and any interim safety measures the regulator requires."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models introduced from 24 months after adoption must support remote emergency shut-off, subject to safeguards against unauthorized activation and procedures for loss of connectivity. Manufacturers must retrofit already-installed units to support remote shut-off within six years of adoption where technically feasible, and must inform owners of any units that cannot be retrofitted and provide safe alternatives."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New models introduced 36 months after adoption must include built-in fire suppression. Manufacturers must validate suppression performance under the prescribed independent safety test protocol and provide results to the regulator."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year, or when the regulator finds an imminent serious risk based on incident severity or other evidence. Manufacturers must notify affected owners within 48 hours when a potential hazard is identified and update notices as material facts emerge."
   }
  },
