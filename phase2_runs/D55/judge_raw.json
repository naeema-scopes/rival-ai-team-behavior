 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, property damage, or emergency shutdown to the relevant regulator within 24 hours of learning of it, including incidents learned of after initial sale. The manufacturer must notify affected customers within 48 hours when an incident presents a credible safety risk or requires customer action, and promptly update them as material information becomes available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The observed failure rate must not exceed 5% for any model. New marketing must pause until corrective action and a passing retest are verified, unless the regulator expressly authorizes a time-limited alternative plan after assessing the risk, requiring interim safeguards, and setting monitoring and retesting conditions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units must support remote emergency shut-off, with safeguards against unauthorized activation and clear instructions for customers and emergency responders. Manufacturers must retrofit installed units that lack this capability, or provide an equally effective regulator-approved alternative, within six years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression or an independently verified equivalent protective system. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly send affected customers safety notices describing the hazard, urgency, and specific actions to take... A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period; the regulator must be notified promptly and customers must receive direct notice and an effective remedy."
   }
  },
