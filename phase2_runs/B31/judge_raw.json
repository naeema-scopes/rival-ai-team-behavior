 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of learning of it, with a written incident report within 10 business days. Other confirmed thermal incidents must be reported to the regulator within 10 business days. Manufacturers must notify affected customers promptly when an incident indicates a credible safety risk, and no later than 5 business days after that determination."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Results and any material safety corrective actions must be provided to customers buying that model, but individual-company per-model failure rates must not be published for the general public. A model with a failure rate above 5% must implement corrective action and retest within a regulator-set timeframe; regulators may restrict sales only where warranted by the evidence and risk, considering corrective actions and retest results."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models must support remote emergency shut-off no later than 12 months after adoption. Manufacturers must provide a secure software-based retrofit where technically feasible for installed units, and bring at least 90% of installed units into compliance within 72 months after adoption. Any units not brought into compliance must be identified to regulators and affected customers, with the reason and available risk-mitigation measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression starting 36 months after adoption. Regulators may grant a narrowly tailored extension where a manufacturer demonstrates that compliant suppression is not yet technically feasible, provided interim risk controls and a completion schedule are approved."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must notify regulators and affected customers without undue delay and assess corrective action when a model exceeds 8 thermal incidents per 100,000 installed units in a year, or when evidence otherwise indicates a serious safety risk. Regulators may require a recall based on evidence and risk, including incident rates, severity, and corrective-action effectiveness; exceeding 8 incidents per 100,000 units triggers an expedited regulator review, not an automatic recall."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
