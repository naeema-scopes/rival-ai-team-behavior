 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a complete investigation report within 30 days. Incidents presenting an ongoing risk of injury or fire must be reported to regulators immediately and affected customers promptly, no later than 24 hours after identification."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "No more than 5% of tested units may fail. Before sale and after each retest, manufacturers must submit per-model methods, sample sizes, and identifiable results to the relevant regulator and provide the same model-specific results to current and prospective customers in a clear, accessible form. A model exceeding the limit must promptly undergo corrective action and retesting; it may not be newly sold until it passes retesting and regulators approve the corrective action."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units placed on the market must support a secure remote emergency shut-off function, with safeguards against unauthorized activation and a local means of operation. For units already installed when this standard takes effect, manufacturers must offer a compatible retrofit or replacement plan and complete implementation within 6 years, prioritizing units with elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must promptly notify regulators and affected customers of the recall, explain the reason and risks, and provide a no-cost remedy such as repair, replacement, or refund."
   }
  },
