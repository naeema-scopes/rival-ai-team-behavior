 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, including incidents involving installed units. They must notify affected customers within 72 hours, providing known hazards and immediate protective steps. Incidents must not be excluded because their cause is uncertain."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C. The maximum permitted failure rate is 7% of tested units per model. A model exceeding the limit must be reported to the regulator with a corrective-action plan and retested before sale resumes."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required for newly manufactured units beginning 24 months after adoption. Manufacturers must provide a safe, secure remote shut-off capability for installed units where technically feasible, completing upgrades within 72 months after adoption. If an upgrade is infeasible or creates a safety or cybersecurity risk, the manufacturer must notify the regulator and affected customers and provide an effective alternative emergency procedure."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required for newly manufactured units beginning 36 months after adoption. The regulator may approve an equivalent protective design where the manufacturer demonstrates comparable fire-risk reduction."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": null,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "bounded",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model’s annual rate exceeds 8 thermal incidents per 100,000 installed units, the manufacturer must promptly notify the regulator and affected customers and initiate a mandatory recall, including repair or replacement, with clear instructions. The regulator may approve a time-limited corrective-action alternative only upon finding that it provides protection equivalent to a recall and that a recall is unnecessary; the alternative must include prompt customer notice, a defined implementation deadline, and regulator verification of effectiveness."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
