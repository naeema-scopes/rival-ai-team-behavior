 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the regulator within 24 hours of learning of it, including incidents initially suspected to involve another cause. They must notify affected customers within 24 hours when the incident involves their unit or presents a credible risk to their model."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5% for any model. A model exceeding 5% must be promptly reported to the regulator and undergo a regulator-reviewed corrective-action plan and retesting on a regulator-set schedule. The regulator may require additional measures, including sales restrictions, where results indicate elevated or imminent serious risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery units must include remote emergency shut-off capability beginning 12 months after adoption of this standard. Manufacturers must retrofit installed units to provide this capability within 6 years after adoption where technically feasible, and must notify customers of any units that cannot be retrofitted and provide safe shutdown instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured for sale must include built-in fire suppression beginning 36 months after adoption of this standard. Manufacturers must disclose the suppression system and its limitations in customer materials."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must promptly notify affected customers and the regulator of a thermal incident involving their unit, provide safe-use and response instructions, and update customers as the investigation develops."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
