 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 5 business days of learning of it, including incidents with no injury or property damage. Incidents involving injury, evacuation, fire-service response, or material property damage shall be reported within 24 hours. Manufacturers shall notify affected customers within 5 business days when an incident indicates a product-specific safety risk, and promptly provide material safety updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 7%. A model exceeding 7% shall be subject to a regulator-approved corrective-action plan and retesting; it shall not be newly placed on the market until it meets the limit. Manufacturers shall provide the complete results for a model to current and prospective customers of that model, in an accessible form, before or at purchase. Results need not be published to the general public as individual-company per-model failure rates."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new home battery models placed on the market from 24 months after adoption shall support secure remote emergency shut-off, with safeguards against unauthorized access and clear customer instructions. Manufacturers shall provide a retrofit or equivalent upgrade for compatible already-installed units within 6 years of adoption, prioritizing units with known safety risks. Where retrofit is technically infeasible, the manufacturer shall notify the owner and provide a safe alternative."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units manufactured for sale or installed from 36 months after adoption shall include built-in fire suppression meeting regulator-approved performance and reliability requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers shall promptly notify affected customers of material safety risks, incidents, corrective actions, and safety updates. A manufacturer shall initiate a regulator-supervised recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year."
   }
  },
