 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every battery-related overheating, fire, or thermal runaway incident to the relevant regulator within 5 business days of learning of it, and immediately, within 24 hours, when the incident involves a fire, injury, death, evacuation, or material property damage. Suspected incidents shall be reported as such; reporting does not depend on confirmation of root cause."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 6.5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model passes if no more than 6.5% of tested units fail. Individual-company per-model failure rates shall not be published to the general public. A model exceeding the limit shall be subject to regulator-supervised corrective action and follow-up testing."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units shall support remote emergency shut-off no later than 24 months after adoption. Manufacturers shall submit a regulator-approved retrofit plan for installed units that do not support the function, prioritizing units with elevated safety risks, and complete retrofits within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New battery units shall include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer shall promptly notify regulators and affected customers... If the verified rate exceeds 8 per 100,000 in a year, the manufacturer shall initiate a recall of the affected model. Such approval does not waive the recall trigger."
   }
  },
