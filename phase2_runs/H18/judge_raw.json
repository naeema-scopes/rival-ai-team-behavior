  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, including incidents involving injury, property damage, or suspected product malfunction. Within 72 hours, the manufacturer must notify affected customers and provide immediate safety instructions when continued use may pose a risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model exceeding a 5% failure rate must be retested and the manufacturer must submit a corrective-action plan to the regulator; customers of that model must be promptly notified of the results and relevant safety precautions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Existing installed units must be upgraded to support remote shut-off, or an equivalent safe emergency-isolation capability, within six years after adoption of this standard."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If a model exceeds 8 thermal incidents per 100,000 installed units in a year, the regulator must promptly review the evidence and require appropriate corrective action; a recall is required when the regulator determines the risk warrants removal from service, considering incident severity, validated rates, and available mitigations."
   }
