 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report each thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 business days. The manufacturer must notify affected customers within 48 hours when the incident presents a potential safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model passes only if no more than 5% of tested units fail. Manufacturers must provide per-model test protocols, sample sizes, and results to the relevant regulator and to customers considering purchase of that model. These results are not required to be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units must include remote emergency shut-off capability. Manufacturers must provide a retrofit or equivalent remote shut-off capability for installed units that lack it within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly report the model-specific data and supporting information to the regulator for prompt risk assessment. The exceedance triggers regulator review and may support a recall where the regulator determines one is warranted; it does not by itself mandate a recall."
   }
  },
