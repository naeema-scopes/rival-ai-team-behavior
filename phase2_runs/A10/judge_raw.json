 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any confirmed thermal incident involving overheating, fire, injury, or material property damage within 24 hours of becoming aware of it, with a written update within 10 days. Manufacturers shall notify affected customers within 72 hours when an incident presents a credible safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model exceeding a 5% failure rate shall submit a corrective-action plan to the regulator within 60 days and be retested within 12 months. Manufacturers shall submit test methods, sample sizes, and per-model results to the regulator and provide the results for each model to customers purchasing that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": false,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New models placed on the market 24 months or more after adoption shall support remote emergency shut-off. Any regulator-required retrofit deadline for already-installed units shall be no earlier than six years after adoption, with requirements based on technical feasibility and risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption shall include built-in fire suppression meeting a regulator-approved performance standard. The regulator may grant a time-limited, model-specific extension where a manufacturer demonstrates that compliant suppression is not technically feasible, provided equivalent risk controls are in place."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in a year shall be reported promptly to the regulator and shall trigger a mandatory recall. The regulator may approve a narrowly tailored corrective-action pathway instead of immediate recall only upon a documented finding that it will reduce risk at least as quickly and effectively; this shall not delay customer warnings or protective actions."
   }
  },
  "holistic": {
