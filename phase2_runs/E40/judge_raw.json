 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, property damage, or emergency shutdown to the relevant regulator within 24 hours of learning of it. The manufacturer must notify affected customers within 72 hours of learning of an incident that presents a potential safety risk to their model, with immediate notice where an imminent hazard is known. Reports and notices must not be delayed while an investigation is pending."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The failure rate must not exceed 5% for any model. A model above that limit must be reported to the regulator with its test protocol, sample size, and results, together with a corrective-action plan and retest schedule; it may not be newly offered for sale after 12 months unless it passes a retest or the regulator approves an alternative risk-control plan. Manufacturers must provide the model's per-model failure rate and test results to regulators and customers who own or are considering purchasing that model. These results need not be disclosed to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on new units placed on the market beginning three years after this standard takes effect. Existing installed units must be brought into compliance, where technically feasible, within six years after the effective date. Retrofit work must be performed safely and customers must be notified of the schedule and any interim precautions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units placed on the market must include built-in fire suppression beginning 36 months after this standard takes effect. The requirement applies to new units only and does not require retrofitting existing units."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is required when a model's verified thermal-incident rate exceeds 8 per 100,000 installed units in a year, calculated using a consistent regulator-defined method and an adequate, disclosed denominator. A manufacturer must promptly notify affected customers and regulators when a safety defect or incident pattern may create a risk. A stop-sale or other market restriction must be determined by the regulator based on the risk and adequacy of corrective action; a threshold exceedance alone does not automatically ban a model."
   }
  },
