 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 120,
    "other_report_days": 30,
    "customer_notice_days": 5,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every battery-related fire, thermal runaway, or other thermal incident involving injury, property damage, evacuation, or emergency-service response to the relevant regulator within 5 calendar days of becoming aware of it. Other confirmed thermal incidents must be reported within 30 calendar days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers must submit complete per-model results and test methods confidentially to the relevant regulator and provide complete per-model results, including failure-rate data, to customers considering or owning that model. A failure rate above 5% triggers regulator review, including consideration of test evidence, uncertainty, and the model's real-world safety record; the regulator may require additional testing, corrective action, or other proportionate safeguards."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required for all newly manufactured home battery units beginning 24 months after adoption of this standard. Manufacturers must retrofit already-installed units to support remote emergency shut-off within 6 years after adoption, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All newly manufactured home battery units must include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the relevant regulator and provide the supporting data and proposed corrective-action plan. The regulator must assess the evidence, including incident severity, trend, and effective corrective actions, and may require a recall or other proportionate safeguards."
   }
  },
