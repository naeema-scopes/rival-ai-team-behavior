 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any battery-related fire, thermal runaway, or event causing injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of becoming aware. Other confirmed thermal incidents shall be reported within 10 business days. The manufacturer shall notify affected customers within 5 business days of confirming a safety-relevant defect or hazard, with immediate notice where continued use presents an imminent risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 6,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% per model. A result above 5% is non-compliant: the manufacturer shall promptly submit a corrective-action plan and retest within 6 months. Regulators may require interim protective measures, including suspension of new sales, where needed to control risk while corrective action is verified."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New residential battery models placed on the market from 24 months after adoption shall support secure remote emergency shut-off, with a clearly documented means for an authorized operator or emergency responder to request shut-off. For units already installed on the adoption date, manufacturers shall provide a compatible retrofit or equivalent safe means of emergency isolation within 6 years, where technically feasible; customers must receive clear instructions on its use."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New residential battery units placed on the market from 36 months after adoption shall include built-in fire suppression or an independently verified integrated mitigation system that limits propagation of fire to adjacent units and provides protection equivalent to suppression."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model's verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in a year, the manufacturer shall promptly notify regulators and provide the incident count, reporting-completeness information, and installed-unit denominator for regulator review. A verified exceedance shall trigger a mandatory recall unless the regulator documents that an equally protective corrective action makes recall unnecessary."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
