 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a written incident report within 10 calendar days. They must promptly notify affected customers of incidents posing a credible safety risk, and in all cases within 48 hours of identifying the affected units. These duties apply regardless of whether an incident is ultimately attributed to the product."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 12,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The 5% level is an action threshold, not an automatic pass/fail limit or market ban. A result above 5% requires the manufacturer promptly to submit a corrective-action plan to the regulator and retest within 12 months. It must also provide the results for each model, in clear and accessible form, to customers who buy that model; this does not require public publication of per-model failure rates."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units placed on the market after adoption must support remote emergency shut-off... Manufacturers must retrofit installed units to support remote emergency shut-off within 6 years after adoption where technically feasible. For units that cannot reasonably be retrofitted, the manufacturer must notify the owner and regulator, explain the limitation, and provide appropriate alternative emergency guidance."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units manufactured for sale or installation must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Customers must receive clear, model-specific safety notices... promptly after the manufacturer identifies a credible safety risk. A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year... A recall requires prompt customer notification and an effective remedy; it does not by itself constitute a market ban."
   }
  },
