  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 10,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, fire, injury, or property damage to the responsible regulator within 24 hours of becoming aware of it, and submit an incident report with available details within 10 calendar days. Manufacturers must notify affected customers within 72 hours when an incident indicates a credible safety risk to their units, and provide updates as material facts become available."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 8% is not permitted. Per-model results, including sample size, failure count, and failure rate, must be provided to the responsible regulator and to customers buying or considering that model. Individual per-model failure rates need not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": false,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New models placed on the market after 1 January 2028 must support remote emergency shut-off, with safeguards against unauthorized activation and a locally accessible means to shut down the unit. Manufacturers must provide a retrofit pathway for installed units where technically feasible. Any required retrofit of installed units must be completed within at least six years from the effective date of this standard."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured or first placed on the market 36 months after adoption of this standard must include built-in fire suppression meeting a regulator-approved performance and maintenance standard. Units placed on the market before that date are not subject to this requirement."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify regulators and affected customers and initiate a recall of that model. The manufacturer must submit an investigation and corrective-action plan, and take regulator-directed interim risk-reduction measures while the recall is carried out."
   }
