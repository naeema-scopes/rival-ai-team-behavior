 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with an initial account of the event and affected model. Within 72 hours, manufacturers must notify affected customers of incidents presenting an ongoing safety risk and provide appropriate precautions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 6,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% is a regulatory action threshold, not an automatic sales ban. Regulators must protect submitted results from public disclosure, subject to applicable law. Customers who buy or own a model must receive that model's numerical failure rate and relevant test results, together with any applicable safety notices and precautions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New models placed on the market more than 12 months after adoption must support remote emergency shut-off, with safeguards against unauthorized activation and a locally accessible shut-off option. Manufacturers must provide a secure software or hardware retrofit for installed units that can support the feature within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption must include built-in fire suppression appropriate to the battery chemistry and installation environment, validated under a regulator-approved test protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "Verified data showing that any model exceeds 8 thermal incidents per 100,000 installed units in a rolling year must be promptly reported to regulators and affected customers and triggers a mandatory recall. Manufacturers must provide customers with clear safety instructions, incident reporting contacts, and any model-specific safety notice or precaution within 72 hours after determining it is relevant to their unit."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
