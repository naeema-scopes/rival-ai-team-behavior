 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a complete incident report within 10 calendar days. They must notify affected customers promptly, and no later than 72 hours after determining that a product or condition may present a safety risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% per model. Manufacturers must submit complete per-model results confidentially to the regulator and provide results to customers of that model; individual-company per-model failure rates must not be publicly disclosed. Regulators should require corrective action and retesting for a non-compliant model, with any sales restriction determined by the regulator based on the risk and adequacy of corrective measures."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "Remote emergency shut-off is required on all newly installed home battery systems beginning 24 months after this standard takes effect. For units already installed on that date, manufacturers must provide a compatible retrofit or equivalent safe mitigation within 6 years, prioritizing systems with elevated risk."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery systems manufactured 36 months or more after this standard takes effect must include built-in fire suppression designed and validated to reduce the risk of fire propagation."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units during a year, the manufacturer must promptly report the rate to the regulator and notify affected customers. The manufacturer must initiate a recall of that model; the regulator may specify the scope and verify implementation."
   }
  },
