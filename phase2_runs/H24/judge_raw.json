 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 10,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, smoke, injury, property damage, or emergency-service response to the relevant regulator within 5 calendar days after learning of it, whether or not injury or property damage occurred. Incidents involving death, serious injury, active fire, or an ongoing threat to life must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% for any model; a rate above 5% is non-compliant. Manufacturers must provide per-model results and protocol details to regulators, the other signatory company, and customers who buy or are considering buying that model. This customer-specific disclosure does not require publication of individual company per-model failure rates to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support remote emergency shut-off by 1 January 2028, with safeguards against unauthorized activation and a locally available means of shut-off. For already-installed units, manufacturers must provide a compatible retrofit or replacement plan within 2 years and complete required retrofits within 6 years of this standard taking effect. Where retrofit is infeasible, provide customers with an equivalent risk-reduction measure and notify the regulator."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard is adopted. Manufacturers must provide regulators with evidence that the suppression system is appropriate for the unit and does not create additional material hazards."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 10,
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must provide customers with clear safety notices for hazards, precautions, and material safety updates affecting their model, and notify affected customers within 10 days of identifying a credible safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "collaborating"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S2 keeps the 5% limit and makes per-model results available to buyers, but it has no sales-stop requirement and leaves interim restrictions to regulator discretion, which protects the Hearth 10 (6.2%). S5 imposes a mandatory recall at 8 per 100,000 with no transition or corrective-action alternative, which captures the Ember 8 (9.9) and is the main cost to Halcyon. S3's 6-year retrofit window and the 2028 new-unit date are not tied to a stated adoption date, so the new-unit deadline is recorded as null."
 },
