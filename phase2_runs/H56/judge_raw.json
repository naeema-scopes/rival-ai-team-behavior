 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, thermal runaway, injury, or property damage to the relevant regulator within 24 hours of becoming aware of it, with a detailed report within 5 calendar days. Manufacturers must notify affected customers within 48 hours when an incident indicates a safety risk to their model or installed unit, and promptly provide any material updates. No incident may be omitted because it was not independently verified; reports may be marked preliminary."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Exceeding 5% alone does not automatically prohibit sale or justify a sales restriction; any interim measures must be based on a separate, documented risk determination and be proportionate to the demonstrated risk. Manufacturers must submit complete per-model results, including sample size and failure rate, to the relevant regulator and provide those results to customers purchasing that model; they are not required to be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support it before sale. Manufacturers must enable the capability on already-installed units within six years of adoption, where technically feasible, and notify owners of units that cannot be updated."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a mandatory recall when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period. The manufacturer must notify the regulator and affected customers within 48 hours of the threshold being met and provide a remedy at no cost. A recall is also required when the regulator determines a serious defect presents an unreasonable risk, regardless of rate."
   }
  },
