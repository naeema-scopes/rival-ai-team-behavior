 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a preliminary account and known risks. Notify affected customers within 72 hours when an incident indicates a credible safety risk to their units, and promptly provide protective instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires a corrective-action plan, enhanced regulator oversight, and retesting on a regulator-approved schedule; it does not by itself prohibit sale or require an automatic market ban. Individual-company per-model failure rates must not be published to the general public; regulators may publish aggregate, non-identifying results."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For units already installed when this standard is adopted, manufacturers must provide the capability through retrofit or an equivalent safe upgrade within six years, where technically feasible, and notify owners of units that cannot be upgraded."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery systems must include built-in fire suppression designed to limit fire propagation and protect occupants and neighbouring properties. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 3,
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Notify affected customers within 72 hours when a credible safety risk is identified, and provide protective instructions and updates as material facts emerge."
   }
  },
