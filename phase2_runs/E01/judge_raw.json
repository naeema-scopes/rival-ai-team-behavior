 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 2,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, smoke, uncontrolled overheating, injury, evacuation, or material property damage to the relevant regulator within 24 hours of learning of it, with a follow-up report within 30 days. Other confirmed thermal incidents shall be reported within 10 business days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers shall submit complete per-model results, including sample size and failures, to the relevant regulator and provide the complete results for that model to customers before purchase. If a model exceeds the 5% failure-rate benchmark, the manufacturer shall submit a corrective-action plan within 30 days and complete retesting within 90 days."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "All new home battery units shall support remote emergency shut-off. Existing installed units shall be brought into compliance, through retrofit or replacement where technically feasible, within six years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units shall include built-in fire suppression designed for the hazards associated with the battery chemistry and installation. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when a model exceeds 8 verified thermal incidents per 100,000 installed units in a year, or when the regulator determines that a defect poses an imminent serious risk; the regulator may require a broader recall where warranted by the evidence. Manufacturers shall promptly notify owners and relevant authorities of newly identified material hazards."
   }
  },
