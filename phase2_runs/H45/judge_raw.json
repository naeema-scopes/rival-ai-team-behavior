  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 14,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of learning of it, with a fuller report within 10 business days. Other confirmed thermal incidents must be reported within 10 business days. Manufacturers must notify affected customers promptly when an incident presents a credible safety risk, and no later than 5 business days after that determination."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers a corrective-action plan submitted to the regulator and annual retesting until compliant; it does not by itself automatically bar sales. Full per-model results must be submitted confidentially to the regulator and provided to customers who buy that model, including prospective customers before purchase."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support secure remote emergency shut-off no later than three years after this standard takes effect... For units already installed when the standard takes effect, manufacturers must provide a retrofit or equivalent mitigation plan and complete implementation within six years."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": true,
    "quote": "A manufacturer must promptly notify regulators and affected customers and initiate a recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year. A recall is also required when the regulator determines that a defect or hazard presents an unreasonable risk of serious injury or fire, regardless of the incident rate."
   }
