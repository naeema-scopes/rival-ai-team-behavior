 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a written follow-up within 10 business days. They must notify affected customers within 72 hours when an incident presents a credible safety risk to their units, and provide updates as material facts emerge."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C using a common, regulator-approved protocol, a representative sample, and documented failure criteria. Results need not be published to the general public, but customers must be provided the model’s failure rate, sample size, test date, and a plain-language summary of the testing and any material safety implications."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required for all newly manufactured units beginning 24 months after adoption. Manufacturers must retrofit installed units to support remote emergency shut-off, where technically feasible, within 72 months after adoption, and report progress and any infeasibility to regulators."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption. The suppression system must be suitable for the battery chemistry and enclosure, and be validated through the regulator-approved safety testing process."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": true,
    "quote": "A rate exceeding 8 thermal incidents per 100,000 installed units in a year for any model must trigger prompt regulator review and a public explanation of the regulator’s determination. The rate is a review threshold, not an automatic recall trigger; regulators must require a recall when the evidence shows an unreasonable safety risk or a serious safety defect warrants recall."
   }
