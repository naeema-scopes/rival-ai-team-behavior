 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a complete investigation report within 30 days. They must notify affected customers within 48 hours when an incident presents a plausible continuing safety risk, and promptly provide updates or corrective instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% per model. A model exceeding that limit must promptly notify the regulator and submit a corrective-action plan and independently validated retest schedule. The regulator may require a sales pause where the results or other evidence indicate an imminent safety risk; otherwise, the manufacturer may continue sales during a time-limited remediation period under regulator oversight."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must include a remotely operable emergency shut-off. For units already installed, manufacturers must enable remote shut-off where supported and complete any necessary retrofit or equivalent effective mitigation within six years of adoption. If a unit cannot be retrofitted, the manufacturer must notify its owner and provide a safe alternative."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression designed and validated for the unit’s battery chemistry and enclosure. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "A mandatory recall is triggered when an independently validated model-level rate exceeds 8 thermal incidents per 100,000 installed units in a year. The recall must include prompt regulator and customer notice and repair, replacement, or refund instructions. A recall requires an effective remedy; it does not by itself permanently prohibit sales of a model once the regulator verifies corrective action and safe resumption."
   }
  },
