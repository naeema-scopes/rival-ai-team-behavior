 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any thermal incident involving fire, smoke, injury, property damage, emergency response, or a safety-related shutdown within 24 hours of learning of it. Other confirmed thermal incidents must be reported within 5 business days. The manufacturer must notify affected owners within 5 business days of confirming a material safety risk, with instructions to reduce risk and contact support."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 7%. Models exceeding 5% must complete corrective action and retesting; models exceeding 7% must not be sold until corrective action is completed and regulators approve retesting at or below 7%. Customers purchasing a model must receive its test results and compliance status; individual companies' per-model failure rates must not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For installed units lacking this function, manufacturers must provide an approved retrofit or equivalent risk-reduction measure within 72 months of adoption, prioritizing units with elevated risk. Regulators may approve alternative risk-reduction measures where a retrofit is infeasible or would create additional safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression meeting a regulator-recognized performance standard, with the requirement taking effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Manufacturers must promptly notify owners of confirmed material risks and provide updated instructions and remedies. A manufacturer must initiate a regulator-supervised recall when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, or when the regulator determines that a defect presents an equivalent imminent risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
