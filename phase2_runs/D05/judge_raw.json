 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, evacuation, or material property damage to the relevant regulator within 24 hours of learning of it, with a fuller incident report within 10 business days. Other confirmed thermal incidents must be reported to the regulator within 5 business days. Manufacturers must notify affected customers within 72 hours when an incident presents a credible safety risk, and provide practical safety instructions and subsequent updates."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 7% of tested units per model. Manufacturers must provide complete model-specific test results, including failure rates, to the regulator and to customers considering or using that model. Results may be provided directly to those customers and need not be posted publicly."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new units must support remote emergency shut-off no later than 12 months after adoption. Manufacturers must retrofit installed units that do not support this function, or provide an equivalent regulator-approved protective measure, within 6 years after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A mandatory safety response is triggered when any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period. The manufacturer must notify the regulator and affected customers promptly and implement a recall or other regulator-approved remedy. Exceeding the threshold requires this safety response but does not by itself require an automatic market ban; the regulator may require a recall based on other evidence of an imminent safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
