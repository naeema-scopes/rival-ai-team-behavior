 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery thermal incident involving fire, smoke, uncontrolled overheating, emergency intervention, injury, or property damage within 24 hours of learning of it. Manufacturers must notify affected customers within 72 hours of learning of an incident that presents a potential safety risk to them, with interim protective instructions where appropriate."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5% of tested units per model. Manufacturers must submit test protocols, sample sizes, per-model failure rates, and corrective actions to the relevant regulator in confidence, and must provide the per-model numerical failure rate and test results to customers of that model in accessible form; those results need not be published publicly."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Existing installed units must be brought into compliance within 72 months of adoption where technically feasible; otherwise, the manufacturer must notify the owner and regulator, explain the limitation, and provide an equivalent risk-mitigation plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If a model exceeds 8 incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator, provide supporting data and proposed corrective actions, and notify affected customers of the risk and protective instructions. Following verification, the regulator must promptly require a recall or other effective protective measures proportionate to the risk, and may require a recall or other protective measures below the threshold whenever warranted."
   }
  },
