  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, evacuation, or property damage to the relevant regulator within 24 hours of becoming aware of it, and provide a complete incident report within 10 business days. The manufacturer must notify affected customers promptly when an incident indicates a material safety risk, and no later than 5 business days after that determination."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 8,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 8% for each model. Manufacturers must submit per-model results, sample sizes, and corrective actions to regulators for oversight, and must provide the numerical failure rate and sample size for each model to its current and prospective customers."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required for all new units manufactured 12 months or more after adoption. Manufacturers must retrofit installed units to support remote emergency shut-off within 72 months after adoption, unless a regulator approves an alternative safety measure for units that cannot reasonably be retrofitted."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression when manufactured 36 months or more after adoption. Manufacturers must provide regulators with evidence that the system has been validated for the unit's intended installation and use."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 10,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "A manufacturer must promptly notify regulators and affected customers and initiate a recall when a model's verified thermal-incident rate exceeds 10 per 100,000 installed units in any rolling 12-month period, or sooner when regulators determine a serious defect creates an unreasonable risk. Regulators may require a recall or other corrective action regardless of the numerical threshold."
   }
