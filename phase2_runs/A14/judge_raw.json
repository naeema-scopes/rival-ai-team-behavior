 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report to the relevant regulator any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage within 5 business days of learning of it. Incidents involving death, serious injury, or an ongoing risk to others shall be reported within 24 hours. Affected customers shall be notified promptly when the incident indicates a credible safety risk, and no later than 5 business days after that determination."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% shall trigger prompt regulator review and a manufacturer corrective-action plan, with retesting on a regulator-set schedule. Regulators may require additional testing or protective measures based on test results and incident data; exceeding 5% alone shall not automatically bar sale, and regulators shall determine appropriate measures to protect safety."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Existing installed units shall be brought into compliance within 72 months of adoption where technically feasible; manufacturers shall notify owners of units that cannot be upgraded and provide safe alternatives or replacement options."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": null,
    "quote": "New units shall include built-in fire suppression no sooner than 36 months after adoption of this standard. The requirement applies to units manufactured on or after the effective date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in a year, based on validated incident data, the manufacturer shall promptly notify the regulator and submit a corrective-action plan. The regulator shall determine whether a recall or other protective action is necessary, considering incident severity, causation, and the effectiveness of proposed measures."
   }
