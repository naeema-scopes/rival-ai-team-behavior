 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, property damage, or emergency-service response to the relevant regulator within 24 hours of becoming aware of it, with a detailed follow-up within 10 business days. They must notify affected customers within 72 hours when an incident indicates a potential safety risk for their model; when there is an immediate danger, they must issue an urgent customer warning without delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model with a failure rate above 5% must promptly submit a corrective-action plan and undergo retesting; the regulator may impose proportionate restrictions or additional safeguards based on the results and other safety evidence. Exceeding 5% alone does not automatically prohibit continued or new sales while the manufacturer implements an approved plan, unless the regulator determines that restriction is necessary to address an unreasonable safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new units must support remote emergency shut-off. Manufacturers must retrofit installed units that do not support it, or provide an equivalent regulator-approved emergency isolation measure, within six years after adoption. The regulator may approve a documented, technically justified alternative where retrofit is infeasible, provided equivalent protection is maintained and affected customers are informed."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "All new units must include built-in fire suppression beginning 36 months after adoption. The regulator may approve an alternative design that provides equivalent or greater fire protection, based on documented testing."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model's verified annual thermal-incident rate exceeds 8 incidents per 100,000 installed units. Manufacturers must notify the regulator and affected customers without delay, stop sales and deployment of the affected model, and implement the regulator-approved recall and remedy."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
