 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 1,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving overheating, fire, injury, emergency response, or property damage to the relevant regulator within 24 hours of learning of it, and submit a fuller report within 10 business days. Manufacturers must notify the affected customer within 24 hours when the incident involves their unit or presents an immediate safety risk; other customers of the same model must be notified within 5 business days when the incident indicates a material model-wide hazard."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate per model is 5%. Exceeding 5% does not by itself require an automatic sales suspension."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New models introduced 3 years after this standard takes effect must support remote emergency shut-off. For units already installed on that date, manufacturers must provide a retrofit or equivalent upgrade plan within 2 years and complete implementation within 6 years, prioritizing units with known safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model's annual thermal-incident rate exceeds 8 per 100,000 installed units, the manufacturer must promptly notify the regulator and provide supporting, model-specific data and its counting method. Following that assessment, the regulator may require a recall or other proportionate corrective action."
   }
  },
