 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 30,
    "customer_notice_days": 2,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, injury, emergency-service response, or material property damage to the relevant regulator within 24 hours of learning of it, with a preliminary account and known consequences. Other confirmed thermal incidents must be reported within 30 days. Manufacturers must notify affected customers within 48 hours when an incident presents an immediate safety risk, and otherwise within 30 days."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numerical_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers prompt regulator notification, a regulator-approved corrective-action plan, and retesting; it does not by itself require market exclusion. Customers who purchase or are considering purchasing a model must receive that model's numerical test result directly and confidentially, along with relevant safety status, precautions, and corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All newly installed home battery systems must support a remote emergency shut-off function no later than 12 months after adoption. Manufacturers must retrofit installed units lacking this function so that they support remote emergency shut-off within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All newly manufactured home battery systems must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers must promptly notify affected customers of material safety risks, incidents, and corrective actions."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
