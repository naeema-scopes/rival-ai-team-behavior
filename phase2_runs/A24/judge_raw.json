 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every such incident to the relevant regulator within 5 calendar days of learning of it, and immediately (within 24 hours) where there is a fire, injury, evacuation, or credible imminent risk. They shall provide affected customers with a safety notice within 5 calendar days of determining that the incident may indicate a product hazard, and promptly update the regulator and customers as material facts emerge."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers shall provide per-model results, including the failure rate and test protocol, to the relevant regulator and to customers purchasing that model before purchase, retain supporting records, and update results promptly after any retest. A failure rate above 5% triggers prompt notice to the regulator and affected customers, a corrective-action plan, and a retest schedule; it does not by itself prohibit sale or require a market ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Existing installed units shall be brought into compliance within 6 years of adoption where technically feasible; manufacturers shall notify owners of units that cannot be upgraded and explain available risk-reduction measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units shall include built-in fire suppression no later than 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer shall initiate a mandatory recall when any model exceeds 8 thermal incidents per 100,000 installed units in a year. Manufacturers shall notify the relevant regulator and affected customers promptly upon meeting the recall trigger and provide instructions for remedy, replacement, or safe decommissioning."
   }
  },
