 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any fire, thermal runaway, or other overheating event involving a battery, whether or not it caused injury or property damage, within 24 hours of becoming aware of it. Manufacturers must notify affected customers within 5 business days when an incident indicates a material risk requiring action, and immediately where an imminent hazard requires urgent action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires prompt notification to the regulator, a corrective-action plan, and retesting after changes. The regulator shall assess the results, corrective progress, and risk in determining whether further protective measures are warranted; exceeding 5% does not by itself prohibit sale or require a market ban."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support secure remote emergency shut-off by the effective date set by the regulator. For units already installed, manufacturers must provide remote shut-off capability through retrofit or replacement within 6 years of the standard taking effect, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression no later than 36 months after this standard is adopted."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in any year, the manufacturer must promptly notify the regulator and affected customers and submit a corrective-action plan. Exceeding the threshold alone does not automatically require a recall or sales ban; regulators may order either where warranted."
   }
  },
