    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 48 hours of learning of it, including incidents involving injury, property damage, or emergency response. They shall notify affected customers within 5 days when an incident indicates a material safety risk or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 60,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5%. For a model already on the market when this standard is adopted, the regulator may approve continued sale during a time-limited remediation period of up to 5 years, subject to interim safeguards, milestones, and periodic review; continued sale is not permitted where the regulator finds an imminent serious risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery storage units manufactured 12 months or more after adoption of this standard shall include remote emergency shut-off meeting regulator-approved performance and cybersecurity requirements. For units already installed when the standard is adopted, manufacturers shall assess retrofit feasibility and provide remote shut-off capability within 6 years where technically and safely feasible. Where retrofit is not feasible, manufacturers shall notify affected customers and the regulator, explain the limitation, and provide safe-use guidance and any available alternative protective measures."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery storage units manufactured 36 months or more after adoption of this standard shall include built-in fire suppression meeting regulator-approved performance requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "bounded",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A model exceeding 8 thermal incidents per 100,000 installed units in any 12-month period shall trigger prompt regulator review and a required corrective-action plan. It shall also trigger a mandatory recall, unless the regulator, based on a documented model-specific safety assessment, determines that a specified alternative corrective action provides equivalent protection and orders that action instead."
   }
