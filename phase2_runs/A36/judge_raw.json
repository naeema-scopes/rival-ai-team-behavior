 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 48,
    "other_report_days": 2,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 48 hours of learning of it, including incidents initially reported by customers or installers. Manufacturers shall provide affected customers with a safety notice within 5 calendar days of identifying a credible product-related hazard, and promptly update the notice as material facts become known."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 7% for any model. Continued sale after the retest deadline requires regulator review of corrective actions and retest results. (Results: provide results for the relevant model to its customers at no charge and without requiring a request; results need not be published to the general public.)"
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery models placed on the market 24 months or more after adoption shall support remote emergency shut-off... Manufacturers shall provide a secure software update enabling this function for installed units designed to support it within 6 years of adoption."
   },
   "S4_fire_suppression": {
