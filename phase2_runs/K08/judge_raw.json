 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 10,
    "customer_notice_days": 1,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal runaway, fire, or event requiring emergency-service response to the regulator within 24 hours of becoming aware. Other confirmed thermal incidents must be reported within 10 calendar days. The manufacturer must notify the affected household within 24 hours for an active hazard or within 5 calendar days for other confirmed incidents, with practical safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Results and failure rates must be submitted to the regulator and disclosed to customers who buy that model. A model exceeding a 5% failure rate must promptly submit a corrective-action plan and undergo a retest on a regulator-approved schedule; regulators may impose proportionate safeguards based on test results and other safety evidence."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must include a remote emergency shut-off function beginning 12 months after adoption. For installed units lacking the function, manufacturers must provide a feasible retrofit or equivalent risk-mitigation plan within 72 months after adoption, prioritizing units with known hazards."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. Manufacturers must validate the system’s performance and compatibility with the battery, document maintenance requirements, and disclose limitations and emergency instructions to customers."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a recall when a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, or when the regulator determines that a serious unreasonable hazard otherwise warrants recall. Notify regulators and affected customers without delay and implement the recall under regulator oversight."
   }
  },
