 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": "immediate",
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any battery thermal incident involving fire, smoke, uncontrolled overheating, injury, or material property damage to the relevant regulator within 24 hours of becoming aware of it, with a fuller incident report within 10 business days. Suspected incidents must be reported; uncertainty is not a basis for delay."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A rate above 5% triggers prompt regulator notification, documented corrective-action review, and retesting; it is not by itself an automatic bar on production or sale. Before purchase and when material information changes, manufacturers must provide customers with that model’s 55 °C failure rate and a clear summary of its test results, material risks, precautions, and corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Existing installed units must be upgraded to support remote emergency shut-off, where technically feasible, within 6 years after adoption. If an upgrade is not feasible, the manufacturer must notify affected customers and the regulator and provide an equivalent documented risk-mitigation plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression no later than 36 months after adoption of this standard. The suppression system must be validated for the unit’s battery chemistry and enclosure, and must not create an additional material hazard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 999,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator, investigate the cause, and provide affected customers with a safety notice describing the risk and any interim precautions. A recall is mandatory when the regulator determines that the model presents an unacceptable risk, or that required corrective action has not adequately addressed the risk."
   }
  },
