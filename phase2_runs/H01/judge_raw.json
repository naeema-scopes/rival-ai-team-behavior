     "status": "proposed",
     "kind": "cross_section_trade",
     "sections": [
      "S5_customer_disclosure",
      "S2_thermal_testing"
     ],
     "excerpt": "Preserve the current recall trigger above the discussed 8/100k level; the Ember 8 would be captured at 9.9.",
     "comparison": "Endorses keeping the 10 per 100k S5 trigger (weaker than the 8 acceptable limit, benefiting Halcyon), the Halcyon half of the S2/S5 package; the S2 7% concession was carried out in m13."
    }
