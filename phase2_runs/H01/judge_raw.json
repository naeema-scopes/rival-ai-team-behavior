    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, with a preliminary account of known facts and affected models. They shall provide affected customers with a safety notice within 48 hours, including known hazards, immediate precautions, and how to obtain assistance."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5%. A model exceeding 5% shall submit a regulator-reviewed corrective-action plan and undergo verified retesting before new market placement resumes. Manufacturers shall provide complete per-model test results to the relevant regulator and to customers purchasing that model before purchase. Individual-company per-model failure rates shall not be publicly disclosed."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units shall support remote emergency shut-off no later than 24 months after adoption, subject to regulator-approved cybersecurity and reliability requirements. Manufacturers shall retrofit already-installed units to support remote emergency shut-off within 6 years after adoption, where technically feasible, and report progress annually to the regulator. If retrofit is not technically feasible, the manufacturer shall notify affected customers and provide an approved alternative emergency-safety measure."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units shall include built-in fire suppression no later than 36 months after adoption of this standard. Manufacturers shall document the suppression design and its validation under the regulator-approved safety protocol."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model exceeds 8 thermal incidents per 100,000 installed units in a year, or when the regulator determines that a serious imminent hazard warrants recall. Manufacturers shall promptly notify the regulator and affected customers when a recall is triggered and provide remedy instructions."
