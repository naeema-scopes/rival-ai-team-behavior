 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a complete investigation and corrective-action report within 30 days. Affected customers must be notified within 48 hours when an incident presents a credible safety risk or requires action; neighbours and other potentially affected members of the public must receive prompt notice when there is an immediate local hazard. No incident may be omitted because its cause is not yet confirmed."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A model exceeding a 5% failure rate must have a regulator-approved corrective-action plan, with retesting at least every six months, clear disclosure of the model's results and risks to its customers, and any required interim safeguards. Per-model failure rates and test results must be provided to customers of that model; manufacturers must not withhold them from those customers. Individual-company, per-model failure rates and test results must not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "All new battery systems placed on the market must support secure remote emergency shut-off by the effective date of this standard. For already-installed units, manufacturers must provide a retrofit or equivalent safe mitigation within six years of that date, where technically feasible, and notify owners of units that cannot be upgraded."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery systems must include built-in fire suppression designed and validated to reduce fire propagation without creating additional hazards. This requirement takes effect 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "A model must be recalled when that model's annual thermal-incident rate exceeds 8 incidents per 100,000 installed units, based on regulator-verified incident and installation data. Manufacturers must promptly notify affected owners of material newly identified risks and provide instructions for protective action; notices must be issued within 48 hours when urgent action is warranted."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
