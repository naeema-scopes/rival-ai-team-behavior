 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers shall report any thermal incident involving fire, smoke, or hazardous overheating to the responsible regulator within 24 hours of becoming aware of it, with a fuller investigation report within 10 business days. Reports shall include incidents known to the manufacturer regardless of whether the unit is confirmed to be the cause."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": null,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Manufacturers shall provide customers considering or owning each model access to that model’s complete per-model test results, including its failure rate; results need not be publicly published. Regulators shall determine any corrective action or sales restrictions based on the complete evidence and risk; no automatic numerical failure-rate ceiling applies."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models shall support remote emergency shut-off no later than 24 months after adoption of this standard. Manufacturers shall retrofit already-installed units to support remote emergency shut-off within 6 years after adoption, where technically feasible, and shall provide customers with safe interim instructions."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units shall include built-in fire suppression no later than 36 months after adoption of this standard. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when any model exceeds 8 thermal incidents per 100,000 installed units in a year. For this standard, a recall requires customer notification and an appropriate corrective remedy; it does not automatically require a sales suspension or market ban."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
