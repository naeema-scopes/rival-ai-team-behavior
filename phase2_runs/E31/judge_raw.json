 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 7,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 5 business days of becoming aware of it, and provide a material update within 30 days. A death, serious injury, evacuation, or fire spreading beyond the battery installation must be reported to the regulator within 24 hours. Customers whose units are implicated must be notified promptly, and no later than 5 business days after the manufacturer determines that a safety action or precaution is warranted. Reports must include known circumstances and follow-up findings; uncertainty is not grounds to delay an initial report."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": 5,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% per model, with compliance required within 3 years of this standard taking effect. Exceeding the limit alone does not require automatic market withdrawal; withdrawal may be required only where necessary to address an inadequately mitigated safety risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units placed on the market 2 years after this standard takes effect must support secure remote emergency shut-off, with safeguards against unauthorized activation and a documented local shut-off method. Manufacturers must provide a plan to retrofit compatible installed units, prioritizing higher-risk units; retrofit completion for units selected for retrofit is due within 6 years of the standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units placed on the market 36 months after this standard takes effect must include built-in fire suppression meeting regulator-approved performance and reliability requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": 7,
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in a year, assessed per model rather than across the manufacturer's fleet, the manufacturer must promptly notify the regulator and provide supporting data and a risk assessment, and initiate a recall. Notices must be sent promptly and no later than 5 business days after the manufacturer determines action or precautions are warranted."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S2 keeps the 5% per-model limit and gives buyers numeric rates, but removes any automatic sales stop, so an over-limit model can remain on sale unless the regulator finds the risk unmitigated. S5 makes recall mandatory above 8 per 100,000 per model, which directly affects Halcyon's Ember 8 at 9.9, while S3's 24-month new-unit deadline is longer than the 12-month acceptable range. The S3 retrofit deadline of 72 months and the S4 36-month suppression timing sit inside the acceptable ranges."
 },
