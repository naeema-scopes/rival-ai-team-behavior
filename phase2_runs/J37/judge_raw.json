 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, including incidents initially suspected to involve a product defect. The manufacturer must notify affected customers within 48 hours when an incident presents a credible safety risk to them, and promptly provide safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 7,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "regulators_only",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 7% for any model. A model exceeding that limit must be reported to the regulator with its test results and a corrective-action plan; the regulator may impose proportionate restrictions pending demonstrated compliance."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Manufacturers must retrofit already-installed units with this capability within six years of the standard’s effective date, where technically feasible, and must inform customers of units awaiting retrofit and available interim safety steps."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after the standard’s adoption must include built-in fire suppression meeting a regulator-approved performance standard. Units manufactured before that date are not subject to this requirement."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": null,
    "quote": "When any model’s annual thermal-incident rate exceeds 8 per 100,000 installed units, the manufacturer must promptly notify the regulator, provide supporting data, and notify affected customers of the risk and interim safety steps. Exceeding this threshold requires a recall of that model."
   }
  },
  "holistic": {
