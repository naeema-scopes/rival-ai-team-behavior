 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "confirmed_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every confirmed thermal incident involving overheating, smoke, fire, or thermal runaway to the relevant regulator within 24 hours of becoming aware of it, including incidents involving injury or property damage. Manufacturers must notify affected customers within 72 hours when an incident indicates a material safety risk to their model or batch; urgent hazards require immediate notice."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop_after_remediation",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% of tested units per model. A model exceeding 5% may continue to be sold only under a time-limited corrective-action authorization from the regulator, based on a safety assessment, interim risk controls, and a defined retest plan. Customers must receive the complete 55 °C test results, including the per-model failure rate and sample size, for the model they buy, together with applicable material safety risks, precautions, and corrective actions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Remote emergency shut-off is required on all new units placed on the market beginning two years after adoption. For units already installed on the adoption date, manufacturers must provide a compatible shut-off retrofit or equivalent upgrade within six years, where technically feasible, and communicate safe interim measures to affected customers."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "Built-in fire suppression is required on all new units placed on the market beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A verified model-specific rate exceeding 8 per 100,000 during that period triggers a mandatory recall of that model. Manufacturers must promptly carry out the recall and notify affected customers and regulators."
   }
  },
  "holistic": {
   "S1_incident_reporting": "acceptable",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "acceptable"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "collaborating",
   "Halcyon-researcher": "collaborating",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "competing"
  },
  "holistic_F_N": 2,
  "holistic_F_H": -2,
  "section_notes": "S2 keeps a 5% cap but lets over-limit models keep selling under an authorization with no stated duration or interim cap, which is the main weakening and favours Northwind's Hearth 10 (6.2%). S5 makes recall mandatory above 8 per 100,000 after regulator verification, which bites on Halcyon's Ember 8 (9.9) and not on Northwind's Hearth 10 (6.4); the transition_months value of 999 for S2 reflects that no fixed end to the authorization is stated. Both companies' red lines are met (customers get per-model results, and the retrofit deadline is six years and the suppression deadline 36 months)."
 },
