 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 2,
    "scope": "serious_only",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any death, serious injury, fire, thermal runaway, or other incident presenting a credible risk of fire or injury to the relevant regulator within 24 hours of learning of it, and provide a completed incident report within 10 calendar days. They must notify affected customers within 48 hours when an incident indicates a material safety risk, including immediate precautions and support contact information."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% from the effective date of this standard. Manufacturers must submit complete per-model results, including numerical failure rates, to the regulator and provide them to customers who buy that model. Numerical per-model failure rates must not be published publicly; public reporting may state compliance status and use aggregate data."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Manufacturers must retrofit installed units to provide remote emergency shut-off within six years after this standard takes effect, where technically feasible; any units not retrofitted must be disclosed to their owners and the relevant local fire authority."
   },
   "S4_fire_suppression": {
