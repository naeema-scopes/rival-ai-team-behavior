  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 7,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the relevant regulator within 24 hours of learning of it, with an initial account of known facts. Manufacturers must notify affected customers promptly when an incident indicates a credible safety risk, and no later than 5 business days after identifying that risk."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% for each model. The manufacturer must also provide the relevant model's results to customers who buy that model, in clear form before purchase. Detailed results need not be publicly published. A model exceeding the limit must not be newly placed on the market until it passes retesting."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 12,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New units placed on the market 12 months or more after adoption must support a secure remote emergency shut-off capability... Manufacturers must provide a plan to retrofit or otherwise enable this capability for installed units within 6 years after adoption, prioritizing units with identified safety risks."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after adoption must include built-in fire suppression designed for the battery's chemistry and installation environment."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "Exceeding this threshold triggers a mandatory recall of that model, including prompt notification of affected customers and an effective remedy such as repair, replacement, or refund. The regulator may approve a documented, time-limited remediation plan specifying the remedy, monitoring, and conditions for resuming sales; this does not waive the recall, customer notification, or remedy obligations."
   }
  },
