 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, property damage, or emergency-service response to the regulator within 24 hours of becoming aware of it, with an initial account of known facts. Affected customers must be notified within 48 hours when the incident presents a credible safety risk or requires customer action; otherwise, customers must receive a summary of material incident trends at least annually."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum permitted failure rate is 5% of tested units. Manufacturers must provide per-model results, including sample size and failure rate, to the regulator and to customers purchasing that model in a clear, accessible format. A model exceeding the limit must submit a corrective-action plan and retest schedule to the regulator. The regulator may restrict sales or require further action based on the results and risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "open_escape",
    "quote": "New units manufactured 24 months after this standard takes effect must support remote emergency shut-off, with safeguards against unauthorized activation and clear instructions for emergency responders. Manufacturers must provide a retrofit plan for installed units and complete retrofits, where technically feasible, within six years after the standard takes effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard takes effect. Units manufactured before the effective date are not required to be retrofitted solely to meet this section."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, the manufacturer must promptly notify the regulator and provide supporting data. The regulator must promptly assess the evidence and risk and may require a recall, customer notification, sales restrictions, or other protective measures. Manufacturers must notify affected customers and stop further sales when a recall is required."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 55,
