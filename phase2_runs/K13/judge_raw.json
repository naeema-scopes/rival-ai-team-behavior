 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": null,
    "customer_notice_days": 3,
    "scope": "serious_only",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any fire, thermal runaway, injury, emergency-service response, or material property damage involving a home battery within 24 hours of becoming aware of it, followed by a complete report within 10 business days. They must notify affected customers within 72 hours when an incident indicates a credible safety risk to their unit or requires customer action."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires prompt regulator review and a documented corrective-action plan; it is not, by itself, an automatic market ban. Manufacturers must provide complete per-model results, including test methods and failure rates, to the relevant regulator and to customers who buy that model."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "For installed units that lack this capability, manufacturers must provide a compliant retrofit or replacement within 6 years of adoption, unless the regulator approves an alternative risk-reduction measure for units where retrofit is not technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression designed for the hazards of the battery chemistry and installation environment. This requirement takes effect 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "If any model exceeds 8 thermal incidents per 100,000 installed units in a rolling 12-month period, the manufacturer must promptly notify the regulator and provide supporting data; the regulator must assess the evidence and may require a proportionate recall or other corrective action. A recall is required when the regulator determines that a serious defect creates an unacceptable risk."
   }
