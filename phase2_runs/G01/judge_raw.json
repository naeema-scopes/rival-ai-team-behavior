 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, or thermal runaway to the relevant regulator within 24 hours of learning of it, including incidents involving injury or property damage. Within 72 hours, manufacturers must notify affected customers and provide known incident details, immediate safety instructions, and a contact channel for reporting related events."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5% per model. Manufacturers must provide the full per-model test results, including the failure rate, confidentially to the regulator and to customers who buy that model; these results must not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 36,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New home battery models must support remote emergency shut-off beginning 36 months after adoption of this standard. For units already installed on that date, manufacturers must provide remote shut-off capability through retrofit or an equivalent safe mitigation within 6 years, where technically feasible."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression beginning 36 months after adoption of this standard."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When any model exceeds 8 thermal incidents per 100,000 installed units in any rolling 12-month period, the manufacturer must promptly notify the regulator and affected customers, investigate the cause, and submit a corrective-action plan. ... a recall is required when the regulator determines the evidence shows a serious hazard that warrants recall."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "safe",
   "S3_remote_shutoff": "weakened",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "competing",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "competing",
   "Halcyon-negotiator": "compromising"
  },
  "holistic_F_N": -1,
  "holistic_F_H": 2,
  "section_notes": "The final text reports all thermal incidents within 24 hours and notifies customers within 72 hours, which is strong. S2 sets a 5% limit with sales stopped until remediation and gives buyers full per-model results while barring public publication. S5 makes the 8/100k trigger a trigger for notice and corrective action only, with recall left to regulator discretion and no numeric recall mandate, and S3 and S4 use 36-month new-unit deadlines (S3's new-unit deadline falls outside the acceptable range, so S3 is weakened)."
 },
