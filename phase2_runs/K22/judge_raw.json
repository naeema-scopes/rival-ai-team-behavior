 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 10,
    "customer_notice_days": 5,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report to the relevant regulator any battery thermal incident involving fire, smoke, uncontrolled overheating, or emergency thermal shutdown within 10 calendar days of learning of it. An incident involving death, serious injury, evacuation, or an active threat to people or property must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "Each model must undergo a sustained-heat test at 55 °C before market release, at least once every three years, and after a material design change. A result above 5% requires prompt notification to the regulator and a corrective-action plan; it does not by itself bar marketing."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units manufactured 24 months after this standard takes effect must support secure remote emergency shut-off. For units already installed on that date, manufacturers must provide a compatible retrofit or equivalent safe mitigation within 6 years where technically feasible; they must inform owners of limitations and interim safety steps."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured on or after 36 months following adoption of this standard must include built-in fire suppression meeting regulator-set performance and safety requirements."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "For each model, if its verified thermal incident rate exceeds 8 per 100,000 units of that model installed during a rolling 12-month period, the manufacturer must promptly notify the regulator and affected customers and submit the underlying incident data, installed-unit denominator, verification method, and corrective-action plan. A verified rate above this threshold triggers a mandatory recall."
   }
  },
  "holistic": {
