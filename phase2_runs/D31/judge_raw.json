 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report any thermal incident involving fire, smoke, uncontrolled overheating, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a written incident report within 10 days. They must notify affected customers within 72 hours when an incident indicates a credible safety risk to their unit or model, and provide immediate safety instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The 5% failure rate is a safety benchmark, not an automatic sales-eligibility limit. Manufacturers must submit complete per-model results, sample sizes, and corrective-action plans to the regulator, and disclose the exact per-model results to current and prospective customers of that model. Exceeding 5% alone does not prohibit sales; the regulator may impose proportionate interim safeguards or sales restrictions based on evidence of risk."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": null,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support secure remote emergency shut-off by 1 January 2028, with safeguards against unauthorized access and clear customer instructions. Manufacturers must retrofit already-installed units to support remote shut-off within six years of this standard’s effective date where technically feasible, prioritizing higher-risk units. If retrofit is infeasible, the manufacturer must provide an equally effective mitigation plan to the regulator and affected customers."
   },
   "S4_fire_suppression": {
    "requirement": "validated_equivalent_allowed",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after this standard’s adoption. The regulator may approve an equivalent or stronger fire-mitigation design where the manufacturer demonstrates that it provides comparable protection to households and neighbours."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a recall when the verified annual rate for any model exceeds 8 thermal incidents per 100,000 installed units. Manufacturers must provide customers with clear safety notices promptly when new information indicates a credible risk, including the affected model, risk, immediate precautions, and available remedies."
   }
  },
