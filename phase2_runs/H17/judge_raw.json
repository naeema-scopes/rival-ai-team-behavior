 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 5,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, or fire to the relevant regulator within 5 calendar days of learning of it. An incident involving injury, property damage, evacuation, or an active fire must be reported within 24 hours."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% is a regulatory review threshold, not an automatic prohibition on sale. Before purchase, each prospective customer must receive the model's per-model test results, including its failure rate, along with relevant test limitations, any identified safety concerns, and corrective actions or use instructions."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 24,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "All new home battery units must include a remote emergency shut-off capability beginning 24 months after adoption. Manufacturers must retrofit installed units that lack this capability within 6 years of adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "All new home battery units must include built-in fire suppression beginning 36 months after adoption."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A manufacturer must initiate a recall when a model exceeds 8 validated thermal incidents per 100,000 installed units in a year, or when the regulator determines that a defect presents an imminent or otherwise unacceptable risk. A recall is a corrective safety action, not an automatic permanent sales ban; under regulator oversight, the remedy must be proportionate to the validated hazard and may include repair, replacement, or refund."
   }
