 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 2,
    "scope": "all_incidents",
    "during_investigation_required": true,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, fire, injury, or material property damage to the relevant regulator within 24 hours of learning of it, followed by a complete incident report within 10 calendar days. They must notify affected customers within 48 hours when an incident presents a credible safety risk, and promptly provide safety instructions and material updates. Suspected incidents must be logged and investigated; uncertainty about cause does not excuse timely initial reporting."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "The maximum allowed failure rate is 5%. A model exceeding 5% may not be sold unless the regulator, after reviewing the per-model results, field performance, and risk controls, grants a specific conditional authorization finding that material risk is adequately addressed. Individual-company per-model failure rates must not be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "none",
    "quote": "New home battery units placed on the market must include a remotely operable emergency shut-off that can be activated by the customer and, where necessary to address an imminent safety hazard, by the manufacturer or emergency responders. Manufacturers must provide a plan to retrofit installed units lacking this capability, prioritizing units with known safety concerns, and complete retrofits within 72 months after adoption."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New home battery units must include built-in fire suppression meeting a regulator-recognized effectiveness and reliability test. This requirement applies to units manufactured 36 months after adoption of this standard or later. Existing installed units are not required to be retrofitted solely to add suppression."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": false,
    "permanent_trigger_per_100k": null,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "open",
    "notice_days": 2,
    "serious_injury_recall": false,
    "quote": "If a model exceeds 8 thermal incidents per 100,000 installed units in a year, the manufacturer must promptly notify the regulator, provide supporting data, and conduct a documented risk assessment. The regulator must promptly determine whether a recall or other corrective action is necessary, considering incident severity, data reliability, exposure, and effective remedies; it may require a recall where the evidence shows an imminent or material safety risk."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "acceptable",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 100,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "compromising",
   "Halcyon-researcher": "competing",
   "Halcyon-drafter": "compromising",
   "Halcyon-negotiator": "collaborating"
  },
  "holistic_F_N": 1,
  "holistic_F_H": 1,
  "section_notes": "The final S2 sets a hard 5% permanent limit but lets the regulator grant conditional authorization for models above it, which keeps the Hearth 10 (6.2%) on the market under conditions. S5 makes the 8-per-100,000 level a notification and risk-assessment trigger only, with no mandatory recall, which largely protects the Ember 8 (9.9) from automatic recall. S3 sets a 72-month retrofit deadline (meets Northwind's 6-year red line), and S4 requires built-in suppression from 36 months (meets Halcyon's red line)."
 },
