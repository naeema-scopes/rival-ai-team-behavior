     "status": "carried_out",
     "excerpt": "A model exceeding 5% may not be sold unless the regulator, after reviewing the per-model results, field performance, and risk controls, grants a specific conditional authorization",
     "kind": "cross_section_trade",
     "sections": [
      "S2",
      "S5"
