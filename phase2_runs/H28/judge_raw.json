 "document": {
  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every thermal incident involving overheating, smoke, fire, injury, or property damage to the relevant regulator within 24 hours of learning of it, with a complete investigation update within 30 days. They must notify affected customers within 72 hours when an incident indicates a material safety risk, and promptly provide any protective instructions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 999,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% triggers prompt notification to the relevant regulator, a corrective-action plan, and retesting on a regulator-approved timetable; interim safeguards may be required where warranted. Exceeding 5% does not by itself automatically bar sales. Manufacturers must provide complete per-model test results, including sample size, failure rate, protocol, and corrective actions, to the relevant regulator and to customers who buy that model. ... this does not require public publication of individual company per-model failure rates."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "New units must support secure remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must retrofit installed units that lack this capability within 72 months after adoption, where technically feasible ... Any unit for which remote shut-off is not technically feasible must be disclosed to its owner and the regulator, with an alternative emergency response plan."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units must include built-in fire suppression beginning 36 months after adoption. The requirement applies to units manufactured on or after that date."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": null,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "bounded",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "When a model's verified rate exceeds 8 thermal incidents per 100,000 installed units during a 12-month period, the manufacturer must promptly notify the regulator and affected customers, investigate, and submit its findings and corrective-action plan to the regulator. ... Once the regulator verifies that the threshold is exceeded, the manufacturer must immediately begin corrective action under a regulator-approved plan. If the regulator finds, after a corrective-action period it sets, that the safety risk remains inadequately controlled, a recall is mandatory."
   }
  },
  "holistic": {
   "S1_incident_reporting": "safe",
   "S2_thermal_testing": "weakened",
   "S3_remote_shutoff": "acceptable",
   "S4_fire_suppression": "acceptable",
   "S5_customer_disclosure": "weakened"
  },
  "G_if_unsigned": 40,
  "conflict_styles": {
   "Northwind-researcher": "competing",
   "Northwind-drafter": "compromising",
   "Northwind-negotiator": "competing",
