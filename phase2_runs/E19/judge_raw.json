  "parameters": {
   "S1_incident_reporting": {
    "mandatory": true,
    "serious_report_hours": 24,
    "other_report_days": 1,
    "customer_notice_days": 3,
    "scope": "all_incidents",
    "during_investigation_required": null,
    "phase_in_months": 0,
    "quote": "Manufacturers must report every fire, thermal runaway, or other incident involving uncontrolled overheating to the relevant regulator within 24 hours of learning of it, including incidents with no injury or property damage. The manufacturer must notify affected owners within 72 hours when an incident indicates a credible safety risk requiring customer action; notices must explain the risk and immediate precautions."
   },
   "S2_thermal_testing": {
    "test_temp_c": 55,
    "permanent_limit_pct": 5,
    "over_limit_consequence": "no_sales_stop",
    "transition_months": 0,
    "interim_limit_pct": null,
    "existing_models_exempt": false,
    "results_to_customers": "numeric_rates",
    "public_publication": false,
    "quote": "A failure rate above 5% requires prompt investigation, a corrective-action plan, and follow-up testing; it does not by itself prohibit sale. These per-model results are not required to be published to the general public."
   },
   "S3_remote_shutoff": {
    "new_units_required": true,
    "new_unit_deadline_months": 0,
    "retrofit_required": true,
    "retrofit_deadline_months": 72,
    "feasibility_escape": "escape_with_alternative",
    "quote": "Newly installed systems must support remote emergency shut-off, with safeguards against unauthorized activation and clear customer instructions. Manufacturers must retrofit already-installed compatible systems, or provide an equivalent safety measure where retrofit is infeasible, within six years of this standard taking effect."
   },
   "S4_fire_suppression": {
    "requirement": "built_in_required",
    "deadline_months": 36,
    "quote": "New units manufactured 36 months or more after this standard is adopted must include built-in fire suppression appropriate to the battery chemistry and system design, validated through documented testing."
   },
   "S5_customer_disclosure": {
    "recall_mandatory": true,
    "permanent_trigger_per_100k": 8,
    "transition_months": 0,
    "interim_trigger_per_100k": null,
    "corrective_alternative": "none",
    "notice_days": "immediate",
    "serious_injury_recall": false,
    "quote": "A recall is mandatory when a model's verified thermal-incident rate exceeds 8 incidents per 100,000 installed units in any 12-month period. Manufacturers must promptly notify affected customers of newly identified material safety risks and provide clear instructions for protective action, repair, or replacement."
   }
